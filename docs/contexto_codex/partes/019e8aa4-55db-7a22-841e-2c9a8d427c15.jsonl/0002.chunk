{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a025f4-5f7d-7191-b1af-b958b3c585aa", "item_id": "call_smf5dHttMwAyXLWlzeNrCFBf", "rollout_ordinal": 2167, "created_at_ms": 1787343273834, "item_type": "fileChange", "updated_at_ordinal": 2167, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_smf5dHttMwAyXLWlzeNrCFBf", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\app.js", "kind": {"type": "update", "move_path": null}, "diff": "@@ -10,2 +10,3 @@\n   playing: false,\n+  catalogWorking: false,\n   reprocessing: false,\n@@ -45,2 +46,3 @@\n   timelineFill: document.getElementById(\"timelineFill\"),\n+  addButton: document.getElementById(\"addButton\"),\n   startButton: document.getElementById(\"startButton\"),\n@@ -48,2 +50,3 @@\n   reprocessButton: document.getElementById(\"reprocessButton\"),\n+  deleteButton: document.getElementById(\"deleteButton\"),\n   detailButton: document.getElementById(\"detailButton\"),\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a025f4-5f7d-7191-b1af-b958b3c585aa", "item_id": "item-345", "rollout_ordinal": 2171, "created_at_ms": 1787343276472, "item_type": "agentMessage", "updated_at_ordinal": 2171, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-345", "text": "Voy a centralizar un poco los estados de botones para evitar falsos “clicables”: si el catálogo está trabajando, se bloquean seleccionar, agregar, eliminar, reprocesar y cantar.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a025f4-5f7d-7191-b1af-b958b3c585aa", "item_id": "call_XC33fn2E4FP1QL5HFrlJuLvl", "rollout_ordinal": 2174, "created_at_ms": 1787343284285, "item_type": "fileChange", "updated_at_ordinal": 2174, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_XC33fn2E4FP1QL5HFrlJuLvl", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\app.js", "kind": {"type": "update", "move_path": null}, "diff": "@@ -157,3 +157,3 @@\n     button.type = \"button\";\n-    button.disabled = state.playing || state.reprocessing;\n+    button.disabled = state.playing || state.catalogWorking;\n     button.innerHTML = `\n@@ -172,3 +172,3 @@\n function selectSong(index) {\n-  if (state.playing) return;\n+  if (state.playing || state.catalogWorking) return;\n   state.selectedIndex = index;\n@@ -195,2 +195,3 @@\n   els.stopButton.disabled = true;\n+  updateCatalogButtons();\n \n@@ -202,3 +203,3 @@\n     els.startButton.disabled = true;\n-    els.reprocessButton.disabled = true;\n+    updateCatalogButtons();\n     setStatus(backendReady ? \"Agrega una cancion para comenzar\" : \"Conectando backend\", false);\n@@ -211,4 +212,4 @@\n   els.currentTime.textContent = formatTime(state.current);\n-  els.startButton.disabled = !backendReady || !song.prepared || !song.id;\n-  els.reprocessButton.disabled = !backendReady || state.playing || state.reprocessing || !song.id;\n+  els.startButton.disabled = !backendReady || state.catalogWorking || !song.prepared || !song.id;\n+  updateCatalogButtons();\n   setStatus(song.prepared ? \"Listo\" : \"Sin procesar\", false);\n@@ -216,2 +217,10 @@\n \n+function updateCatalogButtons() {\n+  const song = currentSong();\n+  const busy = state.playing || state.catalogWorking;\n+  els.addButton.disabled = !backendReady || busy;\n+  els.reprocessButton.disabled = !backendReady || busy || !song?.id;\n+  els.deleteButton.disabled = !backendReady || busy || !song?.id;\n+}\n+\n function currentSong() {\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a025f4-5f7d-7191-b1af-b958b3c585aa", "item_id": "item-346", "rollout_ordinal": 2178, "created_at_ms": 1787343287429, "item_type": "agentMessage", "updated_at_ordinal": 2178, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-346", "text": "Ahora incorporo las acciones reales de agregar/eliminar y actualizo los puntos donde antes solo se bloqueaba `Reprocesar`.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a025f4-5f7d-7191-b1af-b958b3c585aa", "item_id": "call_Yq6SaS1hk8mxZNa1C3BeaiWY", "rollout_ordinal": 2181, "created_at_ms": 1787343307665, "item_type": "fileChange", "updated_at_ordinal": 2181, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_Yq6SaS1hk8mxZNa1C3BeaiWY", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\app.js", "kind": {"type": "update", "move_path": null}, "diff": "@@ -387,3 +387,3 @@\n   const song = currentSong();\n-  if (!song || state.playing) return;\n+  if (!song || state.playing || state.catalogWorking) return;\n \n@@ -409,3 +409,3 @@\n   els.stopButton.disabled = false;\n-  els.reprocessButton.disabled = true;\n+  updateCatalogButtons();\n   els.detailButton.disabled = true;\n@@ -445,5 +445,94 @@\n \n+async function addSong() {\n+  if (state.playing || state.catalogWorking) return;\n+\n+  if (!backendReady || !window.pywebview?.api?.add_song) {\n+    setStatus(\"Backend no conectado\", false);\n+    return;\n+  }\n+\n+  const title = window.prompt(\"Titulo de la cancion\");\n+  if (title == null) return;\n+  const cleanTitle = title.trim();\n+  if (!cleanTitle) {\n+    setStatus(\"Ingresa un titulo para agregar\", false);\n+    return;\n+  }\n+\n+  const artist = window.prompt(\"Artista\", \"\") || \"\";\n+  state.catalogWorking = true;\n+  resetMetrics();\n+  updateCatalogButtons();\n+  renderSongs();\n+  setStatus(\"Selecciona audio; luego se preparara\", true);\n+\n+  try {\n+    const response = await window.pywebview.api.add_song(cleanTitle, artist.trim());\n+    if (response.cancelled) {\n+      setStatus(\"Agregar cancelado\", false);\n+      return;\n+    }\n+    if (!response.ok) {\n+      throw new Error(response.error || \"No se pudo agregar la cancion.\");\n+    }\n+\n+    const added = normalizeBackendSongs([response.song])[0];\n+    if (added) {\n+      songs.push(added);\n+      songs.sort((a, b) => a.title.localeCompare(b.title));\n+      state.selectedIndex = Math.max(0, songs.findIndex((song) => song.id === added.id));\n+      clearCurrentTake();\n+      renderChart();\n+    }\n+    setStatus(\"Cancion agregada\", false);\n+  } catch (error) {\n+    setStatus(`Error: ${String(error.message || error)}`, false);\n+  } finally {\n+    state.catalogWorking = false;\n+    updateSongLabels();\n+    renderSongs();\n+  }\n+}\n+\n+async function deleteSelectedSong() {\n+  const song = currentSong();\n+  if (!song || state.playing || state.catalogWorking) return;\n+\n+  if (!backendReady || !window.pywebview?.api?.delete_song) {\n+    setStatus(\"Backend no conectado\", false);\n+    return;\n+  }\n+\n+  const confirmed = window.confirm(\n+    `Se eliminara \"${song.title}\" del catalogo, junto con sus archivos preparados y grabaciones.\\n\\nQuieres continuar?`\n+  );\n+  if (!confirmed) return;\n+\n+  state.catalogWorking = true;\n+  updateCatalogButtons();\n+  renderSongs();\n+  setStatus(\"Eliminando cancion\", true);\n+\n+  try {\n+    const response = await window.pywebview.api.delete_song(song.id);\n+    if (!response.ok) {\n+      throw new Error(response.error || \"No se pudo eliminar la cancion.\");\n+    }\n+    songs = normalizeBackendSongs(response.songs || []);\n+    state.selectedIndex = Math.min(state.selectedIndex, Math.max(0, songs.length - 1));\n+    clearCurrentTake();\n+    renderChart();\n+    setStatus(songs.length ? \"Cancion eliminada\" : \"Catalogo vacio\", false);\n+  } catch (error) {\n+    setStatus(`Error: ${String(error.message || error)}`, false);\n+  } finally {\n+    state.catalogWorking = false;\n+    updateSongLabels();\n+    renderSongs();\n+  }\n+}\n+\n async function reprocessSelectedSong() {\n   const song = currentSong();\n-  if (!song || state.playing || state.reprocessing) return;\n+  if (!song || state.playing || state.catalogWorking) return;\n \n@@ -459,5 +548,6 @@\n \n+  state.catalogWorking = true;\n   state.reprocessing = true;\n   els.startButton.disabled = true;\n-  els.reprocessButton.disabled = true;\n+  updateCatalogButtons();\n   els.detailButton.disabled = true;\n@@ -475,9 +565,3 @@\n       songs[state.selectedIndex] = updated;\n-      state.current = 0;\n-      state.backendCurrent = 0;\n-      state.viewStart = 0;\n-      state.userPoints = [];\n-      state.gridYMin = null;\n-      state.gridYMax = null;\n-      resetMetrics();\n+      clearCurrentTake();\n       renderChart();\n@@ -488,5 +572,6 @@\n   } finally {\n+    state.catalogWorking = false;\n     state.reprocessing = false;\n     els.startButton.disabled = !backendReady || !currentSong()?.prepared;\n-    els.reprocessButton.disabled = !backendReady || !currentSong();\n+    updateCatalogButtons();\n     renderSongs();\n"}], "status": "completed"}}
