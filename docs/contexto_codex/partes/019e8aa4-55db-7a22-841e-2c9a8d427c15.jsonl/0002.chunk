{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "item-382", "rollout_ordinal": 2386, "created_at_ms": 1787344969411, "item_type": "agentMessage", "updated_at_ordinal": 2386, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-382", "text": "Ajusto el reloj del gráfico para que use la duración de la toma cuando estás revisando una grabación guardada, y la duración de la canción cuando estás en modo canto.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
