e, when available.\n}\n\ntype ClipRect = {\n  height: number;\n  width: number;\n  x: number;\n  y: number;\n};\n\ntype WaitUntil = LoadState | \"commit\";\n\ntype MouseButton = \"left\" | \"right\" | \"middle\";\n\ntype KeyboardModifier = \"Alt\" | \"Control\" | \"ControlOrMeta\" | \"Meta\" | \"Shift\";\n\ntype SelectOptionDescriptor = {\n  index?: number;\n  label?: string;\n  value?: string;\n};\n\ntype WaitForState = \"attached\" | \"detached\" | \"visible\" | \"hidden\";\n\ntype TabClipboardEntry = {\n  base64?: string;\n  mimeType: string;\n  text?: string;\n};\n```\n"}], "structuredContent": null, "_meta": {"browser_use": {}, "codex/browserUse": true, "codex/nodeReplExecutionDurationMs": 2545, "codex/toolSurface": {"backend": "iab", "browserId": "-10ce-4a81-bf20-d6f230a552ea", "kind": "browserUse"}}}, "error": null, "durationMs": 2782}}
