{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "item-372", "rollout_ordinal": 2324, "created_at_ms": 1787344827824, "item_type": "agentMessage", "updated_at_ordinal": 2324, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-372", "text": "Voy a añadir un módulo pequeño para tomas, en vez de meter toda esa lógica en la UI. Así el formato queda claro: audio de voz, resultado JSON, datos de gráfico, duración y métricas viven juntos por cada grabación.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "call_5NrVjPmQbusFf888L40zFbi8", "rollout_ordinal": 2327, "created_at_ms": 1787344848380, "item_type": "fileChange", "updated_at_ordinal": 2327, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_5NrVjPmQbusFf888L40zFbi8", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\tomas.py", "kind": {"type": "add"}, "diff": "import json\nimport os\nfrom datetime import datetime\n\nimport soundfile as sf\n\nfrom audio.catalogo import carpeta_grabaciones\n\n\ndef guardar_toma(cancion, ruta_grabacion, resultado, diagnostico=None):\n    toma = _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico)\n    with open(toma[\"metadata_path\"], \"w\", encoding=\"utf-8\") as f:\n        json.dump(toma, f, indent=2, ensure_ascii=False)\n    return toma\n\n\ndef listar_tomas(cancion):\n    carpeta = carpeta_grabaciones(cancion[\"id\"])\n    tomas = []\n    for nombre in os.listdir(carpeta):\n        if not nombre.lower().endswith(\".wav\"):\n            continue\n        ruta_grabacion = os.path.join(carpeta, nombre)\n        toma = cargar_toma_desde_audio(cancion, ruta_grabacion)\n        if toma:\n            tomas.append(toma)\n\n    return sorted(tomas, key=lambda item: item.get(\"created_at\", \"\"), reverse=True)\n\n\ndef cargar_toma_desde_audio(cancion, ruta_grabacion):\n    metadata_path = _metadata_toma_path(ruta_grabacion)\n    if os.path.exists(metadata_path):\n        with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\n            toma = json.load(f)\n        toma[\"voice_path\"] = ruta_grabacion\n        toma[\"metadata_path\"] = metadata_path\n        toma[\"result_path\"] = _resultado_path(ruta_grabacion)\n        toma[\"instrumental_path\"] = cancion.get(\"instrumental\", \"\")\n        return toma\n\n    resultado_path = _resultado_path(ruta_grabacion)\n    resultado = _leer_json(resultado_path) if os.path.exists(resultado_path) else {}\n    return _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico=None)\n\n\ndef _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico=None):\n    resultado = resultado or {}\n    return {\n        \"id\": os.path.splitext(os.path.basename(ruta_grabacion))[0],\n        \"song_id\": cancion[\"id\"],\n        \"song_title\": cancion.get(\"titulo\", \"Sin titulo\"),\n        \"artist\": cancion.get(\"artista\") or \"Sin artista\",\n        \"created_at\": _fecha_toma(ruta_grabacion),\n        \"voice_path\": ruta_grabacion,\n        \"instrumental_path\": cancion.get(\"instrumental\", \"\"),\n        \"result_path\": _resultado_path(ruta_grabacion),\n        \"metadata_path\": _metadata_toma_path(ruta_grabacion),\n        \"duration\": _duracion(ruta_grabacion),\n        \"metrics\": _metricas(resultado),\n        \"graph\": resultado.get(\"grafico\") or {},\n        \"diagnostics\": diagnostico or {},\n    }\n\n\ndef _metricas(resultado):\n    return {\n        \"error_prom\": resultado.get(\"error_prom\"),\n        \"desviacion\": resultado.get(\"desviacion\"),\n        \"tendencia\": resultado.get(\"tendencia\"),\n        \"porcentaje_50\": resultado.get(\"porcentaje_50\"),\n        \"porcentaje_100\": resultado.get(\"porcentaje_100\"),\n        \"puntos_comparados\": resultado.get(\"puntos_comparados\"),\n        \"error_medio_firmado\": resultado.get(\"error_medio_firmado\"),\n        \"mensaje\": resultado.get(\"mensaje\"),\n    }\n\n\ndef _resultado_path(ruta_grabacion):\n    return os.path.splitext(ruta_grabacion)[0] + \"_resultado.json\"\n\n\ndef _metadata_toma_path(ruta_grabacion):\n    return os.path.splitext(ruta_grabacion)[0] + \"_toma.json\"\n\n\ndef _leer_json(ruta):\n    with open(ruta, \"r\", encoding=\"utf-8\") as f:\n        return json.load(f)\n\n\ndef _duracion(ruta_audio):\n    try:\n        return float(sf.info(ruta_audio).duration)\n    except RuntimeError:\n        return 0.0\n\n\ndef _fecha_toma(ruta_grabacion):\n    stem = os.path.splitext(os.path.basename(ruta_grabacion))[0]\n    partes = stem.split(\"_\")\n    if len(partes) >= 3 and partes[0] == \"usuario\":\n        try:\n            fecha = datetime.strptime(\"_\".join(partes[1:3]), \"%Y%m%d_%H%M%S\")\n            return fecha.isoformat(timespec=\"seconds\")\n        except ValueError:\n            pass\n    return datetime.fromtimestamp(os.path.getmtime(ruta_grabacion)).isoformat(timespec=\"seconds\")\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "item-373", "rollout_ordinal": 2330, "created_at_ms": 1787344854467, "item_type": "reasoning", "updated_at_ordinal": 2330, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "reasoning", "id": "item-373", "summary": ["**Updating backend imports and path handling**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "item-374", "rollout_ordinal": 2332, "created_at_ms": 1787344855491, "item_type": "agentMessage", "updated_at_ordinal": 2332, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-374", "text": "Ahora conecto ese módulo al backend de escritorio: listar tomas por canción, guardar automáticamente la toma al terminar de cantar y devolver URLs `file://` para que el reproductor web pueda cargar voz e instrumental.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "call_kX0zLUMraKepwbV7N5QzyqYd", "rollout_ordinal": 2335, "created_at_ms": 1787344868526, "item_type": "fileChange", "updated_at_ordinal": 2335, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_kX0zLUMraKepwbV7N5QzyqYd", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\desktop_live.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -20,2 +20,3 @@\n from audio.pitch import extraer_pitch_desde_audio\n+from audio.tomas import guardar_toma, listar_tomas\n \n@@ -65,2 +66,9 @@\n \n+    def get_takes(self, song_id):\n+        try:\n+            cancion = cargar_cancion(song_id)\n+            return [self._toma_para_ui(cancion, toma) for toma in listar_tomas(cancion)]\n+        except Exception as exc:\n+            return {\"ok\": False, \"error\": str(exc)}\n+\n     def add_song(self, title, artist=\"\"):\n@@ -228,2 +236,6 @@\n             resultado_ui = self._resultado_para_ui(resultado)\n+            with self._lock:\n+                diagnostico = dict(self._estado.get(\"diagnostics\") or {})\n+            toma = guardar_toma(cancion, ruta_grabacion, resultado, diagnostico)\n+            resultado_ui[\"take\"] = self._toma_para_ui(cancion, toma)\n \n@@ -371,2 +383,27 @@\n \n+    def _toma_para_ui(self, cancion, toma):\n+        metricas = toma.get(\"metrics\") or {}\n+        grafico = toma.get(\"graph\") or {}\n+        puntos_ref = self._puntos_hz_a_midi(\n+            grafico.get(\"t_ref\", []),\n+            grafico.get(\"f_ref\", []),\n+        )\n+        puntos_user = self._puntos_hz_a_midi(\n+            grafico.get(\"t_usr\", []),\n+            grafico.get(\"f_usr\", []),\n+        )\n+        return {\n+            \"id\": toma[\"id\"],\n+            \"song_id\": cancion[\"id\"],\n+            \"created_at\": toma.get(\"created_at\", \"\"),\n+            \"duration\": float(toma.get(\"duration\") or 0),\n+            \"voice_url\": self._archivo_url(toma.get(\"voice_path\", \"\")),\n+            \"instrumental_url\": self._archivo_url(cancion.get(\"instrumental\", \"\")),\n+            \"metrics\": metricas,\n+            \"points_ref\": self._reducir_puntos(puntos_ref, max_puntos=1400),\n+            \"points_user\": self._reducir_puntos(puntos_user, max_puntos=1400),\n+            \"preview_ref\": self._reducir_puntos(puntos_ref, max_puntos=80),\n+            \"preview_user\": self._reducir_puntos(puntos_user, max_puntos=80),\n+        }\n+\n     def _tarea_en_curso(self):\n@@ -399,2 +436,10 @@\n \n+    def _archivo_url(self, ruta):\n+        if not ruta:\n+            return \"\"\n+        try:\n+            return Path(ruta).resolve().as_uri()\n+        except ValueError:\n+            return \"\"\n+\n     def _dispositivos_por_defecto(self):\n"}], "status": "completed"}}
