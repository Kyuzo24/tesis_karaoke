{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0260d-02df-7ef1-8a08-ac36f5eaf521", "item_id": "item-378", "rollout_ordinal": 2348, "created_at_ms": 1787344902903, "item_type": "agentMessage", "updated_at_ordinal": 2348, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-378", "text": "Para que la gráfica pueda alternar entre “canto en vivo” y “toma guardada”, voy a separar la fuente de puntos del gráfico: referencia actual, puntos live, o puntos guardados de la toma seleccionada.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
