{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a062d5-3cb9-73d2-b503-7f0fd0e9a59b", "item_id": "item-779", "rollout_ordinal": 4996, "created_at_ms": 1788364955996, "item_type": "agentMessage", "updated_at_ordinal": 4996, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-779", "text": "Pequeño ajuste de criterio: solo habilitaré esos modos si la canción está preparada y tiene referencia detectable, para evitar botones activos con una canción todavía sin procesar.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
