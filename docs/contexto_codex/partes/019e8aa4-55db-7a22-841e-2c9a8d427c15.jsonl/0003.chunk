{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a062d5-3cb9-73d2-b503-7f0fd0e9a59b", "item_id": "item-775", "rollout_ordinal": 4965, "created_at_ms": 1788364913909, "item_type": "agentMessage", "updated_at_ordinal": 4965, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "item-775", "text": "La disponibilidad de detalle ahora depende de que haya puntos de referencia, no de que ya exista una grabación. Me queda enganchar el botón de notación superior y ajustar un poco el estilo.", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
