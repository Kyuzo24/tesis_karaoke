{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a0cc50-91d3-7061-a2f3-eeaffb57a8d1", "item_id": "call_bTzwtOAQc2AU6YejjwRrrTl5", "rollout_ordinal": 5449, "created_at_ms": 1790134316279, "item_type": "fileChange", "updated_at_ordinal": 5449, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_bTzwtOAQc2AU6YejjwRrrTl5", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\app.js", "kind": {"type": "update", "move_path": null}, "diff": "@@ -257,2 +257,36 @@\n \n+function loadThemePreference() {\n+  let saved = \"dark\";\n+  try {\n+    saved = window.localStorage.getItem(\"karaoke_theme\") || \"dark\";\n+  } catch (_error) {\n+    saved = \"dark\";\n+  }\n+\n+  setTheme(saved === \"light\" ? \"light\" : \"dark\", false);\n+}\n+\n+function updateThemeControls() {\n+  const isLight = state.theme === \"light\";\n+  document.body.dataset.theme = state.theme;\n+  els.themeToggleButton.textContent = isLight ? \"Tema claro\" : \"Tema oscuro\";\n+  els.themeToggleButton.title = isLight ? \"Cambiar a tema oscuro\" : \"Cambiar a tema claro\";\n+}\n+\n+function setTheme(theme, persist = true) {\n+  state.theme = theme === \"light\" ? \"light\" : \"dark\";\n+  if (persist) {\n+    try {\n+      window.localStorage.setItem(\"karaoke_theme\", state.theme);\n+    } catch (_error) {\n+      // Local files can run without localStorage in some embedded browsers.\n+    }\n+  }\n+  updateThemeControls();\n+}\n+\n+function toggleTheme() {\n+  setTheme(state.theme === \"light\" ? \"dark\" : \"light\");\n+}\n+\n function loadVisualOffsetPreference() {\n"}], "status": "completed"}}
