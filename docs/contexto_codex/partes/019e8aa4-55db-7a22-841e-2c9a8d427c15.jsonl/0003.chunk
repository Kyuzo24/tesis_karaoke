lay: flex;\r\n  flex-direction: column;\r\n  gap: 22px;\r\n  min-width: 0;\r\n  padding: 22px;\r\n  background: #141613;\r\n  border-right: 1px solid var(--line);\r\n}\r\n\r\n.brand,\r\n.status-strip,\r\n.section-head,\r\n.library-actions,\r\n.song-meta,\r\n.live-header,\r\n.live-stats,\r\n.chart-legend,\r\n.timeline,\r\n.control-row,\r\n.take-card-head,\r\n.take-player-head,\r\n.take-player-controls,\r\n.mix-row,\r\n.sync-row,\r\n.session-row,\r\n.diagnostic-legend {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.brand {\r\n  gap: 12px;\r\n}\r\n\r\n.brand-mark {\r\n  width: 42px;\r\n  height: 42px;\r\n  display: grid;\r\n  place-items: center;\r\n  color: var(--gold-ink);\r\n  background: var(--gold);\r\n  border-radius: 8px;\r\n  font-weight: 850;\r\n}\r\n\r\n.brand-title {\r\n  font-size: 17px;\r\n  font-weight: 760;\r\n}\r\n\r\n.brand-subtitle,\r\n.eyebrow,\r\n.section-label,\r\n.song-artist,\r\n.song-meta,\r\n.now-card span,\r\n.song-detail p,\r\n.take-card-head span,\r\n.take-card-note,\r\n.take-player-head span,\r\n.take-player-head div:last-child,\r\n.sync-row span,\r\n.sync-row strong,\r\n.session-row span,\r\n.diagnostic-card p,\r\n.diagnostic-metrics span,\r\n.metric-tile span,\r\n.current-note span,\r\n.performance-summary span {\r\n  color: var(--muted);\r\n}\r\n\r\n.brand-subtitle {\r\n  margin-top: 2px;\r\n  font-size: 13px;\r\n}\r\n\r\n.app-nav {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.nav-item {\r\n  width: 100%;\r\n  min-height: 42px;\r\n  padding: 0 12px;\r\n  color: var(--muted);\r\n  text-align: left;\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  font-weight: 760;\r\n}\r\n", "exitCode": 0, "durationMs": 299}}
