{"record_type": "item", "metadata": {"thread_id": "019e8aa4-55db-7a22-841e-2c9a8d427c15", "turn_id": "01a05f8e-fb8f-7853-9ca7-fde6a7d77432", "item_id": "call_O64YXP58JneJEERihn2wGdwT", "rollout_ordinal": 3428, "created_at_ms": 1788309861059, "item_type": "fileChange", "updated_at_ordinal": 3428, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "fileChange", "id": "call_O64YXP58JneJEERihn2wGdwT", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\karaoke.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -64,3 +64,3 @@\n     if pitch_callback is not None:\n-        pitch_queue = queue.Queue(maxsize=1)\n+        pitch_queue = queue.Queue(maxsize=2)\n         pitch_stop = threading.Event()\n@@ -139,2 +139,6 @@\n \n+    audio = np.nan_to_num(audio.astype(\"float32\", copy=False), nan=0.0, posinf=0.0, neginf=0.0)\n+    peak = float(np.max(np.abs(audio))) if audio.size else 0.0\n+    if peak > 0.98:\n+        audio = audio / peak * 0.98\n     return np.ascontiguousarray(audio)\n@@ -146,2 +150,6 @@\n \n+    chunk = np.asarray(chunk, dtype=\"float32\").copy()\n+    if not len(chunk):\n+        return\n+\n     try:\n"}], "status": "completed"}}
