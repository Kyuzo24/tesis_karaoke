857:  state.takeAnimationId = requestAnimationFrame(takePlaybackLoop);\nui_live\\app.js:1861:  const take = selectedTake();\nui_live\\app.js:1862:  if (!take?.instrumentalUrl || !trackAudio.src) return;\nui_live\\app.js:1864:  const target = Math.max(0, (voiceAudio.currentTime || 0) + state.syncOffsetMs / 1000);\nui_live\\app.js:1875:  voiceAudio.volume = Number(els.voiceVolume.value || 0) / 100;\nui_live\\app.js:1877:  voiceAudio.muted = state.voiceMuted;\nui_live\\app.js:1882:  els.voiceMuteButton.classList.toggle(\"is-muted\", state.voiceMuted);\nui_live\\app.js:1884:  els.voiceMuteButton.textContent = state.voiceMuted ? \"Voz mute\" : \"Voz\";\nui_live\\app.js:1890:  const take = selectedTake();\nui_live\\app.js:1891:  const duration = take?.duration || 0;\nui_live\\app.js:1892:  els.takeTimeLabel.textContent = `${formatTime(state.current)} / ${formatTime(duration)}`;\nui_live\\app.js:2008:      takes = [];\nui_live\\app.js:2076:async function deleteSelectedSong() {\nui_live\\app.js:2080:  if (!backendReady || !window.pywebview?.api?.delete_song) {\nui_live\\app.js:2086:    `Se eliminara \"${song.title}\" del catalogo, junto con sus archivos preparados y grabaciones.\\n\\nQuieres continuar?`\nui_live\\app.js:2098:    const response = await window.pywebview.api.delete_song(song.id);\nui_live\\app.js:2100:      throw new Error(response.error || \"No se pudo eliminar la cancion.\");\nui_live\\app.js:2104:    takes = [];\nui_live\\app.js:2230:  } else if (session.status === \"recording\") {\nui_live\\app.js:2268:  if (backendReady && state.sessionStatus === \"recording\") {\nui_live\\app.js:2276:    state.sessionStatus === \"recording\" &&\nui_live\\app.js:2303:  if (result?.take) {\nui_live\\app.js:2304:    const savedTake = normalizeBackendTakes([result.take])[0];\nui_live\\app.js:2306:      takes = [savedTake, ...takes.filter((take) => take.id !== savedTake.id)];\nui_live\\app.js:2344:    els.metricTight.textContent = \"Sin toma\";\nui_live\\app.js:2397:    note: