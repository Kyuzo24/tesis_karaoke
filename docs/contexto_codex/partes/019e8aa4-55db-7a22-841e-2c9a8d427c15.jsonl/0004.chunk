v class=\"modal-actions\">\n+        <button class=\"button\" id=\"genericModalCancel\" type=\"button\">Cancelar</button>\n+        <button class=\"button button-primary\" id=\"genericModalSubmit\" type=\"submit\">Guardar</button>\n+      </div>\n+    </form>\n+  </div>\n+\n   <script src=\"app.js\"></script>\n"}], "status": "completed"}}
