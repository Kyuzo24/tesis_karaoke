{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-bce917bf-2ddc-4263-a957-85e2fe170441", "rollout_ordinal": 492, "created_at_ms": 1790648880644, "item_type": "fileChange", "updated_at_ordinal": 492, "started_at_ms": 1790648880644, "completed_at_ms": 1790648880646}, "item": {"type": "fileChange", "id": "exec-bce917bf-2ddc-4263-a957-85e2fe170441", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\comparar_live_vocadito.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -84,3 +84,3 @@\n     variants = ['antes', '0.6', '0.7', '0.8'] if args.development else ['antes', 'despues']\n-    profiles = ['desktop'] if args.development else ['clasica', 'desktop']\n+    profiles = ['clasica', 'desktop']\n     rows = []\n@@ -140,7 +140,7 @@\n         # sin perder mas de 2 puntos de acierto ni aumentar omisiones mas de 2 puntos.\n-        baseline = totals['all']['desktop_antes']\n         eligible = [v for v in variants[1:]\n-                    if totals['all']['desktop_' + v]['pitch_correct_50c_pct'] >= baseline['pitch_correct_50c_pct'] - 2\n-                    and totals['all']['desktop_' + v]['missed_voiced_pct'] <= baseline['missed_voiced_pct'] + 2]\n-        summary['selected_threshold'] = min(eligible, key=lambda v: totals['all']['desktop_' + v]['false_voiced_pct']) if eligible else None\n+                    if all(totals['all'][p + '_' + v]['pitch_correct_50c_pct'] >= totals['all'][p + '_antes']['pitch_correct_50c_pct'] - 2\n+                           and totals['all'][p + '_' + v]['missed_voiced_pct'] <= totals['all'][p + '_antes']['missed_voiced_pct'] + 2\n+                           for p in profiles)]\n+        summary['selected_threshold'] = min(eligible, key=lambda v: sum(totals['all'][p + '_' + v]['false_voiced_pct'] for p in profiles)) if eligible else None\n     name = 'desarrollo_live.json' if args.development else 'comparacion_live.json'\n"}], "status": "completed"}}
