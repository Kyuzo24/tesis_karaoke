{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0ed8f-1189-7960-bd49-7cd7b4e89509", "item_id": "exec-d1c0537e-5817-4865-9297-950e4b3dba95", "rollout_ordinal": 743, "created_at_ms": 1790692010914, "item_type": "webSearch", "updated_at_ordinal": 743, "started_at_ms": 1790692010914, "completed_at_ms": 1790692012985}, "item": {"type": "webSearch", "id": "exec-d1c0537e-5817-4865-9297-950e4b3dba95", "query": "mirdata mir1k load_pitch pitch 0.02 0.02 download ...", "action": {"type": "search", "query": null, "queries": ["mirdata mir1k load_pitch pitch 0.02 0.02 download", "MIR-1K dataset download github MIR-1K.zip"]}, "results": [{"type": "text_result", "domain": "github.com", "ref_id": "turn7search0", "snippet": "The download speed from this link is very slow.Eventually I downloaded dataset from kaggle: https://www.kaggle.com/datasets/datongmuyuyi/mir1k", "title": "MIR-1K link is dead · Issue #48 · ismir/mir-datasets · GitHub", "url": "https://github.com/ismir/mir-datasets/issues/48"}, {"type": "text_result", "domain": "huggingface.co", "ref_id": "turn7search1", "snippet": "Dataset card Data Studio Files xet Community 1 ... * MIR-1K.zip", "title": "AnhP/Mir-1k-use-DJCM-training at main", "url": "https://huggingface.co/datasets/AnhP/Mir-1k-use-DJCM-training/tree/main"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn7search2", "snippet": "* ValueError – if invalid keys are passed to partial_download ... Deprecated since version 0.3.4: Use mirdata.datasets.guitarset.load_pitch_contour ... * melody1 (F0Data) – the pitch of", "title": "Initializing — mirdata 1.0.0 documentation", "url": "https://mirdata.readthedocs.io/en/latest/source/mirdata.html"}, {"type": "text_result", "domain": "www.ncbi.nlm.nih.gov", "ref_id": "turn7search3", "snippet": "Title Human miRNA 1K", "title": "GEO Accession viewer", "url": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GPL15311"}, {"type": "text_result", "domain": "pypi.org", "ref_id": "turn7search4", "snippet": "orchset.download() # download the dataset ... ## Release files for mirdata 1.0.0 ... mirdata-1.0.0-py3-none-any.whl 263.8 kB Sep 23, 2025 | Python 3 | none |", "title": "mirdata · PyPI", "url": "https://pypi.org/project/mirdata/"}, {"type": "text_result", "domain": "figshare.com", "ref_id": "turn7search5", "snippet": "# MIR-1K.rarCite Download (760.45 MB)[Button: Share][Button: Embed]", "title": "MIR-1K.rar", "url": "https://figshare.com/articles/dataset/MIR-1K_rar/5802891"}, {"type": "text_result", "domain": "music-and-culture-technology-lab.github.io", "ref_id": "turn7search6", "snippet": "export=download&id=1Miw9G2O1Y8g253RQ2uQ4udM5XMKB-9p8'¶ ... Constant settings of MIR-1K dataset.", "title": "Constants", "url": "https://music-and-culture-technology-lab.github.io/omnizart-doc/constants.html"}, {"type": "text_result", "domain": "york135.github.io", "ref_id": "turn7search7", "snippet": "### Time-aligned lyrics annotation for (a part of) the MIR-1k dataset ... Dataset and project page: https://github.com/york135/MIRMLPop", "title": "Datasets | Jun-You Wang (王鈞右)'s homepage", "url": "https://york135.github.io/dataset/"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn7search8", "snippet": "All dataset loaders in `mirdata` have a `download()` function that allows the user to download the canonical version of the dataset (when available).", "title": "Tutorial — mirdata 0.3.1 documentation", "url": "https://mirdata.readthedocs.io/en/0.3.1/source/tutorial.html"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn7search9", "snippet": "* ValueError – if invalid keys are passed to partial_download ... Deprecated since version 0.3.4: Use mirdata.datasets.medleydb_pitch.load_audio ... Deprecated since version 0.3.4: Use mirdata.dataset", "title": "Initializing — mirdata 0.3.8 documentation", "url": "https://mirdata.readthedocs.io/en/0.3.8/source/mirdata.html"}, {"type": "text_result", "domain": "pypi.org", "ref_id": "turn7search10", "snippet": "* MedleyDB Pitch ... Data can alternatively be stored in another location by specifying `data_home` within a relevant function, e.g. `mirdata.orchset.download(data_home='my_custom_path')`", "title": "mirdata · PyPI", "url": "https://pypi.org/project/mirdata/0.2b0/"}, {"type": "text_result", "domain": "www.selectdataset.com", "ref_id": "turn7search11", "snippet": "# MIR-1K.rar ... Dataset", "title": "MIR-1K.rar", "url": "https://www.selectdataset.com/dataset/04a0ee5d2a2a6b8c73def6726580f1cf"}, {"type": "text_result", "domain": "dspace.jaist.ac.jp", "ref_id": "turn7search12", "snippet": "MIR-1K dataset", "title": "JAIST Repository", "url": "https://dspace.jaist.ac.jp/dspace/bitstream/10119/16170/2/paper.pdf"}, {"type": "text_result", "domain": "archives.ismir.net", "ref_id": "turn7search13", "snippet": "The MIR-1K data set² consists of 1,000 song clips in the form of split stereo WAV files sampled at 16 kHz, with the background music", "title": "4.1 Data Set", "url": "https://archives.ismir.net/ismir2013/paper/000063.pdf"}, {"type": "text_result", "domain": "openaccess.city.ac.uk", "ref_id": "turn7search14", "snippet": "The MIR-1K dataset (Hsu & Jang, 2010) contains 1000 clips of Chinese", "title": "City Research Online", "url": "https://openaccess.city.ac.uk/25375/1/Jansson%2C%20Andreas_final%20thesis.pdf"}, {"type": "text_result", "domain": "code.soundsoftware.ac.uk", "ref_id": "turn7search15", "snippet": "duration in MIR-1k dataset.", "title": "ON THE PREPARATION AND VALIDATION OF A LARGE-SCALE DATASET", "url": "https://code.soundsoftware.ac.uk/attachments/download/2806/ON%20THE%20PREPARATION%20AND%20VALIDATION%20OF%20A%20LARGE-SCALE%20DATASET%20OF%20SINGING%20TRANSCRIPTION.pdf"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn7search16", "snippet": "Models are evaluated using the combined test partition of MDB-stem-synth and PTDB-TUG published in [9], as well as on the entire MIR-1K dataset, which was", "title": "Proceedings of the 26th ISMIR Conference, Daejeon, Korea, September 21-25, 2025", "url": "https://zenodo.org/record/17706561/files/000080.pdf"}, {"type": "text_result", "domain": "arxiv.org", "ref_id": "turn7academia17", "snippet": "We introduce the Free Music Archive (FMA), an open and easily accessible dataset suitable for evaluating several tasks in MIR, a field concerned with browsing,", "title": "FMA: A Dataset For Music Analysis", "url": "https://arxiv.org/abs/1612.01840"}, {"type": "text_result", "domain": "www.reddit.com", "ref_id": "turn7reddit18", "snippet": "I'm trying to obtain the **ARAD\\_1K hyperspectral dataset** for academic research on RGB-to-hyperspectral image reconstruction.Unfortunately, I haven't been able to download it because both the", "title": "Looking for the ARAD_1K hyperspectral dataset (GitHub & CodaLab links unavailable)", "url": "https://www.reddit.com/r/computervision/comments/1vezgla/looking_for_the_arad_1k_hyperspectral_dataset/"}, {"type": "text_result", "domain": "hermandong.com", "ref_id": "turn7search19", "snippet": "- MIR-1K", "title": "Datasets\n\n- MIR-1K\n- MedleyDB\n- iKala\n- DSD100\n- M", "url": "https://hermandong.com/teaching/pat498_598_winter2025/lecture13_music_analysis.pdf"}]}}
