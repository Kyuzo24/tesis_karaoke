{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "exec-f8f7c5a8-ae78-42a2-8903-587f5acb3bfa", "rollout_ordinal": 14, "created_at_ms": 1788876213125, "item_type": "commandExecution", "updated_at_ordinal": 14, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "commandExecution", "id": "exec-f8f7c5a8-ae78-42a2-8903-587f5acb3bfa", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"rg --files -g AGENTS.md -g README* -g '*pitch*' -g '*f0*' -g '*fundamental*' -g '*requirements*' -g pyproject.toml\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "92170", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "rg --files -g AGENTS.md -g README* -g '*pitch*' -g '*f0*' -g '*fundamental*' -g '*requirements*' -g pyproject.toml"}], "aggregatedOutput": "ui_live\\README.md\ncanciones\\qué_gano_olvidandote_84dce906\\ref_pitch.csv\naudio\\pitch.py\naudio\\__pycache__\\pitch.cpython-314.pyc\naudio\\__pycache__\\pitch.cpython-310.pyc\ncanciones\\que_gano_olvidandote_a7c974ca\\ref_pitch.csv\ncanciones\\fdsofdisj_9425509d\\ref_pitch.csv\ndocs\\figuras\\figura_2_3_estimacion_f0.png\ndocs\\figuras\\figura_2_3_estimacion_f0.drawio\ndocs\\figuras\\figura_2_3_estimacion_f0.svg\nvenv\\Lib\\site-packages\\demucs\\__pycache__\\repitch.cpython-310.pyc\nvenv\\Lib\\site-packages\\demucs\\repitch.py\nvenv\\Lib\\site-packages\\_sounddevice_data\\portaudio-binaries\\README.md\nvenv\\Lib\\site-packages\\numpy\\ma\\README.rst\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\pitch._pi_wrapper-430.py310.nbi\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\pitch._pi_wrapper-430.py310.2.nbc\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\pitch._pi_wrapper-430.py310.1.nbc\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\pitch.cpython-310.pyc\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\guf-pitch._pi_wrapper-430.py310.nbi\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\guf-pitch._pi_wrapper-430.py310.2.nbc\nvenv\\Lib\\site-packages\\librosa\\core\\__pycache__\\guf-pitch._pi_wrapper-430.py310.1.nbc\nvenv\\Lib\\site-packages\\librosa\\core\\pitch.py\nvenv\\Lib\\site-packages\\matplotlib\\mpl-data\\sample_data\\README.txt\nvenv\\Lib\\site-packages\\packaging\\__pycache__\\requirements.cpython-310.pyc\nvenv\\Lib\\site-packages\\packaging\\requirements.py\nvenv\\Lib\\site-packages\\pkg_resources\\_vendor\\packaging\\__pycache__\\requirements.cpython-310.pyc\nvenv\\Lib\\site-packages\\pkg_resources\\_vendor\\packaging\\requirements.py\nvenv\\Lib\\site-packages\\pip\\_vendor\\packaging\\__pycache__\\requirements.cpython-310.pyc\nvenv\\Lib\\site-packages\\pip\\_vendor\\packaging\\requirements.py\nvenv\\Lib\\site-packages\\pip\\_vendor\\README.rst\nvenv\\Lib\\site-packages\\pip\\_internal\\resolution\\resolvelib\\__pycache__\\requirements.cpython-310.pyc\nvenv\\Lib\\site-packages\\pip\\_internal\\resolution\\resolvelib\\requirements.py\nvenv\\Lib\\site-packages\\scipy.libs\\libscipy_openblas-f07f5a5d207a3a47104dca54d6d0c86a.dll\nvenv\\Lib\\site-packages\\setuptools\\_vendor\\packaging\\__pycache__\\requirements.cpython-310.pyc\nvenv\\Lib\\site-packages\\setuptools\\_vendor\\packaging\\requirements.py\nvenv\\Lib\\site-packages\\sklearn\\externals\\README\nvenv\\Lib\\site-packages\\sklearn\\externals\\array_api_extra\\README.md\nvenv\\Lib\\site-packages\\sklearn\\externals\\array_api_compat\\README.md\nvenv\\Lib\\site-packages\\sklearn\\datasets\\images\\README.txt\nvenv\\Lib\\site-packages\\sympy\\parsing\\autolev\\test-examples\\README.txt\n", "exitCode": 0, "durationMs": 1625}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "exec-7d08acbe-dd75-4704-ab71-545852702c1f", "rollout_ordinal": 19, "created_at_ms": 1788876223818, "item_type": "commandExecution", "updated_at_ordinal": 19, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "commandExecution", "id": "exec-7d08acbe-dd75-4704-ab71-545852702c1f", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content audio/pitch.py; rg -n --glob '\"'!venv/**'\"' --glob '\"'!*.csv'\"' --glob '\"'!*.svg'\"' --glob '\"'!*.drawio'\"' 'YIN|PYIN|pYIN|CREPE|fmin|fmax|PitchDetector' audio docs ui_live\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "25009", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content audio/pitch.py; rg -n --glob '!venv/**' --glob '!*.csv' --glob '!*.svg' --glob '!*.drawio' 'YIN|PYIN|pYIN|CREPE|fmin|fmax|PitchDetector' audio docs ui_live"}], "aggregatedOutput": "import librosa\r\nimport numpy as np\r\n\r\ntry:\r\n    import pyworld as pw\r\nexcept ImportError:\r\n    pw = None\r\n\r\n\r\nFILTRO_SUAVE = {\r\n    \"nota_min\": \"A1\",\r\n    \"nota_max\": \"C7\",\r\n    \"percentil_rms\": 25,\r\n    \"factor_rms\": 1.25,\r\n    \"factor_rms_max\": 0.012,\r\n    \"max_gap\": 5,\r\n    \"min_frames\": 2,\r\n    \"ventana_mediana\": 7,\r\n    \"max_salto_midi\": 9,\r\n}\r\n\r\nFILTRO_TIEMPO_REAL = {\r\n    \"nota_min\": \"C2\",\r\n    \"nota_max\": \"C6\",\r\n    \"factor_rms_max\": 0.08,\r\n    \"factor_ruido\": 2.2,\r\n    \"min_rms_absoluto\": 0.002,\r\n    \"max_gap\": 1,\r\n    \"min_frames\": 3,\r\n    \"ventana_mediana\": 3,\r\n    \"max_salto_midi\": 8,\r\n}\r\n\r\n\r\ndef _rellenar_huecos_cortos(f0, max_gap):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    validos = np.where(f0 > 0)[0]\r\n    if len(validos) < 2:\r\n        return f0\r\n\r\n    for inicio, fin in zip(validos[:-1], validos[1:]):\r\n        gap = fin - inicio - 1\r\n        if 0 < gap <= max_gap:\r\n            f0[inicio + 1 : fin] = np.linspace(f0[inicio], f0[fin], gap + 2)[1:-1]\r\n    return f0\r\n\r\n\r\ndef _quitar_segmentos_cortos(f0, min_frames):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    mask = f0 > 0\r\n    inicio = None\r\n\r\n    for i, activo in enumerate(np.r_[mask, False]):\r\n        if activo and inicio is None:\r\n            inicio = i\r\n        elif not activo and inicio is not None:\r\n            if i - inicio < min_frames:\r\n                f0[inicio:i] = 0\r\n            inicio = None\r\n    return f0\r\n\r\n\r\ndef _mediana_movil(valores, ventana=7):\r\n    valores = np.asarray(valores, dtype=float)\r\n    salida = np.full_like(valores, np.nan, dtype=float)\r\n    radio = ventana // 2\r\n\r\n    for i in range(len(valores)):\r\n        inicio = max(0, i - radio)\r\n        fin = min(len(valores), i + radio + 1)\r\n        segmento = valores[inicio:fin]\r\n        segmento = segmento[~np.isnan(segmento)]\r\n        if len(segmento):\r\n            salida[i] = np.median(segmento)\r\n    return salida\r\n\r\n\r\ndef _filtrar_pitch(t, f0, y, sr, config=None, corregir_octavas=True):\r\n    config = config or FILTRO_SUAVE\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    rms = librosa.feature.rms(y=y, frame_length=2048, hop_length=512)[0]\r\n    t_rms = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=512)\r\n    energia = np.interp(t, t_rms, rms, left=0, right=0)\r\n    umbral_energia = max(\r\n        np.percentile(rms, config[\"percentil_rms\"]) * config[\"factor_rms\"],\r\n        np.max(rms) * config[\"factor_rms_max\"],\r\n    )\r\n    f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= 7:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n    if corregir_octavas:\r\n        return _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _energia_por_tiempo(y, sr, tiempos, ventana=1024):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    tiempos = np.asarray(tiempos, dtype=float)\r\n    if len(y) == 0 or len(tiempos) == 0:\r\n        return np.array([])\r\n\r\n    cuadrado = y * y\r\n    acumulado = np.concatenate(([0.0], np.cumsum(cuadrado)))\r\n    centros = np.clip((tiempos * sr).astype(int), 0, len(y) - 1)\r\n    radio = ventana // 2\r\n    inicios = np.maximum(0, centros - radio)\r\n    fines = np.minimum(len(y), centros + radio)\r\n    muestras = np.maximum(1, fines - inicios)\r\n    energia = (acumulado[fines] - acumulado[inicios]) / muestras\r\n    return np.sqrt(np.maximum(energia, 0.0))\r\n\r\n\r\ndef _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False):\r\n    config = config or FILTRO_TIEMPO_REAL\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n    raw_points = int(np.sum(f0 > 0))\r\n    rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    energia = _energia_por_tiempo(y, sr, t)\r\n    umbral_energia = 0.0\r\n    if len(energia):\r\n        umbral_energia = max(\r\n            float(np.max(energia)) * config[\"factor_rms_max\"],\r\n            config[\"min_rms_absoluto\"],\r\n        )\r\n        if ruido_base is not None and ruido_base > 0:\r\n            umbral_energia = max(umbral_energia, float(ruido_base) * config[\"factor_ruido\"])\r\n        f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= config[\"ventana_mediana\"]:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n\r\n    if devolver_info:\r\n        return t_filtrado, f_filtrado, {\r\n            \"raw_points\": raw_points,\r\n            \"filtered_points\": int(len(f_filtrado)),\r\n            \"rejected_points\": max(0, raw_points - int(len(f_filtrado))),\r\n            \"rms\": rms_chunk,\r\n            \"energy_threshold\": float(umbral_energia),\r\n            \"noise_floor\": float(ruido_base or 0.0),\r\n        }\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _corregir_octavas_por_registro(t, f0, min_puntos=30):\r\n    t = np.asarray(t, dtype=float)\r\n    f0 = np.asarray(f0, dtype=float)\r\n    if len(f0) < min_puntos:\r\n        return t, f0\r\n\r\n    midi = 69 + 12 * np.log2(f0 / 440.0)\r\n    midi = np.nan_to_num(midi, nan=0.0, posinf=0.0, neginf=0.0)\r\n    if np.sum(midi > 0) < min_puntos:\r\n        return t, f0\r\n\r\n    corregido = midi.copy()\r\n    valores = midi[midi > 0]\r\n    umbral_octava_alta = max(70.5, float(np.percentile(valores, 90)) + 4.0)\r\n    segmentos = _segmentos_pitch(t, midi)\r\n    for indice, segmento in enumerate(segmentos):\r\n        inicio, fin, mediana, duracion, _inicio_t, _fin_t = segmento\r\n        if mediana < umbral_octava_alta or duracion > 0.9:\r\n            continue\r\n\r\n        vecinos = [\r\n            nota\r\n            for nota in _medianas_vecinas(segmentos, indice, max_distancia=1.5)\r\n            if nota < umbral_octava_alta\r\n        ]\r\n        if not vecinos:\r\n            continue\r\n\r\n        actual = float(np.median(np.abs(np.asarray(vecinos) - mediana)))\r\n        una_octava_abajo = float(np.median(np.abs(np.asarray(vecinos) - (mediana - 12.0))))\r\n        if actual >= 8.0 and una_octava_abajo <= 5.5 and una_octava_abajo + 2.0 < actual:\r\n            segmento = corregido[inicio:fin]\r\n            segmento[segmento >= umbral_octava_alta] -= 12.0\r\n\r\n    f0_corregido = 440.0 * np.power(2.0, (corregido - 69.0) / 12.0)\r\n    return _limpiar_segmentos_erraticos(t, f0_corregido)\r\n\r\n\r\ndef _limpiar_segmentos_erraticos(t, f0, min_puntos=30):\r\n    t = np.asarray(t, dtype=float)\r\n    f0 = np.asarray(f0, dtype=float)\r\n    if len(f0) < min_puntos:\r\n        return t, f0\r\n\r\n    midi = 69 + 12 * np.log2(f0 / 440.0)\r\n    midi = np.nan_to_num(midi, nan=0.0, posinf=0.0, neginf=0.0)\r\n    valores = midi[midi > 0]\r\n    if len(valores) < min_puntos:\r\n        return t, f0\r\n\r\n    umbral_octava_alta = max(70.5, float(np.percentile(valores, 90)) + 4.0)\r\n    segmentos = _segmentos_pitch(t, midi)\r\n    conservar = np.ones(len(midi), dtype=bool)\r\n\r\n    for indice, segmento in enumerate(segmentos):\r\n        inicio, fin, mediana, duracion, _inicio_t, _fin_t = segmento\r\n        vecinos = _medianas_vecinas(segmentos, indice, max_distancia=1.5)\r\n        distancia_vecinos = float(np.median(np.abs(np.asarray(vecinos) - mediana))) if vecinos else 99.0\r\n\r\n        if mediana >= umbral_octava_alta + 5.0 and duracion <= 0.45 and distancia_vecinos >= 7.0:\r\n            conservar[inicio:fin] = False\r\n        elif mediana >= umbral_octava_alta and duracion <= 0.06 and distancia_vecinos >= 5.0:\r\n            conservar[inicio:fin] = False\r\n\r\n    return t[conservar], f0[conservar]\r\n\r\n\r\ndef _segmentos_pitch(t, midi, max_gap=0.18, max_jump=4.5):\r\n    segmentos = []\r\n    if len(midi) == 0:\r\n        return segmentos\r\n\r\n    inicio = 0\r\n    for i in range(1, len(midi)):\r\n        if t[i] - t[i - 1] > max_gap or abs(midi[i] - midi[i - 1]) > max_jump:\r\n            segmentos.append(_describir_segmento(t, midi, inicio, i))\r\n            inicio = i\r\n    segmentos.append(_describir_segmento(t, midi, inicio, len(midi)))\r\n    return [segmento for segmento in segmentos if segmento is not None]\r\n\r\n\r\ndef _describir_segmento(t, midi, inicio, fin):\r\n    if fin <= inicio:\r\n        return None\r\n    duracion = max(0.0, float(t[fin - 1] - t[inicio]))\r\n    mediana = float(np.median(midi[inicio:fin]))\r\n    return inicio, fin, mediana, duracion, float(t[inicio]), float(t[fin - 1])\r\n\r\n\r\ndef _medianas_vecinas(segmentos, indice, max_distancia=1.0):\r\n    _inicio, _fin, _mediana, _duracion, inicio_t, fin_t = segmentos[indice]\r\n    vecinos = []\r\n\r\n    for anterior in range(indice - 1, max(-1, indice - 4), -1):\r\n        _a_inicio, _a_fin, a_mediana, _a_duracion, _a_inicio_t, a_fin_t = segmentos[anterior]\r\n        distancia = max(0.0, inicio_t - a_fin_t)\r\n        if distancia > max_distancia:\r\n            break\r\n        vecinos.append(a_mediana)\r\n\r\n    for siguiente in range(indice + 1, min(len(segmentos), indice + 4)):\r\n        _s_inicio, _s_fin, s_mediana, _s_duracion, s_inicio_t, _s_fin_t = segmentos[siguiente]\r\n        distancia = max(0.0, s_inicio_t - fin_t)\r\n        if distancia > max_distancia:\r\n            break\r\n        vecinos.append(s_mediana)\r\n\r\n    return vecinos\r\n\r\n\r\ndef _info_pitch_vacio(ruido_base=0.0, rms=0.0):\r\n    return {\r\n        \"raw_points\": 0,\r\n        \"filtered_points\": 0,\r\n        \"rejected_points\": 0,\r\n        \"rms\": float(rms),\r\n        \"energy_threshold\": 0.0,\r\n        \"noise_floor\": float(ruido_base or 0.0),\r\n    }\r\n\r\n\r\ndef _lag_parabolico(autocorrelacion, indice):\r\n    if indice <= 0 or indice >= len(autocorrelacion) - 1:\r\n        return float(indice)\r\n\r\n    izquierda = autocorrelacion[indice - 1]\r\n    centro = autocorrelacion[indice]\r\n    derecha = autocorrelacion[indice + 1]\r\n    denominador = izquierda - 2 * centro + derecha\r\n    if abs(denominador) < 1e-12:\r\n        return float(indice)\r\n\r\n    return float(indice + 0.5 * (izquierda - derecha) / denominador)\r\n\r\n\r\ndef _pitch_autocorrelacion(frame, sr, f_min, f_max, umbral_confianza=0.24):\r\n    frame = np.asarray(frame, dtype=np.float32)\r\n    frame = frame - float(np.mean(frame))\r\n    energia = float(np.dot(frame, frame))\r\n    if energia <= 1e-9:\r\n        return 0.0\r\n\r\n    ventana = np.hanning(len(frame)).astype(np.float32)\r\n    frame = frame * ventana\r\n    n_fft = 1 << (2 * len(frame) - 1).bit_length()\r\n    espectro = np.fft.rfft(frame, n=n_fft)\r\n    autocorrelacion = np.fft.irfft(espectro * np.conj(espectro), n=n_fft)[: len(frame)]\r\n    if autocorrelacion[0] <= 0:\r\n        return 0.0\r\n\r\n    lag_min = max(1, int(sr / f_max))\r\n    lag_max = min(len(frame) - 1, int(sr / f_min))\r\n    if lag_max <= lag_min:\r\n        return 0.0\r\n\r\n    region = autocorrelacion[lag_min : lag_max + 1]\r\n    indice = int(np.argmax(region)) + lag_min\r\n    confianza = float(autocorrelacion[indice] / autocorrelacion[0])\r\n    if confianza < umbral_confianza:\r\n        return 0.0\r\n\r\n    lag = _lag_parabolico(autocorrelacion, indice)\r\n    if lag <= 0:\r\n        return 0.0\r\n    return float(sr / lag)\r\n\r\n\r\ndef extraer_pitch_ligero_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=np.float32).reshape(-1)\r\n    y = np.nan_to_num(y, nan=0.0, posinf=0.0, neginf=0.0)\r\n    rms_chunk = float(np.sqrt(np.mean(y.astype(float) ** 2))) if len(y) else 0.0\r\n    if len(y) < int(sr * 0.12):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\r\n        return np.array([]), np.array([])\r\n\r\n    frame_length = min(2048, len(y))\r\n    hop_length = 1024\r\n    f_min = librosa.note_to_hz(FILTRO_TIEMPO_REAL[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(FILTRO_TIEMPO_REAL[\"nota_max\"])\r\n    umbral_silencio = max(\r\n        FILTRO_TIEMPO_REAL[\"min_rms_absoluto\"],\r\n        float(ruido_base or 0.0) * 1.6,\r\n    )\r\n\r\n    try:\r\n        f0 = librosa.yin(\r\n            y.astype(float, copy=False),\r\n            fmin=f_min,\r\n            fmax=f_max,\r\n            sr=sr,\r\n            frame_length=frame_length,\r\n            hop_length=hop_length,\r\n            center=False,\r\n            trough_threshold=0.15,\r\n        )\r\n        t = (np.arange(len(f0), dtype=float) * hop_length + frame_length / 2) / sr\r\n        f0 = np.nan_to_num(f0, nan=0.0, posinf=0.0, neginf=0.0)\r\n    except Exception:\r\n        tiempos = []\r\n        frecuencias = []\r\n        for inicio in range(0, len(y) - frame_length + 1, hop_length):\r\n            frame = y[inicio : inicio + frame_length]\r\n            rms_frame = float(np.sqrt(np.mean(frame.astype(float) ** 2))) if len(frame) else 0.0\r\n            frecuencia = 0.0\r\n            if rms_frame >= umbral_silencio:\r\n                frecuencia = _pitch_autocorrelacion(frame, sr, f_min, f_max)\r\n            tiempos.append((inicio + frame_length / 2) / sr)\r\n            frecuencias.append(frecuencia)\r\n        t = np.asarray(tiempos, dtype=float)\r\n        f0 = np.asarray(frecuencias, dtype=float)\r\n\r\n    if not len(t):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\r\n        return np.array([]), np.array([])\r\n\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_crudo(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n\r\n    mask = f0 > 0\r\n    return t[mask], f0[mask]\r\n\r\n\r\ndef _extraer_pitch_base(y, sr):\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n    return t, f0\r\n\r\n\r\ndef extraer_pitch_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    if len(y) < int(sr * 0.18):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), {\r\n                \"raw_points\": 0,\r\n                \"filtered_points\": 0,\r\n                \"rejected_points\": 0,\r\n                \"rms\": 0.0,\r\n                \"energy_threshold\": 0.0,\r\n                \"noise_floor\": float(ruido_base or 0.0),\r\n            }\r\n        return np.array([]), np.array([])\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_detallado(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    mask_crudo = f0 > 0\r\n    t_filtrado, f_filtrado = _filtrar_pitch(t, f0, y, sr, corregir_octavas=False)\r\n    t_corregido, f_corregido = _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return {\r\n        \"t_crudo\": t[mask_crudo],\r\n        \"f_crudo\": f0[mask_crudo],\r\n        \"t_filtrado\": t_filtrado,\r\n        \"f_filtrado\": f_filtrado,\r\n        \"t_corregido\": t_corregido,\r\n        \"f_corregido\": f_corregido,\r\n    }\r\n\r\n\r\ndef extraer_pitch(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    return _filtrar_pitch(t, f0, y, sr)\r\n\r\ndef hz_to_nota(f):\r\n    if f <= 0:\r\n        return None\r\n\r\n    A4 = 440.0\r\n    C0 = A4 * pow(2, -4.75)\r\n\r\n    h = round(12 * np.log2(f / C0))\r\n    octava = h // 12\r\n    n = h % 12\r\n\r\n    nombres = ['C', 'C#', 'D', 'D#', 'E', 'F',\r\n               'F#', 'G', 'G#', 'A', 'A#', 'B']\r\n\r\n    return f\"{nombres[n]}{octava}\"\r\naudio\\pitch.py:370:            fmin=f_min,\naudio\\pitch.py:371:            fmax=f_max,\naudio\\pitch.py:425:            fmin=librosa.note_to_hz(\"C2\"),\naudio\\pitch.py:426:            fmax=librosa.note_to_hz(\"C7\"),\naudio\\pitch.py:443:            fmin=librosa.note_to_hz(\"C2\"),\naudio\\pitch.py:444:            fmax=librosa.note_to_hz(\"C7\"),\ndocs\\generar_capitulos_3_4.py:323:    add_body(document, \"La referencia se almacena como una secuencia temporal con frecuencia y nota aproximada. Su estimación utiliza Pyworld, que proporciona acceso a procedimientos de WORLD [11], y pYIN como alternativa. Antes de guardar los datos se aplican filtros de rango, energía, duración y estabilidad. El sistema permite reprocesar la referencia cuando se modifican los parámetros o cuando el resultado inicial contiene pocos puntos válidos.\")\ndocs\\generar_capitulos_3_4_v2.py:93:    add_body(document, \"Los parámetros actuales —rango A1–C7, umbral RMS, relleno de huecos de hasta cinco marcos, duración mínima de dos marcos, mediana de siete marcos y rechazo de saltos superiores a nueve semitonos— se tratarán como una configuración inicial. Se compararán configuraciones sin modificar varias variables simultáneamente y se almacenará la versión utilizada. También deberá unificarse el rango del filtro con el fallback pYIN, que actualmente comienza en C2.\")\ndocs\\generar_capitulos_3_4_v2.py:182:    add_body(document, \"pitch.py utiliza DIO y StoneMask cuando Pyworld está disponible [11]. Si la dependencia no existe, utiliza pYIN. El resultado pasa por FILTRO_SUAVE, cuya configuración actual se resume en el Cuadro 4.2. Estos parámetros se diseñaron para reducir ruido y detecciones aisladas, pero aún no constituyen valores validados para todas las voces.\")\ndocs\\generar_capitulos_3_4_v2.py:186:            (\"Rango\", \"A1–C7\", \"Descarta frecuencias fuera del rango.\", \"pYIN comienza en C2; debe unificarse.\"),\ndocs\\generar_capitulo_2_1.py:311:add_heading(document, \"2.3.2. Estimación mediante pYIN\", 2)\ndocs\\generar_capitulo_2_1.py:314:    \"pYIN es un método de estimación de frecuencia fundamental que extiende el enfoque YIN mediante un modelo probabilístico. En lugar de depender de un único umbral para seleccionar un periodo, considera múltiples candidatos y asigna probabilidades a las posibles estimaciones. Posteriormente, utiliza la continuidad temporal para obtener una trayectoria de F0 y determinar los intervalos sonoros y no sonoros [9].\",\ndocs\\generar_capitulo_2_1.py:336:    \"Pyworld proporciona acceso a las funciones de WORLD desde Python. En el prototipo actual se utiliza DIO para producir una estimación inicial y StoneMask para refinarla. Cuando esta biblioteca no se encuentra disponible, pYIN puede emplearse como alternativa. La elección definitiva para el procesamiento en tiempo real deberá considerar no solo la precisión, sino también la latencia y el consumo de recursos.\",\ndocs\\generar_capitulo_2_1.py:878:    \"librosa development team, “librosa.pyin: Fundamental Frequency Estimation Using Probabilistic YIN,” documentación oficial de librosa. Disponible en: https://librosa.org/doc/latest/generated/librosa.pyin.html.\",\ndocs\\generar_carta_gantt_actualizada.ps1:88:    @(\"RF05\",\"Extraer pitch de referencia\",\"Funcional\",\"Completado\",\"Extracción mediante Pyworld o pYIN\"),\ndocs\\generar_indice_y_portada.py:121:        (\"2.3.2.\", \"Estimación mediante pYIN\", 2),\n", "exitCode": 0, "durationMs": 1066}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "exec-69674648-f6f4-4756-a17d-8fd28c9ca9b0", "rollout_ordinal": 20, "created_at_ms": 1788876223664, "item_type": "webSearch", "updated_at_ordinal": 20, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "webSearch", "id": "exec-69674648-f6f4-4756-a17d-8fd28c9ca9b0", "query": "site.zenodo.org PTDB-TUG pitch tracking database ...", "action": {"type": "search", "query": null, "queries": ["site.zenodo.org PTDB-TUG pitch tracking database", "site.zenodo.org MIR-1K singing pitch dataset", "site.zenodo.org Vocadito dataset pitch annotations", "site.zenodo.org MDB-stem-synth dataset"]}, "results": [{"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search0", "snippet": "The MIR-1K dataset is designed for the research of singing voice separation. ... [4] Chao-Ling Hsu, Liang-Yu Chen, Jyh-Shing Roger Jang and Hsing-Ji Li, “Singing", "title": "MIR-1K dataset | Zenodo", "url": "https://zenodo.org/records/3532216"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search1", "snippet": "Part of the dissertation Pitch of Voiced Speech in the Short-Time Fourier Transform: Algorithms, Ground Truths, and Evaluation Methods. ... * PTDB-TUG (corpus truth and", "title": "A Replication Dataset for Fundamental Frequency Estimation | Zenodo", "url": "https://zenodo.org/records/3904389"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search12", "snippet": "Raw Pitch Accuracy obtained by SWIPE implementations on the MIR-1K and MDB-stem-synth datasets, compared to baseline values previously reported in self-supervised pitch estimation papers. ...", "title": "Proceedings of the 26th ISMIR Conference, Daejeon, Korea, September 21-25, 2025", "url": "https://zenodo.org/record/17706561/files/000080.pdf"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search13", "snippet": "1. <i>MIR-1K</i> [57] contains 1000 tracks (about two hours) of people singing Chinese pop songs, with separate vocal and background music tracks provided. ... The", "title": "Proceedings of the 24th ISMIR Conference, Milan, Italy, November 5-9, 2023", "url": "https://zenodo.org/records/10265343/files/000063.pdf"}, {"type": "text_result", "domain": "archives.ismir.net", "ref_id": "turn0search14", "snippet": "Furthermore, no dataset provides more than one note annotation, and as we will see, the note annotation task itself is quite subjective. ... Vocadito is", "title": "VOCADITO: A DATASET OF SOLO VOCALS WITH F₀, NOTE, AND LYRIC ANNOTATIONS – EXTENDED ABSTRACT", "url": "https://archives.ismir.net/ismir2021/latebreaking/000044.pdf"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search15", "snippet": "Rubinstein, ‘vocadito: A ... a cappella singing audio dataset for automatic ... model of reference pitch memory’, J.", "title": "THE VocalNotes DATASET", "url": "https://zenodo.org/records/10433321/files/354_paper.pdf"}, {"type": "text_result", "domain": "www.researchgate.net", "ref_id": "turn0search2", "snippet": "2 https://zenodo.org/record/5557945 ... In this report, we introduced vocadito, a small dataset of ... Annotations for the ﬁrst 5.5 seconds of track 6 of vocadito.", "title": "(PDF) vocadito: A dataset of solo vocals with $f_0$, note, and lyric annotations", "url": "https://www.researchgate.net/publication/355222802_vocadito_A_dataset_of_solo_vocals_with_f_0_note_and_lyric_annotations?_tp=eyJjb250ZXh0Ijp7InBhZ2UiOiJzY2llbnRpZmljQ29udHJpYnV0aW9ucyIsInByZXZpb3VzUGFnZSI6bnVsbCwic3ViUGFnZSI6bnVsbH19"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search16", "snippet": "pitch annotation | [26] | MultitrackTable 1: A summary of public datasets relevant to singing voice detection ... Music Database [4] and MIR-1K Corpus [8].", "title": "REVISITING SINGING VOICE DETECTION:", "url": "https://zenodo.org/record/1492463/files/38_Paper.pdf"}, {"type": "text_result", "domain": "help.zenodo.org", "ref_id": "turn0search3", "snippet": "This guide explains how to perform advanced search queries on Zenodo using easy to understand examples. ... `recid` | integer | Zenodo specific record identifier.", "title": "Search guide | Zenodo", "url": "https://help.zenodo.org/guides/search/"}, {"type": "text_result", "domain": "arxiv.org", "ref_id": "turn0academia17", "snippet": "Title: vocadito: A dataset of solo vocals with $f_0$, note, and lyric annotations", "title": "vocadito: A dataset of solo vocals with $f_0$, note, and lyric annotations", "url": "https://arxiv.org/abs/2110.05580"}, {"type": "text_result", "domain": "www2.spsc.tugraz.at", "ref_id": "turn0search4", "snippet": "# Index of /databases/PTDB-TUG", "title": "Index of /databases/PTDB-TUG", "url": "https://www2.spsc.tugraz.at/databases/PTDB-TUG/"}, {"type": "text_result", "domain": "github.com", "ref_id": "turn0search5", "snippet": "--csv fixtures/pitch_reports/vocadito_1.csv", "title": "harmonizer/harmonizer.md at main · DiegoZC4/harmonizer · GitHub", "url": "https://github.com/DiegoZC4/harmonizer/blob/main/harmonizer.md"}, {"type": "text_result", "domain": "www.researchgate.net", "ref_id": "turn0search6", "snippet": "The database, referenced as PTDB-TUG, consists of ... pitch tracking approaches on a subset of speakers from PTDB- ... corpus was a supervised on-site recording", "title": "(PDF) A Pitch Tracking Corpus with Evaluation on Multipitch Tracking Scenario.", "url": "https://www.researchgate.net/publication/221488871_A_Pitch_Tracking_Corpus_with_Evaluation_on_Multipitch_Tracking_Scenario"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn0search7", "snippet": "Accurate beat tracking without DBN postprocessing\" (Foscarin/Schlüter/Widmer, ISMIR 2024) and prior publications by other authors, but for many of these datasets, audio data is not", "title": "Beat This! Spectrograms for Beat and Downbeat Tracking | Zenodo", "url": "https://zenodo.org/records/13922116"}, {"type": "text_result", "domain": "www.sciencedirect.com", "ref_id": "turn0search8", "snippet": "Dataset-1: The dataset consists of 40 audio files obtained by mixing a subset of utterances from the Pitch Tracking Database of Graz university of Technology", "title": "Two-pitch tracking in co-channel speech using modified group delay functions - ScienceDirect", "url": "https://www.sciencedirect.com/science/article/abs/pii/S0167639316302710"}, {"type": "text_result", "domain": "doczz.net", "ref_id": "turn0search9", "snippet": "signals can be seen on a part of speech uttering from the PTDB-TUG1 database with ... Pitch Tracking Database from Graz University of Technology available", "title": "Modern Methods of Time-Frequency Warping of Sound Signals", "url": "https://doczz.net/doc/7459325/modern-methods-of-time-frequency-warping-of-sound-signals"}, {"type": "text_result", "domain": "ses-isleme.github.io", "ref_id": "turn0search10", "snippet": "vocadito = mirdata.initialize('vocadito') ... Raw Pitch Accuracy 0.8833058758923669", "title": "8. Ezgi Analizi - Temel titreşim frekans kestirimi — Python Ile Ses İşlemeye Giriş", "url": "https://ses-isleme.github.io/notebooks/08_EzgiAnalizi_FrekansKestirimi.html"}, {"type": "text_result", "domain": "www.seas.ucla.edu", "ref_id": "turn0search11", "snippet": "We show that the proposed fusion network, FusedF0, can outperform both the state-of-the-art DSP baselines and the state-of-the-art raw waveform processing DNN, CREPE, for different", "title": "Child Speech Data", "url": "https://www.seas.ucla.edu/spapl/projects/F0.html"}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "exec-dda097fd-10c9-4a44-9444-95e76216d38a", "rollout_ordinal": 25, "created_at_ms": 1788876231967, "item_type": "webSearch", "updated_at_ordinal": 25, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "webSearch", "id": "exec-dda097fd-10c9-4a44-9444-95e76216d38a", "query": "MIR-1K dataset official 1000 pitch annotations ...", "action": {"type": "search", "query": null, "queries": ["MIR-1K dataset official 1000 pitch annotations", "MDB-stem-synth dataset official zenodo 230", "iKala dataset official 252 pitch annotations license"]}, "results": [{"type": "text_result", "domain": "zenodo.org", "ref_id": "turn1search0", "snippet": "MDB-stem-synth contains 230 solo stems (tracks) from the MedleyDB dataset (http://medleydb.weebly.com/) spanning a ... The MDB-stem-synth dataset is offered free of charge under the terms", "title": "MDB-stem-synth | Zenodo", "url": "https://zenodo.org/records/1481172"}, {"type": "text_result", "domain": "datamed.org", "ref_id": "turn1search1", "snippet": "Multimedia&nbsp;Information&nbsp;Retrieval lab,&nbsp;1000&nbsp;song clips, dataset for&nbsp;singing voice separation ... Manual annotations of the dataset include pitch contours in semitone, indices a", "title": "DataMed Data Discovery Index", "url": "https://datamed.org/dataset/6d633296-1c41-486a-b5e3-8c7fb9e00980"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn1search12", "snippet": "Our experiments use three f0-annotated datasets that are commonly used for training and benchmarking pitch detectors: ... MIR-1K [23] contains 1000 short recordings (133 minutes", "title": "Proceedings of the 26th ISMIR Conference, Daejeon, Korea, September 21-25, 2025", "url": "https://zenodo.org/record/17706561/files/000080.pdf"}, {"type": "text_result", "domain": "transactions.ismir.net", "ref_id": "turn1search2", "snippet": "MIR‑1K (Hsu and Jang, 2010) contains 1000 tracks (about 2 h) of amateur singing of Chinese pop songs, with separate vocal and background music tracks", "title": "PESTO: Real‑Time Pitch Estimation with Self‑Supervised Transposition‑Equivariant Objective | Transactions of the International Society for Music Information Retrieval", "url": "https://transactions.ismir.net/en/articles/10.5334/tismir.251"}, {"type": "text_result", "domain": "www.ncbi.nlm.nih.gov", "ref_id": "turn1search3", "snippet": "Title Human miRNA 1K ... The labeled RNAs were mixed and hybridized to the array with a 2×hybridization solution (final concentration: 5× Denhart’s solution, 0.5%", "title": "GEO Accession viewer", "url": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GPL15311"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn1search13", "snippet": "The iKala dataset is comprised of 252 30-second excerpts sampled from 206 iKala songs (plus 100 hidden excerpts reserved for MIREX). ... path to the", "title": "mirdata", "url": "https://mirdata.readthedocs.io/_/downloads/en/0.2.1/pdf/"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn1search14", "snippet": "For more details and download info, please visit: - https://synthdatasets.weebly.com/mdb-stem-synth.html - https://zenodo.org/record/1481172class mirdata.datasets.mdb_stem_synth.Dataset(data_home=None", "title": "mirdata", "url": "https://mirdata.readthedocs.io/_/downloads/en/stable/pdf/"}, {"type": "text_result", "domain": "music-ir.org", "ref_id": "turn1search4", "snippet": "It contains 1000 song clips recorded at 16 kHz sample rate with 16-bit resolution. ... However, MIR-1K does not contain the annotation for evaluating note-wise", "title": "2009:Audio Melody Extraction - MIREX Wiki", "url": "https://music-ir.org/mirex/wiki/2009%3AAudio_Melody_Extraction"}, {"type": "text_result", "domain": "github.com", "ref_id": "turn1search5", "snippet": "Eventually I downloaded dataset from kaggle: https://www.kaggle.com/datasets/datongmuyuyi/mir1k", "title": "MIR-1K link is dead · Issue #48 · ismir/mir-datasets · GitHub", "url": "https://github.com/ismir/mir-datasets/issues/48"}, {"type": "text_result", "domain": "audiolabs-erlangen.de", "ref_id": "turn1search15", "snippet": "So the MDB-stem-synth dataset is appropriate for this task. ... MDB-stem-synth consists of 230 solo stems (tracks) from different instruments and voices.", "title": "2.3 DATASETS", "url": "https://audiolabs-erlangen.de/content/05_fau/professor/00_mueller/01_group/2019_Bauer_F0Estimation_MasterThesis.pdf"}, {"type": "text_result", "domain": "help.zenodo.org", "ref_id": "turn1search6", "snippet": "The table below lists the data type of each field. ... `created` | datetime | Creation timestamp of record in Zenodo. ... `filetype` | string", "title": "Search guide | Zenodo", "url": "https://help.zenodo.org/guides/search/"}, {"type": "text_result", "domain": "static.aminer.org", "ref_id": "turn1search16", "snippet": "All 1000 song clips of the MIR-1K dataset are used to evaluate ... With SVE1: Pitch detection with only the first stage of", "title": "Towards Solving the Bottleneck of Pitch-based Singing", "url": "https://static.aminer.org/pdf/20170130/pdfs/mm/v1k3dunltfi48xo6fah5rz7hgjcmwzap.pdf"}, {"type": "text_result", "domain": "pmc.ncbi.nlm.nih.gov", "ref_id": "turn1search7", "snippet": "Table 1 describes the most commonly used datasets in the singing voice detection task and the related papers used for each dataset. ... MIR-1k (Multimedia", "title": "Singing Voice Detection: A Survey - PMC", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8775013/"}, {"type": "text_result", "domain": "codeshare.me", "ref_id": "turn1search8", "snippet": "A lightweight yet powerful audio-to-MIDI converter with pitch bend detection ... * LICENSE (plaintext) ... * ikala.py (python)", "title": "constants.py - basic-pitch by @github-repos | Codeshare", "url": "https://codeshare.me/c/9fb0b1f7-f91e-44bd-ab4b-e89951815b1d/blob/basic_pitch/constants.py"}, {"type": "text_result", "domain": "gitlite.dev", "ref_id": "turn1search9", "snippet": "* 📄test_ikala.py ... * 📄test_medleydb_pitch.py ... * 📁annotation ... * 📄LICENSE", "title": "basic-pitch - GitLite", "url": "https://gitlite.dev/detail.php?id=lqnRhu3nY7OGm-h4Yzl2ug0AZC2ArbiwIuP2SN6Rors&lang=en"}, {"type": "text_result", "domain": "figshare.com", "ref_id": "turn1search10", "snippet": "# MIR-1K.rar ... dataset ... CC BY 4.0", "title": "MIR-1K.rar", "url": "https://figshare.com/articles/dataset/MIR-1K_rar/5802891"}, {"type": "text_result", "domain": "github.com", "ref_id": "turn1search11", "snippet": "* Pull requests 0 ... For training on your own data, create a new YAML file `configs/data/my_dataset.yaml` and specify the path to: ... find MIR-1K/PitchLabel", "title": "pesto-full/README.md at master · SonyCSLParis/pesto-full · GitHub", "url": "https://github.com/SonyCSLParis/pesto-full/blob/master/README.md"}, {"type": "text_result", "domain": "code.soundsoftware.ac.uk", "ref_id": "turn1search17", "snippet": "note pitch ... is based on EfficientNet-b0 [16], which is a CNN model that ... We split MIR-1k into a 900-clip training set and a", "title": "ON THE PREPARATION AND VALIDATION OF A LARGE-SCALE DATASET", "url": "https://code.soundsoftware.ac.uk/attachments/download/2806/ON%20THE%20PREPARATION%20AND%20VALIDATION%20OF%20A%20LARGE-SCALE%20DATASET%20OF%20SINGING%20TRANSCRIPTION.pdf"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn1view0", "snippet": "Total lines: 181", "title": "vocadito: A dataset of solo vocals with f0, note, and lyric Annotations | Zenodo", "url": "https://zenodo.org/records/5557945"}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "rs_06f6aa8593d2a892016aa015cee28887d28b81249dad3de395", "rollout_ordinal": 28, "created_at_ms": 1788876237352, "item_type": "reasoning", "updated_at_ordinal": 28, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016aa015cee28887d28b81249dad3de395", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "msg_06f6aa8593d2a892016aa015cf474087d29479ad4f91f27245", "rollout_ordinal": 30, "created_at_ms": 1788876237749, "item_type": "agentMessage", "updated_at_ordinal": 30, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016aa015cf474087d29479ad4f91f27245", "text": "Tu código usa YIN para la ruta ligera y WORLD/pYIN para otras extracciones, además de filtros de energía y corrección de octavas. Por eso, los datasets te servirán principalmente para medir errores y ajustar esos parámetros. Encontré opciones de voz sola y de karaoke con voz y acompañamiento separados.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "exec-a013f813-390c-4d3f-af7d-768f0b27654e", "rollout_ordinal": 34, "created_at_ms": 1788876245143, "item_type": "webSearch", "updated_at_ordinal": 34, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "webSearch", "id": "exec-a013f813-390c-4d3f-af7d-768f0b27654e", "query": "site.upf.edu MIR-QBSH dataset singing humming pitch annotations ...", "action": {"type": "search", "query": null, "queries": ["site.upf.edu MIR-QBSH dataset singing humming pitch annotations", "site.ee.columbia.edu RWC MedleyDB pitch dataset 60 vocal melody ADC2004"]}, "results": [{"type": "text_result", "domain": "www.upf.edu", "ref_id": "turn2search0", "snippet": "# MTG-QBH: Query By Humming dataset ... Whilst the query recordings are included in this dataset, audio files for the music collections listed in the", "title": "MTG-QBH: Query By Humming dataset - MTG - Music Technology Group (UPF)", "url": "https://www.upf.edu/web/mtg/mtg-qbh"}, {"type": "text_result", "domain": "www.upf.edu", "ref_id": "turn2search1", "snippet": "MIRDATA:Library of tools for accessing and working with datasets of relevance to the field of Music Information Retrieval (MIR). ... Choral Singing Dataset: ... A", "title": "Software & Datasets - MTG - Music Technology Group (UPF)", "url": "https://www.upf.edu/en/web/mtg/software-datasets"}, {"type": "text_result", "domain": "compmusic.upf.edu", "ref_id": "turn2search2", "snippet": "### Jingju A Cappella Singing Pitch Contour Dataset ... ### Jingju A Cappella Singing Audio and Boundary Annotation Dataset ... The dataset is formed by", "title": "Datasets | Computational models", "url": "https://compmusic.upf.edu/datasets"}, {"type": "text_result", "domain": "labrosa.ee.columbia.edu", "ref_id": "turn2search3", "snippet": "Transcribing real music recordings into score is a difficult problem; one simplification is to search for only a single dominant melody line within a piece", "title": "Musical Melody Extraction", "url": "https://labrosa.ee.columbia.edu/projects/melody/"}, {"type": "text_result", "domain": "www.upf.edu", "ref_id": "turn2search4", "snippet": "Link: http://mtg.upf.edu/download/datasets/phenicx-anechoic ... Jingju (Beijing opera) Phoneme Annotation ... Jingju a cappella singing dataset [Data set].", "title": "Datasets - Engineering MdM Strategic Research Program (UPF)", "url": "https://www.upf.edu/web/mdm-dtic/datasets-2016/-/asset_publisher/QYr5lox2Csty/content/-audio-features-acousticbrainz-crowdsourced-acoustic-information-available-under-cc0-license"}, {"type": "text_result", "domain": "www.mdpi.com", "ref_id": "turn2search5", "snippet": "To train the HRNet for the SVS, we constructed a dataset of 400 songs (around 29 h) by randomly mixing the vocals and accompaniment in", "title": "Vocal Melody Extraction via HRNet-Based Singing Voice Separation and Encoder-Decoder-Based F0 Estimation", "url": "https://www.mdpi.com/2079-9292/10/3/298"}, {"type": "text_result", "domain": "transactions.ismir.net", "ref_id": "turn2search12", "snippet": "RWC* ... 60% ... Table 1 Specification comparison between our SCMS and different state-of-the-art-melody datasets (Goto et al., 2002)*, (LabROSA, 2005)⊚, ... The dataset includes", "title": "DATASET\nRepertoire-Specific Vocal \nPitch Data Gene", "url": "https://transactions.ismir.net/articles/137/files/6499954ec1b0b.pdf"}, {"type": "text_result", "domain": "www.researchgate.net", "ref_id": "turn2search6", "snippet": "all the vocal multi-tracks in MedleyDB, there are only two ... and have melody, of which 60 were used in the literature. ... ADC04 MIREX05", "title": "(PDF) Vocal Melody Labeling in MedleyDB", "url": "https://www.researchgate.net/publication/366087595_Vocal_Melody_Labeling_in_MedleyDB"}, {"type": "text_result", "domain": "www.researchgate.net", "ref_id": "turn2search7", "snippet": "2 https://labrosa.ee.columbia.edu/projects/melody ... Method ADC 2004 (vocal) ... MCDNN [5] 60.0 52.2 56.3 59.5 19.6 ... 2004, MIREX 05 and Medley DB dataset.", "title": "(PDF) Frequency-Temporal Attention Network for Singing Melody Extraction", "url": "https://www.researchgate.net/publication/349492035_Frequency-Temporal_Attention_Network_for_Singing_Melody_Extraction"}, {"type": "text_result", "domain": "repositori-api.upf.edu", "ref_id": "turn2search13", "snippet": "Approaches dealing with the speciﬁc task of singing transcription have usually been developed in user-oriented MIR taskssuch as query-by-humming (QBH), query-by-singing (QBS), sight-singing tutors or", "title": "IEEE TRANSACTIONS ON AUDIO, SPEECH, AND LANGUAGE PROCESSING", "url": "https://repositori-api.upf.edu/api/core/bitstreams/b76051ba-a8d2-426a-9043-f77c0915ffa2/content"}, {"type": "text_result", "domain": "reference-global.com", "ref_id": "turn2search8", "snippet": "# Repertoire-Specific Vocal Pitch Data Generation for Improved Melodic Analysis of Carnatic Music ... Specification comparison between our SCMS and different state-of-the-art-melody datasets (Goto et", "title": "Repertoire-Specific Vocal Pitch Data Generation for...", "url": "https://reference-global.com/article/10.5334/tismir.137?tab=figures-and-tables"}, {"type": "text_result", "domain": "repositori-api.upf.edu", "ref_id": "turn2search14", "snippet": "the latter point, the input dataset for our process is ... accompaniment leaked in the singing voice using U-Net-based singing voice separation (Yu et al.,", "title": "DATASET\nRepertoire-Specific Vocal \nPitch Data Gene", "url": "https://repositori-api.upf.edu/api/core/bitstreams/858e62fa-5555-41a3-b7b7-8edb5866d41d/content"}, {"type": "text_result", "domain": "keums.github.io", "ref_id": "turn2search15", "snippet": "Pitch-shifting has proven to be an effective way to increase data and improve results for singing voice activity detection [38], as well as melody extraction", "title": "5.3 **Experiments**", "url": "https://keums.github.io/assets/Thesis.pdf"}, {"type": "text_result", "domain": "paperzz.com", "ref_id": "turn2search9", "snippet": "such as ADC2004 and MIREX05. ... 60% ... Existing collections for melody extraction evaluation (ADC2004 through RWC) and the new MedleyDB dataset. ... within the", "title": "MedleyDB - MARL: Music and Audio Research Laboratory", "url": "https://paperzz.com/doc/8457523/medleydb---marl--music-and-audio-research-laboratory"}, {"type": "text_result", "domain": "www.mdpi.com", "ref_id": "turn2search10", "snippet": "Pitch-shifting has proven to be an effective way to increase data and improve results for singing voice activity detection [38], as well as melody extraction", "title": "Joint Detection and Classification of Singing Voice Melody Using Convolutional Recurrent Neural Networks", "url": "https://www.mdpi.com/2076-3417/9/7/1324"}, {"type": "text_result", "domain": "archives.ismir.net", "ref_id": "turn2search16", "snippet": "We use the RWC pop music database as our main training set [8]. ... We thus increase the size of training set and genre diversity", "title": "Proceedings of the 17th ISMIR Conference, New York City, USA, August 7-11, 2016                                                                 821", "url": "https://archives.ismir.net/ismir2016/paper/000119.pdf"}, {"type": "text_result", "domain": "www.mdpi.com", "ref_id": "turn2search11", "snippet": "Matching accuracies with the pitch data (automatically extracted) of the 2009 MIR-QbSH corpus database. ... Matching accuracies of 4431 singing and humming queries of 2009", "title": "Multi-Classifier Based on a Query-by-Singing/Humming System", "url": "https://www.mdpi.com/2073-8994/7/2/994"}, {"type": "text_result", "domain": "arxiv.org", "ref_id": "turn2academia17", "snippet": "Query by Singing/Humming (QBSH) is a Music Information Retrieval (MIR) system with small audio excerpt as query. ... Current work on QBSH focuses mainly on", "title": "An Extensive Analysis of Query by Singing/Humming System Through Query Proportion", "url": "https://arxiv.org/abs/1301.1894"}, {"type": "text_result", "ref_id": "turn2view0", "snippet": "Total lines: 1", "title": "Internal Error"}, {"type": "text_result", "domain": "zenodo.org", "ref_id": "turn2view1", "snippet": "Total lines: 203", "title": "MIR-1K dataset | Zenodo", "url": "https://zenodo.org/records/3532216"}, {"type": "text_result", "domain": "mirdata.readthedocs.io", "ref_id": "turn2view2", "snippet": "Total lines: 493", "title": "mirdata.datasets.ikala — mirdata 1.0.0 documentation", "url": "https://mirdata.readthedocs.io/en/stable/_modules/mirdata/datasets/ikala.html"}, {"type": "text_result", "ref_id": "turn2view3", "snippet": "Total lines: 1", "title": "Internal Error"}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "rs_06f6aa8593d2a892016aa015dc5dc487d2bda8d7f528aeb4ef", "rollout_ordinal": 37, "created_at_ms": 1788876250868, "item_type": "reasoning", "updated_at_ordinal": 37, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016aa015dc5dc487d2bda8d7f528aeb4ef", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a08154-ab3b-7ad2-b82f-1f8fc213dc43", "item_id": "msg_06f6aa8593d2a892016aa015dcde0887d29e9f838b0702404d", "rollout_ordinal": 39, "created_at_ms": 1788876251312, "item_type": "agentMessage", "updated_at_ordinal": 39, "started_at_ms": null, "completed_at_ms": null}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016aa015dcde0887d29e9f838b0702404d", "text": "**Para tu karaoke, empezaría con Vocadito y MIR-1K.** Busqué datasets con anotaciones de frecuencia fundamental (*F0*) que permitan comparar lo que detecta tu algoritmo con una referencia.\n\nRevisé [audio/pitch.py](</C:/Users/Diego Tapia/Desktop/Pene/U/Tesis/tesis_karaoke/audio/pitch.py>): usas YIN en la extracción ligera y WORLD/pYIN en otras rutas, además de filtros de energía, duración y octavas. Estos datos te servirían para **medir errores y ajustar parámetros**, sin necesidad de entrenar una red neuronal.\n\n| Dataset | Qué contiene | Cómo te ayudaría |\n|---|---|---|\n| **[Vocadito](https://zenodo.org/records/5557945)** | 40 fragmentos de canto monofónico, 28 participantes y 7 idiomas. Incluye F0 revisada manualmente y dos anotaciones de notas por grabación. Hay grabaciones con micrófonos de teléfono y computador. | **Primera opción para probar el micrófono del usuario.** Permite revisar notas graves, consonantes, voz débil y diferencias entre estimar F0 y segmentar notas. Es pequeño para entrenamiento, pero práctico para diagnóstico. |\n| **[MIR-1K](https://zenodo.org/records/3532216)** | 1.000 fragmentos de karaoke de 4–13 segundos, aproximadamente 133 minutos. Voz y acompañamiento en canales separados; anotaciones de pitch y regiones sin voz. | **Primera opción para robustez en karaoke.** Puedes evaluar la voz aislada y luego añadir acompañamiento a diferentes volúmenes para medir cuánto empeora la detección. |\n| **[MDB-stem-synth](https://zenodo.org/records/1481172)** | 230 pistas monofónicas resintetizadas de instrumentos y voces. Referencias en CSV con tiempo y F0 en Hz, aproximadamente cada 2,9 ms. Descarga de 1,8 GB; licencia CC BY-NC 4.0. | Útil para medir **errores de octava y precisión de frecuencia** con referencias controladas. Para tu aplicación conviene analizar las voces por separado; la resíntesis no reproduce todas las dificultades de una grabación real. |\n| **[iKala](https://mirdata.readthedocs.io/en/stable/_modules/mirdata/datasets/ikala.html)** | 252 fragmentos de 30 segundos, con voz y acompañamiento separados y contornos de pitch anotados por humanos. | Buena segunda evaluación de canto con acompañamiento. La documentación indica que la descarga requiere solicitar acceso, por lo que dejaría su incorporación para después. |\n\n**Cómo los usaría para mejorar tu implementación:**\n\n1. **Medir el resultado antes y después de cada filtro.** Así sabrás si el umbral RMS elimina voz suave o si la corrección de octavas modifica saltos musicales legítimos.\n2. **Evaluar precisión en cents, errores de octava y detecciones falsas en regiones sin F0.** Tu código devuelve principalmente los puntos válidos; para evaluar también las omisiones debes conservar una línea temporal completa.\n3. **Simular el procesamiento por bloques del modo en vivo.** Mediría precisión y latencia con los mismos tamaños de bloque que usa la aplicación.\n4. **Separar cantantes y canciones entre ajuste y prueba.** Evitaría que fragmentos de una misma interpretación aparezcan en ambos conjuntos.\n\nUn detalle importante para la tesis: **F0 y nota musical no son la misma anotación**. Para detectar afinación necesitas la frecuencia continua; para evaluar inicio, duración y nombre de una nota necesitas eventos de notas. Vocadito incluye ambas y sus autores muestran que redondear F0 a semitonos no basta para obtener una transcripción fiable. [Artículo de Vocadito](https://arxiv.org/abs/2110.05580).", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0ead5-00cd-7ad2-a450-c8d8f93d5390", "item_id": "01a0ead5-02f4-7372-8b7f-26cd03dc8ba4", "rollout_ordinal": 52, "created_at_ms": 1790646223619, "item_type": "userMessage", "updated_at_ordinal": 52, "started_at_ms": 1790646223619, "completed_at_ms": 1790646223619}, "item": {"type": "userMessage", "id": "01a0ead5-02f4-7372-8b7f-26cd03dc8ba4", "clientId": "9b8a71bd-b6f1-45cc-ba8c-7d9870a44bcb", "content": [{"type": "text", "text": "ok, como debería proseguir?\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0ead5-00cd-7ad2-a450-c8d8f93d5390", "item_id": "msg_06f6aa8593d2a892016abb17d2762c87d29bfc79fa3c557482", "rollout_ordinal": 53, "created_at_ms": 1790646227825, "item_type": "agentMessage", "updated_at_ordinal": 53, "started_at_ms": 1790646227825, "completed_at_ms": 1790646240625}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb17d2762c87d29bfc79fa3c557482", "text": "**El siguiente paso debería ser medir tu algoritmo actual con Vocadito antes de modificarlo.** Así podrás demostrar qué cambios mejoran la detección y cuáles la empeoran.\n\nSeguiría este orden:\n\n1. **Preparar una evaluación reproducible.** Descargar Vocadito y ejecutar tu detector sobre cada grabación, comparando su F0 con la anotación del dataset. Alinear los tiempos y conservar los intervalos donde el detector no encuentra frecuencia.\n\n2. **Registrar una línea base.** Medir:\n   - Porcentaje de estimaciones dentro de ±50 cents —medio semitono— respecto de la referencia.\n   - Errores de octava.\n   - Voz que el detector omite y detecciones en intervalos sin voz tonal.\n   - Tiempo de procesamiento y latencia del modo en vivo.\n\n3. **Identificar dónde falla.** Graficar la frecuencia real y la estimada en algunos ejemplos: voz grave, voz suave, vibrato y cambios rápidos de nota. Comparar la salida original con la salida después de tus filtros.\n\n4. **Ajustar una cosa a la vez.** Empezaría por el umbral de energía, el tamaño de ventana y los filtros de duración y saltos. Reservaría cantantes completos para la prueba final, sin usarlos para elegir parámetros.\n\n5. **Probar condiciones de karaoke con MIR-1K.** Primero voz aislada; después voz con acompañamiento a distintos niveles. Esto permitirá distinguir los errores propios del detector de los provocados por la música de fondo.\n\nPara la tesis, el primer entregable sería **un script de evaluación, una tabla de resultados iniciales y unas gráficas de los fallos**. Con esa evidencia podrás decidir si basta con ajustar YIN/WORLD o si conviene comparar otro detector. **Todavía no empezaría entrenando un modelo.**", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "01a0eadc-b231-7602-8447-a4375325c2b7", "rollout_ordinal": 62, "created_at_ms": 1790646727232, "item_type": "userMessage", "updated_at_ordinal": 62, "started_at_ms": 1790646727232, "completed_at_ms": 1790646727232}, "item": {"type": "userMessage", "id": "01a0eadc-b231-7602-8447-a4375325c2b7", "clientId": "f270ffa4-91a0-4002-b54d-b0c8d58837c2", "content": [{"type": "text", "text": "puedes hacer tú la prueba con vocadito?\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "msg_06f6aa8593d2a892016abb19c8a34087d2b502cfbf83a02250", "rollout_ordinal": 63, "created_at_ms": 1790646730015, "item_type": "agentMessage", "updated_at_ordinal": 63, "started_at_ms": 1790646730015, "completed_at_ms": 1790646731345}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb19c8a34087d2b502cfbf83a02250", "text": "Voy a descargar Vocadito y preparar una evaluación del detector actual, con métricas de precisión, errores de octava y detección de voz.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-42007e24-cc83-44d4-bca4-2fcf12a7e580", "rollout_ordinal": 67, "created_at_ms": 1790646735163, "item_type": "commandExecution", "updated_at_ordinal": 67, "started_at_ms": 1790646735163, "completed_at_ms": 1790646735724}, "item": {"type": "commandExecution", "id": "exec-42007e24-cc83-44d4-bca4-2fcf12a7e580", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Location; rg --files -g AGENTS.md -g '*eval*' -g '*requirements*' -g pyproject.toml -g '\"'!venv/**'\"'; Get-Content audio/pitch.py | Select-Object -Last 150\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "53991", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Location; rg --files -g AGENTS.md -g '*eval*' -g '*requirements*' -g pyproject.toml -g '!venv/**'; Get-Content audio/pitch.py | Select-Object -Last 150"}], "aggregatedOutput": "\r\nPath\r\n----\r\nC:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\r\n            fmax=f_max,\r\n            sr=sr,\r\n            frame_length=frame_length,\r\n            hop_length=hop_length,\r\n            center=False,\r\n            trough_threshold=0.15,\r\n        )\r\n        t = (np.arange(len(f0), dtype=float) * hop_length + frame_length / 2) / sr\r\n        f0 = np.nan_to_num(f0, nan=0.0, posinf=0.0, neginf=0.0)\r\n    except Exception:\r\n        tiempos = []\r\n        frecuencias = []\r\n        for inicio in range(0, len(y) - frame_length + 1, hop_length):\r\n            frame = y[inicio : inicio + frame_length]\r\n            rms_frame = float(np.sqrt(np.mean(frame.astype(float) ** 2))) if len(frame) else 0.0\r\n            frecuencia = 0.0\r\n            if rms_frame >= umbral_silencio:\r\n                frecuencia = _pitch_autocorrelacion(frame, sr, f_min, f_max)\r\n            tiempos.append((inicio + frame_length / 2) / sr)\r\n            frecuencias.append(frecuencia)\r\n        t = np.asarray(tiempos, dtype=float)\r\n        f0 = np.asarray(frecuencias, dtype=float)\r\n\r\n    if not len(t):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\r\n        return np.array([]), np.array([])\r\n\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_crudo(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n\r\n    mask = f0 > 0\r\n    return t[mask], f0[mask]\r\n\r\n\r\ndef _extraer_pitch_base(y, sr):\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n    return t, f0\r\n\r\n\r\ndef extraer_pitch_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    if len(y) < int(sr * 0.18):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), {\r\n                \"raw_points\": 0,\r\n                \"filtered_points\": 0,\r\n                \"rejected_points\": 0,\r\n                \"rms\": 0.0,\r\n                \"energy_threshold\": 0.0,\r\n                \"noise_floor\": float(ruido_base or 0.0),\r\n            }\r\n        return np.array([]), np.array([])\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_detallado(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    mask_crudo = f0 > 0\r\n    t_filtrado, f_filtrado = _filtrar_pitch(t, f0, y, sr, corregir_octavas=False)\r\n    t_corregido, f_corregido = _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return {\r\n        \"t_crudo\": t[mask_crudo],\r\n        \"f_crudo\": f0[mask_crudo],\r\n        \"t_filtrado\": t_filtrado,\r\n        \"f_filtrado\": f_filtrado,\r\n        \"t_corregido\": t_corregido,\r\n        \"f_corregido\": f_corregido,\r\n    }\r\n\r\n\r\ndef extraer_pitch(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    return _filtrar_pitch(t, f0, y, sr)\r\n\r\ndef hz_to_nota(f):\r\n    if f <= 0:\r\n        return None\r\n\r\n    A4 = 440.0\r\n    C0 = A4 * pow(2, -4.75)\r\n\r\n    h = round(12 * np.log2(f / C0))\r\n    octava = h // 12\r\n    n = h % 12\r\n\r\n    nombres = ['C', 'C#', 'D', 'D#', 'E', 'F',\r\n               'F#', 'G', 'G#', 'A', 'A#', 'B']\r\n\r\n    return f\"{nombres[n]}{octava}\"\r\n\r\n", "exitCode": 0, "durationMs": 560}}
