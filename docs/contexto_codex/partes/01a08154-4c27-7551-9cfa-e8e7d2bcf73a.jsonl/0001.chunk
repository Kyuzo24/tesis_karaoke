xlsx\r\ncodigo.txt\r\ndesktop_live.py\r\nDestello.wav\r\nEspecificacion_de_Requisitos.docx\r\nHistorias_de_Usuario.docx\r\nIndice_estado_actual_memoria.docx\r\nIndice_tentativo_memoria.docx\r\niniciar_app.bat\r\niniciar_live.bat\r\nmain.py\r\nPortada_memoria.docx\r\nPuntos_1.6_y_1.7.docx\r\nQué gano olvidandote.wav\r\nref.csv\r\nReferencias_documento_final.docx\r\nSombra.wav\r\ntest.py\r\nusr.csv\r\naudio\\karaoke.py:16:from audio.pitch import extraer_pitch, extraer_pitch_ligero_desde_audio, extraer_pitch_detallado\naudio\\karaoke.py:21:    samplerate=44100,\naudio\\karaoke.py:27:    segundos_chunk_pitch=0.38,\naudio\\karaoke.py:34:    reproduccion = _cargar_reproduccion(instrumental_path, samplerate)\naudio\\karaoke.py:40:    ruido_base = medir_ruido_ambiente(samplerate, duracion_calibracion_ruido)\naudio\\karaoke.py:53:        samplerate=samplerate,\naudio\\karaoke.py:70:            args=(pitch_queue, pitch_stop, pitch_callback, diagnostico_callback, samplerate, ruido_base),\naudio\\karaoke.py:78:            frames_grabados = int(transcurrido * samplerate)\naudio\\karaoke.py:86:                inicio_chunk_t = max(0, transcurrido - segundos_chunk_pitch)\naudio\\karaoke.py:87:                inicio_chunk = int(inicio_chunk_t * samplerate)\naudio\\karaoke.py:88:                fin_chunk = min(frames_grabados, duracion_frames)\naudio\\karaoke.py:89:                chunk = np.asarray(grabacion[inicio_chunk:fin_chunk]).reshape(-1)\naudio\\karaoke.py:90:                _encolar_pitch_reciente(pitch_queue, inicio_chunk_t, chunk)\naudio\\karaoke.py:100:    frames_grabados = min(max(int((time.monotonic() - inicio) * samplerate), 1), duracion_frames)\naudio\\karaoke.py:102:        progreso_callback(frames_grabados / samplerate)\naudio\\karaoke.py:104:    sf.write(salida, grabacion, samplerate)\naudio\\karaoke.py:108:def medir_ruido_ambiente(samplerate=44100, duracion=0.6):\naudio\\karaoke.py:109:    muestras = max(1, int(samplerate * duracion))\naudio\\karaoke.py:112:        samplerate=samplerate,\naudio\\karaoke.py:121:def _cargar_reproduccion(ruta_audio, samplerate):\naudio\\karaoke.py:127:        if sr != samplerate:\naudio\\karaoke.py:131:                target_sr=samplerate,\naudio\\karaoke.py:135:        audio, _ = librosa.load(ruta_audio, sr=samplerate, mono=False)\naudio\\karaoke.py:148:def _encolar_pitch_reciente(pitch_queue, inicio_t, chunk):\naudio\\karaoke.py:152:    chunk = np.asarray(chunk, dtype=\"float32\").copy()\naudio\\karaoke.py:153:    if not len(chunk):\naudio\\karaoke.py:157:        pitch_queue.put_nowait((inicio_t, chunk))\naudio\\karaoke.py:165:            pitch_queue.put_nowait((inicio_t, chunk))\naudio\\karaoke.py:175:    samplerate,\naudio\\karaoke.py:181:            inicio_chunk_t, chunk = pitch_queue.get(timeout=0.04)\naudio\\karaoke.py:186:            t_pitch, f_pitch, info = extraer_pitch_ligero_desde_audio(\naudio\\karaoke.py:187:                chunk,\naudio\\karaoke.py:188:                samplerate,\naudio\\karaoke.py:189:                offset_t=inicio_chunk_t,\naudio\\pitch.py:138:    rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\naudio\\pitch.py:175:            \"rms\": rms_chunk,\naudio\\pitch.py:349:def extraer_pitch_ligero_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\naudio\\pitch.py:352:    rms_chunk = float(np.sqrt(np.mean(y.astype(float) ** 2))) if len(y) else 0.0\naudio\\pitch.py:355:            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\naudio\\pitch.py:396:            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\nUnable to create process using 'C:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Python\\Python310\\python.exe -c \"import sys,librosa,numpy,matplotlib; from audio import pitch; print(sys.version); print('world',pitch.pw is not None)\"'\r\n", "exitCode": 1, "durationMs": 604}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-c646fe41-c37d-41c6-98b1-16faaa777a23", "rollout_ordinal": 74, "created_at_ms": 1790646745503, "item_type": "webSearch", "updated_at_ordinal": 74, "started_at_ms": 1790646745503, "completed_at_ms": 1790646747123}, "item": {"type": "webSearch", "id": "exec-c646fe41-c37d-41c6-98b1-16faaa777a23", "query": "", "action": {"type": "other"}, "results": [{"type": "text_result", "domain": "zenodo.org", "ref_id": "turn4view0", "snippet": "Total lines: 178", "title": "vocadito: A dataset of solo vocals with f0, note, and lyric Annotations | Zenodo", "url": "https://zenodo.org/records/5557945/latest"}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-6efd1a52-deec-4cc6-9949-56cb42f20f6a", "rollout_ordinal": 79, "created_at_ms": 1790646753899, "item_type": "commandExecution", "updated_at_ordinal": 79, "started_at_ms": 1790646753899, "completed_at_ms": 1790646759105}, "item": {"type": "commandExecution", "id": "exec-6efd1a52-deec-4cc6-9949-56cb42f20f6a", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Command python,py,uv -ErrorAction SilentlyContinue | Select-Object Name,Source; python -c \\\"import sys; print(sys.executable); import numpy,librosa,matplotlib; print('ok')\\\"; Get-Content audio/karaoke.py | Select-Object -First 105\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "50995", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Command python,py,uv -ErrorAction SilentlyContinue | Select-Object Name,Source; python -c \"import sys; print(sys.executable); import numpy,librosa,matplotlib; print('ok')\"; Get-Content audio/karaoke.py | Select-Object -First 105"}], "aggregatedOutput": "\r\nC:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Python\\Python314\\python.exe\r\nok\r\nName       Source\r\n----       ------\r\npython.exe C:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Python\\Python314\\python.exe\r\npy.exe     C:\\Windows\\py.exe\r\nimport json\r\nimport os\r\nimport queue\r\nimport threading\r\nimport time\r\nfrom datetime import datetime\r\n\r\nimport librosa\r\nimport numpy as np\r\nimport sounddevice as sd\r\nimport soundfile as sf\r\n\r\nfrom audio.catalogo import carpeta_grabaciones, leer_pitch_csv\r\nfrom audio.comparacion import comparar\r\nfrom audio.metricas import hz_to_midi\r\nfrom audio.pitch import extraer_pitch, extraer_pitch_ligero_desde_audio, extraer_pitch_detallado\r\n\r\n\r\ndef grabar_con_instrumental(\r\n    cancion,\r\n    samplerate=44100,\r\n    detener_evento=None,\r\n    progreso_callback=None,\r\n    pitch_callback=None,\r\n    diagnostico_callback=None,\r\n    intervalo_pitch=0.06,\r\n    segundos_chunk_pitch=0.38,\r\n    duracion_calibracion_ruido=0.6,\r\n):\r\n    instrumental_path = cancion[\"instrumental\"]\r\n    if not os.path.exists(instrumental_path):\r\n        raise FileNotFoundError(\"No existe la pista instrumental de la cancion.\")\r\n\r\n    reproduccion = _cargar_reproduccion(instrumental_path, samplerate)\r\n\r\n    duracion_frames = reproduccion.shape[0]\r\n    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\r\n    salida = os.path.join(carpeta_grabaciones(cancion[\"id\"]), f\"usuario_{timestamp}.wav\")\r\n\r\n    ruido_base = medir_ruido_ambiente(samplerate, duracion_calibracion_ruido)\r\n    if diagnostico_callback is not None:\r\n        diagnostico_callback({\r\n            \"noise_floor\": ruido_base,\r\n            \"rms\": ruido_base,\r\n            \"energy_threshold\": 0.0,\r\n            \"raw_points\": 0,\r\n            \"filtered_points\": 0,\r\n            \"rejected_points\": 0,\r\n        })\r\n\r\n    grabacion = sd.playrec(\r\n        reproduccion,\r\n        samplerate=samplerate,\r\n        channels=1,\r\n        dtype=\"float32\",\r\n        blocking=False,\r\n    )\r\n\r\n    inicio = time.monotonic()\r\n    ultimo_analisis = 0\r\n    pitch_queue = None\r\n    pitch_stop = None\r\n    pitch_worker = None\r\n\r\n    if pitch_callback is not None:\r\n        pitch_queue = queue.Queue(maxsize=2)\r\n        pitch_stop = threading.Event()\r\n        pitch_worker = threading.Thread(\r\n            target=_worker_pitch_tiempo_real,\r\n            args=(pitch_queue, pitch_stop, pitch_callback, diagnostico_callback, samplerate, ruido_base),\r\n            daemon=True,\r\n        )\r\n        pitch_worker.start()\r\n\r\n    try:\r\n        while True:\r\n            transcurrido = time.monotonic() - inicio\r\n            frames_grabados = int(transcurrido * samplerate)\r\n            if frames_grabados >= duracion_frames:\r\n                break\r\n            if detener_evento is not None and detener_evento.is_set():\r\n                break\r\n            if progreso_callback is not None:\r\n                progreso_callback(transcurrido)\r\n            if pitch_callback is not None and transcurrido - ultimo_analisis >= intervalo_pitch:\r\n                inicio_chunk_t = max(0, transcurrido - segundos_chunk_pitch)\r\n                inicio_chunk = int(inicio_chunk_t * samplerate)\r\n                fin_chunk = min(frames_grabados, duracion_frames)\r\n                chunk = np.asarray(grabacion[inicio_chunk:fin_chunk]).reshape(-1)\r\n                _encolar_pitch_reciente(pitch_queue, inicio_chunk_t, chunk)\r\n                ultimo_analisis = transcurrido\r\n            sd.sleep(18)\r\n    finally:\r\n        sd.stop()\r\n        if pitch_stop is not None:\r\n            pitch_stop.set()\r\n        if pitch_worker is not None:\r\n            pitch_worker.join(timeout=0.4)\r\n\r\n    frames_grabados = min(max(int((time.monotonic() - inicio) * samplerate), 1), duracion_frames)\r\n    if progreso_callback is not None:\r\n        progreso_callback(frames_grabados / samplerate)\r\n    grabacion = np.asarray(grabacion[:frames_grabados]).reshape(frames_grabados, 1)\r\n    sf.write(salida, grabacion, samplerate)\r\n    return salida\r\n\r\n", "exitCode": 0, "durationMs": 5206}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "rs_06f6aa8593d2a892016abb19fa7d6887d2b2179f02a8850568", "rollout_ordinal": 86, "created_at_ms": 1790646779881, "item_type": "reasoning", "updated_at_ordinal": 86, "started_at_ms": 1790646779881, "completed_at_ms": 1790646781114}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb19fa7d6887d2b2179f02a8850568", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-1bd07422-f88a-4f25-b4b2-e07cb71b7386", "rollout_ordinal": 90, "created_at_ms": 1790646785859, "item_type": "commandExecution", "updated_at_ordinal": 90, "started_at_ms": 1790646785859, "completed_at_ms": 1790646786680}, "item": {"type": "commandExecution", "id": "exec-1bd07422-f88a-4f25-b4b2-e07cb71b7386", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"from audio import pitch; import sys,librosa,numpy; print('Python',sys.version); print('librosa',librosa.__version__); print('numpy',numpy.__version__); print('WORLD',pitch.pw is not None)\\\"; Get-Content audio/pitch.py | Select-Object -First 195\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "94575", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python -c \"from audio import pitch; import sys,librosa,numpy; print('Python',sys.version); print('librosa',librosa.__version__); print('numpy',numpy.__version__); print('WORLD',pitch.pw is not None)\"; Get-Content audio/pitch.py | Select-Object -First 195"}], "aggregatedOutput": "Python 3.14.5 (tags/v3.14.5:5607950, May 10 2026, 10:43:50) [MSC v.1944 64 bit (AMD64)]\r\nlibrosa 0.11.0\r\nnumpy 2.4.4\r\nWORLD False\r\nimport librosa\r\nimport numpy as np\r\n\r\ntry:\r\n    import pyworld as pw\r\nexcept ImportError:\r\n    pw = None\r\n\r\n\r\nFILTRO_SUAVE = {\r\n    \"nota_min\": \"A1\",\r\n    \"nota_max\": \"C7\",\r\n    \"percentil_rms\": 25,\r\n    \"factor_rms\": 1.25,\r\n    \"factor_rms_max\": 0.012,\r\n    \"max_gap\": 5,\r\n    \"min_frames\": 2,\r\n    \"ventana_mediana\": 7,\r\n    \"max_salto_midi\": 9,\r\n}\r\n\r\nFILTRO_TIEMPO_REAL = {\r\n    \"nota_min\": \"C2\",\r\n    \"nota_max\": \"C6\",\r\n    \"factor_rms_max\": 0.08,\r\n    \"factor_ruido\": 2.2,\r\n    \"min_rms_absoluto\": 0.002,\r\n    \"max_gap\": 1,\r\n    \"min_frames\": 3,\r\n    \"ventana_mediana\": 3,\r\n    \"max_salto_midi\": 8,\r\n}\r\n\r\n\r\ndef _rellenar_huecos_cortos(f0, max_gap):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    validos = np.where(f0 > 0)[0]\r\n    if len(validos) < 2:\r\n        return f0\r\n\r\n    for inicio, fin in zip(validos[:-1], validos[1:]):\r\n        gap = fin - inicio - 1\r\n        if 0 < gap <= max_gap:\r\n            f0[inicio + 1 : fin] = np.linspace(f0[inicio], f0[fin], gap + 2)[1:-1]\r\n    return f0\r\n\r\n\r\ndef _quitar_segmentos_cortos(f0, min_frames):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    mask = f0 > 0\r\n    inicio = None\r\n\r\n    for i, activo in enumerate(np.r_[mask, False]):\r\n        if activo and inicio is None:\r\n            inicio = i\r\n        elif not activo and inicio is not None:\r\n            if i - inicio < min_frames:\r\n                f0[inicio:i] = 0\r\n            inicio = None\r\n    return f0\r\n\r\n\r\ndef _mediana_movil(valores, ventana=7):\r\n    valores = np.asarray(valores, dtype=float)\r\n    salida = np.full_like(valores, np.nan, dtype=float)\r\n    radio = ventana // 2\r\n\r\n    for i in range(len(valores)):\r\n        inicio = max(0, i - radio)\r\n        fin = min(len(valores), i + radio + 1)\r\n        segmento = valores[inicio:fin]\r\n        segmento = segmento[~np.isnan(segmento)]\r\n        if len(segmento):\r\n            salida[i] = np.median(segmento)\r\n    return salida\r\n\r\n\r\ndef _filtrar_pitch(t, f0, y, sr, config=None, corregir_octavas=True):\r\n    config = config or FILTRO_SUAVE\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    rms = librosa.feature.rms(y=y, frame_length=2048, hop_length=512)[0]\r\n    t_rms = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=512)\r\n    energia = np.interp(t, t_rms, rms, left=0, right=0)\r\n    umbral_energia = max(\r\n        np.percentile(rms, config[\"percentil_rms\"]) * config[\"factor_rms\"],\r\n        np.max(rms) * config[\"factor_rms_max\"],\r\n    )\r\n    f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= 7:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n    if corregir_octavas:\r\n        return _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _energia_por_tiempo(y, sr, tiempos, ventana=1024):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    tiempos = np.asarray(tiempos, dtype=float)\r\n    if len(y) == 0 or len(tiempos) == 0:\r\n        return np.array([])\r\n\r\n    cuadrado = y * y\r\n    acumulado = np.concatenate(([0.0], np.cumsum(cuadrado)))\r\n    centros = np.clip((tiempos * sr).astype(int), 0, len(y) - 1)\r\n    radio = ventana // 2\r\n    inicios = np.maximum(0, centros - radio)\r\n    fines = np.minimum(len(y), centros + radio)\r\n    muestras = np.maximum(1, fines - inicios)\r\n    energia = (acumulado[fines] - acumulado[inicios]) / muestras\r\n    return np.sqrt(np.maximum(energia, 0.0))\r\n\r\n\r\ndef _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False):\r\n    config = config or FILTRO_TIEMPO_REAL\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n    raw_points = int(np.sum(f0 > 0))\r\n    rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    energia = _energia_por_tiempo(y, sr, t)\r\n    umbral_energia = 0.0\r\n    if len(energia):\r\n        umbral_energia = max(\r\n            float(np.max(energia)) * config[\"factor_rms_max\"],\r\n            config[\"min_rms_absoluto\"],\r\n        )\r\n        if ruido_base is not None and ruido_base > 0:\r\n            umbral_energia = max(umbral_energia, float(ruido_base) * config[\"factor_ruido\"])\r\n        f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= config[\"ventana_mediana\"]:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n\r\n    if devolver_info:\r\n        return t_filtrado, f_filtrado, {\r\n            \"raw_points\": raw_points,\r\n            \"filtered_points\": int(len(f_filtrado)),\r\n            \"rejected_points\": max(0, raw_points - int(len(f_filtrado))),\r\n            \"rms\": rms_chunk,\r\n            \"energy_threshold\": float(umbral_energia),\r\n            \"noise_floor\": float(ruido_base or 0.0),\r\n        }\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _corregir_octavas_por_registro(t, f0, min_puntos=30):\r\n    t = np.asarray(t, dtype=float)\r\n    f0 = np.asarray(f0, dtype=float)\r\n    if len(f0) < min_puntos:\r\n        return t, f0\r\n\r\n    midi = 69 + 12 * np.log2(f0 / 440.0)\r\n    midi = np.nan_to_num(midi, nan=0.0, posinf=0.0, neginf=0.0)\r\n    if np.sum(midi > 0) < min_puntos:\r\n        return t, f0\r\n\r\n    corregido = midi.copy()\r\n    valores = midi[midi > 0]\r\n    umbral_octava_alta = max(70.5, float(np.percentile(valores, 90)) + 4.0)\r\n", "exitCode": 0, "durationMs": 820}}
