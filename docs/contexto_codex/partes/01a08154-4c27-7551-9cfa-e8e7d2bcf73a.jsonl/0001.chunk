{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "rs_06f6aa8593d2a892016abb1dcdc7bc87d2aaa8ca579a3aeb22", "rollout_ordinal": 237, "created_at_ms": 1790647759175, "item_type": "reasoning", "updated_at_ordinal": 237, "started_at_ms": 1790647759175, "completed_at_ms": 1790647759687}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb1dcdc7bc87d2aaa8ca579a3aeb22", "summary": [], "content": []}}
