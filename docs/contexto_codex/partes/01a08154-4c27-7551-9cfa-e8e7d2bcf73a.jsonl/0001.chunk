{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf8-3a8d-7550-bf58-4c1f6e794551", "item_id": "exec-8755b0b3-5447-451c-b917-e27cb545707a", "rollout_ordinal": 429, "created_at_ms": 1790648547949, "item_type": "commandExecution", "updated_at_ordinal": 429, "started_at_ms": 1790648547949, "completed_at_ms": 1790648548435}, "item": {"type": "commandExecution", "id": "exec-8755b0b3-5447-451c-b917-e27cb545707a", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content desktop_live.py | Select-Object -Skip 360 -First 60; Get-Content desktop_live.py | Select-Object -Skip 510 -First 100; rg -n 'LIVE_|max_jump|salto|chdir|grabar_con_instrumental' desktop_live.py app.py; Get-Content iniciar_live.bat; Get-Content iniciar_app.bat\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "25768", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content desktop_live.py | Select-Object -Skip 360 -First 60; Get-Content desktop_live.py | Select-Object -Skip 510 -First 100; rg -n 'LIVE_|max_jump|salto|chdir|grabar_con_instrumental' desktop_live.py app.py; Get-Content iniciar_live.bat; Get-Content iniciar_app.bat"}], "aggregatedOutput": "        with self._lock:\r\n            estado = dict(self._estado)\r\n            estado[\"pitch_points\"] = list(self._pitch_pendiente)\r\n            self._pitch_pendiente = []\r\n        return estado\r\n\r\n    def get_status(self):\r\n        entrada, salida = self._dispositivos_por_defecto()\r\n        return {\r\n            \"backend\": \"Python\",\r\n            \"ui\": \"pywebview\",\r\n            \"ready\": True,\r\n            \"input_device\": entrada,\r\n            \"output_device\": salida,\r\n        }\r\n\r\n    def get_reference_diagnostics(self, song_id):\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            diagnostico = diagnosticar_filtros(cancion)\r\n            return {\r\n                \"ok\": True,\r\n                \"diagnostic\": self._diagnostico_referencia_para_ui(diagnostico[\"referencia\"]),\r\n            }\r\n        except Exception as exc:\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def _ejecutar_sesion(self, cancion):\r\n        try:\r\n            ruta_grabacion = grabar_con_instrumental(\r\n                cancion,\r\n                detener_evento=self._detener,\r\n                progreso_callback=self._actualizar_progreso,\r\n                pitch_callback=self._agregar_pitch_usuario,\r\n                diagnostico_callback=self._actualizar_diagnostico_live,\r\n                intervalo_pitch=LIVE_PITCH_INTERVAL,\r\n                segundos_chunk_pitch=LIVE_PITCH_CHUNK,\r\n            )\r\n\r\n            with self._lock:\r\n                self._estado[\"status\"] = \"comparing\"\r\n                self._estado[\"recording_path\"] = ruta_grabacion\r\n\r\n            resultado = comparar_grabacion(cancion, ruta_grabacion)\r\n            resultado_ui = self._resultado_para_ui(resultado)\r\n            with self._lock:\r\n                diagnostico = dict(self._estado.get(\"diagnostics\") or {})\r\n            toma = guardar_toma(cancion, ruta_grabacion, resultado, diagnostico)\r\n            resultado_ui[\"take\"] = self._toma_para_ui(cancion, toma)\r\n\r\n            with self._lock:\r\n                self._estado[\"status\"] = \"finished\"\r\n                self._estado[\"result\"] = resultado_ui\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado[\"status\"] = \"error\"\r\n                self._estado[\"error\"] = str(exc)\r\n\r\n    def _actualizar_progreso(self, tiempo):\r\n        with self._lock:\r\n            if not np.isnan(m)\r\n        ]\r\n\r\n    def _diagnostico_referencia_para_ui(self, diagnostico):\r\n        crudos = self._puntos_hz_a_midi(\r\n            diagnostico.get(\"t_crudo\", []),\r\n            diagnostico.get(\"f_crudo\", []),\r\n        )\r\n        filtrados = self._puntos_hz_a_midi(\r\n            diagnostico.get(\"t_filtrado\", []),\r\n            diagnostico.get(\"f_filtrado\", []),\r\n        )\r\n        corregidos = self._puntos_hz_a_midi(\r\n            diagnostico.get(\"t_corregido\", []),\r\n            diagnostico.get(\"f_corregido\", []),\r\n        )\r\n        return {\r\n            \"path\": diagnostico.get(\"ruta\", \"\"),\r\n            \"raw_count\": int(diagnostico.get(\"puntos_crudos\", 0)),\r\n            \"filtered_count\": int(diagnostico.get(\"puntos_filtrados\", 0)),\r\n            \"corrected_count\": int(diagnostico.get(\"puntos_corregidos\", 0)),\r\n            \"octave_corrections\": int(diagnostico.get(\"correcciones_octava\", 0)),\r\n            \"retention\": float(diagnostico.get(\"conservacion\", 0.0)),\r\n            \"points_raw\": self._reducir_puntos(crudos, max_puntos=3500),\r\n            \"points_filtered\": self._reducir_puntos(filtrados, max_puntos=3500),\r\n            \"points_corrected\": self._reducir_puntos(corregidos, max_puntos=3500),\r\n        }\r\n\r\n    def _duracion_cancion(self, cancion):\r\n        for key in [\"instrumental\", \"original\", \"vocals\"]:\r\n            ruta = cancion.get(key)\r\n            if ruta and os.path.exists(ruta):\r\n                try:\r\n                    return float(sf.info(ruta).duration)\r\n                except RuntimeError:\r\n                    continue\r\n        return 0\r\n\r\n    def _puntos_referencia(self, cancion):\r\n        ruta = cancion.get(\"pitch_referencia\")\r\n        if not ruta or not os.path.exists(ruta):\r\n            return []\r\n\r\n        tiempos, frecuencias = leer_pitch_csv(ruta)\r\n        midi = hz_to_midi(frecuencias)\r\n        puntos = [\r\n            [float(t), float(m)]\r\n            for t, m in zip(tiempos, midi)\r\n            if not np.isnan(m)\r\n        ]\r\n        return self._reducir_puntos(puntos, max_puntos=3500)\r\n\r\n    def _reducir_puntos(self, puntos, max_puntos=900):\r\n        if len(puntos) <= max_puntos:\r\n            return puntos\r\n        salto = max(1, int(np.ceil(len(puntos) / max_puntos)))\r\n        return puntos[::salto]\r\n\r\n    def _cancion_para_ui(self, cancion):\r\n        return {\r\n            \"id\": cancion[\"id\"],\r\n            \"title\": cancion.get(\"titulo\", \"Sin titulo\"),\r\n            \"artist\": cancion.get(\"artista\") or \"Sin artista\",\r\n            \"duration\": self._duracion_cancion(cancion),\r\n            \"prepared\": bool(cancion.get(\"preparada\")),\r\n            \"points\": self._puntos_referencia(cancion),\r\n        }\r\n\r\n    def _toma_para_ui(self, cancion, toma):\r\n        metricas = toma.get(\"metrics\") or {}\r\n        grafico = toma.get(\"graph\") or {}\r\n        puntos_ref = self._puntos_hz_a_midi(\r\n            grafico.get(\"t_ref\", []),\r\n            grafico.get(\"f_ref\", []),\r\n        )\r\n        puntos_user = self._puntos_hz_a_midi(\r\n            grafico.get(\"t_usr\", []),\r\n            grafico.get(\"f_usr\", []),\r\n        )\r\n        return {\r\n            \"id\": toma[\"id\"],\r\n            \"song_id\": cancion[\"id\"],\r\n            \"name\": toma.get(\"name\", \"\"),\r\n            \"favorite\": bool(toma.get(\"favorite\")),\r\n            \"created_at\": toma.get(\"created_at\", \"\"),\r\n            \"duration\": float(toma.get(\"duration\") or 0),\r\n            \"voice_url\": self._archivo_url(toma.get(\"voice_path\", \"\")),\r\n            \"instrumental_url\": self._archivo_url(cancion.get(\"instrumental\", \"\")),\r\n            \"metrics\": metricas,\r\n            \"points_ref\": self._reducir_puntos(puntos_ref, max_puntos=3500),\r\n            \"points_user\": self._reducir_puntos(puntos_user, max_puntos=3500),\r\n            \"preview_ref\": self._reducir_puntos(puntos_ref, max_puntos=80),\r\n            \"preview_user\": self._reducir_puntos(puntos_user, max_puntos=80),\r\n        }\r\n\r\n    def _tarea_en_curso(self):\r\n        return self._estado[\"status\"] in [\r\n            \"adding\",\r\n            \"deleting\",\r\n            \"calibrating\",\r\napp.py:17:from audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\napp.py:406:            self.grabacion_actual = grabar_con_instrumental(\ndesktop_live.py:19:from audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\ndesktop_live.py:25:LIVE_PITCH_INTERVAL = 0.10\ndesktop_live.py:26:LIVE_PITCH_CHUNK = 0.24\ndesktop_live.py:27:LIVE_MAX_JUMP_MIDI = 7\ndesktop_live.py:28:LIVE_JUMP_RESET_SECONDS = 0.55\ndesktop_live.py:390:            ruta_grabacion = grabar_con_instrumental(\ndesktop_live.py:396:                intervalo_pitch=LIVE_PITCH_INTERVAL,\ndesktop_live.py:397:                segundos_chunk_pitch=LIVE_PITCH_CHUNK,\ndesktop_live.py:436:        rechazados_salto = 0\ndesktop_live.py:442:                    rechazados_salto += 1\ndesktop_live.py:449:            diagnostico[\"rejected_jumps\"] += rechazados_salto\ndesktop_live.py:450:            diagnostico[\"rejected_points\"] += rechazados_salto\ndesktop_live.py:463:        if delta_t > LIVE_JUMP_RESET_SECONDS:\ndesktop_live.py:466:        if abs(midi - midi_anterior) > LIVE_MAX_JUMP_MIDI:\ndesktop_live.py:566:        salto = max(1, int(np.ceil(len(puntos) / max_puntos)))\ndesktop_live.py:567:        return puntos[::salto]\ndesktop_live.py:674:    os.chdir(Path(__file__).parent)\n@echo off\r\nsetlocal\r\ncd /d \"%~dp0\"\r\nset \"PYTHONPATH=%CD%\\venv\\Lib\\site-packages\"\r\npy -3.10 desktop_live.py\r\n@echo off\r\nsetlocal\r\ncd /d \"%~dp0\"\r\nset \"PYTHONPATH=%CD%\\venv\\Lib\\site-packages\"\r\npy -3.10 app.py\r\n", "exitCode": 0, "durationMs": 485}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf8-3a8d-7550-bf58-4c1f6e794551", "item_id": "msg_06f6aa8593d2a892016abb20e752c087d2974ee49402a8cec9", "rollout_ordinal": 432, "created_at_ms": 1790648552805, "item_type": "agentMessage", "updated_at_ordinal": 432, "started_at_ms": 1790648552805, "completed_at_ms": 1790648562243}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb20e752c087d2974ee49402a8cec9", "text": "**Sí: las dos interfaces comparten el mismo núcleo de procesamiento y el mismo almacenamiento.** Lo confirmé en el código, aunque hay una diferencia importante en el modo en vivo.\n\n| Parte | Cómo está organizada |\n|---|---|\n| Interfaces | Una en Tkinter (`app.py`) y otra en pywebview (`desktop_live.py` + `ui_live`). |\n| Procesamiento | Ambas utilizan los módulos compartidos de `audio/` para detectar frecuencias, comparar y calcular resultados. |\n| Almacenamiento | Ambas utilizan las carpetas `canciones/` y `grabaciones/`, con archivos de audio, CSV y JSON. |\n\n**YIN y pYIN/WORLD son métodos dentro de ese mismo núcleo**, utilizados para tareas diferentes; no son dos backends separados para cada interfaz.\n\nLa diferencia es que **la interfaz nueva añade ajustes propios**: utiliza ventanas de audio de 240 ms, actualiza cada 100 ms y aplica un filtro adicional de saltos. También incorpora la gestión de tomas guardadas. Por eso, las dos interfaces pueden mostrar resultados distintos durante el canto aunque compartan el detector.\n\nEsto precisa lo que dijimos de Vocadito: **la prueba en vivo usó los valores predeterminados del módulo compartido —380 ms y 60 ms—, no toda la configuración de la interfaz nueva.** El 95,84 % corresponde a esa simulación.\n\nUna mejora en el detector compartido beneficia a ambas interfaces, pero debemos evaluar también la configuración específica de la interfaz que vayas a utilizar.", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "01a0eaf9-c728-7b23-ae8a-351eae869bac", "rollout_ordinal": 441, "created_at_ms": 1790648633142, "item_type": "userMessage", "updated_at_ordinal": 441, "started_at_ms": 1790648633142, "completed_at_ms": 1790648633142}, "item": {"type": "userMessage", "id": "01a0eaf9-c728-7b23-ae8a-351eae869bac", "clientId": "399b618d-e071-4687-9262-22bda6889fa9", "content": [{"type": "text", "text": "okey, era solo para confirmar, haz los ajustes que consideres necesarios y vuelve a hacer una prueba\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "msg_06f6aa8593d2a892016abb213f18a087d2855c7d920d702781", "rollout_ordinal": 442, "created_at_ms": 1790648640566, "item_type": "agentMessage", "updated_at_ordinal": 442, "started_at_ms": 1790648640566, "completed_at_ms": 1790648642835}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb213f18a087d2855c7d920d702781", "text": "Voy a corregir el error de muestreo de pYIN y revisar las falsas detecciones de YIN. Después repetiré la evaluación con Vocadito, incluyendo la configuración que usa la interfaz nueva.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-d928e38e-c5e8-46e3-836d-bccf11514655", "rollout_ordinal": 446, "created_at_ms": 1790648644813, "item_type": "commandExecution", "updated_at_ordinal": 446, "started_at_ms": 1790648644813, "completed_at_ms": 1790648645380}, "item": {"type": "commandExecution", "id": "exec-d928e38e-c5e8-46e3-836d-bccf11514655", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"rg --files -g AGENTS.md -g '\"'!venv/**'\"'; Get-Content audio/pitch.py; Get-Content scripts/evaluar_vocadito.py\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "94621", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "rg --files -g AGENTS.md -g '!venv/**'; Get-Content audio/pitch.py; Get-Content scripts/evaluar_vocadito.py"}], "aggregatedOutput": "import librosa\r\nimport numpy as np\r\n\r\ntry:\r\n    import pyworld as pw\r\nexcept ImportError:\r\n    pw = None\r\n\r\n\r\nFILTRO_SUAVE = {\r\n    \"nota_min\": \"A1\",\r\n    \"nota_max\": \"C7\",\r\n    \"percentil_rms\": 25,\r\n    \"factor_rms\": 1.25,\r\n    \"factor_rms_max\": 0.012,\r\n    \"max_gap\": 5,\r\n    \"min_frames\": 2,\r\n    \"ventana_mediana\": 7,\r\n    \"max_salto_midi\": 9,\r\n}\r\n\r\nFILTRO_TIEMPO_REAL = {\r\n    \"nota_min\": \"C2\",\r\n    \"nota_max\": \"C6\",\r\n    \"factor_rms_max\": 0.08,\r\n    \"factor_ruido\": 2.2,\r\n    \"min_rms_absoluto\": 0.002,\r\n    \"max_gap\": 1,\r\n    \"min_frames\": 3,\r\n    \"ventana_mediana\": 3,\r\n    \"max_salto_midi\": 8,\r\n}\r\n\r\n\r\ndef _rellenar_huecos_cortos(f0, max_gap):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    validos = np.where(f0 > 0)[0]\r\n    if len(validos) < 2:\r\n        return f0\r\n\r\n    for inicio, fin in zip(validos[:-1], validos[1:]):\r\n        gap = fin - inicio - 1\r\n        if 0 < gap <= max_gap:\r\n            f0[inicio + 1 : fin] = np.linspace(f0[inicio], f0[fin], gap + 2)[1:-1]\r\n    return f0\r\n\r\n\r\ndef _quitar_segmentos_cortos(f0, min_frames):\r\n    f0 = np.asarray(f0, dtype=float).copy()\r\n    mask = f0 > 0\r\n    inicio = None\r\n\r\n    for i, activo in enumerate(np.r_[mask, False]):\r\n        if activo and inicio is None:\r\n            inicio = i\r\n        elif not activo and inicio is not None:\r\n            if i - inicio < min_frames:\r\n                f0[inicio:i] = 0\r\n            inicio = None\r\n    return f0\r\n\r\n\r\ndef _mediana_movil(valores, ventana=7):\r\n    valores = np.asarray(valores, dtype=float)\r\n    salida = np.full_like(valores, np.nan, dtype=float)\r\n    radio = ventana // 2\r\n\r\n    for i in range(len(valores)):\r\n        inicio = max(0, i - radio)\r\n        fin = min(len(valores), i + radio + 1)\r\n        segmento = valores[inicio:fin]\r\n        segmento = segmento[~np.isnan(segmento)]\r\n        if len(segmento):\r\n            salida[i] = np.median(segmento)\r\n    return salida\r\n\r\n\r\ndef _filtrar_pitch(t, f0, y, sr, config=None, corregir_octavas=True):\r\n    config = config or FILTRO_SUAVE\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    rms = librosa.feature.rms(y=y, frame_length=2048, hop_length=512)[0]\r\n    t_rms = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=512)\r\n    energia = np.interp(t, t_rms, rms, left=0, right=0)\r\n    umbral_energia = max(\r\n        np.percentile(rms, config[\"percentil_rms\"]) * config[\"factor_rms\"],\r\n        np.max(rms) * config[\"factor_rms_max\"],\r\n    )\r\n    f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= 7:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n    if corregir_octavas:\r\n        return _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _energia_por_tiempo(y, sr, tiempos, ventana=1024):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    tiempos = np.asarray(tiempos, dtype=float)\r\n    if len(y) == 0 or len(tiempos) == 0:\r\n        return np.array([])\r\n\r\n    cuadrado = y * y\r\n    acumulado = np.concatenate(([0.0], np.cumsum(cuadrado)))\r\n    centros = np.clip((tiempos * sr).astype(int), 0, len(y) - 1)\r\n    radio = ventana // 2\r\n    inicios = np.maximum(0, centros - radio)\r\n    fines = np.minimum(len(y), centros + radio)\r\n    muestras = np.maximum(1, fines - inicios)\r\n    energia = (acumulado[fines] - acumulado[inicios]) / muestras\r\n    return np.sqrt(np.maximum(energia, 0.0))\r\n\r\n\r\ndef _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False):\r\n    config = config or FILTRO_TIEMPO_REAL\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n    raw_points = int(np.sum(f0 > 0))\r\n    rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    energia = _energia_por_tiempo(y, sr, t)\r\n    umbral_energia = 0.0\r\n    if len(energia):\r\n        umbral_energia = max(\r\n            float(np.max(energia)) * config[\"factor_rms_max\"],\r\n            config[\"min_rms_absoluto\"],\r\n        )\r\n        if ruido_base is not None and ruido_base > 0:\r\n            umbral_energia = max(umbral_energia, float(ruido_base) * config[\"factor_ruido\"])\r\n        f0[energia < umbral_energia] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= config[\"ventana_mediana\"]:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n\r\n    if devolver_info:\r\n        return t_filtrado, f_filtrado, {\r\n            \"raw_points\": raw_points,\r\n            \"filtered_points\": int(len(f_filtrado)),\r\n            \"rejected_points\": max(0, raw_points - int(len(f_filtrado))),\r\n            \"rms\": rms_chunk,\r\n            \"energy_threshold\": float(umbral_energia),\r\n            \"noise_floor\": float(ruido_base or 0.0),\r\n        }\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _corregir_octavas_por_registro(t, f0, min_puntos=30):\r\n    t = np.asarray(t, dtype=float)\r\n    f0 = np.asarray(f0, dtype=float)\r\n    if len(f0) < min_puntos:\r\n        return t, f0\r\n\r\n    midi = 69 + 12 * np.log2(f0 / 440.0)\r\n    midi = np.nan_to_num(midi, nan=0.0, posinf=0.0, neginf=0.0)\r\n    if np.sum(midi > 0) < min_puntos:\r\n        return t, f0\r\n\r\n    corregido = midi.copy()\r\n    valores = midi[midi > 0]\r\n    umbral_octava_alta = max(70.5, float(np.percentile(valores, 90)) + 4.0)\r\n    segmentos = _segmentos_pitch(t, midi)\r\n    for indice, segmento in enumerate(segmentos):\r\n        inicio, fin, mediana, duracion, _inicio_t, _fin_t = segmento\r\n        if mediana < umbral_octava_alta or duracion > 0.9:\r\n            continue\r\n\r\n        vecinos = [\r\n            nota\r\n            for nota in _medianas_vecinas(segmentos, indice, max_distancia=1.5)\r\n            if nota < umbral_octava_alta\r\n        ]\r\n        if not vecinos:\r\n            continue\r\n\r\n        actual = float(np.median(np.abs(np.asarray(vecinos) - mediana)))\r\n        una_octava_abajo = float(np.median(np.abs(np.asarray(vecinos) - (mediana - 12.0))))\r\n        if actual >= 8.0 and una_octava_abajo <= 5.5 and una_octava_abajo + 2.0 < actual:\r\n            segmento = corregido[inicio:fin]\r\n            segmento[segmento >= umbral_octava_alta] -= 12.0\r\n\r\n    f0_corregido = 440.0 * np.power(2.0, (corregido - 69.0) / 12.0)\r\n    return _limpiar_segmentos_erraticos(t, f0_corregido)\r\n\r\n\r\ndef _limpiar_segmentos_erraticos(t, f0, min_puntos=30):\r\n    t = np.asarray(t, dtype=float)\r\n    f0 = np.asarray(f0, dtype=float)\r\n    if len(f0) < min_puntos:\r\n        return t, f0\r\n\r\n    midi = 69 + 12 * np.log2(f0 / 440.0)\r\n    midi = np.nan_to_num(midi, nan=0.0, posinf=0.0, neginf=0.0)\r\n    valores = midi[midi > 0]\r\n    if len(valores) < min_puntos:\r\n        return t, f0\r\n\r\n    umbral_octava_alta = max(70.5, float(np.percentile(valores, 90)) + 4.0)\r\n    segmentos = _segmentos_pitch(t, midi)\r\n    conservar = np.ones(len(midi), dtype=bool)\r\n\r\n    for indice, segmento in enumerate(segmentos):\r\n        inicio, fin, mediana, duracion, _inicio_t, _fin_t = segmento\r\n        vecinos = _medianas_vecinas(segmentos, indice, max_distancia=1.5)\r\n        distancia_vecinos = float(np.median(np.abs(np.asarray(vecinos) - mediana))) if vecinos else 99.0\r\n\r\n        if mediana >= umbral_octava_alta + 5.0 and duracion <= 0.45 and distancia_vecinos >= 7.0:\r\n            conservar[inicio:fin] = False\r\n        elif mediana >= umbral_octava_alta and duracion <= 0.06 and distancia_vecinos >= 5.0:\r\n            conservar[inicio:fin] = False\r\n\r\n    return t[conservar], f0[conservar]\r\n\r\n\r\ndef _segmentos_pitch(t, midi, max_gap=0.18, max_jump=4.5):\r\n    segmentos = []\r\n    if len(midi) == 0:\r\n        return segmentos\r\n\r\n    inicio = 0\r\n    for i in range(1, len(midi)):\r\n        if t[i] - t[i - 1] > max_gap or abs(midi[i] - midi[i - 1]) > max_jump:\r\n            segmentos.append(_describir_segmento(t, midi, inicio, i))\r\n            inicio = i\r\n    segmentos.append(_describir_segmento(t, midi, inicio, len(midi)))\r\n    return [segmento for segmento in segmentos if segmento is not None]\r\n\r\n\r\ndef _describir_segmento(t, midi, inicio, fin):\r\n    if fin <= inicio:\r\n        return None\r\n    duracion = max(0.0, float(t[fin - 1] - t[inicio]))\r\n    mediana = float(np.median(midi[inicio:fin]))\r\n    return inicio, fin, mediana, duracion, float(t[inicio]), float(t[fin - 1])\r\n\r\n\r\ndef _medianas_vecinas(segmentos, indice, max_distancia=1.0):\r\n    _inicio, _fin, _mediana, _duracion, inicio_t, fin_t = segmentos[indice]\r\n    vecinos = []\r\n\r\n    for anterior in range(indice - 1, max(-1, indice - 4), -1):\r\n        _a_inicio, _a_fin, a_mediana, _a_duracion, _a_inicio_t, a_fin_t = segmentos[anterior]\r\n        distancia = max(0.0, inicio_t - a_fin_t)\r\n        if distancia > max_distancia:\r\n            break\r\n        vecinos.append(a_mediana)\r\n\r\n    for siguiente in range(indice + 1, min(len(segmentos), indice + 4)):\r\n        _s_inicio, _s_fin, s_mediana, _s_duracion, s_inicio_t, _s_fin_t = segmentos[siguiente]\r\n        distancia = max(0.0, s_inicio_t - fin_t)\r\n        if distancia > max_distancia:\r\n            break\r\n        vecinos.append(s_mediana)\r\n\r\n    return vecinos\r\n\r\n\r\ndef _info_pitch_vacio(ruido_base=0.0, rms=0.0):\r\n    return {\r\n        \"raw_points\": 0,\r\n        \"filtered_points\": 0,\r\n        \"rejected_points\": 0,\r\n        \"rms\": float(rms),\r\n        \"energy_threshold\": 0.0,\r\n        \"noise_floor\": float(ruido_base or 0.0),\r\n    }\r\n\r\n\r\ndef _lag_parabolico(autocorrelacion, indice):\r\n    if indice <= 0 or indice >= len(autocorrelacion) - 1:\r\n        return float(indice)\r\n\r\n    izquierda = autocorrelacion[indice - 1]\r\n    centro = autocorrelacion[indice]\r\n    derecha = autocorrelacion[indice + 1]\r\n    denominador = izquierda - 2 * centro + derecha\r\n    if abs(denominador) < 1e-12:\r\n        return float(indice)\r\n\r\n    return float(indice + 0.5 * (izquierda - derecha) / denominador)\r\n\r\n\r\ndef _pitch_autocorrelacion(frame, sr, f_min, f_max, umbral_confianza=0.24):\r\n    frame = np.asarray(frame, dtype=np.float32)\r\n    frame = frame - float(np.mean(frame))\r\n    energia = float(np.dot(frame, frame))\r\n    if energia <= 1e-9:\r\n        return 0.0\r\n\r\n    ventana = np.hanning(len(frame)).astype(np.float32)\r\n    frame = frame * ventana\r\n    n_fft = 1 << (2 * len(frame) - 1).bit_length()\r\n    espectro = np.fft.rfft(frame, n=n_fft)\r\n    autocorrelacion = np.fft.irfft(espectro * np.conj(espectro), n=n_fft)[: len(frame)]\r\n    if autocorrelacion[0] <= 0:\r\n        return 0.0\r\n\r\n    lag_min = max(1, int(sr / f_max))\r\n    lag_max = min(len(frame) - 1, int(sr / f_min))\r\n    if lag_max <= lag_min:\r\n        return 0.0\r\n\r\n    region = autocorrelacion[lag_min : lag_max + 1]\r\n    indice = int(np.argmax(region)) + lag_min\r\n    confianza = float(autocorrelacion[indice] / autocorrelacion[0])\r\n    if confianza < umbral_confianza:\r\n        return 0.0\r\n\r\n    lag = _lag_parabolico(autocorrelacion, indice)\r\n    if lag <= 0:\r\n        return 0.0\r\n    return float(sr / lag)\r\n\r\n\r\ndef extraer_pitch_ligero_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=np.float32).reshape(-1)\r\n    y = np.nan_to_num(y, nan=0.0, posinf=0.0, neginf=0.0)\r\n    rms_chunk = float(np.sqrt(np.mean(y.astype(float) ** 2))) if len(y) else 0.0\r\n    if len(y) < int(sr * 0.12):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\r\n        return np.array([]), np.array([])\r\n\r\n    frame_length = min(2048, len(y))\r\n    hop_length = 1024\r\n    f_min = librosa.note_to_hz(FILTRO_TIEMPO_REAL[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(FILTRO_TIEMPO_REAL[\"nota_max\"])\r\n    umbral_silencio = max(\r\n        FILTRO_TIEMPO_REAL[\"min_rms_absoluto\"],\r\n        float(ruido_base or 0.0) * 1.6,\r\n    )\r\n\r\n    try:\r\n        f0 = librosa.yin(\r\n            y.astype(float, copy=False),\r\n            fmin=f_min,\r\n            fmax=f_max,\r\n            sr=sr,\r\n            frame_length=frame_length,\r\n            hop_length=hop_length,\r\n            center=False,\r\n            trough_threshold=0.15,\r\n        )\r\n        t = (np.arange(len(f0), dtype=float) * hop_length + frame_length / 2) / sr\r\n        f0 = np.nan_to_num(f0, nan=0.0, posinf=0.0, neginf=0.0)\r\n    except Exception:\r\n        tiempos = []\r\n        frecuencias = []\r\n        for inicio in range(0, len(y) - frame_length + 1, hop_length):\r\n            frame = y[inicio : inicio + frame_length]\r\n            rms_frame = float(np.sqrt(np.mean(frame.astype(float) ** 2))) if len(frame) else 0.0\r\n            frecuencia = 0.0\r\n            if rms_frame >= umbral_silencio:\r\n                frecuencia = _pitch_autocorrelacion(frame, sr, f_min, f_max)\r\n            tiempos.append((inicio + frame_length / 2) / sr)\r\n            frecuencias.append(frecuencia)\r\n        t = np.asarray(tiempos, dtype=float)\r\n        f0 = np.asarray(frecuencias, dtype=float)\r\n\r\n    if not len(t):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), _info_pitch_vacio(ruido_base, rms_chunk)\r\n        return np.array([]), np.array([])\r\n\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_crudo(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n\r\n    mask = f0 > 0\r\n    return t[mask], f0[mask]\r\n\r\n\r\ndef _extraer_pitch_base(y, sr):\r\n    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n    return t, f0\r\n\r\n\r\ndef extraer_pitch_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    if len(y) < int(sr * 0.18):\r\n        if devolver_info:\r\n            return np.array([]), np.array([]), {\r\n                \"raw_points\": 0,\r\n                \"filtered_points\": 0,\r\n                \"rejected_points\": 0,\r\n                \"rms\": 0.0,\r\n                \"energy_threshold\": 0.0,\r\n                \"noise_floor\": float(ruido_base or 0.0),\r\n            }\r\n        return np.array([]), np.array([])\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n    resultado = _filtrar_pitch_tiempo_real(\r\n        t,\r\n        f0,\r\n        y,\r\n        sr,\r\n        ruido_base=ruido_base,\r\n        devolver_info=devolver_info,\r\n    )\r\n    if devolver_info:\r\n        t_filtrado, f_filtrado, info = resultado\r\n        return t_filtrado + offset_t, f_filtrado, info\r\n\r\n    t_filtrado, f_filtrado = resultado\r\n    return t_filtrado + offset_t, f_filtrado\r\n\r\n\r\ndef extraer_pitch_detallado(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    mask_crudo = f0 > 0\r\n    t_filtrado, f_filtrado = _filtrar_pitch(t, f0, y, sr, corregir_octavas=False)\r\n    t_corregido, f_corregido = _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return {\r\n        \"t_crudo\": t[mask_crudo],\r\n        \"f_crudo\": f0[mask_crudo],\r\n        \"t_filtrado\": t_filtrado,\r\n        \"f_filtrado\": f_filtrado,\r\n        \"t_corregido\": t_corregido,\r\n        \"f_corregido\": f_corregido,\r\n    }\r\n\r\n\r\ndef extraer_pitch(ruta_audio):\r\n    y, sr = librosa.load(ruta_audio, sr=None)\r\n    t, f0 = _extraer_pitch_base(y, sr)\r\n\r\n    return _filtrar_pitch(t, f0, y, sr)\r\n\r\ndef hz_to_nota(f):\r\n    if f <= 0:\r\n        return None\r\n\r\n    A4 = 440.0\r\n    C0 = A4 * pow(2, -4.75)\r\n\r\n    h = round(12 * np.log2(f / C0))\r\n    octava = h // 12\r\n    n = h % 12\r\n\r\n    nombres = ['C', 'C#', 'D', 'D#', 'E', 'F',\r\n               'F#', 'G', 'G#', 'A', 'A#', 'B']\r\n\r\n    return f\"{nombres[n]}{octava}\"\r\n\"\"\"Benchmark reproducible del detector existente; no ajusta sus parametros.\r\n\r\npython scripts/evaluar_vocadito.py\r\nDataset v3: https://zenodo.org/records/5578807\r\n\"\"\"\r\nfrom pathlib import Path\r\nimport argparse\r\nimport hashlib\r\nimport importlib.metadata\r\nimport json\r\nimport platform\r\nimport sys\r\nimport time\r\n\r\nimport numpy as np\r\nimport librosa\r\nimport soundfile as sf\r\nimport matplotlib\r\nmatplotlib.use('Agg')\r\nimport matplotlib.pyplot as plt\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\nfrom audio import pitch\r\n\r\nMODES = ('base', 'filtrado', 'final', 'yin_stream')\r\n\r\n\r\ndef align(t, f, target, tolerance):\r\n    \"\"\"Vecino mas cercano acotado: nunca une silencios entre puntos validos.\"\"\"\r\n    out = np.zeros(len(target))\r\n    if not len(t):\r\n        return out\r\n    assert len(t) == len(f) and np.all(np.diff(t) > 0)\r\n    right = np.clip(np.searchsorted(t, target), 0, len(t) - 1)\r\n    left = np.maximum(right - 1, 0)\r\n    idx = np.where(abs(t[left] - target) <= abs(t[right] - target), left, right)\r\n    valid = abs(t[idx] - target) <= tolerance + 1e-9\r\n    out[valid] = f[idx[valid]]\r\n    return out\r\n\r\n\r\ndef counts(ref, est):\r\n    rv, ev = ref > 0, est > 0\r\n    both = rv & ev\r\n    cents = 1200 * np.log2(est[both] / ref[both])\r\n    good = abs(cents) <= 50\r\n    octaves = abs(abs(cents) - 1200) <= 50\r\n    return {\r\n        'frames': len(ref), 'voiced': int(rv.sum()), 'unvoiced': int((~rv).sum()),\r\n        'both_voiced': int(both.sum()), 'correct_pitch': int(good.sum()),\r\n        'missed': int((rv & ~ev).sum()), 'false_voiced': int((~rv & ev).sum()),\r\n        'correct_unvoiced': int((~rv & ~ev).sum()),\r\n        'octave_errors': int(octaves.sum()),\r\n    }, abs(cents)\r\n\r\n\r\ndef percentages(c):\r\n    def pct(n, d):\r\n        return 100 * n / d if d else None\r\n    return {\r\n        'pitch_correct_50c_pct': pct(c['correct_pitch'], c['voiced']),\r\n        'missed_voiced_pct': pct(c['missed'], c['voiced']),\r\n        'false_voiced_pct': pct(c['false_voiced'], c['unvoiced']),\r\n        'octave_error_pct': pct(c['octave_errors'], c['voiced']),\r\n        'overall_accuracy_pct': pct(c['correct_pitch'] + c['correct_unvoiced'], c['frames']),\r\n    }\r\n\r\n\r\ndef stream(y, sr):\r\n    \"\"\"Simula worker: ventana 380 ms, llamadas 60 ms, solo puntos nuevos.\r\n\r\n    Sin hardware/cola, sin ruido de calibracion y sin descarte de llamadas.\r\n    Se conservan tiempos reales de disponibilidad para estimar retraso.\r\n    \"\"\"\r\n    ts, fs, delays, calls = [], [], [], []\r\n    last = 0.0\r\n    for end in np.arange(0.06, len(y) / sr, 0.06):\r\n        start = max(0.0, end - 0.38)\r\n        chunk = y[int(start * sr):int(end * sr)]\r\n        tic = time.perf_counter()\r\n        t, f = pitch.extraer_pitch_ligero_desde_audio(chunk, sr, offset_t=start, ruido_base=None)\r\n        elapsed = time.perf_counter() - tic\r\n        calls.append(elapsed)\r\n        new = t > last\r\n        if np.any(new):\r\n            ts.extend(t[new]); fs.extend(f[new])\r\n            delays.extend(end - t[new] + elapsed)\r\n            last = float(t[new].max())\r\n    return np.asarray(ts), np.asarray(fs), np.asarray(calls), np.asarray(delays)\r\n\r\n\r\ndef check_evaluator():\r\n    # Un hueco no se interpola como una nota sostenida.\r\n    assert np.array_equal(align(np.array([0., .02]), np.array([440., 440.]),\r\n                               np.array([0., .01, .02]), .004), [440., 0., 440.])\r\n    c, _ = counts(np.array([440., 440., 440., 0., 0.]),\r\n                  np.array([440., 880., 0., 440., 0.]))\r\n    assert c['correct_pitch'] == c['missed'] == c['octave_errors'] == c['false_voiced'] == 1\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument('--data', type=Path, default=ROOT / 'data/vocadito_benchmark')\r\n    parser.add_argument('--output', type=Path, default=ROOT / 'output/vocadito_benchmark')\r\n    parser.add_argument('--limit', type=int)\r\n    args = parser.parse_args()\r\n    check_evaluator()\r\n    args.output.mkdir(parents=True, exist_ok=True)\r\n    (args.output / 'predicciones').mkdir(exist_ok=True)\r\n    archive = args.data / 'vocadito.zip'\r\n    checksum = hashlib.md5(archive.read_bytes()).hexdigest()\r\n    assert checksum == 'dea40fd18f14d899643c4ba221b33a46', 'Dataset no coincide con v3'\r\n    files = sorted((args.data / 'Audio').glob('*.wav'), key=lambda p: int(p.stem.split('_')[-1]))\r\n    assert len(files) == 40, f'Se esperaban 40 audios, hay {len(files)}'\r\n    files = files[:args.limit] if args.limit else files\r\n    # Warmup excluido de tiempos; tambien registra el coste de arranque.\r\n    tic = time.perf_counter()\r\n    warm = .1 * np.sin(2 * np.pi * 220 * np.arange(44100) / 44100)\r\n    pitch._extraer_pitch_base(warm, 44100)\r\n    pitch.extraer_pitch_ligero_desde_audio(warm[:16758], 44100)\r\n    warmup = time.perf_counter() - tic\r\n    all_counts = {m: [] for m in MODES}\r\n    all_cents = {m: [] for m in MODES}\r\n    rows, call_times, delays, base_times, audio_seconds = [], [], [], [], 0.\r\n    for n, path in enumerate(files, 1):\r\n        y, sr = sf.read(path, dtype='float32')\r\n        assert y.ndim == 1 and sr == 44100\r\n        duration = len(y) / sr\r\n        audio_seconds += duration\r\n        reference = np.loadtxt(args.data / 'Annotations/F0' / (path.stem + '_f0.csv'), delimiter=',')\r\n        rt, rf = reference.T\r\n        assert np.all(np.diff(rt) > 0) and np.all(rf >= 0)\r\n        tic = time.perf_counter()\r\n        t, f = pitch._extraer_pitch_base(y, sr)\r\n        base_elapsed = time.perf_counter() - tic\r\n        base_times.append(base_elapsed)\r\n        tf, ff = pitch._filtrar_pitch(t, f.copy(), y, sr, corregir_octavas=False)\r\n        tc, fc = pitch._corregir_octavas_por_registro(tf, ff.copy())\r\n        hop = float(np.median(np.diff(t)))\r\n        predictions = {\r\n            'base': align(t, f, rt, hop / 2),\r\n            'filtrado': align(tf, ff, rt, hop / 2),\r\n            'final': align(tc, fc, rt, hop / 2),\r\n        }\r\n        st, sfreq, calls, delay = stream(y, sr)\r\n        predictions['yin_stream'] = align(st, sfreq, rt, 1024 / sr / 2)\r\n        call_times.extend(calls); delays.extend(delay)\r\n        row = {'track': path.stem, 'duration_s': duration, 'base_processing_s': base_elapsed, 'metrics': {}}\r\n        for mode, est in predictions.items():\r\n            c, error = counts(rf, est)\r\n            all_counts[mode].append(c); all_cents[mode].append(error)\r\n            row['metrics'][mode] = {**percentages(c), 'counts': c,\r\n                'median_abs_cents_both_voiced': float(np.median(error)) if len(error) else None}\r\n        rows.append(row)\r\n        np.savez_compressed(args.output / 'predicciones' / (path.stem + '.npz'),\r\n                            time=rt, reference=rf, **predictions)\r\n        print(f'{n}/{len(files)} {path.stem}: final={row[\"metrics\"][\"final\"][\"pitch_correct_50c_pct\"]:.1f}% '\r\n              f'live={row[\"metrics\"][\"yin_stream\"][\"pitch_correct_50c_pct\"]:.1f}%', flush=True)\r\n    summary = {}\r\n    for mode in MODES:\r\n        pooled = {key: sum(c[key] for c in all_counts[mode]) for key in all_counts[mode][0]}\r\n        errors = np.concatenate(all_cents[mode])\r\n        summary[mode] = {**percentages(pooled), 'counts': pooled,\r\n            'macro_pitch_correct_50c_pct': float(np.mean([r['metrics'][mode]['pitch_correct_50c_pct'] for r in rows])),\r\n            'median_abs_cents_both_voiced': float(np.median(errors)),\r\n            'p90_abs_cents_both_voiced': float(np.percentile(errors, 90))}\r\n    report = {\r\n        'dataset_url': 'https://zenodo.org/records/5578807', 'dataset_md5': checksum,\r\n        'tracks': len(files), 'duration_s': audio_seconds,\r\n        'python': sys.version, 'platform': platform.platform(),\r\n        'versions': {p: importlib.metadata.version(p) for p in ['librosa', 'numpy', 'soundfile', 'matplotlib']},\r\n        'backend': 'WORLD' if pitch.pw is not None else 'pYIN',\r\n        'pitch_sha256': hashlib.sha256((ROOT / 'audio/pitch.py').read_bytes()).hexdigest(),\r\n        'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\r\n        'config_offline': pitch.FILTRO_SUAVE, 'config_live': pitch.FILTRO_TIEMPO_REAL,\r\n        'warmup_s': warmup, 'base_processing_s': sum(base_times),\r\n        'base_realtime_factor': sum(base_times) / audio_seconds,\r\n        'live_call_median_ms': float(np.median(call_times) * 1000),\r\n        'live_call_p95_ms': float(np.percentile(call_times, 95) * 1000),\r\n        'live_call_over_60ms_pct': float(np.mean(np.array(call_times) > .06) * 100),\r\n        'live_availability_delay_median_ms': float(np.median(delays) * 1000),\r\n        'live_availability_delay_p95_ms': float(np.percentile(delays, 95) * 1000),\r\n        'summary': summary, 'per_track': rows,\r\n    }\r\n    (args.output / 'resultados.json').write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding='utf-8')\r\n    labels = ['pYIN base', 'Filtros', 'Salida final', 'YIN en bloques']\r\n    fig, ax = plt.subplots(figsize=(9, 4.5), layout='constrained')\r\n    vals = [summary[m]['pitch_correct_50c_pct'] for m in MODES]\r\n    bars = ax.bar(labels, vals, color=['#526c91', '#c18340', '#477b61', '#8764a5'])\r\n    ax.bar_label(bars, fmt='%.1f%%', padding=3)\r\n    ax.set(ylim=(0, 100), ylabel='Aciertos / frames de referencia con F0 (%)',\r\n           title=f'Vocadito: {len(files)} grabaciones, tolerancia de 50 cents')\r\n    fig.savefig(args.output / 'resumen.png', dpi=160); plt.close(fig)\r\n    # Peor caso final y mayor perdida producida por filtros, sin seleccion manual.\r\n    worst = min(rows, key=lambda r: r['metrics']['final']['pitch_correct_50c_pct'])\r\n    loss = min(rows, key=lambda r: r['metrics']['final']['pitch_correct_50c_pct'] - r['metrics']['base']['pitch_correct_50c_pct'])\r\n    chosen = list(dict.fromkeys([worst['track'], loss['track']]))\r\n    for track in chosen:\r\n        data = np.load(args.output / 'predicciones' / (track + '.npz'))\r\n        fig, axes = plt.subplots(3, 1, figsize=(12, 8), sharex=True, layout='constrained')\r\n        for ax, mode in zip(axes, ['base', 'final', 'yin_stream']):\r\n            for key, label, color in [('reference', 'Referencia', '#333333'), (mode, mode, '#c55940')]:\r\n                hz = data[key]; midi = np.full(len(hz), np.nan); v = hz > 0\r\n                midi[v] = 69 + 12 * np.log2(hz[v] / 440)\r\n                ax.plot(data['time'], midi, '.', ms=1.5, label=label, color=color)\r\n            ax.set_ylabel('Altura MIDI'); ax.legend(loc='upper right'); ax.grid(alpha=.2)\r\n        axes[0].set_title(track + ': referencia y estimacion (huecos = ausencia de F0)')\r\n        axes[-1].set_xlabel('Tiempo (s)')\r\n        fig.savefig(args.output / (track + '.png'), dpi=140); plt.close(fig)\r\n    print(json.dumps({k: v for k, v in report.items() if k not in ['per_track', 'summary']}, indent=2))\r\n\r\n\r\nif __name__ == '__main__':\r\n    main()\r\n", "exitCode": 0, "durationMs": 567}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "rs_06f6aa8593d2a892016abb214824fc87d2b74552e54e2de628", "rollout_ordinal": 449, "created_at_ms": 1790648649576, "item_type": "reasoning", "updated_at_ordinal": 449, "started_at_ms": 1790648649576, "completed_at_ms": 1790648663094}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb214824fc87d2b74552e54e2de628", "summary": ["**Selecting lag metric**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-2dec7240-75c1-4af1-9e8f-27f1f109af68", "rollout_ordinal": 453, "created_at_ms": 1790648666409, "item_type": "commandExecution", "updated_at_ordinal": 453, "started_at_ms": 1790648666409, "completed_at_ms": 1790648671612}, "item": {"type": "commandExecution", "id": "exec-2dec7240-75c1-4af1-9e8f-27f1f109af68", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content desktop_live.py | Select-Object -Skip 420 -First 66; Get-Content audio/karaoke.py | Select-Object -Skip 170 -First 42; Get-Content data/vocadito_benchmark/vocadito_metadata.csv; Get-ChildItem scripts -Name; Get-ChildItem -Force -Name .gitignore; python -c \"import inspect,librosa; print(inspect.getsource(librosa.yin)[-6000:])\"'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "88079", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content desktop_live.py | Select-Object -Skip 420 -First 66; Get-Content audio/karaoke.py | Select-Object -Skip 170 -First 42; Get-Content data/vocadito_benchmark/vocadito_metadata.csv; Get-ChildItem scripts -Name; Get-ChildItem -Force -Name .gitignore; python -c \"import inspect,librosa; print(inspect.getsource(librosa.yin)[-6000:])\""}], "aggregatedOutput": "            if self._estado[\"status\"] in [\"calibrating\", \"preparing\"]:\r\n                self._estado[\"status\"] = \"recording\"\r\n            self._estado[\"current\"] = float(tiempo)\r\n\r\n    def _agregar_pitch_usuario(self, tiempos, frecuencias):\r\n        midi = hz_to_midi(frecuencias)\r\n        puntos = sorted(\r\n            (\r\n                [float(t), float(m)]\r\n                for t, m in zip(tiempos, midi)\r\n                if not np.isnan(m)\r\n            ),\r\n            key=lambda punto: punto[0],\r\n        )\r\n        aceptados = []\r\n        rechazados_salto = 0\r\n        with self._lock:\r\n            for punto in puntos:\r\n                if self._aceptar_punto_usuario(punto):\r\n                    aceptados.append(punto)\r\n                else:\r\n                    rechazados_salto += 1\r\n\r\n            self._pitch_pendiente.extend(aceptados)\r\n            if len(self._pitch_pendiente) > 300:\r\n                self._pitch_pendiente = self._pitch_pendiente[-300:]\r\n            diagnostico = dict(self._estado.get(\"diagnostics\") or self._diagnostico_inicial())\r\n            diagnostico[\"accepted_points\"] += len(aceptados)\r\n            diagnostico[\"rejected_jumps\"] += rechazados_salto\r\n            diagnostico[\"rejected_points\"] += rechazados_salto\r\n            self._estado[\"diagnostics\"] = diagnostico\r\n\r\n    def _aceptar_punto_usuario(self, punto):\r\n        tiempo, midi = punto\r\n        if self._ultimo_punto_usuario is None:\r\n            self._ultimo_punto_usuario = punto\r\n            return True\r\n\r\n        tiempo_anterior, midi_anterior = self._ultimo_punto_usuario\r\n        delta_t = tiempo - tiempo_anterior\r\n        if delta_t <= 0:\r\n            return False\r\n        if delta_t > LIVE_JUMP_RESET_SECONDS:\r\n            self._ultimo_punto_usuario = punto\r\n            return True\r\n        if abs(midi - midi_anterior) > LIVE_MAX_JUMP_MIDI:\r\n            return False\r\n\r\n        self._ultimo_punto_usuario = punto\r\n        return True\r\n\r\n    def _actualizar_diagnostico_live(self, info):\r\n        with self._lock:\r\n            diagnostico = dict(self._estado.get(\"diagnostics\") or self._diagnostico_inicial())\r\n            diagnostico[\"noise_floor\"] = float(info.get(\"noise_floor\", diagnostico[\"noise_floor\"]))\r\n            diagnostico[\"last_rms\"] = float(info.get(\"rms\", diagnostico[\"last_rms\"]))\r\n            diagnostico[\"energy_threshold\"] = float(info.get(\"energy_threshold\", diagnostico[\"energy_threshold\"]))\r\n            diagnostico[\"raw_points\"] += int(info.get(\"raw_points\", 0))\r\n            diagnostico[\"filtered_points\"] += int(info.get(\"filtered_points\", 0))\r\n            diagnostico[\"rejected_points\"] += int(info.get(\"rejected_points\", 0))\r\n            diagnostico[\"pitch_errors\"] += int(info.get(\"pitch_errors\", 0))\r\n            self._estado[\"diagnostics\"] = diagnostico\r\n\r\n    def _resultado_para_ui(self, resultado):\r\n        grafico = resultado.get(\"grafico\") or {}\r\n        salida = {\r\n    pitch_queue,\r\n    pitch_stop,\r\n    pitch_callback,\r\n    diagnostico_callback,\r\n    samplerate,\r\n    ruido_base,\r\n):\r\n    ultimo_pitch_t = 0\r\n    while not pitch_stop.is_set() or not pitch_queue.empty():\r\n        try:\r\n            inicio_chunk_t, chunk = pitch_queue.get(timeout=0.04)\r\n        except queue.Empty:\r\n            continue\r\n\r\n        try:\r\n            t_pitch, f_pitch, info = extraer_pitch_ligero_desde_audio(\r\n                chunk,\r\n                samplerate,\r\n                offset_t=inicio_chunk_t,\r\n                ruido_base=ruido_base,\r\n                devolver_info=True,\r\n            )\r\n            if diagnostico_callback is not None:\r\n                diagnostico_callback(info)\r\n            nuevos = t_pitch > ultimo_pitch_t\r\n            if np.any(nuevos):\r\n                ultimo_pitch_t = float(np.max(t_pitch[nuevos]))\r\n                pitch_callback(\r\n                    [float(t) for t in t_pitch[nuevos]],\r\n                    [float(f) for f in f_pitch[nuevos]],\r\n                )\r\n        except Exception:\r\n            if diagnostico_callback is not None:\r\n                diagnostico_callback({\r\n                    \"noise_floor\": ruido_base,\r\n                    \"rms\": 0.0,\r\n                    \"energy_threshold\": 0.0,\r\n                    \"raw_points\": 0,\r\n                    \"filtered_points\": 0,\r\n                    \"rejected_points\": 0,\r\n                    \"pitch_errors\": 1,\r\n                })\r\ntrack_id,singer_id,average_pitch,language\r\n1,S1,50,Tagalog\r\n2,S2,65,Spanish\r\n3,S1,52,Tagalog\r\n4,S3,47,Catalan/Valencian\r\n5,S4,57,Catalan/Valencian\r\n6,S5,61,English\r\n7,S6,63,Tagalog\r\n8,S1,49,Tagalog\r\n9,S6,62,Tagalog\r\n10,S7,49,English\r\n11,S8,59,English\r\n12,S9,59,English\r\n13,S10,51,French\r\n14,S11,59,English\r\n15,S12,61,English\r\n16,S6,59,Tagalog\r\n17,S12,60,none\r\n18,S13,52,English\r\n19,S14,55,English\r\n20,S15,58,English\r\n21,S16,50,English\r\n22,S17,59,English\r\n23,S18,48,French\r\n24,S19,59,French\r\n25,S20,60,French\r\n26,S21,48,French\r\n27,S22,56,French\r\n28,S21,47,French\r\n29,S23,58,French\r\n30,S24,56,French+English\r\n31,S23,59,French\r\n32,S25,59,English\r\n33,S26,53,English\r\n34,S27,58,English\r\n35,S28,47,Mandarin\r\n36,S28,48,Mandarin\r\n37,S29,62,Hawaiian+English\r\n38,S29,60,English\r\n39,S29,61,English\r\n40,S9,60,English\r\n__pycache__\r\ndiagnostico_sr_pyin.py\r\nevaluar_vocadito.py\r\ninforme_vocadito.py\r\nGet-ChildItem: \r\nLine |\r\n   2 |  … hildItem scripts -Name; Get-ChildItem -Force -Name .gitignore; python …\r\n     |                            ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\r\n     | Cannot find path 'C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\.gitignore' because it does not exist.\r\n  \"\"\"Fundamental frequency (F0) estimation using the YIN algorithm.\r\n\r\n    YIN is an autocorrelation based method for fundamental frequency estimation [#]_.\r\n    First, a normalized difference function is computed over short (overlapping) frames of audio.\r\n    Next, the first minimum in the difference function below ``trough_threshold`` is selected as\r\n    an estimate of the signal's period.\r\n    Finally, the estimated period is refined using parabolic interpolation before converting\r\n    into the corresponding frequency.\r\n\r\n    .. [#] De Cheveign�, Alain, and Hideki Kawahara.\r\n        \"YIN, a fundamental frequency estimator for speech and music.\"\r\n        The Journal of the Acoustical Society of America 111.4 (2002): 1917-1930.\r\n\r\n    Parameters\r\n    ----------\r\n    y : np.ndarray [shape=(..., n)]\r\n        audio time series. Multi-channel is supported..\r\n\r\n    fmin : number > 0 [scalar]\r\n        minimum frequency in Hertz.\r\n        The recommended minimum is ``librosa.note_to_hz('C2')`` (~65 Hz)\r\n        though lower values may be feasible.\r\n\r\n    fmax : number > fmin, <= sr/2 [scalar]\r\n        maximum frequency in Hertz.\r\n        The recommended maximum is ``librosa.note_to_hz('C7')`` (~2093 Hz)\r\n        though higher values may be feasible.\r\n\r\n    sr : number > 0 [scalar]\r\n        sampling rate of ``y`` in Hertz.\r\n\r\n    frame_length : int > 0 [scalar]\r\n        length of the frames in samples.\r\n        By default, ``frame_length=2048`` corresponds to a time scale of about 93 ms at\r\n        a sampling rate of 22050 Hz.\r\n\r\n    hop_length : None or int > 0 [scalar]\r\n        number of audio samples between adjacent YIN predictions.\r\n        If ``None``, defaults to ``frame_length // 4``.\r\n\r\n    trough_threshold : number > 0 [scalar]\r\n        absolute threshold for peak estimation.\r\n\r\n    center : boolean\r\n        If ``True``, the signal `y` is padded so that frame\r\n        ``D[:, t]`` is centered at `y[t * hop_length]`.\r\n        If ``False``, then ``D[:, t]`` begins at ``y[t * hop_length]``.\r\n        Defaults to ``True``,  which simplifies the alignment of ``D`` onto a\r\n        time grid by means of ``librosa.core.frames_to_samples``.\r\n\r\n    pad_mode : string or function\r\n        If ``center=True``, this argument is passed to ``np.pad`` for padding\r\n        the edges of the signal ``y``. By default (``pad_mode=\"constant\"``),\r\n        ``y`` is padded on both sides with zeros.\r\n        If ``center=False``,  this argument is ignored.\r\n        .. see also:: `np.pad`\r\n\r\n    win_length : Deprecated\r\n        length of the window for calculating autocorrelation in samples.\r\n\r\n        .. warning:: This parameter is deprecated as of 0.11.0 and\r\n            will be removed in 1.0.\r\n\r\n    Returns\r\n    -------\r\n    f0: np.ndarray [shape=(..., n_frames)]\r\n        time series of fundamental frequencies in Hertz.\r\n\r\n        If multi-channel input is provided, f0 curves are estimated separately for each channel.\r\n\r\n    See Also\r\n    --------\r\n    librosa.pyin :\r\n        Fundamental frequency (F0) estimation using probabilistic YIN (pYIN).\r\n\r\n    Examples\r\n    --------\r\n    Computing a fundamental frequency (F0) curve from an audio input\r\n\r\n    >>> y = librosa.chirp(fmin=440, fmax=880, duration=5.0, sr=22050)\r\n    >>> librosa.yin(y, fmin=440, fmax=880, sr=22050)\r\n    array([442.66354675, 441.95299983, 441.58010963, ...,\r\n        871.161732  , 873.99001454, 877.04297681])\r\n    \"\"\"\r\n    if fmin is None or fmax is None:\r\n        raise ParameterError('both \"fmin\" and \"fmax\" must be provided')\r\n\r\n    if not isinstance(win_length, Deprecated):\r\n        warnings.warn(\r\n            \"The win_length parameter has been deprecated in version 0.11.0 \"\r\n            \"and has no effect. It will be removed in version 1.0.0.\",\r\n            category=FutureWarning,\r\n            stacklevel=3,\r\n        )\r\n\r\n    __check_yin_params(\r\n        sr=sr, fmax=fmax, fmin=fmin, frame_length=frame_length\r\n    )\r\n\r\n    # Set the default hop if it is not already specified.\r\n    if hop_length is None:\r\n        hop_length = frame_length // 4\r\n\r\n    # Check that audio is valid.\r\n    util.valid_audio(y)\r\n\r\n    # Pad the time series so that frames are centered\r\n    if center:\r\n        padding = [(0, 0)] * y.ndim\r\n        padding[-1] = (frame_length // 2, frame_length // 2)\r\n        y = np.pad(y, padding, mode=pad_mode)\r\n\r\n    # Frame audio.\r\n    y_frames = util.frame(y, frame_length=frame_length, hop_length=hop_length)\r\n\r\n    # Calculate minimum and maximum periods\r\n    min_period = int(np.floor(sr / fmax))\r\n    max_period = min(int(np.ceil(sr / fmin)), frame_length - 1)\r\n\r\n    # Calculate cumulative mean normalized difference function.\r\n    yin_frames = _cumulative_mean_normalized_difference(\r\n        y_frames, min_period, max_period\r\n    )\r\n\r\n    # Parabolic interpolation.\r\n    parabolic_shifts = _parabolic_interpolation(yin_frames)\r\n\r\n    # Find local minima.\r\n    is_trough = util.localmin(yin_frames, axis=-2)\r\n    is_trough[..., 0, :] = yin_frames[..., 0, :] < yin_frames[..., 1, :]\r\n\r\n    # Find minima below peak threshold.\r\n    is_threshold_trough = np.logical_and(is_trough, yin_frames < trough_threshold)\r\n\r\n    # Absolute threshold.\r\n    # \"The solution we propose is to set an absolute threshold and choose the\r\n    # smallest value of tau that gives a minimum of d' deeper than\r\n    # this threshold. If none is found, the global minimum is chosen instead.\"\r\n    target_shape = list(yin_frames.shape)\r\n    target_shape[-2] = 1\r\n\r\n    global_min = np.argmin(yin_frames, axis=-2)\r\n    yin_period = np.argmax(is_threshold_trough, axis=-2)\r\n\r\n    global_min = global_min.reshape(target_shape)\r\n    yin_period = yin_period.reshape(target_shape)\r\n\r\n    no_trough_below_threshold = np.all(~is_threshold_trough, axis=-2, keepdims=True)\r\n    yin_period[no_trough_below_threshold] = global_min[no_trough_below_threshold]\r\n\r\n    # Refine peak by parabolic interpolation.\r\n\r\n    yin_period = (\r\n        min_period\r\n        + yin_period\r\n        + np.take_along_axis(parabolic_shifts, yin_period, axis=-2)\r\n    )[..., 0, :]\r\n\r\n    # Convert period to fundamental frequency.\r\n    f0: np.ndarray = sr / yin_period\r\n    return f0\r\n\r\n", "exitCode": 0, "durationMs": 5202}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "rs_06f6aa8593d2a892016abb2160f01887d2bcb7dbb7ba6b7389", "rollout_ordinal": 456, "created_at_ms": 1790648674358, "item_type": "reasoning", "updated_at_ordinal": 456, "started_at_ms": 1790648674358, "completed_at_ms": 1790648686035}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb2160f01887d2bcb7dbb7ba6b7389", "summary": ["**Adding pitch confidence gating**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-574661e0-c382-4d90-a8fe-68382a273d8d", "rollout_ordinal": 460, "created_at_ms": 1790648715478, "item_type": "commandExecution", "updated_at_ordinal": 460, "started_at_ms": 1790648715478, "completed_at_ms": 1790648715930}, "item": {"type": "commandExecution", "id": "exec-574661e0-c382-4d90-a8fe-68382a273d8d", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'New-Item -ItemType Directory -Force output/vocadito_mejoras/antes | Out-Null; Copy-Item -LiteralPath audio/pitch.py -Destination output/vocadito_mejoras/antes/pitch.py; Copy-Item -LiteralPath desktop_live.py -Destination output/vocadito_mejoras/antes/desktop_live.py; Copy-Item -LiteralPath scripts/evaluar_vocadito.py -Destination output/vocadito_mejoras/antes/evaluar_vocadito.py; Get-Content audio/pitch.py | Select-Object -Skip 435 -First 17'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "89482", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "New-Item -ItemType Directory -Force output/vocadito_mejoras/antes | Out-Null; Copy-Item -LiteralPath audio/pitch.py -Destination output/vocadito_mejoras/antes/pitch.py; Copy-Item -LiteralPath desktop_live.py -Destination output/vocadito_mejoras/antes/desktop_live.py; Copy-Item -LiteralPath scripts/evaluar_vocadito.py -Destination output/vocadito_mejoras/antes/evaluar_vocadito.py; Get-Content audio/pitch.py | Select-Object -Skip 435 -First 17"}], "aggregatedOutput": "    if pw is not None:\r\n        y = y.astype(np.float64)\r\n        f0, t = pw.dio(y, sr)\r\n        f0 = pw.stonemask(y, f0, t, sr)\r\n    else:\r\n        f0, voiced_flag, voiced_prob = librosa.pyin(\r\n            y,\r\n            fmin=librosa.note_to_hz(\"C2\"),\r\n            fmax=librosa.note_to_hz(\"C7\"),\r\n        )\r\n        t = librosa.times_like(f0, sr=sr)\r\n        f0 = np.nan_to_num(f0, nan=0.0)\r\n    return t, f0\r\n\r\n\r\ndef extraer_pitch_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n", "exitCode": 0, "durationMs": 451}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-4b4f1d60-8fdf-443a-8c07-e479931cbcfb", "rollout_ordinal": 461, "created_at_ms": 1790648716059, "item_type": "fileChange", "updated_at_ordinal": 461, "started_at_ms": 1790648716059, "completed_at_ms": 1790648716061}, "item": {"type": "fileChange", "id": "exec-4b4f1d60-8fdf-443a-8c07-e479931cbcfb", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\pitch.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -31,2 +31,3 @@\n     \"max_salto_midi\": 8,\n+    \"min_periodicidad\": 0.7,\n }\n@@ -132,3 +133,4 @@\n \n-def _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False):\n+def _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False,\n+                             periodicidad=None):\n     config = config or FILTRO_TIEMPO_REAL\n@@ -154,3 +156,11 @@\n \n+    periodicos = None\n+    if periodicidad is not None:\n+        periodicos = np.asarray(periodicidad) >= config.get(\"min_periodicidad\", 0.7)\n+        f0[~periodicos] = 0\n+\n     f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\n+    # Un hueco rechazado por falta de periodicidad no debe volver a ser una nota.\n+    if periodicos is not None:\n+        f0[~periodicos] = 0\n     f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\n@@ -348,2 +358,31 @@\n \n+def _periodicidad_candidatos(y, sr, f0, frame_length, hop_length):\n+    \"\"\"Similitud normalizada de cada frame con una copia desplazada un periodo.\n+\n+    YIN puede devolver un candidato incluso para ruido. Esta comprobacion es\n+    independiente del volumen: resta DC y compara la energia de ambas copias.\n+    No interpreta la similitud como una probabilidad estadistica.\n+    \"\"\"\n+    confianza = np.zeros(len(f0), dtype=float)\n+    for i, frecuencia in enumerate(f0):\n+        if not np.isfinite(frecuencia) or frecuencia <= 0:\n+            continue\n+        frame = np.asarray(y[i * hop_length:i * hop_length + frame_length], dtype=float)\n+        if len(frame) != frame_length:\n+            continue\n+        frame = frame - np.mean(frame)\n+        periodo = sr / frecuencia\n+        lag = int(np.floor(periodo))\n+        if lag < 1 or lag + 1 >= frame_length:\n+            continue\n+        # Interpolacion del desplazamiento para no penalizar periodos no enteros.\n+        fraccion = periodo - lag\n+        original = frame[:frame_length - lag - 1]\n+        desplazado = (1 - fraccion) * frame[lag:-1] + fraccion * frame[lag + 1:]\n+        energia = np.dot(original, original) + np.dot(desplazado, desplazado)\n+        if energia > np.finfo(float).tiny:\n+            confianza[i] = np.clip(2 * np.dot(original, desplazado) / energia, 0, 1)\n+    return confianza\n+\n+\n def extraer_pitch_ligero_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\n@@ -405,2 +444,3 @@\n         devolver_info=devolver_info,\n+        periodicidad=_periodicidad_candidatos(y, sr, f0, frame_length, hop_length),\n     )\n@@ -424,2 +464,3 @@\n             y,\n+            sr=sr,\n             fmin=librosa.note_to_hz(\"C2\"),\n@@ -442,2 +483,3 @@\n             y,\n+            sr=sr,\n             fmin=librosa.note_to_hz(\"C2\"),\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "rs_06f6aa8593d2a892016abb21937b4487d29a19251425f73b97", "rollout_ordinal": 464, "created_at_ms": 1790648724946, "item_type": "reasoning", "updated_at_ordinal": 464, "started_at_ms": 1790648724946, "completed_at_ms": 1790648726373}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb21937b4487d29a19251425f73b97", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-496b9aa6-8a8b-4a87-bf3b-715839d495f5", "rollout_ordinal": 468, "created_at_ms": 1790648728159, "item_type": "commandExecution", "updated_at_ordinal": 468, "started_at_ms": 1790648728159, "completed_at_ms": 1790648728517}, "item": {"type": "commandExecution", "id": "exec-496b9aa6-8a8b-4a87-bf3b-715839d495f5", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"rg -n -C 4 'periodicidad|periodicos|sr=sr' audio/pitch.py\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "91424", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "rg -n -C 4 'periodicidad|periodicos|sr=sr' audio/pitch.py"}], "aggregatedOutput": "28-    \"max_gap\": 1,\n29-    \"min_frames\": 3,\n30-    \"ventana_mediana\": 3,\n31-    \"max_salto_midi\": 8,\n32:    \"min_periodicidad\": 0.7,\n33-}\n34-\n35-\n36-def _rellenar_huecos_cortos(f0, max_gap):\n--\n85-    f_max = librosa.note_to_hz(config[\"nota_max\"])\n86-    f0[(f0 < f_min) | (f0 > f_max)] = 0\n87-\n88-    rms = librosa.feature.rms(y=y, frame_length=2048, hop_length=512)[0]\n89:    t_rms = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=512)\n90-    energia = np.interp(t, t_rms, rms, left=0, right=0)\n91-    umbral_energia = max(\n92-        np.percentile(rms, config[\"percentil_rms\"]) * config[\"factor_rms\"],\n93-        np.max(rms) * config[\"factor_rms_max\"],\n--\n131-    return np.sqrt(np.maximum(energia, 0.0))\n132-\n133-\n134-def _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False,\n135:                             periodicidad=None):\n136-    config = config or FILTRO_TIEMPO_REAL\n137-    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\n138-    t = np.asarray(t, dtype=float)\n139-    raw_points = int(np.sum(f0 > 0))\n--\n153-        if ruido_base is not None and ruido_base > 0:\n154-            umbral_energia = max(umbral_energia, float(ruido_base) * config[\"factor_ruido\"])\n155-        f0[energia < umbral_energia] = 0\n156-\n157:    periodicos = None\n158:    if periodicidad is not None:\n159:        periodicos = np.asarray(periodicidad) >= config.get(\"min_periodicidad\", 0.7)\n160:        f0[~periodicos] = 0\n161-\n162-    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\n163:    # Un hueco rechazado por falta de periodicidad no debe volver a ser una nota.\n164:    if periodicos is not None:\n165:        f0[~periodicos] = 0\n166-    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\n167-\n168-    mask = f0 > 0\n169-    if np.sum(mask) >= config[\"ventana_mediana\"]:\n--\n355-        return 0.0\n356-    return float(sr / lag)\n357-\n358-\n359:def _periodicidad_candidatos(y, sr, f0, frame_length, hop_length):\n360-    \"\"\"Similitud normalizada de cada frame con una copia desplazada un periodo.\n361-\n362-    YIN puede devolver un candidato incluso para ruido. Esta comprobacion es\n363-    independiente del volumen: resta DC y compara la energia de ambas copias.\n--\n407-        f0 = librosa.yin(\n408-            y.astype(float, copy=False),\n409-            fmin=f_min,\n410-            fmax=f_max,\n411:            sr=sr,\n412-            frame_length=frame_length,\n413-            hop_length=hop_length,\n414-            center=False,\n415-            trough_threshold=0.15,\n--\n441-        y,\n442-        sr,\n443-        ruido_base=ruido_base,\n444-        devolver_info=devolver_info,\n445:        periodicidad=_periodicidad_candidatos(y, sr, f0, frame_length, hop_length),\n446-    )\n447-    if devolver_info:\n448-        t_filtrado, f_filtrado, info = resultado\n449-        return t_filtrado + offset_t, f_filtrado, info\n--\n461-        f0 = pw.stonemask(y, f0, t, sr)\n462-    else:\n463-        f0, voiced_flag, voiced_prob = librosa.pyin(\n464-            y,\n465:            sr=sr,\n466-            fmin=librosa.note_to_hz(\"C2\"),\n467-            fmax=librosa.note_to_hz(\"C7\"),\n468-        )\n469:        t = librosa.times_like(f0, sr=sr)\n470-        f0 = np.nan_to_num(f0, nan=0.0)\n471-\n472-    mask = f0 > 0\n473-    return t[mask], f0[mask]\n--\n480-        f0 = pw.stonemask(y, f0, t, sr)\n481-    else:\n482-        f0, voiced_flag, voiced_prob = librosa.pyin(\n483-            y,\n484:            sr=sr,\n485-            fmin=librosa.note_to_hz(\"C2\"),\n486-            fmax=librosa.note_to_hz(\"C7\"),\n487-        )\n488:        t = librosa.times_like(f0, sr=sr)\n489-        f0 = np.nan_to_num(f0, nan=0.0)\n490-    return t, f0\n491-\n492-\n", "exitCode": 0, "durationMs": 358}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "rs_06f6aa8593d2a892016abb219972cc87d2b70f1eb43133b757", "rollout_ordinal": 471, "created_at_ms": 1790648730843, "item_type": "reasoning", "updated_at_ordinal": 471, "started_at_ms": 1790648730843, "completed_at_ms": 1790648745222}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb219972cc87d2b70f1eb43133b757", "summary": ["**Preparing baseline code wrapper**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "msg_06f6aa8593d2a892016abb21a7c20487d2b091381e26de4c11", "rollout_ordinal": 473, "created_at_ms": 1790648745256, "item_type": "agentMessage", "updated_at_ordinal": 473, "started_at_ms": 1790648745256, "completed_at_ms": 1790648747376}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb21a7c20487d2b091381e26de4c11", "text": "La corrección de pYIN ya está aplicada. Para YIN estoy añadiendo una comprobación de periodicidad: que el sonido tenga un patrón repetitivo compatible con una nota. Probaré unos pocos umbrales en un grupo fijo de cantantes y luego evaluaré el elegido en los demás, vigilando que no descarte demasiadas notas válidas.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf9-c67b-7040-a527-db145ff6b2cc", "item_id": "exec-f3a23328-543c-4f3c-abb5-a3b82fa72d3b", "rollout_ordinal": 477, "created_at_ms": 1790648835496, "item_type": "fileChange", "updated_at_ordinal": 477, "started_at_ms": 1790648835496, "completed_at_ms": 1790648835499}, "item": {"type": "fileChange", "id": "exec-f3a23328-543c-4f3c-abb5-a3b82fa72d3b", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\comparar_live_vocadito.py", "kind": {"type": "add"}, "diff": "\"\"\"Comparacion del detector anterior y nuevo, con ambas configuraciones de UI.\n\n--development selecciona un umbral solo usando cantantes S1 a S8.\nSin esa opcion evalua todos los audios sin seleccionar parametros.\nLa particion restante es una comprobacion interna: Vocadito ya se inspecciono\nen la evaluacion inicial y no se presenta como un test externo independiente.\n\"\"\"\nimport argparse\nimport ast\nimport csv\nimport hashlib\nimport importlib.util\nimport json\nfrom pathlib import Path\nimport sys\nimport time\nfrom types import SimpleNamespace\n\nimport numpy as np\nimport soundfile as sf\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT))\nfrom audio import pitch\nfrom scripts.evaluar_vocadito import align, counts, percentages\n\nOUT = ROOT / 'output/vocadito_mejoras'\nDATA = ROOT / 'data/vocadito_benchmark'\nDEVELOPMENT = {f'S{i}' for i in range(1, 9)}\n\n\ndef load_before():\n    path = OUT / 'antes/pitch.py'\n    spec = importlib.util.spec_from_file_location('pitch_before', path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\ndef ui_policy():\n    # Extrae del codigo real solo las constantes y el filtro de puntos.\n    # No importa la GUI, no abre dispositivos ni crea hilos.\n    tree = ast.parse((ROOT / 'desktop_live.py').read_text(encoding='utf-8'))\n    constants = {}\n    for node in tree.body:\n        if isinstance(node, ast.Assign):\n            for target in node.targets:\n                if isinstance(target, ast.Name) and target.id.startswith('LIVE_'):\n                    constants[target.id] = ast.literal_eval(node.value)\n    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'LiveBackend')\n    method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == '_aceptar_punto_usuario')\n    scope = dict(constants)\n    exec(compile(ast.Module(body=[method], type_ignores=[]), 'desktop_live_policy', 'exec'), scope)\n    return constants, scope['_aceptar_punto_usuario']\n\n\ndef simulate(y, sr, detector, interval, window, accept=None):\n    ts, fs, elapsed = [], [], []\n    last = 0.\n    state = SimpleNamespace(_ultimo_punto_usuario=None)\n    for end in np.arange(interval, len(y) / sr, interval):\n        start = max(0., end - window)\n        tic = time.perf_counter()\n        t, f = detector(y[int(start * sr):int(end * sr)], sr, offset_t=start, ruido_base=None)\n        new = t > last\n        if np.any(new):\n            last = float(t[new].max())\n            for ti, fi in zip(t[new], f[new]):\n                if accept is None or accept(state, [float(ti), float(69 + 12 * np.log2(fi / 440))]):\n                    ts.append(ti); fs.append(fi)\n        elapsed.append(time.perf_counter() - tic)\n    return np.asarray(ts), np.asarray(fs), elapsed\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--development', action='store_true')\n    args = parser.parse_args()\n    before = load_before()\n    config, accept = ui_policy()\n    metadata = list(csv.DictReader((DATA / 'vocadito_metadata.csv').open(encoding='utf-8')))\n    if args.development:\n        metadata = [r for r in metadata if r['singer_id'] in DEVELOPMENT]\n    variants = ['antes', '0.6', '0.7', '0.8'] if args.development else ['antes', 'despues']\n    profiles = ['desktop'] if args.development else ['clasica', 'desktop']\n    rows = []\n    timings = {}\n    warm = .1 * np.sin(2 * np.pi * 220 * np.arange(16758) / 44100)\n    before.extraer_pitch_ligero_desde_audio(warm, 44100)\n    pitch.extraer_pitch_ligero_desde_audio(warm, 44100)\n    pred_dir = OUT / 'live_predicciones'\n    if not args.development:\n        pred_dir.mkdir(parents=True, exist_ok=True)\n    for n, row in enumerate(metadata, 1):\n        name = 'vocadito_' + row['track_id']\n        y, sr = sf.read(DATA / 'Audio' / (name + '.wav'), dtype='float32')\n        rt, ref = np.loadtxt(DATA / 'Annotations/F0' / (name + '_f0.csv'), delimiter=',').T\n        preds = {'time': rt, 'reference': ref}\n        result = {'track': name, 'singer': row['singer_id'],\n                  'split': 'development' if row['singer_id'] in DEVELOPMENT else 'validation', 'metrics': {}}\n        for profile in profiles:\n            interval, window, policy = (.06, .38, None) if profile == 'clasica' else (\n                config['LIVE_PITCH_INTERVAL'], config['LIVE_PITCH_CHUNK'], accept)\n            for variant in variants:\n                module = before if variant == 'antes' else pitch\n                if args.development and variant != 'antes':\n                    module.FILTRO_TIEMPO_REAL['min_periodicidad'] = float(variant)\n                t, f, durations = simulate(y, sr, module.extraer_pitch_ligero_desde_audio, interval, window, policy)\n                est = align(t, f, rt, 1024 / sr / 2)\n                key = profile + '_' + variant\n                c, _ = counts(ref, est)\n                preds[key] = est\n                result['metrics'][key] = {**percentages(c), 'counts': c}\n                timings.setdefault(key, []).extend(durations)\n        rows.append(result)\n        if not args.development:\n            np.savez_compressed(pred_dir / (name + '.npz'), **preds)\n        print(f'{n}/{len(metadata)} {name}', flush=True)\n    totals = {}\n    for group in ['all', 'development', 'validation']:\n        subset = [r for r in rows if group == 'all' or r['split'] == group]\n        if not subset:\n            continue\n        totals[group] = {}\n        for key in subset[0]['metrics']:\n            pooled = {field: sum(r['metrics'][key]['counts'][field] for r in subset)\n                      for field in subset[0]['metrics'][key]['counts']}\n            totals[group][key] = {**percentages(pooled), 'counts': pooled}\n    summary = {'development_singers': sorted(DEVELOPMENT), 'tracks': len(rows),\n               'desktop_config': config, 'config_live': dict(pitch.FILTRO_TIEMPO_REAL),\n               'pitch_sha256': hashlib.sha256((ROOT / 'audio/pitch.py').read_bytes()).hexdigest(),\n               'before_sha256': hashlib.sha256((OUT / 'antes/pitch.py').read_bytes()).hexdigest(),\n               'ui_sha256': hashlib.sha256((ROOT / 'desktop_live.py').read_bytes()).hexdigest(),\n               'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n               'summary': totals, 'per_track': rows,\n               'timing_ms': {k: {'median': float(np.median(v)*1000), 'p95': float(np.percentile(v,95)*1000)}\n                             for k, v in timings.items()}}\n    if args.development:\n        # Objetivo fijado antes de mirar los resultados: reducir falsos positivos\n        # sin perder mas de 2 puntos de acierto ni aumentar omisiones mas de 2 puntos.\n        baseline = totals['all']['desktop_antes']\n        eligible = [v for v in variants[1:]\n                    if totals['all']['desktop_' + v]['pitch_correct_50c_pct'] >= baseline['pitch_correct_50c_pct'] - 2\n                    and totals['all']['desktop_' + v]['missed_voiced_pct'] <= baseline['missed_voiced_pct'] + 2]\n        summary['selected_threshold'] = min(eligible, key=lambda v: totals['all']['desktop_' + v]['false_voiced_pct']) if eligible else None\n    name = 'desarrollo_live.json' if args.development else 'comparacion_live.json'\n    (OUT / name).write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding='utf-8')\n    print(json.dumps({'summary': totals, 'selected_threshold': summary.get('selected_threshold')}, indent=2))\n\n\nif __name__ == '__main__':\n    main()\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\tests\\test_pitch.py", "kind": {"type": "add"}, "diff": "\"\"\"Regresiones de frecuencia de muestreo y rechazo de senales no tonales.\"\"\"\nimport tempfile\nfrom pathlib import Path\nimport unittest\nfrom unittest.mock import patch\n\nimport numpy as np\nimport soundfile as sf\nfrom audio import pitch\n\n\ndef tone(sr, hz=440, amplitude=.1, duration=.4):\n    return amplitude * np.sin(2*np.pi*hz*np.arange(int(sr*duration))/sr)\n\n\nclass PitchTests(unittest.TestCase):\n    def test_pyin_sample_rates_and_file_entrypoint(self):\n        with patch.object(pitch, 'pw', None):\n            for sr in [22050, 44100, 48000]:\n                with self.subTest(sr=sr):\n                    _, f = pitch._extraer_pitch_base(tone(sr), sr)\n                    self.assertLess(abs(np.median(f[f > 0])-440), 2)\n            with tempfile.TemporaryDirectory() as folder:\n                path = Path(folder) / 'tone.wav'\n                sf.write(path, tone(44100), 44100, subtype='FLOAT')\n                _, f = pitch.extraer_pitch_crudo(str(path))\n                self.assertLess(abs(np.median(f)-440), 2)\n\n    def test_live_silence_and_noise_are_not_notes(self):\n        rng = np.random.default_rng(42)\n        for y in [np.zeros(16758), rng.normal(0, .05, 16758)]:\n            _, f = pitch.extraer_pitch_ligero_desde_audio(y, 44100)\n            self.assertEqual(len(f), 0)\n\n    def test_live_soft_and_loud_tones_keep_pitch(self):\n        for amp in [.005, .1]:\n            t, f = pitch.extraer_pitch_ligero_desde_audio(tone(44100, amplitude=amp), 44100, offset_t=2)\n            self.assertGreater(len(f), 8)\n            self.assertTrue(np.all(t >= 2))\n            self.assertLess(abs(np.median(f)-440), 2)\n\n    def test_rejected_periodicity_is_not_gap_filled(self):\n        t = np.arange(9) * .025 + .05\n        f = np.full(9, 440.)\n        confidence = np.ones(9); confidence[4] = 0\n        ts, _ = pitch._filtrar_pitch_tiempo_real(t, f, tone(44100), 44100, periodicidad=confidence)\n        self.assertFalse(np.any(np.isclose(ts, t[4])))\n\n    def test_fallback_rejects_noise(self):\n        with patch.object(pitch.librosa, 'yin', side_effect=RuntimeError('forced fallback')):\n            _, f = pitch.extraer_pitch_ligero_desde_audio(np.random.default_rng(7).normal(0, .05, 16758), 44100)\n            self.assertEqual(len(f), 0)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"}], "status": "completed"}}
