{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-d608448f-72d4-4483-b5d1-bef968bbada7", "rollout_ordinal": 382, "created_at_ms": 1790648156627, "item_type": "fileChange", "updated_at_ordinal": 382, "started_at_ms": 1790648156627, "completed_at_ms": 1790648156629}, "item": {"type": "fileChange", "id": "exec-d608448f-72d4-4483-b5d1-bef968bbada7", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\informe_vocadito.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -50,3 +50,6 @@\n     'sistemático de frecuencia. Un control independiente con una sinusoide de 440 Hz '\n-    'a 44.100 Hz produjo aproximadamente 220 Hz en la ruta actual.', '',\n+    'a 44.100 Hz produjo aproximadamente 220 Hz en la ruta actual. '\n+    'La misma llamada con `sr=sr` explícito devolvió 440 Hz. '\n+    'El control reproducible está en `scripts/diagnostico_sr_pyin.py` y sus valores '\n+    'en `diagnostico_sr.json`; no equivale a evaluar la corrección sobre todo Vocadito.', '',\n     'La ruta YIN ligera sí proporciona `sr=sr`. El fallo anterior no se atribuye '\n@@ -102,3 +105,4 @@\n     'Se utilizó el Python 3.14 disponible, con versiones registradas en `resultados.json`.', '',\n-    '```powershell', 'python scripts/evaluar_vocadito.py', 'python scripts/informe_vocadito.py', '```', '',\n+    '```powershell', 'python scripts/evaluar_vocadito.py', 'python scripts/diagnostico_sr_pyin.py',\n+    'python scripts/informe_vocadito.py', '```', '',\n     'La carpeta `data/vocadito_benchmark` debe contener el ZIP oficial v3 y sus carpetas '\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-dfd93c08-d6d5-43a5-9679-b1922a79da36", "rollout_ordinal": 384, "created_at_ms": 1790648157168, "item_type": "commandExecution", "updated_at_ordinal": 384, "started_at_ms": 1790648157168, "completed_at_ms": 1790648158873}, "item": {"type": "commandExecution", "id": "exec-dfd93c08-d6d5-43a5-9679-b1922a79da36", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'python scripts/informe_vocadito.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "43931", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python scripts/informe_vocadito.py"}], "aggregatedOutput": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\output\\vocadito_benchmark\\informe.md\r\n", "exitCode": 0, "durationMs": 1705}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "exec-811948db-db3c-4b51-bd5e-d4efa3c86ef0", "rollout_ordinal": 385, "created_at_ms": 1790648158895, "item_type": "mcpToolCall", "updated_at_ordinal": 385, "started_at_ms": 1790648158895, "completed_at_ms": 1790648159030}, "item": {"type": "mcpToolCall", "id": "exec-811948db-db3c-4b51-bd5e-d4efa3c86ef0", "server": "codex_app", "tool": "open_in_codex", "status": "completed", "arguments": {"target": {"type": "file", "path": "C:/Users/Diego Tapia/Desktop/Pene/U/Tesis/tesis_karaoke/output/vocadito_benchmark/informe.md"}}, "appContext": null, "mcpAppUi": null, "pluginId": "codex-app-tools@openai-bundled", "readOnlyHint": null, "result": {"content": [{"type": "text", "text": "{\"status\":\"queued\",\"threadId\":\"01a08154-4c27-7551-9cfa-e8e7d2bcf73a\"}"}], "structuredContent": null, "_meta": null}, "error": null, "durationMs": 134}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eadc-b17d-7dd2-8950-d8d1145e8e9a", "item_id": "msg_06f6aa8593d2a892016abb1f61976087d2b4d446b0b2fe4e0e", "rollout_ordinal": 388, "created_at_ms": 1790648163044, "item_type": "agentMessage", "updated_at_ordinal": 388, "started_at_ms": 1790648163044, "completed_at_ms": 1790648173092}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb1f61976087d2b4d446b0b2fe4e0e", "text": "Sí. Evalué **las 40 grabaciones de Vocadito: 13,62 minutos de audio**, sin modificar el detector.\n\n| Ruta actual | Aciertos dentro de ±50 cents | Falsas detecciones en frames sin F0 |\n|---|---:|---:|\n| YIN, simulación del modo en vivo | **95,84 %** | **50,37 %** |\n| pYIN, salida final con filtros | **0,76 %** | **17,36 %** |\n\n**Encontré un error concreto en pYIN:** falta pasar `sr=sr`. Interpreta audio de 44.100 Hz como si fuera de 22.050 Hz. Lo confirmé con un tono de 440 Hz: devuelve 220 Hz; pasando el parámetro correctamente devuelve 440 Hz.\n\nYIN detecta bien la altura cuando hay voz tonal, pero necesita mejorar el rechazo de segmentos sin F0.\n\nDejé el [informe con resultados y gráficas](</C:/Users/Diego Tapia/Desktop/Pene/U/Tesis/tesis_karaoke/output/vocadito_benchmark/informe.md>) y el [script para repetir la evaluación](</C:/Users/Diego Tapia/Desktop/Pene/U/Tesis/tesis_karaoke/scripts/evaluar_vocadito.py>).\n\n**El próximo paso es corregir ese parámetro y repetir la prueba.** WORLD no se evaluó porque no está instalado en el Python disponible; el modo en vivo se simuló sin micrófono ni calibración ambiental.", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf4-e9bc-7663-81b6-e532f4dd243b", "item_id": "01a0eaf4-ea69-7490-8c9a-7d186e90a01d", "rollout_ordinal": 397, "created_at_ms": 1790648314491, "item_type": "userMessage", "updated_at_ordinal": 397, "started_at_ms": 1790648314491, "completed_at_ms": 1790648314491}, "item": {"type": "userMessage", "id": "01a0eaf4-ea69-7490-8c9a-7d186e90a01d", "clientId": "225f66dd-3479-4773-9262-76aaed38d8f9", "content": [{"type": "text", "text": "no entendí muy bien los resultados obtenidos, explicalos más en simple\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf4-e9bc-7663-81b6-e532f4dd243b", "item_id": "msg_06f6aa8593d2a892016abb1ffbe1a087d2bc7f9fb030c365fb", "rollout_ordinal": 398, "created_at_ms": 1790648317276, "item_type": "agentMessage", "updated_at_ordinal": 398, "started_at_ms": 1790648317276, "completed_at_ms": 1790648329803}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb1ffbe1a087d2bc7f9fb030c365fb", "text": "La prueba consistió en darle a tu programa **40 grabaciones de personas cantando** y comparar sus respuestas con las frecuencias anotadas en Vocadito.\n\nTu programa usa dos métodos, y encontramos cosas distintas:\n\n**1. El método del modo en vivo, YIN, reconoce bastante bien la nota cuando la persona canta.**\n\nDe cada 100 momentos en los que había una frecuencia definida, acertó aproximadamente **96**, aceptando un margen de medio semitono.\n\nEl problema aparece cuando **no hay una nota que detectar**, por ejemplo en una pausa o una consonante: en aproximadamente **50 de cada 100 de esos momentos**, el programa igualmente indicó una frecuencia.\n\nEs decir: **reconoce bien las notas, pero le cuesta saber cuándo no debería mostrar ninguna.** Esto podría explicar puntos o notas extrañas entre las frases cantadas.\n\n**2. El otro método, pYIN, tiene un error en cómo recibe el audio.**\n\nEn la prueba, interpretó la frecuencia de muestreo como la mitad de la real. Es parecido a reproducir una grabación a la mitad de velocidad: todo suena más grave.\n\nPor ejemplo:\n\n- La frecuencia correcta era **440 Hz**, un La.\n- El programa respondió **220 Hz**, también un La, pero **una octava más abajo**.\n\nAunque reconoce una forma parecida a la melodía, está en la octava equivocada. Por eso obtuvo menos del 1 % de aciertos: la evaluación exige acertar también la octava.\n\n**Qué significa para tu proyecto:** no hace falta concluir que todo el algoritmo funciona mal. Primero hay que corregir ese error de pYIN y repetir la prueba. Después conviene mejorar YIN para que deje de mostrar notas donde no corresponde.\n\nEstos resultados son de grabaciones de voz sola. Todavía no indican cómo rendirá con música de fondo y ruido del micrófono.", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf6-882d-7a71-bd79-3ba604c997ea", "item_id": "01a0eaf6-88d2-7900-bab3-edda915032b0", "rollout_ordinal": 407, "created_at_ms": 1790648420578, "item_type": "userMessage", "updated_at_ordinal": 407, "started_at_ms": 1790648420578, "completed_at_ms": 1790648420579}, "item": {"type": "userMessage", "id": "01a0eaf6-88d2-7900-bab3-edda915032b0", "clientId": "63f7058c-35d8-4d25-b6ec-03c696753574", "content": [{"type": "text", "text": "como podemos utilizar esta información para mejorar el analisis?\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf6-882d-7a71-bd79-3ba604c997ea", "item_id": "rs_06f6aa8593d2a892016abb20662d0887d282ae60c53e7f607a", "rollout_ordinal": 408, "created_at_ms": 1790648423571, "item_type": "reasoning", "updated_at_ordinal": 408, "started_at_ms": 1790648423571, "completed_at_ms": 1790648424800}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abb20662d0887d282ae60c53e7f607a", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf6-882d-7a71-bd79-3ba604c997ea", "item_id": "msg_06f6aa8593d2a892016abb20675e1887d29c3ce4dd3d2df4af", "rollout_ordinal": 410, "created_at_ms": 1790648424838, "item_type": "agentMessage", "updated_at_ordinal": 410, "started_at_ms": 1790648424838, "completed_at_ms": 1790648436986}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb20675e1887d29c3ce4dd3d2df4af", "text": "Podemos usar los resultados para **corregir problemas concretos y comprobar si cada cambio mejora el análisis**. Haría esto en este orden:\n\n**1. Corregir la frecuencia de muestreo en pYIN.**  \nEs el primer paso porque actualmente puede interpretar las notas una octava más abajo. Después repetimos la prueba con Vocadito: ese resultado será una base válida para decidir qué otros ajustes necesita.\n\n**2. Mejorar cuándo el sistema acepta una nota.**  \nYIN suele acertar cuando hay canto, pero también devuelve frecuencias donde no debería. Podemos combinar:\n\n- **Volumen:** comprobar que la señal supera el ruido ambiental.\n- **Periodicidad:** comprobar si el sonido tiene un patrón repetitivo compatible con una nota.\n- **Continuidad:** revisar si la estimación se mantiene durante varios instantes.\n\nNo bastaría con subir el umbral de volumen: podríamos eliminar notas cantadas suavemente. Tampoco debemos exigir demasiada estabilidad, porque perderíamos vibratos o notas cortas.\n\n**3. Usar las grabaciones problemáticas para entender los errores.**  \nCompararíamos la referencia con lo que detecta tu programa para distinguir tres situaciones: nota equivocada, nota omitida y nota inventada. Cada una necesita un ajuste diferente.\n\n**4. Comparar cada cambio con la versión anterior.**  \nLa meta sería **reducir las falsas detecciones conservando una precisión cercana al 96 % que vimos en los momentos con F0**. También mediríamos si el cambio añade demora al modo en vivo.\n\nPara evitar ajustar el programa únicamente a Vocadito, usaríamos una parte para desarrollar las mejoras y comprobaríamos el resultado en grabaciones reservadas o en otro dataset, como MIR-1K.\n\nEl beneficio para el karaoke sería una referencia mejor calculada y menos notas falsas entre frases. Eso también ayudaría a que la comparación de afinación y el puntaje reflejen mejor lo que realmente cantó el usuario.", "phase": "final_answer", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf8-3a8d-7550-bf58-4c1f6e794551", "item_id": "01a0eaf8-3b2e-7890-ae44-e494f69d42a6", "rollout_ordinal": 419, "created_at_ms": 1790648531770, "item_type": "userMessage", "updated_at_ordinal": 419, "started_at_ms": 1790648531770, "completed_at_ms": 1790648531770}, "item": {"type": "userMessage", "id": "01a0eaf8-3b2e-7890-ae44-e494f69d42a6", "clientId": "340c48a2-44f6-483c-b412-4b6ce88f40fe", "content": [{"type": "text", "text": "solo para asegurarme, la aplicación por ahora tiene 2 interfaces gráficas, pero el backend es solo 1 verdad? el algoritmo y el almacenamiento de datos es solo 1?\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf8-3a8d-7550-bf58-4c1f6e794551", "item_id": "msg_06f6aa8593d2a892016abb20d4980087d2bb659365906353de", "rollout_ordinal": 420, "created_at_ms": 1790648534075, "item_type": "agentMessage", "updated_at_ordinal": 420, "started_at_ms": 1790648534075, "completed_at_ms": 1790648535089}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abb20d4980087d2bb659365906353de", "text": "Voy a revisar cómo ambas interfaces llaman al procesamiento de audio y dónde guardan los datos para confirmártelo.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eaf8-3a8d-7550-bf58-4c1f6e794551", "item_id": "exec-c550b01e-4475-48ac-ac66-b609d9c9a642", "rollout_ordinal": 424, "created_at_ms": 1790648539777, "item_type": "commandExecution", "updated_at_ordinal": 424, "started_at_ms": 1790648539777, "completed_at_ms": 1790648540311}, "item": {"type": "commandExecution", "id": "exec-c550b01e-4475-48ac-ac66-b609d9c9a642", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content app.py -TotalCount 130; Get-Content desktop_live.py -TotalCount 90; Get-Content audio/catalogo.py -TotalCount 180; rg -n --glob '*.py' --glob '\"'!venv/**'\"' --glob '\"'!docs/**'\"' --glob '\"'!scripts/**'\"' '\"'^(from audio|import audio)|extraer_pitch|carpeta_|sqlite|json.dump|to_csv|sf.write|guardar|comparar'\"\\\\(' app.py desktop_live.py audio ui_live main.py\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "34724", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content app.py -TotalCount 130; Get-Content desktop_live.py -TotalCount 90; Get-Content audio/catalogo.py -TotalCount 180; rg -n --glob '*.py' --glob '!venv/**' --glob '!docs/**' --glob '!scripts/**' '^(from audio|import audio)|extraer_pitch|carpeta_|sqlite|json.dump|to_csv|sf.write|guardar|comparar\\(' app.py desktop_live.py audio ui_live main.py"}], "aggregatedOutput": "import os\r\nimport threading\r\nimport time\r\nimport tkinter as tk\r\nfrom tkinter import filedialog, messagebox, simpledialog, ttk\r\n\r\nfrom matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\r\nfrom matplotlib.figure import Figure\r\n\r\nfrom audio.catalogo import (\r\n    agregar_cancion,\r\n    cargar_canciones,\r\n    eliminar_cancion,\r\n    leer_pitch_csv,\r\n    regenerar_pitch_referencia,\r\n)\r\nfrom audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\r\nfrom audio.visualizacion import (\r\n    aplicar_vista_detalle,\r\n    actualizar_usuario_tiempo_real,\r\n    actualizar_ventana_cursor,\r\n    configurar_grafico_diagnostico,\r\n    configurar_grafico_esperado,\r\n    configurar_grafico_notas,\r\n    rango_midi_grafico,\r\n)\r\n\r\n\r\nclass KaraokeApp(tk.Tk):\r\n    def __init__(self):\r\n        super().__init__()\r\n        self.title(\"Karaoke Afinacion\")\r\n        self.geometry(\"1080x680\")\r\n        self.minsize(920, 560)\r\n\r\n        self.canciones = []\r\n        self.cancion_actual = None\r\n        self.grabacion_actual = None\r\n        self.trabajando = False\r\n        self.grabando = False\r\n        self.detener_grabacion = threading.Event()\r\n        self.t_ref_actual = []\r\n        self.f_ref_actual = []\r\n        self.t_usr_tiempo_real = []\r\n        self.f_usr_tiempo_real = []\r\n        self.ventana_grafico = 12\r\n        self.ultimo_resultado_grafico = None\r\n        self.detalle_ventana_x = 12\r\n        self.detalle_rango_y = 14\r\n        self.detalle_x_inicio = 0\r\n        self.detalle_x_max = 0\r\n        self.detalle_y_inicio = 48\r\n        self.detalle_y_min = 48\r\n        self.detalle_y_max = 72\r\n        self.ultimo_redibujado = 0\r\n\r\n        self._crear_ui()\r\n        self.cargar_catalogo()\r\n\r\n    def _crear_ui(self):\r\n        contenedor = ttk.Frame(self, padding=16)\r\n        contenedor.pack(fill=tk.BOTH, expand=True)\r\n\r\n        panel_superior = ttk.Frame(contenedor)\r\n        panel_superior.pack(fill=tk.BOTH, expand=False)\r\n\r\n        panel_izq = ttk.Frame(panel_superior)\r\n        panel_izq.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)\r\n\r\n        ttk.Label(panel_izq, text=\"Canciones disponibles\").pack(anchor=tk.W)\r\n        self.lista = tk.Listbox(panel_izq, height=14)\r\n        self.lista.pack(fill=tk.BOTH, expand=True, pady=(6, 10))\r\n        self.lista.bind(\"<<ListboxSelect>>\", self.seleccionar_cancion)\r\n\r\n        botones_catalogo = ttk.Frame(panel_izq)\r\n        botones_catalogo.pack(fill=tk.X)\r\n        ttk.Button(botones_catalogo, text=\"Agregar cancion\", command=self.agregar_cancion).pack(\r\n            side=tk.LEFT\r\n        )\r\n        self.btn_eliminar = ttk.Button(\r\n            botones_catalogo,\r\n            text=\"Eliminar\",\r\n            command=self.eliminar_cancion,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_eliminar.pack(side=tk.LEFT, padx=(8, 0))\r\n        self.btn_reprocesar = ttk.Button(\r\n            botones_catalogo,\r\n            text=\"Reprocesar\",\r\n            command=self.reprocesar_cancion,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_reprocesar.pack(side=tk.LEFT, padx=(8, 0))\r\n        ttk.Button(botones_catalogo, text=\"Actualizar lista\", command=self.cargar_catalogo).pack(\r\n            side=tk.LEFT, padx=(8, 0)\r\n        )\r\n\r\n        panel_der = ttk.Frame(panel_superior, padding=(18, 0, 0, 0))\r\n        panel_der.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)\r\n\r\n        ttk.Label(panel_der, text=\"Cancion seleccionada\").pack(anchor=tk.W)\r\n        self.info = tk.StringVar(value=\"Selecciona una cancion para comenzar.\")\r\n        ttk.Label(panel_der, textvariable=self.info, justify=tk.LEFT, wraplength=320).pack(\r\n            anchor=tk.W, pady=(6, 14)\r\n        )\r\n\r\n        acciones = ttk.Frame(panel_der)\r\n        acciones.pack(fill=tk.X, pady=(0, 14))\r\n        self.btn_cantar = ttk.Button(\r\n            acciones,\r\n            text=\"Cantar y grabar\",\r\n            command=self.cantar,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_cantar.pack(fill=tk.X)\r\n        self.btn_detener = ttk.Button(\r\n            acciones,\r\n            text=\"Detener y comparar\",\r\n            command=self.detener_canto,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_detener.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_diagnostico = ttk.Button(\r\n            acciones,\r\n            text=\"Diagnosticar filtros\",\r\n            command=self.diagnosticar_filtros,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_diagnostico.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_ver_detalle = ttk.Button(\r\nimport os\r\nimport threading\r\nfrom pathlib import Path\r\n\r\nimport numpy as np\r\nimport sounddevice as sd\r\nimport soundfile as sf\r\nimport webview\r\n\r\nfrom audio.catalogo import (\r\n    agregar_cancion,\r\n    cargar_cancion,\r\n    cargar_canciones,\r\n    editar_cancion,\r\n    eliminar_cancion,\r\n    leer_pitch_csv,\r\n    regenerar_pitch_referencia,\r\n)\r\nfrom audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\r\nfrom audio.metricas import hz_to_midi\r\nfrom audio.pitch import extraer_pitch_ligero_desde_audio\r\nfrom audio.tomas import actualizar_toma, eliminar_toma, guardar_toma, listar_tomas\r\n\r\n\r\nLIVE_PITCH_INTERVAL = 0.10\r\nLIVE_PITCH_CHUNK = 0.24\r\nLIVE_MAX_JUMP_MIDI = 7\r\nLIVE_JUMP_RESET_SECONDS = 0.55\r\n\r\n\r\nclass LiveBackend:\r\n    def __init__(self):\r\n        self._lock = threading.Lock()\r\n        self._detener = threading.Event()\r\n        self._hilo = None\r\n        self._pitch_pendiente = []\r\n        self._ultimo_punto_usuario = None\r\n        self._estado = self._estado_inicial()\r\n        threading.Thread(target=self._calentar_pitch_tiempo_real, daemon=True).start()\r\n\r\n    def _estado_inicial(self):\r\n        return {\r\n            \"status\": \"idle\",\r\n            \"current\": 0.0,\r\n            \"duration\": 0.0,\r\n            \"song_id\": None,\r\n            \"recording_path\": None,\r\n            \"result\": None,\r\n            \"error\": None,\r\n            \"diagnostics\": self._diagnostico_inicial(),\r\n        }\r\n\r\n    def _diagnostico_inicial(self):\r\n        return {\r\n            \"noise_floor\": 0.0,\r\n            \"last_rms\": 0.0,\r\n            \"energy_threshold\": 0.0,\r\n            \"raw_points\": 0,\r\n            \"filtered_points\": 0,\r\n            \"accepted_points\": 0,\r\n            \"rejected_points\": 0,\r\n            \"rejected_jumps\": 0,\r\n            \"pitch_errors\": 0,\r\n        }\r\n\r\n    def get_songs(self):\r\n        return [self._cancion_para_ui(cancion) for cancion in cargar_canciones()]\r\n\r\n    def get_takes(self, song_id):\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            return [self._toma_para_ui(cancion, toma) for toma in listar_tomas(cancion)]\r\n        except Exception as exc:\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def edit_take(self, song_id, take_id, name=\"\"):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"editing\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            toma = actualizar_toma(cancion, take_id, nombre=name)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\nimport csv\r\nimport json\r\nimport os\r\nimport shutil\r\nimport uuid\r\nfrom datetime import datetime\r\n\r\nfrom audio.guardar import guardar_csv\r\nfrom audio.pitch import extraer_pitch\r\nfrom audio.separacion import preparar_pistas\r\n\r\n\r\nCATALOGO_DIR = \"canciones\"\r\nGRABACIONES_DIR = \"grabaciones\"\r\n\r\n\r\ndef asegurar_directorios():\r\n    os.makedirs(CATALOGO_DIR, exist_ok=True)\r\n    os.makedirs(GRABACIONES_DIR, exist_ok=True)\r\n\r\n\r\ndef _slug(texto):\r\n    limpio = \"\".join(c.lower() if c.isalnum() else \"_\" for c in texto.strip())\r\n    partes = [p for p in limpio.split(\"_\") if p]\r\n    return \"_\".join(partes) or \"cancion\"\r\n\r\n\r\ndef _metadata_path(cancion_id):\r\n    return os.path.join(CATALOGO_DIR, cancion_id, \"metadata.json\")\r\n\r\n\r\ndef guardar_metadata(metadata):\r\n    with open(_metadata_path(metadata[\"id\"]), \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(metadata, f, indent=2, ensure_ascii=False)\r\n\r\n\r\ndef cargar_canciones():\r\n    asegurar_directorios()\r\n    canciones = []\r\n    for nombre in os.listdir(CATALOGO_DIR):\r\n        metadata_path = _metadata_path(nombre)\r\n        if os.path.exists(metadata_path):\r\n            with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\r\n                canciones.append(json.load(f))\r\n    return sorted(canciones, key=lambda item: item.get(\"titulo\", \"\").lower())\r\n\r\n\r\ndef cargar_cancion(cancion_id):\r\n    with open(_metadata_path(cancion_id), \"r\", encoding=\"utf-8\") as f:\r\n        return json.load(f)\r\n\r\n\r\ndef eliminar_cancion(cancion_id):\r\n    asegurar_directorios()\r\n    metadata = cargar_cancion(cancion_id)\r\n\r\n    carpeta = os.path.join(CATALOGO_DIR, cancion_id)\r\n    demucs_dir = \"\"\r\n    original = metadata.get(\"original\") or \"\"\r\n    if original:\r\n        nombre_original = os.path.splitext(os.path.basename(original))[0]\r\n        demucs_dir = os.path.join(\"output\", \"htdemucs\", nombre_original)\r\n\r\n    grabaciones_dir = os.path.join(GRABACIONES_DIR, cancion_id)\r\n\r\n    for ruta in [carpeta, demucs_dir, grabaciones_dir]:\r\n        if ruta and os.path.exists(ruta):\r\n            shutil.rmtree(ruta)\r\n\r\n\r\ndef editar_cancion(cancion_id, titulo, artista=\"\"):\r\n    metadata = cargar_cancion(cancion_id)\r\n    metadata[\"titulo\"] = titulo\r\n    metadata[\"artista\"] = artista\r\n    guardar_metadata(metadata)\r\n    _actualizar_tomas_cancion(cancion_id, titulo, artista)\r\n    return metadata\r\n\r\n\r\ndef _actualizar_tomas_cancion(cancion_id, titulo, artista=\"\"):\r\n    grabaciones_dir = os.path.join(GRABACIONES_DIR, cancion_id)\r\n    if not os.path.isdir(grabaciones_dir):\r\n        return\r\n\r\n    for nombre in os.listdir(grabaciones_dir):\r\n        if not nombre.endswith(\"_toma.json\"):\r\n            continue\r\n        ruta = os.path.join(grabaciones_dir, nombre)\r\n        try:\r\n            with open(ruta, \"r\", encoding=\"utf-8\") as f:\r\n                toma = json.load(f)\r\n            toma[\"song_title\"] = titulo\r\n            toma[\"artist\"] = artista or \"Sin artista\"\r\n            with open(ruta, \"w\", encoding=\"utf-8\") as f:\r\n                json.dump(toma, f, indent=2, ensure_ascii=False)\r\n        except (OSError, json.JSONDecodeError):\r\n            continue\r\n\r\n\r\ndef agregar_cancion(ruta_audio, titulo, artista=\"\", forzar=False):\r\n    asegurar_directorios()\r\n    cancion_id = f\"{_slug(titulo)}_{uuid.uuid4().hex[:8]}\"\r\n    carpeta = os.path.join(CATALOGO_DIR, cancion_id)\r\n    os.makedirs(carpeta, exist_ok=True)\r\n\r\n    extension = os.path.splitext(ruta_audio)[1].lower() or \".wav\"\r\n    original_path = os.path.join(carpeta, f\"{cancion_id}{extension}\")\r\n    shutil.copy2(ruta_audio, original_path)\r\n\r\n    metadata = {\r\n        \"id\": cancion_id,\r\n        \"titulo\": titulo,\r\n        \"artista\": artista,\r\n        \"original\": original_path,\r\n        \"vocals\": \"\",\r\n        \"instrumental\": \"\",\r\n        \"pitch_referencia\": os.path.join(carpeta, \"ref_pitch.csv\"),\r\n        \"creada_en\": datetime.now().isoformat(timespec=\"seconds\"),\r\n        \"preparada\": False,\r\n    }\r\n    guardar_metadata(metadata)\r\n    return preparar_cancion(cancion_id, forzar=forzar)\r\n\r\n\r\ndef preparar_cancion(cancion_id, forzar=False):\r\n    metadata = cargar_cancion(cancion_id)\r\n    vocals_path, instrumental_path = preparar_pistas(\r\n        metadata[\"original\"],\r\n        forzar_separacion=forzar,\r\n    )\r\n\r\n    if forzar or not os.path.exists(metadata[\"pitch_referencia\"]):\r\n        tiempos, frecuencias = extraer_pitch(vocals_path)\r\n        guardar_csv(metadata[\"pitch_referencia\"], tiempos, frecuencias)\r\n\r\n    metadata[\"vocals\"] = vocals_path\r\n    metadata[\"instrumental\"] = instrumental_path\r\n    metadata[\"preparada\"] = True\r\n    guardar_metadata(metadata)\r\n    return metadata\r\n\r\n\r\ndef regenerar_pitch_referencia(cancion_id, forzar_separacion=False):\r\n    metadata = cargar_cancion(cancion_id)\r\n    vocals_path = metadata.get(\"vocals\") or \"\"\r\n\r\n    if forzar_separacion or not os.path.exists(vocals_path):\r\n        vocals_path, instrumental_path = preparar_pistas(\r\n            metadata[\"original\"],\r\n            forzar_separacion=forzar_separacion,\r\n        )\r\n        metadata[\"vocals\"] = vocals_path\r\n        metadata[\"instrumental\"] = instrumental_path\r\n\r\n    tiempos, frecuencias = extraer_pitch(metadata[\"vocals\"])\r\n    guardar_csv(metadata[\"pitch_referencia\"], tiempos, frecuencias)\r\n    metadata[\"preparada\"] = True\r\n    guardar_metadata(metadata)\r\n    return metadata\r\n\r\n\r\ndef leer_pitch_csv(ruta_csv):\r\n    tiempos = []\r\n    frecuencias = []\r\n    with open(ruta_csv, \"r\", newline=\"\", encoding=\"utf-8\") as f:\r\n        reader = csv.DictReader(f)\r\n        for row in reader:\r\n            tiempos.append(float(row[\"tiempo\"]))\r\n            frecuencias.append(float(row[\"frecuencia\"]))\r\n    return tiempos, frecuencias\r\n\r\n\r\ndef carpeta_grabaciones(cancion_id):\r\n    ruta = os.path.join(GRABACIONES_DIR, cancion_id)\r\n    os.makedirs(ruta, exist_ok=True)\r\n    return ruta\r\nmain.py:1:from audio.separacion import separar_voz\r\nmain.py:2:from audio.pitch import extraer_pitch\r\nmain.py:3:from audio.comparacion import comparar\r\nmain.py:4:from audio.guardar import guardar_csv\r\nmain.py:5:from audio.visualizacion import graficar\r\nmain.py:11:    t_ref, f_ref = extraer_pitch(ref_v)\r\nmain.py:12:    t_usr, f_usr = extraer_pitch(usr_v)\r\nmain.py:14:    guardar_csv(\"ref.csv\", t_ref, f_ref)\r\nmain.py:15:    guardar_csv(\"usr.csv\", t_usr, f_usr)\r\nmain.py:16:    return comparar(f_ref, f_usr)\r\ndesktop_live.py:10:from audio.catalogo import (\ndesktop_live.py:19:from audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\ndesktop_live.py:20:from audio.metricas import hz_to_midi\ndesktop_live.py:21:from audio.pitch import extraer_pitch_ligero_desde_audio\ndesktop_live.py:22:from audio.tomas import actualizar_toma, eliminar_toma, guardar_toma, listar_tomas\ndesktop_live.py:408:            toma = guardar_toma(cancion, ruta_grabacion, resultado, diagnostico)\ndesktop_live.py:668:            extraer_pitch_ligero_desde_audio(senal, sr)\napp.py:10:from audio.catalogo import (\napp.py:17:from audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\napp.py:18:from audio.visualizacion import (\naudio\\comparacion.py:4:from audio.metricas import calcular_metricas_errores, hz_to_cents\naudio\\comparacion.py:6:def comparar(f_ref, f_usr):\naudio\\pitch.py:349:def extraer_pitch_ligero_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\naudio\\pitch.py:415:def extraer_pitch_crudo(ruta_audio):\naudio\\pitch.py:435:def _extraer_pitch_base(y, sr):\naudio\\pitch.py:451:def extraer_pitch_desde_audio(y, sr, offset_t=0, ruido_base=None, devolver_info=False):\naudio\\pitch.py:465:    t, f0 = _extraer_pitch_base(y, sr)\naudio\\pitch.py:482:def extraer_pitch_detallado(ruta_audio):\naudio\\pitch.py:485:    t, f0 = _extraer_pitch_base(y, sr)\naudio\\pitch.py:500:def extraer_pitch(ruta_audio):\naudio\\pitch.py:502:    t, f0 = _extraer_pitch_base(y, sr)\naudio\\visualizacion.py:3:from audio.metricas import hz_to_midi\naudio\\guardar.py:2:from audio.pitch import hz_to_nota\r\naudio\\guardar.py:4:def guardar_csv(ruta_salida, tiempos, frecuencias):\r\naudio\\tomas.py:7:from audio.