 -2.2156573116691285\r\n      ],\r\n      \"omisiones_pp\": [\r\n        -4.599423631123919,\r\n        0.6335675613408587\r\n      ]\r\n    }\r\n  },\r\n  \"mir1k/voz\": {\r\n    \"groups\": 6,\r\n    \"percentile_95\": {\r\n      \"aciertos_pp\": [\r\n        -0.8468424872973612,\r\n        1.0460251046025104\r\n      ],\r\n      \"falsas_pp\": [\r\n        -2.985524728588662,\r\n        -1.6524048391856005\r\n      ],\r\n      \"omisiones_pp\": [\r\n        -1.020272956141513,\r\n        0.8716224629560454\r\n      ]\r\n    }\r\n  },\r\n  \"vocadito/voz\": {\r\n    \"groups\": 9,\r\n    \"percentile_95\": {\r\n      \"aciertos_pp\": [\r\n        -1.6723948462751237,\r\n        0.9899229401304055\r\n      ],\r\n      \"falsas_pp\": [\r\n        -4.277085748608967,\r\n        0.009779100307266782\r\n      ],\r\n      \"omisiones_pp\": [\r\n        -1.3062935721841877,\r\n        1.5019078299711248\r\n      ]\r\n    }\r\n  }\r\n}\r\n", "exitCode": 0, "durationMs": 1303}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "rs_06f6aa8593d2a892016abc670eec4487d2b737130cfbf693cb", "rollout_ordinal": 1773, "created_at_ms": 1790732047771, "item_type": "reasoning", "updated_at_ordinal": 1773, "started_at_ms": 1790732047771, "completed_at_ms": 1790732065856}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abc670eec4487d2b737130cfbf693cb", "summary": ["**Optimizing classic cache**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-04ed8fa3-4a45-4915-baaf-f33a4e507612", "rollout_ordinal": 1776, "created_at_ms": 1790732081813, "item_type": "fileChange", "updated_at_ordinal": 1776, "started_at_ms": 1790732081813, "completed_at_ms": 1790732081815}, "item": {"type": "fileChange", "id": "exec-04ed8fa3-4a45-4915-baaf-f33a4e507612", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\informe_filtro_aprendido.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -59,3 +59,11 @@\n         lines+=['',f\"Límites de regresión y objetivo positivo: **{'cumple' if checks[phase]['passes'] else 'no cumple'}**. Cambio del objetivo: {checks[phase]['objective_gain']:+.3f} puntos.\",'']\n-    lines+=['## Medición y reproducibilidad','',\n+    intervals=json.loads((OUT/'intervalos_validacion.json').read_text())\n+    lines+=['## Variabilidad entre cantantes y artistas','',\n+        'Se hizo un bootstrap pareado de 2.000 repeticiones, remuestreando grupos completos de la validación, no frames independientes. Los intervalos percentiles del 95% son exploratorios: hay solo seis cantantes de MIR y nueve grupos de cada uno de los otros datasets en validación. No corrigen la inspección histórica de los datasets.', '',\n+        '| Escenario | Cambio en aciertos: intervalo 95% (pp) | Cambio en falsas notas: intervalo 95% (pp) |','|---|---:|---:|']\n+    for group,value in intervals['results'].items():\n+        a=value['percentile_95']['aciertos_pp'];b=value['percentile_95']['falsas_pp']\n+        lines.append(f'| {LABELS[group]} | [{a[0]:+.2f}, {a[1]:+.2f}] | [{b[0]:+.2f}, {b[1]:+.2f}] |')\n+    lines+=['','Los aumentos puntuales de acierto no deben interpretarse como mejoras garantizadas para cualquier cantante; varios intervalos incluyen cero.', '',\n+        '## Medición y reproducibilidad','',\n         'Acierto: frecuencia dentro de ±50 cents de la referencia, dividido por todos los instantes con voz. Las omisiones cuentan como fallos. Falsas notas: detecciones durante instantes sin voz, divididas por todos esos instantes. Estos porcentajes tienen denominadores diferentes y no se suman.', '',\n"}], "status": "completed"}}
