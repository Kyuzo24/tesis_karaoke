{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "msg_06f6aa8593d2a892016abbd2e6701887d2a50314b86514518b", "rollout_ordinal": 1101, "created_at_ms": 1790694118646, "item_type": "agentMessage", "updated_at_ordinal": 1101, "started_at_ms": 1790694118646, "completed_at_ms": 1790694120661}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abbd2e6701887d2a50314b86514518b", "text": "Hay una diferencia importante respecto de Vocadito: estas voces fueron resintetizadas, lo que permite conocer su frecuencia de referencia con precisión. Servirán como comprobación adicional del detector, aunque no reemplazan una prueba con voces naturales captadas por micrófono.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
