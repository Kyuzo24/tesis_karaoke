{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "msg_06f6aa8593d2a892016abc6615704c87d2b07077da28160d97", "rollout_ordinal": 1721, "created_at_ms": 1790731798273, "item_type": "agentMessage", "updated_at_ordinal": 1721, "started_at_ms": 1790731798273, "completed_at_ms": 1790731800879}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abc6615704c87d2b07077da28160d97", "text": "La integración del modelo ya está preparada, pero aún no está activada por defecto. Funcionará con NumPy y un archivo de reglas; no hará falta instalar scikit-learn para usar la aplicación. Estoy comprobando que produzca las mismas decisiones que el modelo evaluado y que siga rechazando ruido y respetando la calibración del micrófono.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-8d11c385-bb2c-469a-8f93-c67d2fedaebb", "rollout_ordinal": 1724, "created_at_ms": 1790731824405, "item_type": "fileChange", "updated_at_ordinal": 1724, "started_at_ms": 1790731824405, "completed_at_ms": 1790731824406}, "item": {"type": "fileChange", "id": "exec-8d11c385-bb2c-469a-8f93-c67d2fedaebb", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\tests\\test_pitch.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -65,2 +65,40 @@\n \n+class LearnedFilterTests(unittest.TestCase):\n+    def setUp(self):\n+        self.config_patch = patch.dict(pitch.FILTRO_TIEMPO_REAL, usar_filtro_aprendido=True)\n+        self.config_patch.start()\n+        self.addCleanup(self.config_patch.stop)\n+\n+    def test_learned_filter_keeps_tones_at_live_sample_rates(self):\n+        from audio.filtro_aprendido import _cargar_modelo\n+        self.assertIsNotNone(_cargar_modelo())\n+        for sr in [22050, 44100, 48000]:\n+            for amp in [.005, .1]:\n+                with self.subTest(sr=sr, amplitude=amp):\n+                    t, f = pitch.extraer_pitch_ligero_desde_audio(tone(sr, amplitude=amp), sr, offset_t=2)\n+                    self.assertGreater(len(f), 3)\n+                    self.assertTrue(np.all(t >= 2))\n+                    self.assertLess(abs(np.median(f)-440), 2)\n+\n+    def test_learned_filter_rejects_noise_even_with_fallback_detector(self):\n+        y = np.random.default_rng(42).normal(0, .05, 16758)\n+        self.assertEqual(len(pitch.extraer_pitch_ligero_desde_audio(y, 44100)[1]), 0)\n+        with patch.object(pitch.librosa, 'yin', side_effect=RuntimeError('forced fallback')):\n+            self.assertEqual(len(pitch.extraer_pitch_ligero_desde_audio(y, 44100)[1]), 0)\n+\n+    def test_learned_filter_respects_microphone_noise_floor(self):\n+        _, f = pitch.extraer_pitch_ligero_desde_audio(tone(44100, amplitude=.005), 44100, ruido_base=.02)\n+        self.assertEqual(len(f), 0)\n+\n+    def test_missing_model_preserves_previous_filter(self):\n+        from audio import filtro_aprendido\n+        y = tone(44100) + np.random.default_rng(6).normal(0, .02, 17640)\n+        with patch.dict(pitch.FILTRO_TIEMPO_REAL, usar_filtro_aprendido=False):\n+            expected = pitch.extraer_pitch_ligero_desde_audio(y, 44100)\n+        with patch.object(filtro_aprendido, '_cargar_modelo', return_value=None):\n+            actual = pitch.extraer_pitch_ligero_desde_audio(y, 44100)\n+        for a, b in zip(actual, expected):\n+            np.testing.assert_array_equal(a, b)\n+\n+\n if __name__ == '__main__':\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-ba9c8090-ff00-481a-8719-7032bf89dd04", "rollout_ordinal": 1726, "created_at_ms": 1790731824904, "item_type": "commandExecution", "updated_at_ordinal": 1726, "started_at_ms": 1790731824904, "completed_at_ms": 1790731831327}, "item": {"type": "commandExecution", "id": "exec-ba9c8090-ff00-481a-8719-7032bf89dd04", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'python -m unittest discover -s tests -v'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "10373", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python -m unittest discover -s tests -v"}], "aggregatedOutput": "test_learned_filter_keeps_tones_at_live_sample_rates (test_pitch.LearnedFilterTests.test_learned_filter_keeps_tones_at_live_sample_rates) ... ok\r\ntest_learned_filter_rejects_noise_even_with_fallback_detector (test_pitch.LearnedFilterTests.test_learned_filter_rejects_noise_even_with_fallback_detector) ... ok\r\ntest_learned_filter_respects_microphone_noise_floor (test_pitch.LearnedFilterTests.test_learned_filter_respects_microphone_noise_floor) ... ok\r\ntest_missing_model_preserves_previous_filter (test_pitch.LearnedFilterTests.test_missing_model_preserves_previous_filter) ... ok\r\ntest_fallback_rejects_noise (test_pitch.PitchTests.test_fallback_rejects_noise) ... ok\r\ntest_live_harmonics_and_vibrato_keep_pitch (test_pitch.PitchTests.test_live_harmonics_and_vibrato_keep_pitch) ... ok\r\ntest_live_silence_and_noise_are_not_notes (test_pitch.PitchTests.test_live_silence_and_noise_are_not_notes) ... ok\r\ntest_live_soft_and_loud_tones_keep_pitch (test_pitch.PitchTests.test_live_soft_and_loud_tones_keep_pitch) ... ok\r\ntest_pyin_sample_rates_and_file_entrypoint (test_pitch.PitchTests.test_pyin_sample_rates_and_file_entrypoint) ... C:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Python\\Python314\\Lib\\site-packages\\audioread\\rawread.py:16: DeprecationWarning: aifc was removed in Python 3.13. Please be aware that you are currently NOT using standard 'aifc', but instead a separately installed 'standard-aifc'.\r\n  import aifc\r\nC:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Python\\Python314\\Lib\\site-packages\\audioread\\rawread.py:19: DeprecationWarning: sunau was removed in Python 3.13. Please be aware that you are currently NOT using standard 'sunau', but instead a separately installed 'standard-sunau'.\r\n  import sunau\r\nok\r\ntest_rejected_periodicity_is_not_gap_filled (test_pitch.PitchTests.test_rejected_periodicity_is_not_gap_filled) ... ok\r\n\r\n----------------------------------------------------------------------\r\nRan 10 tests in 5.258s\r\n\r\nOK\r\n", "exitCode": 0, "durationMs": 6422}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "rs_06f6aa8593d2a892016abc663ed8c087d28011ef7d2bfeed1c", "rollout_ordinal": 1729, "created_at_ms": 1790731839646, "item_type": "reasoning", "updated_at_ordinal": 1729, "started_at_ms": 1790731839646, "completed_at_ms": 1790731848187}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abc663ed8c087d28011ef7d2bfeed1c", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-7624fc0e-eb6c-42ed-b526-45eb0ba8eb40", "rollout_ordinal": 1732, "created_at_ms": 1790731879343, "item_type": "fileChange", "updated_at_ordinal": 1732, "started_at_ms": 1790731879343, "completed_at_ms": 1790731879344}, "item": {"type": "fileChange", "id": "exec-7624fc0e-eb6c-42ed-b526-45eb0ba8eb40", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\verificar_filtro_aprendido.py", "kind": {"type": "add"}, "diff": "\"\"\"Paridad del modelo exportado y comprobación extremo a extremo con audio.\"\"\"\nfrom pathlib import Path\nimport argparse,json,sys,hashlib\nimport numpy as np\nROOT=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(ROOT))\nfrom audio import pitch,filtro_aprendido\nfrom scripts import entrenar_filtro as train\nfrom scripts.comparar_live_vocadito import simulate,ui_policy\nfrom scripts.evaluar_vocadito import align,counts\n\ndef main():\n    parser=argparse.ArgumentParser();parser.add_argument('--profile',choices=['desktop','clasica'],default='desktop');args=parser.parse_args()\n    inv=train.partition();model=json.loads((train.OUT/'modelo.json').read_text());windows=0\n    for row in inv:\n        for path in train.paths(row,args.profile):\n            with np.load(path) as archive:z={k:archive[k] for k in archive.files}\n            offsets=np.r_[0,np.cumsum(z['sizes'])]\n            for i in sorted({0,len(z['sizes'])//2,len(z['sizes'])-1}):\n                sl=slice(offsets[i],offsets[i+1])\n                actual_x=filtro_aprendido.caracteristicas(z['f'][sl],z['p'][sl],z['e'][sl])\n                np.testing.assert_array_equal(actual_x,z['X'][sl])\n                actual=filtro_aprendido.aceptar_candidatos(z['f'][sl],z['p'][sl],z['e'][sl])\n                expected=(train.predict(model['tree'],z['X'][sl])>=model['cutoff'])&(z['p'][sl]>=model['periodicity_floor'])\n                np.testing.assert_array_equal(actual,expected);windows+=1\n    config,accept=ui_policy();interval,window=(config['LIVE_PITCH_INTERVAL'],config['LIVE_PITCH_CHUNK']) if args.profile=='desktop' else (.06,.38)\n    selected=[next(r for r in inv if r['dataset']==ds and r['stage']=='validacion') for ds in ['vocadito','mir1k','mdb']]\n    pitch.FILTRO_TIEMPO_REAL['usar_filtro_aprendido']=True\n    checks=[];timings=[]\n    for row in selected:\n        scenarios,sr,rt,ref=train.c.audio(row)\n        folder='todos' if args.profile=='desktop' else 'clasica'\n        expected=json.loads((train.OUT/folder/(row['dataset']+'_'+row['name']+'.json')).read_text())\n        for condition,y in scenarios.items():\n            t,f,durations=simulate(y,sr,pitch.extraer_pitch_ligero_desde_audio,interval,window,accept if args.profile=='desktop' else None)\n            result=counts(ref,align(t,f,rt,1024/sr/2))[0]\n            assert result==expected['metrics'][condition][model['name']]['counts'] if 'counts' in expected['metrics'][condition][model['name']] else result==expected['metrics'][condition][model['name']],(row['name'],condition)\n            checks.append(row['dataset']+'/'+row['name']+'/'+condition);timings.extend(durations)\n            print('Audio completo coincide:',checks[-1],flush=True)\n    train.c.save(train.OUT/('integracion_'+args.profile+'.json'),{'feature_windows_checked':windows,'full_audio_checks':checks,'processing_ms':{'median':float(np.median(timings)*1000),'p95':float(np.percentile(timings,95)*1000)},'model_sha256':hashlib.sha256(filtro_aprendido.RUTA_MODELO.read_bytes()).hexdigest(),'pitch_sha256':hashlib.sha256((ROOT/'audio/pitch.py').read_bytes()).hexdigest(),'inference_sha256':hashlib.sha256((ROOT/'audio/filtro_aprendido.py').read_bytes()).hexdigest()})\n    print('Integración verificada:',windows,'ventanas y',len(checks),'audios/condiciones completos.',flush=True)\n\nif __name__=='__main__':main()\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-e09f4974-55c3-4c3a-a47d-d0b8cdc4dd6d", "rollout_ordinal": 1736, "created_at_ms": 1790731879869, "item_type": "commandExecution", "updated_at_ordinal": 1736, "started_at_ms": 1790731879869, "completed_at_ms": 1790731895033}, "item": {"type": "commandExecution", "id": "exec-e09f4974-55c3-4c3a-a47d-d0b8cdc4dd6d", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'python scripts/verificar_filtro_aprendido.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "20547", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python scripts/verificar_filtro_aprendido.py"}], "aggregatedOutput": "Audio completo coincide: vocadito/vocadito_10/voz\r\nAudio completo coincide: mir1k/Kenshin_5_03/voz\r\nAudio completo coincide: mir1k/Kenshin_5_03/musica10\r\nAudio completo coincide: mir1k/Kenshin_5_03/musica0\r\nAudio completo coincide: mdb/AvaLuna_Waterduct_STEM_08/voz\r\nIntegraci�n verificada: 1155 ventanas y 5 audios/condiciones completos.\r\n", "exitCode": 0, "durationMs": 15163}}
