{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "msg_06f6aa8593d2a892016abbd0d3148087d28bf21de9be254bc6", "rollout_ordinal": 980, "created_at_ms": 1790693587327, "item_type": "agentMessage", "updated_at_ordinal": 980, "started_at_ms": 1790693587327, "completed_at_ms": 1790693589622}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abbd0d3148087d28bf21de9be254bc6", "text": "Identifiqué **60 pistas vocales: 41 etiquetadas como voz masculina y 19 como voz femenina**. Evaluaré las 60 completas. Eso cubre toda la parte vocal identificada de MDB-stem-synth, aunque no sus 170 pistas instrumentales. En esta prueba mediré YIN en vivo; no volveré a ejecutar el análisis posterior con pYIN.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "rs_06f6aa8593d2a892016abbd0d56c3087d2ab8c6bfd6bf3a207", "rollout_ordinal": 982, "created_at_ms": 1790693589650, "item_type": "reasoning", "updated_at_ordinal": 982, "started_at_ms": 1790693589650, "completed_at_ms": 1790693609077}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abbd0d56c3087d2ab8c6bfd6bf3a207", "summary": ["**Checking audio metadata**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-919992dc-689a-49c4-93d7-dbda7ccd3e20", "rollout_ordinal": 985, "created_at_ms": 1790693663177, "item_type": "fileChange", "updated_at_ordinal": 985, "started_at_ms": 1790693663177, "completed_at_ms": 1790693663179}, "item": {"type": "fileChange", "id": "exec-919992dc-689a-49c4-93d7-dbda7ccd3e20", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\evaluar_mdb.py", "kind": {"type": "add"}, "diff": "\"\"\"Todas las pistas vocales de MDB-stem-synth; solo interfaz nueva en vivo.\n\nComparacion congelada antes/despues, con resultados reanudables por pista.\n\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport importlib.metadata\nimport json\nimport sys\nimport numpy as np\nimport soundfile as sf\n\nROOT=Path(__file__).resolve().parents[1]\nsys.path.insert(0,str(ROOT))\nfrom audio import pitch\nfrom scripts.comparar_live_vocadito import load_before,ui_policy,simulate\nfrom scripts.evaluar_vocadito import align,counts,percentages,check_evaluator\n\nDATA=ROOT/'data/mdb_stem_synth'\nOUT=ROOT/'output/mdb_evaluacion'\n\n\ndef digest(path,algorithm='sha256'):\n    with path.open('rb') as f:\n        return hashlib.file_digest(f,algorithm).hexdigest()\n\n\ndef main():\n    check_evaluator()\n    manifest=json.loads((DATA/'manifest.json').read_text(encoding='utf-8'))\n    selected=manifest['selected']\n    assert len(selected)==manifest['vocal_tracks']==60\n    assert len(manifest['inventory'])==manifest['total_tracks']==230\n    before=load_before()\n    config,accept=ui_policy()\n    OUT.mkdir(parents=True,exist_ok=True)\n    (OUT/'tracks').mkdir(exist_ok=True)\n    (OUT/'predicciones').mkdir(exist_ok=True)\n    protocol={\n        'pitch_sha256':digest(ROOT/'audio/pitch.py'),\n        'before_sha256':digest(ROOT/'output/vocadito_mejoras/antes/pitch.py'),\n        'ui_sha256':digest(ROOT/'desktop_live.py'),\n        'script_sha256':digest(Path(__file__)),\n        'manifest_sha256':digest(DATA/'manifest.json'),\n        'config_live':pitch.FILTRO_TIEMPO_REAL,'desktop_config':config,\n        'scope':'60 pistas vocales completas de las 230; solo YIN en vivo, interfaz nueva',\n        'sample_rate':44100,'reference_hop':128/44100,'noise_floor':None,\n        'versions':{p:importlib.metadata.version(p) for p in ['librosa','numpy','soundfile']},\n        'python':sys.version,\n    }\n    pp=OUT/'protocolo.json'\n    if pp.exists():\n        assert json.loads(pp.read_text(encoding='utf-8'))==protocol,'Protocolo diferente: no mezclar resultados.'\n    else:\n        pp.write_text(json.dumps(protocol,indent=2),encoding='utf-8')\n    for row in selected:\n        for key in ['audio','f0']:\n            assert digest(DATA/row[key][0],'md5')==row[key][1],row['track']\n    warm=.1*np.sin(2*np.pi*220*np.arange(16758)/44100)\n    for mod in [before,pitch]:\n        mod.extraer_pitch_ligero_desde_audio(warm,44100)\n    rows=[]\n    for i,track in enumerate(selected,1):\n        name=track['track']\n        cache=OUT/'tracks'/(name+'.json')\n        if cache.exists():\n            rows.append(json.loads(cache.read_text(encoding='utf-8')))\n            print(f'{i}/60 {name}: recuperado',flush=True)\n            continue\n        y,sr=sf.read(DATA/track['audio'][0],dtype='float32')\n        assert sr==44100 and y.ndim==1\n        rt,ref=np.loadtxt(DATA/track['f0'][0],delimiter=',').T\n        assert np.isfinite(ref).all() and np.all(ref>=0)\n        assert abs(rt[0])<1e-8 and np.allclose(np.diff(rt),128/44100,atol=1e-7)\n        assert abs(len(y)/sr-rt[-1])<.05\n        row={'track':name,'song':track['song'],'instrument':track['instrument'],\n             'duration_s':len(y)/sr,'metrics':{},'timing':{},\n             'reference_below_C2':int(((ref>0)&(ref<65.4063913)).sum()),\n             'reference_above_C6':int((ref>1046.5022612).sum())}\n        predictions={'time':rt,'reference':ref}\n        for label,mod in [('antes',before),('despues',pitch)]:\n            t,f,timings=simulate(y,sr,mod.extraer_pitch_ligero_desde_audio,\n                                config['LIVE_PITCH_INTERVAL'],config['LIVE_PITCH_CHUNK'],accept)\n            est=align(t,f,rt,1024/sr/2)\n            assert np.isfinite(est).all()\n            c,error=counts(ref,est)\n            row['metrics'][label]={**percentages(c),'counts':c,\n                                  'median_abs_cents_both_voiced':float(np.median(error)) if len(error) else None}\n            row['timing'][label]={'median_ms':float(np.median(timings)*1000),\n                                  'p95_ms':float(np.percentile(timings,95)*1000)}\n            predictions[label]=est\n        np.savez_compressed(OUT/'predicciones'/(name+'.npz'),**predictions)\n        cache.write_text(json.dumps(row,indent=2),encoding='utf-8')\n        rows.append(row)\n        print(f'{i}/60 {name}: aciertos {row[\"metrics\"][\"antes\"][\"pitch_correct_50c_pct\"]:.1f}% '\n              f'-> {row[\"metrics\"][\"despues\"][\"pitch_correct_50c_pct\"]:.1f}%',flush=True)\n    def summarize(group):\n        result={}\n        for label in ['antes','despues']:\n            c={k:sum(r['metrics'][label]['counts'][k] for r in group) for k in group[0]['metrics'][label]['counts']}\n            result[label]={**percentages(c),'counts':c,\n                           'macro_pitch_correct_50c_pct':float(np.mean([r['metrics'][label]['pitch_correct_50c_pct'] for r in group]))}\n        return result\n    result={'protocol':protocol,'tracks':len(rows),'dataset_total_tracks':230,\n            'songs':len({r['song'] for r in rows}),'duration_s':sum(r['duration_s'] for r in rows),\n            'summary':summarize(rows),'per_track':rows,\n            'by_instrument':{inst:summarize([r for r in rows if r['instrument']==inst]) for inst in sorted({r['instrument'] for r in rows})},\n            'reference_below_C2':sum(r['reference_below_C2'] for r in rows),\n            'reference_above_C6':sum(r['reference_above_C6'] for r in rows)}\n    assert digest(ROOT/'audio/pitch.py')==protocol['pitch_sha256']\n    (OUT/'resultados.json').write_text(json.dumps(result,indent=2),encoding='utf-8')\n    print('Evaluacion completa: 60/60 pistas vocales.',flush=True)\n\n\nif __name__=='__main__':\n    main()\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-dc3f703e-d9bf-453e-ab23-d107fdf0591a", "rollout_ordinal": 987, "created_at_ms": 1790693668749, "item_type": "commandExecution", "updated_at_ordinal": 987, "started_at_ms": 1790693668749, "completed_at_ms": 1790693669146}, "item": {"type": "commandExecution", "id": "exec-dc3f703e-d9bf-453e-ab23-d107fdf0591a", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"from pathlib import Path; p=Path('data/mdb_stem_synth'); fs=list((p/'parts').glob('*.part')); print('bytes descargados:',sum(f.stat().st_size for f in fs)+(p/'archive.prefix').stat().st_size,'/ 1845117819')\\\"\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "16407", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python -c \"from pathlib import Path; p=Path('data/mdb_stem_synth'); fs=list((p/'parts').glob('*.part')); print('bytes descargados:',sum(f.stat().st_size for f in fs)+(p/'archive.prefix').stat().st_size,'/ 1845117819')\""}], "aggregatedOutput": "bytes descargados: 665464832 / 1845117819\r\n", "exitCode": 0, "durationMs": 397}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "01a0eda8-f94c-7e00-944d-1e1d74fd81e0", "rollout_ordinal": 996, "created_at_ms": 1790693669196, "item_type": "contextCompaction", "updated_at_ordinal": 996, "started_at_ms": 1790693669196, "completed_at_ms": 1790693772043}, "item": {"type": "contextCompaction", "id": "01a0eda8-f94c-7e00-944d-1e1d74fd81e0"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-dba2da94-7ed9-4bb0-8ec4-ebf9e4507f0f", "rollout_ordinal": 999, "created_at_ms": 1790693782826, "item_type": "commandExecution", "updated_at_ordinal": 999, "started_at_ms": 1790693782826, "completed_at_ms": 1790693783234}, "item": {"type": "commandExecution", "id": "exec-dba2da94-7ed9-4bb0-8ec4-ebf9e4507f0f", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content scripts/evaluar_mdb.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "60389", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "read", "command": "Get-Content scripts/evaluar_mdb.py", "name": "evaluar_mdb.py", "path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\evaluar_mdb.py"}], "aggregatedOutput": "\"\"\"Todas las pistas vocales de MDB-stem-synth; solo interfaz nueva en vivo.\r\n\r\nComparacion congelada antes/despues, con resultados reanudables por pista.\r\n\"\"\"\r\nfrom pathlib import Path\r\nimport hashlib\r\nimport importlib.metadata\r\nimport json\r\nimport sys\r\nimport numpy as np\r\nimport soundfile as sf\r\n\r\nROOT=Path(__file__).resolve().parents[1]\r\nsys.path.insert(0,str(ROOT))\r\nfrom audio import pitch\r\nfrom scripts.comparar_live_vocadito import load_before,ui_policy,simulate\r\nfrom scripts.evaluar_vocadito import align,counts,percentages,check_evaluator\r\n\r\nDATA=ROOT/'data/mdb_stem_synth'\r\nOUT=ROOT/'output/mdb_evaluacion'\r\n\r\n\r\ndef digest(path,algorithm='sha256'):\r\n    with path.open('rb') as f:\r\n        return hashlib.file_digest(f,algorithm).hexdigest()\r\n\r\n\r\ndef main():\r\n    check_evaluator()\r\n    manifest=json.loads((DATA/'manifest.json').read_text(encoding='utf-8'))\r\n    selected=manifest['selected']\r\n    assert len(selected)==manifest['vocal_tracks']==60\r\n    assert len(manifest['inventory'])==manifest['total_tracks']==230\r\n    before=load_before()\r\n    config,accept=ui_policy()\r\n    OUT.mkdir(parents=True,exist_ok=True)\r\n    (OUT/'tracks').mkdir(exist_ok=True)\r\n    (OUT/'predicciones').mkdir(exist_ok=True)\r\n    protocol={\r\n        'pitch_sha256':digest(ROOT/'audio/pitch.py'),\r\n        'before_sha256':digest(ROOT/'output/vocadito_mejoras/antes/pitch.py'),\r\n        'ui_sha256':digest(ROOT/'desktop_live.py'),\r\n        'script_sha256':digest(Path(__file__)),\r\n        'manifest_sha256':digest(DATA/'manifest.json'),\r\n        'config_live':pitch.FILTRO_TIEMPO_REAL,'desktop_config':config,\r\n        'scope':'60 pistas vocales completas de las 230; solo YIN en vivo, interfaz nueva',\r\n        'sample_rate':44100,'reference_hop':128/44100,'noise_floor':None,\r\n        'versions':{p:importlib.metadata.version(p) for p in ['librosa','numpy','soundfile']},\r\n        'python':sys.version,\r\n    }\r\n    pp=OUT/'protocolo.json'\r\n    if pp.exists():\r\n        assert json.loads(pp.read_text(encoding='utf-8'))==protocol,'Protocolo diferente: no mezclar resultados.'\r\n    else:\r\n        pp.write_text(json.dumps(protocol,indent=2),encoding='utf-8')\r\n    for row in selected:\r\n        for key in ['audio','f0']:\r\n            assert digest(DATA/row[key][0],'md5')==row[key][1],row['track']\r\n    warm=.1*np.sin(2*np.pi*220*np.arange(16758)/44100)\r\n    for mod in [before,pitch]:\r\n        mod.extraer_pitch_ligero_desde_audio(warm,44100)\r\n    rows=[]\r\n    for i,track in enumerate(selected,1):\r\n        name=track['track']\r\n        cache=OUT/'tracks'/(name+'.json')\r\n        if cache.exists():\r\n            rows.append(json.loads(cache.read_text(encoding='utf-8')))\r\n            print(f'{i}/60 {name}: recuperado',flush=True)\r\n            continue\r\n        y,sr=sf.read(DATA/track['audio'][0],dtype='float32')\r\n        assert sr==44100 and y.ndim==1\r\n        rt,ref=np.loadtxt(DATA/track['f0'][0],delimiter=',').T\r\n        assert np.isfinite(ref).all() and np.all(ref>=0)\r\n        assert abs(rt[0])<1e-8 and np.allclose(np.diff(rt),128/44100,atol=1e-7)\r\n        assert abs(len(y)/sr-rt[-1])<.05\r\n        row={'track':name,'song':track['song'],'instrument':track['instrument'],\r\n             'duration_s':len(y)/sr,'metrics':{},'timing':{},\r\n             'reference_below_C2':int(((ref>0)&(ref<65.4063913)).sum()),\r\n             'reference_above_C6':int((ref>1046.5022612).sum())}\r\n        predictions={'time':rt,'reference':ref}\r\n        for label,mod in [('antes',before),('despues',pitch)]:\r\n            t,f,timings=simulate(y,sr,mod.extraer_pitch_ligero_desde_audio,\r\n                                config['LIVE_PITCH_INTERVAL'],config['LIVE_PITCH_CHUNK'],accept)\r\n            est=align(t,f,rt,1024/sr/2)\r\n            assert np.isfinite(est).all()\r\n            c,error=counts(ref,est)\r\n            row['metrics'][label]={**percentages(c),'counts':c,\r\n                                  'median_abs_cents_both_voiced':float(np.median(error)) if len(error) else None}\r\n            row['timing'][label]={'median_ms':float(np.median(timings)*1000),\r\n                                  'p95_ms':float(np.percentile(timings,95)*1000)}\r\n            predictions[label]=est\r\n        np.savez_compressed(OUT/'predicciones'/(name+'.npz'),**predictions)\r\n        cache.write_text(json.dumps(row,indent=2),encoding='utf-8')\r\n        rows.append(row)\r\n        print(f'{i}/60 {name}: aciertos {row[\"metrics\"][\"antes\"][\"pitch_correct_50c_pct\"]:.1f}% '\r\n              f'-> {row[\"metrics\"][\"despues\"][\"pitch_correct_50c_pct\"]:.1f}%',flush=True)\r\n    def summarize(group):\r\n        result={}\r\n        for label in ['antes','despues']:\r\n            c={k:sum(r['metrics'][label]['counts'][k] for r in group) for k in group[0]['metrics'][label]['counts']}\r\n            result[label]={**percentages(c),'counts':c,\r\n                           'macro_pitch_correct_50c_pct':float(np.mean([r['metrics'][label]['pitch_correct_50c_pct'] for r in group]))}\r\n        return result\r\n    result={'protocol':protocol,'tracks':len(rows),'dataset_total_tracks':230,\r\n            'songs':len({r['song'] for r in rows}),'duration_s':sum(r['duration_s'] for r in rows),\r\n            'summary':summarize(rows),'per_track':rows,\r\n            'by_instrument':{inst:summarize([r for r in rows if r['instrument']==inst]) for inst in sorted({r['instrument'] for r in rows})},\r\n            'reference_below_C2':sum(r['reference_below_C2'] for r in rows),\r\n            'reference_above_C6':sum(r['reference_above_C6'] for r in rows)}\r\n    assert digest(ROOT/'audio/pitch.py')==protocol['pitch_sha256']\r\n    (OUT/'resultados.json').write_text(json.dumps(result,indent=2),encoding='utf-8')\r\n    print('Evaluacion completa: 60/60 pistas vocales.',flush=True)\r\n\r\n\r\nif __name__=='__main__':\r\n    main()\r\n", "exitCode": 0, "durationMs": 407}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "rs_06f6aa8593d2a892016abbd1985e3c87d297bdb70496111f32", "rollout_ordinal": 1002, "created_at_ms": 1790693784588, "item_type": "reasoning", "updated_at_ordinal": 1002, "started_at_ms": 1790693784588, "completed_at_ms": 1790693785407}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abbd1985e3c87d297bdb70496111f32", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "msg_06f6aa8593d2a892016abbd1992a4c87d2b8f88f0e41236697", "rollout_ordinal": 1004, "created_at_ms": 1790693785435, "item_type": "agentMessage", "updated_at_ordinal": 1004, "started_at_ms": 1790693785435, "completed_at_ms": 1790693786940}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abbd1992a4c87d2b8f88f0e41236697", "text": "La descarga ya superó la mitad de los bloques. La comparación usará exactamente los mismos parámetros que en las pruebas anteriores, para comprobar si la mejora se mantiene con estas voces sin ajustar el algoritmo al nuevo dataset.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-b9cbcf67-c611-4a95-b255-ac3db06dc257", "rollout_ordinal": 1008, "created_at_ms": 1790693788654, "item_type": "commandExecution", "updated_at_ordinal": 1008, "started_at_ms": 1790693788654, "completed_at_ms": 1790693789044}, "item": {"type": "commandExecution", "id": "exec-b9cbcf67-c611-4a95-b255-ac3db06dc257", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content scripts/preparar_mdb.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "53015", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "read", "command": "Get-Content scripts/preparar_mdb.py", "name": "preparar_mdb.py", "path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\preparar_mdb.py"}], "aggregatedOutput": "\"\"\"Inventario vocal completo; descarga oficial reanudable por rangos y MD5.\"\"\"\r\nfrom pathlib import Path\r\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\r\nfrom collections import Counter\r\nimport hashlib\r\nimport json\r\nimport shutil\r\nimport tarfile\r\nimport time\r\nimport requests\r\nimport yaml\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nDATA = ROOT / 'data/mdb_stem_synth'\r\nREV = '537bb7bad0601fc58e4fff8404f71658b86ef60e'\r\nURL = 'https://zenodo.org/records/1481172/files/MDB-stem-synth.tar.gz?download=1'\r\nSIZE = 1845117819\r\nMD5 = '31c1f6b4888e5fd108af91c69789a809'\r\n\r\n\r\ndef md5(path):\r\n    with path.open('rb') as f:\r\n        return hashlib.file_digest(f, 'md5').hexdigest()\r\n\r\n\r\ndef metadata(song):\r\n    path = DATA / 'metadata' / (song + '_METADATA.yaml')\r\n    if not path.exists():\r\n        r = requests.get(f'https://raw.githubusercontent.com/marl/medleydb/{REV}/medleydb/data/Metadata/{path.name}', timeout=40)\r\n        r.raise_for_status()\r\n        path.parent.mkdir(exist_ok=True)\r\n        path.write_bytes(r.content)\r\n    return song, yaml.safe_load(path.read_text(encoding='utf-8'))\r\n\r\n\r\ndef part(start, end):\r\n    path = DATA / 'parts' / f'{start}-{end}.part'\r\n    if path.exists() and path.stat().st_size == end-start+1:\r\n        return path\r\n    for attempt in range(4):\r\n        try:\r\n            with requests.get(URL, headers={'Range': f'bytes={start}-{end}'}, stream=True, timeout=(30,90)) as r:\r\n                r.raise_for_status()\r\n                assert r.status_code == 206 and r.headers['Content-Range'] == f'bytes {start}-{end}/{SIZE}'\r\n                with path.open('wb') as f:\r\n                    for chunk in r.iter_content(1024*1024):\r\n                        f.write(chunk)\r\n            assert path.stat().st_size == end-start+1\r\n            return path\r\n        except Exception:\r\n            if attempt == 3:\r\n                raise\r\n            time.sleep(3)\r\n\r\n\r\ndef main():\r\n    index = json.loads((DATA / 'index.json').read_text())['tracks']\r\n    assert len(index) == 230\r\n    songs = sorted({name.rsplit('_STEM_',1)[0] for name in index})\r\n    with ThreadPoolExecutor(max_workers=6) as pool:\r\n        metas = dict(pool.map(metadata, songs))\r\n    inventory = []\r\n    for name, paths in sorted(index.items()):\r\n        song, stem = name.rsplit('_STEM_',1)\r\n        inst = metas[song]['stems']['S'+stem]['instrument']\r\n        labels = inst if isinstance(inst,list) else [inst]\r\n        vocal = any('singer' in s or 'vocal' in s for s in labels)\r\n        inventory.append({'track':name,'song':song,'instrument':inst,'vocal':vocal,**paths})\r\n    selected = [x for x in inventory if x['vocal']]\r\n    manifest = {'total_tracks':230, 'vocal_tracks':len(selected),'selection':'Todas las pistas con singer o vocal en la etiqueta instrument de MedleyDB.',\r\n                'metadata_revision':REV,'archive_url':URL,'archive_md5':MD5,\r\n                'index_md5':md5(DATA/'index.json'), 'inventory':inventory,'selected':selected}\r\n    (DATA/'manifest.json').write_text(json.dumps(manifest,indent=2),encoding='utf-8')\r\n    print('Inventario completo:',len(selected),'pistas vocales de 230;',Counter(str(x['instrument']) for x in selected),flush=True)\r\n    archive = DATA/'MDB-stem-synth.tar.gz'\r\n    if not archive.exists() or archive.stat().st_size != SIZE:\r\n        prefix = DATA/'archive.prefix'\r\n        if archive.exists() and not prefix.exists():\r\n            archive.rename(prefix)\r\n        offset = prefix.stat().st_size if prefix.exists() else 0\r\n        (DATA/'parts').mkdir(exist_ok=True)\r\n        ranges = [(start,min(start+32*1024*1024-1,SIZE-1)) for start in range(offset,SIZE,32*1024*1024)]\r\n        done = 0\r\n        with ThreadPoolExecutor(max_workers=8) as pool:\r\n            for future in as_completed([pool.submit(part,*r) for r in ranges]):\r\n                future.result(); done+=1\r\n                print(f'Descarga: {done}/{len(ranges)} bloques completos',flush=True)\r\n        with archive.open('wb') as f:\r\n            if prefix.exists():\r\n                with prefix.open('rb') as src:\r\n                    shutil.copyfileobj(src,f)\r\n            for start,end in ranges:\r\n                with (DATA/'parts'/f'{start}-{end}.part').open('rb') as src:\r\n                    shutil.copyfileobj(src,f)\r\n    assert md5(archive) == MD5, 'Checksum del archivo oficial incorrecto'\r\n    print('Archivo completo y MD5 oficial verificado.',flush=True)\r\n    # Solo datos vocales y sus etiquetas; no extrae rutas ni enlaces del tar.\r\n    wanted = {Path(x[k][0]).name:(x[k][0],x[k][1]) for x in selected for k in ['audio','f0']}\r\n    found = set()\r\n    with tarfile.open(archive,'r|gz') as tar:\r\n        for member in tar:\r\n            name=Path(member.name).name\r\n            if name not in wanted or not member.isfile():\r\n                continue\r\n            rel,expected = wanted[name]\r\n            dst=DATA/rel\r\n            dst.parent.mkdir(exist_ok=True)\r\n            with tar.extractfile(member) as src, dst.open('wb') as f:\r\n                shutil.copyfileobj(src,f)\r\n            assert md5(dst)==expected, name\r\n            found.add(name)\r\n    assert len(found)==len(wanted), (len(found),len(wanted))\r\n    print(f'Listo: {len(selected)} audios vocales completos y sus etiquetas verificadas.',flush=True)\r\n\r\n\r\nif __name__=='__main__':\r\n    main()\r\n", "exitCode": 0, "durationMs": 389}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-980f0b6b-7753-43b9-855a-40bfea7c9513", "rollout_ordinal": 1013, "created_at_ms": 1790693862840, "item_type": "fileChange", "updated_at_ordinal": 1013, "started_at_ms": 1790693862840, "completed_at_ms": 1790693862842}, "item": {"type": "fileChange", "id": "exec-980f0b6b-7753-43b9-855a-40bfea7c9513", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\informe_mdb.py", "kind": {"type": "add"}, "diff": "\"\"\"Informe reproducible de la evaluación vocal completa de MDB-stem-synth.\"\"\"\nfrom pathlib import Path\nimport json\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nROOT = Path(__file__).resolve().parents[1]\nOUT = ROOT / 'output/mdb_evaluacion'\n\n\ndef main():\n    r = json.loads((OUT/'resultados.json').read_text(encoding='utf-8'))\n    assert r['tracks'] == 60 and len(r['per_track']) == 60\n    metrics = [\n        ('pitch_correct_50c_pct', 'Tono correcto cuando hay voz', 'Mayor es mejor'),\n        ('false_voiced_pct', 'Detecta notas cuando no hay voz', 'Menor es mejor'),\n        ('missed_voiced_pct', 'No detecta una nota cuando hay voz', 'Menor es mejor'),\n        ('octave_error_pct', 'Errores de una octava', 'Menor es mejor'),\n    ]\n    fig, axes = plt.subplots(1, 3, figsize=(12, 4.4), layout='constrained')\n    for ax, (key, title, direction) in zip(axes, metrics):\n        values = [r['summary'][v][key] for v in ['antes', 'despues']]\n        bars = ax.bar(['Anterior', 'Mejorado'], values, color=['#8594ab', '#168b8b'], width=.6)\n        ax.bar_label(bars, labels=[f'{v:.2f}%' for v in values], padding=5)\n        ax.set_ylim(0, 106)\n        ax.set_ylabel('Porcentaje')\n        ax.set_title(title+'\\n'+direction, fontsize=10)\n        ax.spines[['top', 'right']].set_visible(False)\n        ax.set_axisbelow(True)\n        ax.grid(axis='y', alpha=.2)\n    fig.suptitle('MDB-stem-synth · las 60 pistas vocales completas\\nYIN en vivo, configuración de la interfaz nueva', fontsize=13)\n    fig.savefig(OUT/'comparacion.png', dpi=170)\n    plt.close(fig)\n    lines = [\n        '# Evaluación externa con MDB-stem-synth', '',\n        f\"Se evaluaron **60 de 60 pistas vocales identificadas**, completas, de {r['songs']} canciones: **{r['duration_s']/60:.2f} minutos** de audio. El dataset completo tiene 230 pistas; las otras 170 son instrumentales y no forman parte de esta prueba.\", '',\n        'Las etiquetas originales clasifican 41 pistas como `male singer` y 19 como `female singer`. Son pistas, no un recuento de personas distintas. La selección incluye todas las etiquetas que contienen `singer` o `vocal`, sin elegir ejemplos por su resultado.', '',\n        '## Resultado', '',\n        '| Medida | Anterior | Mejorado | Cambio (puntos porcentuales) |',\n        '|---|---:|---:|---:|',\n    ]\n    for key, title, direction in metrics:\n        a, b = [r['summary'][v][key] for v in ['antes', 'despues']]\n        lines.append(f'| {title} ({direction.lower()}) | {a:.2f}% | {b:.2f}% | {b-a:+.2f} |')\n    lines += ['', '![Comparación antes/después](comparacion.png)', '',\n        '“Tono correcto” significa estar a menos de medio semitono (50 cents) de la referencia cuando hay voz. Las notas omitidas cuentan como fallos. Las falsas notas se calculan sobre los instantes sin voz; por eso estos porcentajes no deben sumarse. El error de octava usa una distancia de 1.200 ± 50 cents y se divide por todos los instantes con voz.', '',\n        'Los porcentajes principales agrupan todos los instantes de referencia: las pistas largas pesan más. Como comprobación, el promedio que da el mismo peso a cada pista es '\n        f\"{r['summary']['antes']['macro_pitch_correct_50c_pct']:.2f}% → {r['summary']['despues']['macro_pitch_correct_50c_pct']:.2f}% de tono correcto.\", '',\n        '## Desglose por etiqueta original', '',\n        '| Etiqueta | Tono correcto anterior | Tono correcto mejorado | Falsas notas anterior | Falsas notas mejorado |',\n        '|---|---:|---:|---:|---:|']\n    for label, group in r['by_instrument'].items():\n        a,b=group['antes'],group['despues']\n        lines.append(f\"| {label} | {a['pitch_correct_50c_pct']:.2f}% | {b['pitch_correct_50c_pct']:.2f}% | {a['false_voiced_pct']:.2f}% | {b['false_voiced_pct']:.2f}% |\")\n    changes = sorted(r['per_track'], key=lambda p: p['metrics']['despues']['pitch_correct_50c_pct']-p['metrics']['antes']['pitch_correct_50c_pct'])\n    better=sum(p['metrics']['despues']['pitch_correct_50c_pct']>p['metrics']['antes']['pitch_correct_50c_pct'] for p in changes)\n    worse=sum(p['metrics']['despues']['pitch_correct_50c_pct']<p['metrics']['antes']['pitch_correct_50c_pct'] for p in changes)\n    lines += ['', f'El tono correcto subió en {better} pistas, bajó en {worse} y quedó igual en {60-better-worse}.', '',\n        '### Cinco pistas con el cambio menos favorable', '',\n        '| Pista | Anterior | Mejorado | Cambio |', '|---|---:|---:|---:|']\n    for p in changes[:5]:\n        a,b=[p['metrics'][v]['pitch_correct_50c_pct'] for v in ['antes','despues']]\n        lines.append(f\"| {p['track']} | {a:.2f}% | {b:.2f}% | {b-a:+.2f} pp |\")\n    voiced=r['summary']['antes']['counts']['voiced']\n    lines += ['', '## Método y límites', '',\n        '- Se descargó el archivo oficial completo y se verificó su MD5; también se verificaron los 60 audios y sus 60 referencias contra el índice de mirdata.',\n        '- Se comparó el YIN anterior con el YIN mejorado, usando ventanas de 0,24 s, actualizaciones de 0,10 s y la política real de aceptación de saltos de la interfaz nueva. Se mantuvieron los parámetros del algoritmo; este dataset no se usó para reajustarlos.',\n        '- Se procesó cada audio completo, con silencios incluidos. La simulación usa voz aislada y no estima un piso de ruido del micrófono. No reproduce hardware, colas ni pérdidas de audio de una sesión real.',\n        '- La referencia empieza en 0 s y avanza 128/44.100 s. Las predicciones se alinean al instante más cercano con tolerancia de medio salto de análisis (1.024/44.100/2 s); no se interpolan huecos sin notas.',\n        '- Esta prueba evalúa únicamente YIN en vivo con la interfaz nueva. No mide pYIN de canciones guardadas ni la configuración de la interfaz clásica.',\n        '- MDB-stem-synth contiene voces resintetizadas a partir de grabaciones. Permite una referencia de frecuencia conocida, pero no sustituye una prueba con micrófono y voces naturales, ni demuestra que funcione mejor sobre voz mezclada con música.',\n        f\"- Referencia fuera del rango nominal C2–C6: {r['reference_below_C2']} instantes por debajo y {r['reference_above_C6']} por encima, de {voiced} instantes con voz ({100*(r['reference_below_C2']+r['reference_above_C6'])/voiced:.3f}%). No se excluyeron del cálculo.\", '',\n        '## Reproducibilidad y fuentes', '',\n        '- [Archivo oficial y licencia CC BY-NC 4.0](https://zenodo.org/records/1481172).',\n        '- [Descripción del dataset y publicación](https://synthdatasets.weebly.com/mdb-stem-synth.html).',\n        '- [Índice de mirdata](https://zenodo.org/records/14042058).',\n        '- [Metadatos MedleyDB fijados a una revisión](https://github.com/marl/medleydb/tree/537bb7bad0601fc58e4fff8404f71658b86ef60e/medleydb/data/Metadata).',\n        '- `protocolo.json`: versiones, parámetros y hashes de código. `resultados.json`: métricas agregadas y por pista. `predicciones/`: referencia y predicciones alineadas. `data/mdb_stem_synth/manifest.json`: inventario de las 230 pistas y selección vocal.', '',\n        'Para reproducir desde la raíz del proyecto: `python scripts/preparar_mdb.py`, `python scripts/evaluar_mdb.py` y `python scripts/informe_mdb.py`.', '',\n        'El código de producción no se modificó durante esta evaluación.', '',\n    ]\n    (OUT/'informe.md').write_text('\\n'.join(lines), encoding='utf-8')\n    print(OUT/'informe.md')\n\n\nif __name__ == '__main__':\n    main()\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-3d57b8d5-4223-4990-9b44-f612bbe7933b", "rollout_ordinal": 1018, "created_at_ms": 1790693871926, "item_type": "commandExecution", "updated_at_ordinal": 1018, "started_at_ms": 1790693871926, "completed_at_ms": 1790693872370}, "item": {"type": "commandExecution", "id": "exec-3d57b8d5-4223-4990-9b44-f612bbe7933b", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content scripts/comparar_live_vocadito.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "86332", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "read", "command": "Get-Content scripts/comparar_live_vocadito.py", "name": "comparar_live_vocadito.py", "path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\comparar_live_vocadito.py"}], "aggregatedOutput": "\"\"\"Comparacion del detector anterior y nuevo, con ambas configuraciones de UI.\r\n\r\n--development selecciona un umbral solo usando cantantes S1 a S8.\r\nSin esa opcion evalua todos los audios sin seleccionar parametros.\r\nLa particion restante es una comprobacion interna: Vocadito ya se inspecciono\r\nen la evaluacion inicial y no se presenta como un test externo independiente.\r\n\"\"\"\r\nimport argparse\r\nimport ast\r\nimport csv\r\nimport hashlib\r\nimport importlib.util\r\nimport json\r\nfrom pathlib import Path\r\nimport sys\r\nimport time\r\nfrom types import SimpleNamespace\r\n\r\nimport numpy as np\r\nimport soundfile as sf\r\n\r\nROOT = Path(__file__).resolve().parents[1]\r\nsys.path.insert(0, str(ROOT))\r\nfrom audio import pitch\r\nfrom scripts.evaluar_vocadito import align, counts, percentages\r\n\r\nOUT = ROOT / 'output/vocadito_mejoras'\r\nDATA = ROOT / 'data/vocadito_benchmark'\r\nDEVELOPMENT = {f'S{i}' for i in range(1, 9)}\r\n\r\n\r\ndef load_before():\r\n    path = OUT / 'antes/pitch.py'\r\n    spec = importlib.util.spec_from_file_location('pitch_before', path)\r\n    mod = importlib.util.module_from_spec(spec)\r\n    spec.loader.exec_module(mod)\r\n    return mod\r\n\r\n\r\ndef ui_policy():\r\n    # Extrae del codigo real solo las constantes y el filtro de puntos.\r\n    # No importa la GUI, no abre dispositivos ni crea hilos.\r\n    tree = ast.parse((ROOT / 'desktop_live.py').read_text(encoding='utf-8'))\r\n    constants = {}\r\n    for node in tree.body:\r\n        if isinstance(node, ast.Assign):\r\n            for target in node.targets:\r\n                if isinstance(target, ast.Name) and target.id.startswith('LIVE_'):\r\n                    constants[target.id] = ast.literal_eval(node.value)\r\n    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'LiveBackend')\r\n    method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == '_aceptar_punto_usuario')\r\n    scope = dict(constants)\r\n    exec(compile(ast.Module(body=[method], type_ignores=[]), 'desktop_live_policy', 'exec'), scope)\r\n    return constants, scope['_aceptar_punto_usuario']\r\n\r\n\r\ndef simulate(y, sr, detector, interval, window, accept=None):\r\n    ts, fs, elapsed = [], [], []\r\n    last = 0.\r\n    state = SimpleNamespace(_ultimo_punto_usuario=None)\r\n    for end in np.arange(interval, len(y) / sr, interval):\r\n        start = max(0., end - window)\r\n        tic = time.perf_counter()\r\n        t, f = detector(y[int(start * sr):int(end * sr)], sr, offset_t=start, ruido_base=None)\r\n        new = t > last\r\n        if np.any(new):\r\n            last = float(t[new].max())\r\n            for ti, fi in zip(t[new], f[new]):\r\n                if accept is None or accept(state, [float(ti), float(69 + 12 * np.log2(fi / 440))]):\r\n                    ts.append(ti); fs.append(fi)\r\n        elapsed.append(time.perf_counter() - tic)\r\n    return np.asarray(ts), np.asarray(fs), elapsed\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    parser.add_argument('--development', action='store_true')\r\n    args = parser.parse_args()\r\n    before = load_before()\r\n    config, accept = ui_policy()\r\n    metadata = list(csv.DictReader((DATA / 'vocadito_metadata.csv').open(encoding='utf-8')))\r\n    if args.development:\r\n        metadata = [r for r in metadata if r['singer_id'] in DEVELOPMENT]\r\n    variants = ['antes', '0.6', '0.7', '0.8'] if args.development else ['antes', 'despues']\r\n    profiles = ['clasica', 'desktop']\r\n    rows = []\r\n    timings = {}\r\n    warm = .1 * np.sin(2 * np.pi * 220 * np.arange(16758) / 44100)\r\n    before.extraer_pitch_ligero_desde_audio(warm, 44100)\r\n    pitch.extraer_pitch_ligero_desde_audio(warm, 44100)\r\n    pred_dir = OUT / 'live_predicciones'\r\n    if not args.development:\r\n        pred_dir.mkdir(parents=True, exist_ok=True)\r\n    for n, row in enumerate(metadata, 1):\r\n        name = 'vocadito_' + row['track_id']\r\n        y, sr = sf.read(DATA / 'Audio' / (name + '.wav'), dtype='float32')\r\n        rt, ref = np.loadtxt(DATA / 'Annotations/F0' / (name + '_f0.csv'), delimiter=',').T\r\n        preds = {'time': rt, 'reference': ref}\r\n        result = {'track': name, 'singer': row['singer_id'],\r\n                  'split': 'development' if row['singer_id'] in DEVELOPMENT else 'validation', 'metrics': {}}\r\n        for profile in profiles:\r\n            interval, window, policy = (.06, .38, None) if profile == 'clasica' else (\r\n                config['LIVE_PITCH_INTERVAL'], config['LIVE_PITCH_CHUNK'], accept)\r\n            for variant in variants:\r\n                module = before if variant == 'antes' else pitch\r\n                if args.development and variant != 'antes':\r\n                    module.FILTRO_TIEMPO_REAL['min_periodicidad'] = float(variant)\r\n                t, f, durations = simulate(y, sr, module.extraer_pitch_ligero_desde_audio, interval, window, policy)\r\n                est = align(t, f, rt, 1024 / sr / 2)\r\n                key = profile + '_' + variant\r\n                c, _ = counts(ref, est)\r\n                preds[key] = est\r\n                result['metrics'][key] = {**percentages(c), 'counts': c}\r\n                timings.setdefault(key, []).extend(durations)\r\n        rows.append(result)\r\n        if not args.development:\r\n            np.savez_compressed(pred_dir / (name + '.npz'), **preds)\r\n        print(f'{n}/{len(metadata)} {name}', flush=True)\r\n    totals = {}\r\n    for group in ['all', 'development', 'validation']:\r\n        subset = [r for r in rows if group == 'all' or r['split'] == group]\r\n        if not subset:\r\n            continue\r\n        totals[group] = {}\r\n        for key in subset[0]['metrics']:\r\n            pooled = {field: sum(r['metrics'][key]['counts'][field] for r in subset)\r\n                      for field in subset[0]['metrics'][key]['counts']}\r\n            totals[group][key] = {**percentages(pooled), 'counts': pooled}\r\n    summary = {'development_singers': sorted(DEVELOPMENT), 'tracks': len(rows),\r\n               'desktop_config': config, 'config_live': dict(pitch.FILTRO_TIEMPO_REAL),\r\n               'pitch_sha256': hashlib.sha256((ROOT / 'audio/pitch.py').read_bytes()).hexdigest(),\r\n               'before_sha256': hashlib.sha256((OUT / 'antes/pitch.py').read_bytes()).hexdigest(),\r\n               'ui_sha256': hashlib.sha256((ROOT / 'desktop_live.py').read_bytes()).hexdigest(),\r\n               'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\r\n               'summary': totals, 'per_track': rows,\r\n               'timing_ms': {k: {'median': float(np.median(v)*1000), 'p95': float(np.percentile(v,95)*1000)}\r\n                             for k, v in timings.items()}}\r\n    if args.development:\r\n        # Objetivo fijado antes de mirar los resultados: reducir falsos positivos\r\n        # sin perder mas de 2 puntos de acierto ni aumentar omisiones mas de 2 puntos.\r\n        eligible = [v for v in variants[1:]\r\n                    if all(totals['all'][p + '_' + v]['pitch_correct_50c_pct'] >= totals['all'][p + '_antes']['pitch_correct_50c_pct'] - 2\r\n                           and totals['all'][p + '_' + v]['missed_voiced_pct'] <= totals['all'][p + '_antes']['missed_voiced_pct'] + 2\r\n                           for p in profiles)]\r\n        summary['selected_threshold'] = min(eligible, key=lambda v: sum(totals['all'][p + '_' + v]['false_voiced_pct'] for p in profiles)) if eligible else None\r\n    name = 'desarrollo_live.json' if args.development else 'comparacion_live.json'\r\n    (OUT / name).write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding='utf-8')\r\n    print(json.dumps({'summary': totals, 'selected_threshold': summary.get('selected_threshold')}, indent=2))\r\n\r\n\r\nif __name__ == '__main__':\r\n    main()\r\n", "exitCode": 0, "durationMs": 443}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "rs_06f6aa8593d2a892016abbd1f5550887d2b702f4c3d22f8cd1", "rollout_ordinal": 1021, "created_at_ms": 1790693877567, "item_type": "reasoning", "updated_at_ordinal": 1021, "started_at_ms": 1790693877567, "completed_at_ms": 1790693878796}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abbd1f5550887d2b702f4c3d22f8cd1", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-5a609d91-3a4f-48ed-b15f-45da52d5c156", "rollout_ordinal": 1025, "created_at_ms": 1790693881126, "item_type": "commandExecution", "updated_at_ordinal": 1025, "started_at_ms": 1790693881126, "completed_at_ms": 1790693882049}, "item": {"type": "commandExecution", "id": "exec-5a609d91-3a4f-48ed-b15f-45da52d5c156", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"rg -n -A 65 '\"'^def (align|counts|percentages|check_evaluator)'\"' scripts/evaluar_vocadito.py\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "41364", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "rg -n -A 65 '^def (align|counts|percentages|check_evaluator)' scripts/evaluar_vocadito.py"}], "aggregatedOutput": "29:def align(t, f, target, tolerance):\n30-    \"\"\"Vecino mas cercano acotado: nunca une silencios entre puntos validos.\"\"\"\n31-    out = np.zeros(len(target))\n32-    if not len(t):\n33-        return out\n34-    assert len(t) == len(f) and np.all(np.diff(t) > 0)\n35-    right = np.clip(np.searchsorted(t, target), 0, len(t) - 1)\n36-    left = np.maximum(right - 1, 0)\n37-    idx = np.where(abs(t[left] - target) <= abs(t[right] - target), left, right)\n38-    valid = abs(t[idx] - target) <= tolerance + 1e-9\n39-    out[valid] = f[idx[valid]]\n40-    return out\n41-\n42-\n43:def counts(ref, est):\n44-    rv, ev = ref > 0, est > 0\n45-    both = rv & ev\n46-    cents = 1200 * np.log2(est[both] / ref[both])\n47-    good = abs(cents) <= 50\n48-    octaves = abs(abs(cents) - 1200) <= 50\n49-    return {\n50-        'frames': len(ref), 'voiced': int(rv.sum()), 'unvoiced': int((~rv).sum()),\n51-        'both_voiced': int(both.sum()), 'correct_pitch': int(good.sum()),\n52-        'missed': int((rv & ~ev).sum()), 'false_voiced': int((~rv & ev).sum()),\n53-        'correct_unvoiced': int((~rv & ~ev).sum()),\n54-        'octave_errors': int(octaves.sum()),\n55-    }, abs(cents)\n56-\n57-\n58:def percentages(c):\n59-    def pct(n, d):\n60-        return 100 * n / d if d else None\n61-    return {\n62-        'pitch_correct_50c_pct': pct(c['correct_pitch'], c['voiced']),\n63-        'missed_voiced_pct': pct(c['missed'], c['voiced']),\n64-        'false_voiced_pct': pct(c['false_voiced'], c['unvoiced']),\n65-        'octave_error_pct': pct(c['octave_errors'], c['voiced']),\n66-        'overall_accuracy_pct': pct(c['correct_pitch'] + c['correct_unvoiced'], c['frames']),\n67-    }\n68-\n69-\n70-def stream(y, sr):\n71-    \"\"\"Simula worker: ventana 380 ms, llamadas 60 ms, solo puntos nuevos.\n72-\n73-    Sin hardware/cola, sin ruido de calibracion y sin descarte de llamadas.\n74-    Se conservan tiempos reales de disponibilidad para estimar retraso.\n75-    \"\"\"\n76-    ts, fs, delays, calls = [], [], [], []\n77-    last = 0.0\n78-    for end in np.arange(0.06, len(y) / sr, 0.06):\n79-        start = max(0.0, end - 0.38)\n80-        chunk = y[int(start * sr):int(end * sr)]\n81-        tic = time.perf_counter()\n82-        t, f = pitch.extraer_pitch_ligero_desde_audio(chunk, sr, offset_t=start, ruido_base=None)\n83-        elapsed = time.perf_counter() - tic\n84-        calls.append(elapsed)\n85-        new = t > last\n86-        if np.any(new):\n87-            ts.extend(t[new]); fs.extend(f[new])\n88-            delays.extend(end - t[new] + elapsed)\n89-            last = float(t[new].max())\n90-    return np.asarray(ts), np.asarray(fs), np.asarray(calls), np.asarray(delays)\n91-\n92-\n93:def check_evaluator():\n94-    # Un hueco no se interpola como una nota sostenida.\n95-    assert np.array_equal(align(np.array([0., .02]), np.array([440., 440.]),\n96-                               np.array([0., .01, .02]), .004), [440., 0., 440.])\n97-    c, _ = counts(np.array([440., 440., 440., 0., 0.]),\n98-                  np.array([440., 880., 0., 440., 0.]))\n99-    assert c['correct_pitch'] == c['missed'] == c['octave_errors'] == c['false_voiced'] == 1\n100-\n101-\n102-def main():\n103-    parser = argparse.ArgumentParser()\n104-    parser.add_argument('--data', type=Path, default=ROOT / 'data/vocadito_benchmark')\n105-    parser.add_argument('--output', type=Path, default=ROOT / 'output/vocadito_benchmark')\n106-    parser.add_argument('--limit', type=int)\n107-    args = parser.parse_args()\n108-    check_evaluator()\n109-    args.output.mkdir(parents=True, exist_ok=True)\n110-    (args.output / 'predicciones').mkdir(exist_ok=True)\n111-    archive = args.data / 'vocadito.zip'\n112-    checksum = hashlib.md5(archive.read_bytes()).hexdigest()\n113-    assert checksum == 'dea40fd18f14d899643c4ba221b33a46', 'Dataset no coincide con v3'\n114-    files = sorted((args.data / 'Audio').glob('*.wav'), key=lambda p: int(p.stem.split('_')[-1]))\n115-    assert len(files) == 40, f'Se esperaban 40 audios, hay {len(files)}'\n116-    files = files[:args.limit] if args.limit else files\n117-    # Warmup excluido de tiempos; tambien registra el coste de arranque.\n118-    tic = time.perf_counter()\n119-    warm = .1 * np.sin(2 * np.pi * 220 * np.arange(44100) / 44100)\n120-    pitch._extraer_pitch_base(warm, 44100)\n121-    pitch.extraer_pitch_ligero_desde_audio(warm[:16758], 44100)\n122-    warmup = time.perf_counter() - tic\n123-    all_counts = {m: [] for m in MODES}\n124-    all_cents = {m: [] for m in MODES}\n125-    rows, call_times, delays, base_times, audio_seconds = [], [], [], [], 0.\n126-    for n, path in enumerate(files, 1):\n127-        y, sr = sf.read(path, dtype='float32')\n128-        assert y.ndim == 1 and sr == 44100\n129-        duration = len(y) / sr\n130-        audio_seconds += duration\n131-        reference = np.loadtxt(args.data / 'Annotations/F0' / (path.stem + '_f0.csv'), delimiter=',')\n132-        rt, rf = reference.T\n133-        assert np.all(np.diff(rt) > 0) and np.all(rf >= 0)\n134-        tic = time.perf_counter()\n135-        t, f = pitch._extraer_pitch_base(y, sr)\n136-        base_elapsed = time.perf_counter() - tic\n137-        base_times.append(base_elapsed)\n138-        tf, ff = pitch._filtrar_pitch(t, f.copy(), y, sr, corregir_octavas=False)\n139-        tc, fc = pitch._corregir_octavas_por_registro(tf, ff.copy())\n140-        hop = float(np.median(np.diff(t)))\n141-        predictions = {\n142-            'base': align(t, f, rt, hop / 2),\n143-            'filtrado': align(tf, ff, rt, hop / 2),\n144-            'final': align(tc, fc, rt, hop / 2),\n145-        }\n146-        st, sfreq, calls, delay = stream(y, sr)\n147-        predictions['yin_stream'] = align(st, sfreq, rt, 1024 / sr / 2)\n148-        call_times.extend(calls); delays.extend(delay)\n149-        row = {'track': path.stem, 'duration_s': duration, 'base_processing_s': base_elapsed, 'metrics': {}}\n150-        for mode, est in predictions.items():\n151-            c, error = counts(rf, est)\n152-            all_counts[mode].append(c); all_cents[mode].append(error)\n153-            row['metrics'][mode] = {**percentages(c), 'counts': c,\n154-                'median_abs_cents_both_voiced': float(np.median(error)) if len(error) else None}\n155-        rows.append(row)\n156-        np.savez_compressed(args.output / 'predicciones' / (path.stem + '.npz'),\n157-                            time=rt, reference=rf, **predictions)\n158-        print(f'{n}/{len(files)} {path.stem}: final={row[\"metrics\"][\"final\"][\"pitch_correct_50c_pct\"]:.1f}% '\n", "exitCode": 0, "durationMs": 922}}
