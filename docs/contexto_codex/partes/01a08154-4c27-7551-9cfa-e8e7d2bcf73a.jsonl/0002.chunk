{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "msg_06f6aa8593d2a892016abc604158ac87d2990a5ac197d3520f", "rollout_ordinal": 1381, "created_at_ms": 1790730306223, "item_type": "agentMessage", "updated_at_ordinal": 1381, "started_at_ms": 1790730306223, "completed_at_ms": 1790730307938}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abc604158ac87d2990a5ac197d3520f", "text": "La nueva evaluación reproduce exactamente los resultados del filtro actual en las pistas de Vocadito comprobadas. Eso confirma que la comparación parte de la misma referencia. La calibración ya está probando también los casos con música de MIR-1K.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-811a7aa9-e208-46e3-9842-035380ea0b11", "rollout_ordinal": 1385, "created_at_ms": 1790730312471, "item_type": "commandExecution", "updated_at_ordinal": 1385, "started_at_ms": 1790730312471, "completed_at_ms": 1790730314653}, "item": {"type": "commandExecution", "id": "exec-811a7aa9-e208-46e3-9842-035380ea0b11", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python -c \\\"import json; from pathlib import Path; from scripts.calibrar_multidataset import aggregate; rs=[json.loads(p.read_text()) for p in Path('output/calibracion_multidataset/calibracion').glob('*.json')]; s=aggregate(rs);\nfor g,vs in s.items():\n print(g)\n for v,m in vs.items(): print(v,*(round(m[k],2) for k in ['pitch_correct_50c_pct','false_voiced_pct','missed_voiced_pct']))\\\"\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "12959", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python -c \"import json; from pathlib import Path; from scripts.calibrar_multidataset import aggregate; rs=[json.loads(p.read_text()) for p in Path('output/calibracion_multidataset/calibracion').glob('*.json')]; s=aggregate(rs);\nfor g,vs in s.items():\n print(g)\n for v,m in vs.items(): print(v,*(round(m[k],2) for k in ['pitch_correct_50c_pct','false_voiced_pct','missed_voiced_pct']))\""}], "aggregatedOutput": "mir1k/voz\r\nbase 92.26 6.95 6.36\r\numbral_060 92.75 8.18 5.72\r\numbral_050 93.63 9.48 4.75\r\ncontinuidad_050 92.53 7.96 6.01\r\ncontinuidad_040 92.56 8.42 5.97\r\ncontinuidad_060 92.25 7.5 6.34\r\ncontinuidad_065_045 92.52 8.64 6.0\r\nmir1k/musica10\r\nbase 69.44 12.41 25.92\r\numbral_060 69.22 18.22 24.64\r\numbral_050 68.37 24.99 24.63\r\ncontinuidad_050 68.82 17.01 25.25\r\ncontinuidad_040 68.87 17.73 25.06\r\ncontinuidad_060 68.9 15.49 25.48\r\ncontinuidad_065_045 67.77 20.71 25.83\r\nmir1k/musica0\r\nbase 15.56 21.32 67.49\r\numbral_060 18.77 29.38 57.26\r\numbral_050 20.09 37.48 49.76\r\ncontinuidad_050 17.84 26.98 60.71\r\ncontinuidad_040 17.8 27.8 60.15\r\ncontinuidad_060 17.2 24.99 62.52\r\ncontinuidad_065_045 19.14 31.57 55.9\r\nvocadito/voz\r\nbase 93.62 12.58 4.6\r\numbral_060 93.64 15.03 4.46\r\numbral_050 93.67 17.53 4.39\r\ncontinuidad_050 93.78 15.21 4.38\r\ncontinuidad_040 93.7 16.29 4.43\r\ncontinuidad_060 93.8 13.96 4.38\r\ncontinuidad_065_045 93.6 16.28 4.49\r\n", "exitCode": 0, "durationMs": 2182}}
