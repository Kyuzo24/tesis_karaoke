9996,\r\n      \"missed_voiced_pct\": -13.388162836112357\r\n    },\r\n    \"mir1k/musica10\": {\r\n      \"pitch_correct_50c_pct\": 2.512392969806214,\r\n      \"false_voiced_pct\": -6.124444444444445,\r\n      \"missed_voiced_pct\": -2.1180712032447033\r\n    },\r\n    \"mir1k/voz\": {\r\n      \"pitch_correct_50c_pct\": 0.09764158029142322,\r\n      \"false_voiced_pct\": -1.9733333333333336,\r\n      \"missed_voiced_pct\": -0.15021781583295724\r\n    },\r\n    \"mdb/voz\": {\r\n      \"pitch_correct_50c_pct\": -0.34687888202270756,\r\n      \"false_voiced_pct\": -0.34088115268362024,\r\n      \"missed_voiced_pct\": 0.44711850676900333\r\n    }\r\n  }\r\n}\r\n{\r\n  \"feature_windows_checked\": 1155,\r\n  \"full_audio_checks\": [\r\n    \"vocadito/vocadito_10/voz\",\r\n    \"mir1k/Kenshin_5_03/voz\",\r\n    \"mir1k/Kenshin_5_03/musica10\",\r\n    \"mir1k/Kenshin_5_03/musica0\",\r\n    \"mdb/AvaLuna_Waterduct_STEM_08/voz\"\r\n  ],\r\n  \"processing_ms\": {\r\n    \"median\": 2.007799997954862,\r\n    \"p95\": 3.382160000910516\r\n  },\r\n  \"model_sha256\": \"1cd0b229a988a03aadb1fbbe8853a4b8f811c1629a85ec4eba092e90ac8efed1\",\r\n  \"pitch_sha256\": \"abf33d28b50d97a7a64248cec8feea6d45a266ff8c27b1bf10728da6244e6a53\",\r\n  \"inference_sha256\": \"4b3162071cf9982da5c2b1902ff3d7b65599e47e9d353f7893def42f704987ae\"\r\n}\r\n", "exitCode": 0, "durationMs": 1571}}
