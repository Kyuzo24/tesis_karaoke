{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0eda3-e2a4-7e12-96a0-4fcd3605e23a", "item_id": "exec-90602235-2485-428c-ab0c-9992239574b2", "rollout_ordinal": 1241, "created_at_ms": 1790694589630, "item_type": "commandExecution", "updated_at_ordinal": 1241, "started_at_ms": 1790694589630, "completed_at_ms": 1790694593849}, "item": {"type": "commandExecution", "id": "exec-90602235-2485-428c-ab0c-9992239574b2", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"python scripts/informe_mdb.py\npython -c \\\"import json,hashlib,numpy as np; from pathlib import Path; p=Path('output/mdb_evaluacion'); r=json.loads((p/'resultados.json').read_text()); assert len(list((p/'tracks').glob('*.json')))==len(list((p/'predicciones').glob('*.npz')))==r['tracks']==60; assert hashlib.sha256(Path('audio/pitch.py').read_bytes()).hexdigest()==r['protocol']['pitch_sha256'];\nfor row in r['per_track']:\n z=np.load(p/'predicciones'/(row['track']+'.npz')); assert all(np.isfinite(z[k]).all() for k in z.files); assert len(set(len(z[k]) for k in z.files))==1\n for v in ['antes','despues']:\n  c=row['metrics'][v]['counts']; assert c['voiced']+c['unvoiced']==c['frames']; assert c['both_voiced']+c['missed']==c['voiced']; assert c['false_voiced']+c['correct_unvoiced']==c['unvoiced']\n assert row['metrics']['antes']['counts']['frames']==row['metrics']['despues']['counts']['frames']\nprint(json.dumps({k:r[k] for k in ['tracks','songs','duration_s','summary','reference_below_C2','reference_above_C6']},indent=2)); print('VALIDACION COMPLETA OK')\\\"\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "93169", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python scripts/informe_mdb.py\npython -c \"import json,hashlib,numpy as np; from pathlib import Path; p=Path('output/mdb_evaluacion'); r=json.loads((p/'resultados.json').read_text()); assert len(list((p/'tracks').glob('*.json')))==len(list((p/'predicciones').glob('*.npz')))==r['tracks']==60; assert hashlib.sha256(Path('audio/pitch.py').read_bytes()).hexdigest()==r['protocol']['pitch_sha256'];\nfor row in r['per_track']:\n z=np.load(p/'predicciones'/(row['track']+'.npz')); assert all(np.isfinite(z[k]).all() for k in z.files); assert len(set(len(z[k]) for k in z.files))==1\n for v in ['antes','despues']:\n  c=row['metrics'][v]['counts']; assert c['voiced']+c['unvoiced']==c['frames']; assert c['both_voiced']+c['missed']==c['voiced']; assert c['false_voiced']+c['correct_unvoiced']==c['unvoiced']\n assert row['metrics']['antes']['counts']['frames']==row['metrics']['despues']['counts']['frames']\nprint(json.dumps({k:r[k] for k in ['tracks','songs','duration_s','summary','reference_below_C2','reference_above_C6']},indent=2)); print('VALIDACION COMPLETA OK')\""}], "aggregatedOutput": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\output\\mdb_evaluacion\\informe.md\r\n{\r\n  \"tracks\": 60,\r\n  \"songs\": 47,\r\n  \"duration_s\": 11954.534444444444,\r\n  \"summary\": {\r\n    \"antes\": {\r\n      \"pitch_correct_50c_pct\": 90.41795171753695,\r\n      \"missed_voiced_pct\": 4.818969047904584,\r\n      \"false_voiced_pct\": 0.9258321898317543,\r\n      \"octave_error_pct\": 0.3447858424540832,\r\n      \"overall_accuracy_pct\": 95.35890917831468,\r\n      \"counts\": {\r\n        \"frames\": 4118730,\r\n        \"voiced\": 1767764,\r\n        \"unvoiced\": 2350966,\r\n        \"both_voiced\": 1682576,\r\n        \"correct_pitch\": 1598376,\r\n        \"missed\": 85188,\r\n        \"false_voiced\": 21766,\r\n        \"correct_unvoiced\": 2329200,\r\n        \"octave_errors\": 6095\r\n      },\r\n      \"macro_pitch_correct_50c_pct\": 89.01097445597443\r\n    },\r\n    \"despues\": {\r\n      \"pitch_correct_50c_pct\": 88.7049968208426,\r\n      \"missed_voiced_pct\": 8.030314001190204,\r\n      \"false_voiced_pct\": 0.7134514067834243,\r\n      \"octave_error_pct\": 0.31808544579480064,\r\n      \"overall_accuracy_pct\": 94.74493351105802,\r\n      \"counts\": {\r\n        \"frames\": 4118730,\r\n        \"voiced\": 1767764,\r\n        \"unvoiced\": 2350966,\r\n        \"both_voiced\": 1625807,\r\n        \"correct_pitch\": 1568095,\r\n        \"missed\": 141957,\r\n        \"false_voiced\": 16773,\r\n        \"correct_unvoiced\": 2334193,\r\n        \"octave_errors\": 5623\r\n      },\r\n      \"macro_pitch_correct_50c_pct\": 87.40339499994073\r\n    }\r\n  },\r\n  \"reference_below_C2\": 454,\r\n  \"reference_above_C6\": 0\r\n}\r\nVALIDACION COMPLETA OK\r\n", "exitCode": 0, "durationMs": 4218}}
