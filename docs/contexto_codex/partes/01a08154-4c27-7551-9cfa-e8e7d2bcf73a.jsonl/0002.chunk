{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "rs_06f6aa8593d2a892016abc659fbf4087d297bbc4e06392ef0b", "rollout_ordinal": 1700, "created_at_ms": 1790731680564, "item_type": "reasoning", "updated_at_ordinal": 1700, "started_at_ms": 1790731680564, "completed_at_ms": 1790731696117}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abc659fbf4087d297bbc4e06392ef0b", "summary": ["**Adding opt-in pitch filter**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "msg_06f6aa8593d2a892016abc65af568487d2bf515934aa936219", "rollout_ordinal": 1702, "created_at_ms": 1790731696153, "item_type": "agentMessage", "updated_at_ordinal": 1702, "started_at_ms": 1790731696153, "completed_at_ms": 1790731700073}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016abc65af568487d2bf515934aa936219", "text": "El modelo también superó los límites fijados en las 55 grabaciones reservadas. En MIR-1K con la voz 10 dB sobre la música, los aciertos subieron de **73,47 % a 75,12 %** y las falsas notas bajaron de **10,33 % a 4,28 %**.\n\nHay un coste pequeño: en Vocadito y MDB bajan unos 0,37 puntos los aciertos. La mejora está principalmente en reducir falsas detecciones y manejar mejor las mezclas; no mejora todas las métricas por igual.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "rs_06f6aa8593d2a892016abc65c2d34c87d29e4fbb31fb4f6866", "rollout_ordinal": 1708, "created_at_ms": 1790731715672, "item_type": "reasoning", "updated_at_ordinal": 1708, "started_at_ms": 1790731715672, "completed_at_ms": 1790731724485}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abc65c2d34c87d29e4fbb31fb4f6866", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0efd4-365e-7141-8747-ea98e8d77c19", "item_id": "exec-9ac6dbb9-c599-4db7-8a98-cc6f4e8a5e42", "rollout_ordinal": 1711, "created_at_ms": 1790731767006, "item_type": "fileChange", "updated_at_ordinal": 1711, "started_at_ms": 1790731767006, "completed_at_ms": 1790731767008}, "item": {"type": "fileChange", "id": "exec-9ac6dbb9-c599-4db7-8a98-cc6f4e8a5e42", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\filtro_aprendido.py", "kind": {"type": "add"}, "diff": "\"\"\"Aceptación de candidatos YIN con un árbol exportado a JSON.\n\nNo requiere scikit-learn en ejecución. El entrenamiento y la validación están\ndocumentados en output/filtro_aprendido/informe.md.\n\"\"\"\nfrom functools import lru_cache\nimport json\nfrom pathlib import Path\n\nimport numpy as np\n\nCARACTERISTICAS = [\n    'periodicidad', 'energia_relativa', 'log10_rms',\n    'periodicidad_anterior', 'periodicidad_siguiente',\n    'salto_min_semitonos', 'salto_max_semitonos',\n    'periodicidad_media', 'fraccion_periodica',\n]\nRUTA_MODELO = Path(__file__).with_name('filtro_pitch.json')\n\n\ndef caracteristicas(f0, periodicidad, energia):\n    \"\"\"Describe candidatos con las muestras ya disponibles en la ventana.\"\"\"\n    f0 = np.asarray(f0, dtype=float)\n    p = np.asarray(periodicidad, dtype=float)\n    e = np.asarray(energia, dtype=float)\n    if not len(f0):\n        return np.empty((0, len(CARACTERISTICAS)), dtype=np.float32)\n    anterior = np.r_[p[0], p[:-1]]\n    siguiente = np.r_[p[1:], p[-1]]\n    midi = 69 + 12 * np.log2(np.maximum(f0, 1) / 440)\n    salto_a = np.minimum(24, abs(midi - np.r_[midi[0], midi[:-1]]))\n    salto_s = np.minimum(24, abs(midi - np.r_[midi[1:], midi[-1]]))\n    return np.column_stack([\n        p, e / max(float(e.max()), 1e-12), np.log10(np.maximum(e, 1e-8)),\n        anterior, siguiente, np.minimum(salto_a, salto_s),\n        np.maximum(salto_a, salto_s), np.full(len(f0), np.mean(p)),\n        np.full(len(f0), np.mean(p >= .7)),\n    ]).astype(np.float32)\n\n\n@lru_cache(maxsize=1)\ndef _cargar_modelo():\n    try:\n        data = json.loads(RUTA_MODELO.read_text(encoding='utf-8'))\n        if data['features'] != CARACTERISTICAS:\n            return None\n        tree = data['tree']\n        result = {k: np.asarray(tree[k], dtype=int if k in ['feature', 'left', 'right'] else float)\n                  for k in ['feature', 'threshold', 'left', 'right', 'probability']}\n        n = len(result['feature'])\n        if not n or any(a.shape != (n,) or not np.isfinite(a).all() for a in result.values()):\n            return None\n        branches = result['feature'] >= 0\n        if np.any(result['feature'][branches] >= len(CARACTERISTICAS)):\n            return None\n        # Los hijos posteriores al padre impiden ciclos en un JSON dañado.\n        for key in ['left', 'right']:\n            children = result[key][branches]\n            if np.any(children <= np.flatnonzero(branches)) or np.any(children >= n):\n                return None\n        cutoff, floor = float(data['cutoff']), float(data['periodicity_floor'])\n        if not (0 <= cutoff <= 1 and 0 <= floor <= 1):\n            return None\n        result.update(cutoff=cutoff, floor=floor)\n        return result\n    except (OSError, ValueError, KeyError, TypeError):\n        return None\n\n\ndef aceptar_candidatos(f0, periodicidad, energia):\n    \"\"\"Devuelve None si no hay modelo válido para conservar el filtro anterior.\"\"\"\n    model = _cargar_modelo()\n    if model is None:\n        return None\n    x = caracteristicas(f0, periodicidad, energia)\n    nodes = np.zeros(len(x), dtype=int)\n    feature = model['feature']\n    while np.any(feature[nodes] >= 0):\n        ids = np.flatnonzero(feature[nodes] >= 0)\n        current = nodes[ids]\n        nodes[ids] = np.where(\n            x[ids, feature[current]] <= model['threshold'][current],\n            model['left'][current], model['right'][current],\n        )\n    return ((model['probability'][nodes] >= model['cutoff'])\n            & (np.asarray(periodicidad) >= model['floor']))\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\pitch.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -2,2 +2,3 @@\n import numpy as np\n+from audio.filtro_aprendido import aceptar_candidatos\n \n@@ -32,2 +33,3 @@\n     \"min_periodicidad\": 0.7,\n+    \"usar_filtro_aprendido\": False,\n }\n@@ -139,2 +141,3 @@\n     raw_points = int(np.sum(f0 > 0))\n+    candidatos = f0.copy()\n     rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\n@@ -159,2 +162,6 @@\n         periodicos = np.asarray(periodicidad) >= config.get(\"min_periodicidad\", 0.7)\n+        if config.get(\"usar_filtro_aprendido\", False):\n+            aprendidos = aceptar_candidatos(candidatos, periodicidad, energia)\n+            if aprendidos is not None:\n+                periodicos = aprendidos\n         f0[~periodicos] = 0\n"}], "status": "completed"}}
