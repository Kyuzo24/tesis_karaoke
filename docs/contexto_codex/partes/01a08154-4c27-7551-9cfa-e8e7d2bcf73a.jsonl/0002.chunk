anifest.json','data/mdb_stem_synth/manifest.json','data/vocadito_benchmark/vocadito_metadata.csv']; doc={'files':{f:hashlib.sha256(Path(f).read_bytes()).hexdigest() for f in files},'versions':{n:importlib.metadata.version(n) for n in ['scikit-learn','numpy','librosa','soundfile']}}; (p/'procedencia.json').write_text(json.dumps(doc,indent=2),encoding='utf-8'); print('Procedencia registrada')\""}], "aggregatedOutput": "Procedencia registrada\r\n", "exitCode": 0, "durationMs": 957}}
