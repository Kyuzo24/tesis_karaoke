{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0f117-a5f1-7111-b278-9eb39cf5349f", "item_id": "rs_06f6aa8593d2a892016abcb2625b8c87d2b79c53e38873e8ac", "rollout_ordinal": 1891, "created_at_ms": 1790751331777, "item_type": "reasoning", "updated_at_ordinal": 1891, "started_at_ms": 1790751331777, "completed_at_ms": 1790751349404}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016abcb2625b8c87d2b79c53e38873e8ac", "summary": ["**Testing model opt-in handling**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a0f117-a5f1-7111-b278-9eb39cf5349f", "item_id": "exec-9bf8f929-b923-4c44-aeda-a3427612047e", "rollout_ordinal": 1894, "created_at_ms": 1790751371747, "item_type": "fileChange", "updated_at_ordinal": 1894, "started_at_ms": 1790751371747, "completed_at_ms": 1790751371748}, "item": {"type": "fileChange", "id": "exec-9bf8f929-b923-4c44-aeda-a3427612047e", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\verificar_filtro_aprendido.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -3,2 +3,3 @@\n import argparse,json,sys,hashlib\n+from functools import partial\n import numpy as np\n@@ -27,3 +28,3 @@\n     selected=[next(r for r in inv if r['dataset']==ds and r['stage']=='validacion') for ds in ['vocadito','mir1k','mdb']]\n-    pitch.FILTRO_TIEMPO_REAL['usar_filtro_aprendido']=True\n+    detector=partial(pitch.extraer_pitch_ligero_desde_audio,usar_filtro_aprendido=True)\n     checks=[];timings=[]\n@@ -34,5 +35,5 @@\n         for condition,y in scenarios.items():\n-            t,f,durations=simulate(y,sr,pitch.extraer_pitch_ligero_desde_audio,interval,window,accept if args.profile=='desktop' else None)\n+            t,f,durations=simulate(y,sr,detector,interval,window,accept if args.profile=='desktop' else None)\n             result=counts(ref,align(t,f,rt,1024/sr/2))[0]\n-            assert result==expected['metrics'][condition][model['name']]['counts'] if 'counts' in expected['metrics'][condition][model['name']] else result==expected['metrics'][condition][model['name']],(row['name'],condition)\n+            assert result==expected['metrics'][condition][model['name']],(row['name'],condition)\n             checks.append(row['dataset']+'/'+row['name']+'/'+condition);timings.extend(durations)\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\tests\\test_pitch.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -102,2 +102,30 @@\n \n+    def test_explicit_selection_does_not_modify_shared_defaults(self):\n+        y = tone(44100)\n+        with patch.dict(pitch.FILTRO_TIEMPO_REAL, usar_filtro_aprendido=False):\n+            with patch.object(pitch, 'aceptar_candidatos', return_value=None) as learned:\n+                pitch.extraer_pitch_ligero_desde_audio(y, 44100)\n+                learned.assert_not_called()\n+                pitch.extraer_pitch_ligero_desde_audio(y, 44100, usar_filtro_aprendido=True)\n+                learned.assert_called_once()\n+                self.assertFalse(pitch.FILTRO_TIEMPO_REAL['usar_filtro_aprendido'])\n+\n+    def test_worker_passes_explicit_filter_selection(self):\n+        import queue\n+        import threading\n+        from audio import karaoke\n+        for enabled in [False, True]:\n+            q = queue.Queue()\n+            q.put((0., tone(44100)))\n+            stop = threading.Event()\n+            stop.set()\n+            with patch.object(karaoke, 'extraer_pitch_ligero_desde_audio',\n+                              return_value=(np.array([.1]), np.array([440.]), {})) as detector:\n+                received = []\n+                karaoke._worker_pitch_tiempo_real(q, stop, lambda t, f: received.extend(f),\n+                                                 None, 44100, .001, usar_filtro_aprendido=enabled)\n+                self.assertEqual(detector.call_args.kwargs['usar_filtro_aprendido'], enabled)\n+                self.assertEqual(received, [440.])\n+                self.assertEqual(q.unfinished_tasks, 0)\n+\n \n"}], "status": "completed"}}
