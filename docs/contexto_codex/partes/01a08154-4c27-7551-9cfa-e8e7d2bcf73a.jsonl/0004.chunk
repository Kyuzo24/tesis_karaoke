ght')))\""}], "aggregatedOutput": "<!doctype html>\r\n<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <title>Karaoke Studio</title>\r\n  <link rel=\"stylesheet\" href=\"styles.css\">\r\n</head>\r\n<body data-view=\"practice\">\r\n  <main class=\"app-shell\">\r\n    <aside class=\"side-nav\">\r\n      <div class=\"brand\">\r\n        <div class=\"brand-mark\">K</div>\r\n        <div>\r\n          <div class=\"brand-title\">Karaoke Studio</div>\r\n          <div class=\"brand-subtitle\">Afinacion en tiempo real</div>\r\n        </div>\r\n      </div>\r\n\r\n      <nav class=\"app-nav\" aria-label=\"Vistas principales\">\r\n        <button class=\"nav-item\" type=\"button\" data-view-target=\"library\">Biblioteca</button>\r\n        <button class=\"nav-item is-active\" type=\"button\" data-view-target=\"practice\">Practicar</button>\r\n        <button class=\"nav-item\" type=\"button\" data-view-target=\"result\">Resultado</button>\r\n        <button class=\"nav-item\" type=\"button\" data-view-target=\"history\">Historial</button>\r\n        <button class=\"nav-item\" type=\"button\" data-view-target=\"diagnostics\">Diagnostico</button>\r\n        <button class=\"nav-item\" type=\"button\" data-view-target=\"settings\">Ajustes</button>\r\n      </nav>\r\n\r\n      <section class=\"now-card\">\r\n        <div class=\"section-label\">Cancion actual</div>\r\n        <strong id=\"selectedSongMini\">Sin canciones</strong>\r\n        <span id=\"selectedSongMiniMeta\">Catalogo vacio</span>\r\n      </section>\r\n\r\n      <div class=\"status-strip\">\r\n        <span class=\"status-dot\" id=\"statusDot\"></span>\r\n        <span id=\"statusLabel\">Listo</span>\r\n      </div>\r\n    </aside>\r\n\r\n    <section class=\"workspace\">\r\n      <header class=\"topbar\">\r\n        <div>\r\n          <div class=\"eyebrow\" id=\"artistLabel\">Catalogo</div>\r\n          <h1 id=\"songTitle\">Karaoke Studio</h1>\r\n        </div>\r\n      </header>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"library\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Biblioteca</div>\r\n            <h2>Canciones</h2>\r\n          </div>\r\n          <div class=\"library-actions\">\r\n            <button class=\"button button-primary\" id=\"addButton\" type=\"button\">Agregar</button>\r\n            <button class=\"button\" id=\"editButton\" type=\"button\" disabled>Editar</button>\r\n            <button class=\"button\" id=\"reprocessButton\" type=\"button\" disabled>Reprocesar</button>\r\n            <button class=\"button button-danger\" id=\"deleteButton\" type=\"button\" disabled>Eliminar</button>\r\n          </div>\r\n        </div>\r\n        <div class=\"library-layout\">\r\n          <section class=\"song-browser\">\r\n            <div class=\"song-list\" id=\"songList\"></div>\r\n          </section>\r\n          <aside class=\"song-detail\">\r\n            <div class=\"section-label\">Seleccion</div>\r\n            <h3 id=\"librarySongTitle\">Sin cancion seleccionada</h3>\r\n            <p id=\"librarySongMeta\">Agrega una cancion para comenzar.</p>\r\n            <button class=\"button button-primary button-large\" id=\"libraryPracticeButton\" type=\"button\" disabled>Practicar</button>\r\n          </aside>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"view-panel is-active\" data-view-panel=\"practice\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Practicar</div>\r\n            <h2>Referencia y voz en vivo</h2>\r\n          </div>\r\n        </div>\r\n        <div id=\"practiceChartMount\"></div>\r\n      </section>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"result\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Resultado</div>\r\n            <h2>Ultima toma</h2>\r\n          </div>\r\n        </div>\r\n        <section class=\"metrics-grid\">\r\n          <article class=\"metric-tile\">\r\n            <span>Afinacion</span>\r\n            <strong id=\"metricTight\">--</strong>\r\n            <p id=\"metricTightNote\">--</p>\r\n          </article>\r\n          <article class=\"metric-tile\">\r\n            <span>Margen</span>\r\n            <strong id=\"metricLoose\">--</strong>\r\n            <p id=\"metricLooseNote\">--</p>\r\n          </article>\r\n          <article class=\"metric-tile\">\r\n            <span>Tendencia</span>\r\n            <strong id=\"metricTrend\">--</strong>\r\n            <p id=\"metricTrendNote\">--</p>\r\n          </article>\r\n          <article class=\"metric-tile\">\r\n            <span>Voz util</span>\r\n            <strong id=\"metricPoints\">--</strong>\r\n            <p id=\"metricPointsNote\">--</p>\r\n          </article>\r\n        </section>\r\n        <div class=\"result-layout\">\r\n          <div id=\"resultChartMount\"></div>\r\n          <div id=\"resultPlayerMount\"></div>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"history\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Historial</div>\r\n            <h2>Tomas guardadas</h2>\r\n          </div>\r\n        </div>\r\n        <div class=\"history-layout\">\r\n          <section class=\"takes-panel\">\r\n            <div class=\"take-list\" id=\"takeList\"></div>\r\n          </section>\r\n          <section class=\"history-detail\">\r\n            <div id=\"historyChartMount\"></div>\r\n            <div id=\"historyPlayerMount\"></div>\r\n          </section>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"diagnostics\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Diagnostico</div>\r\n            <h2>Lectura de referencia</h2>\r\n          </div>\r\n          <button class=\"button\" id=\"referenceDiagnosticButton\" type=\"button\">Analizar referencia</button>\r\n        </div>\r\n        <section class=\"diagnostic-layout\">\r\n          <article class=\"diagnostic-card\">\r\n            <div class=\"section-label\">Capas</div>\r\n            <div class=\"diagnostic-metrics\">\r\n              <div>\r\n                <span>Crudo</span>\r\n                <strong id=\"diagnosticRawCount\">--</strong>\r\n              </div>\r\n              <div>\r\n                <span>Filtrado</span>\r\n                <strong id=\"diagnosticFilteredCount\">--</strong>\r\n              </div>\r\n              <div>\r\n                <span>Corregido</span>\r\n                <strong id=\"diagnosticCorrectedCount\">--</strong>\r\n              </div>\r\n              <div>\r\n                <span>Octavas</span>\r\n                <strong id=\"diagnosticOctaveCount\">--</strong>\r\n              </div>\r\n            </div>\r\n            <p id=\"diagnosticStatus\">Analiza la referencia para revisar que notas se pierden o se corrigen.</p>\r\n          </article>\r\n          <article class=\"diagnostic-chart-card\">\r\n            <div class=\"diagnostic-legend\">\r\n              <span><i class=\"swatch raw\"></i> Crudo</span>\r\n              <span><i class=\"swatch filtered\"></i> Filtrado</span>\r\n              <span><i class=\"swatch corrected\"></i> Corregido</span>\r\n            </div>\r\n            <svg id=\"diagnosticChart\" class=\"diagnostic-chart\" viewBox=\"0 0 1200 420\" role=\"img\" aria-label=\"Diagnostico de lectura de referencia\">\r\n              <g id=\"diagnosticGridLayer\"></g>\r\n              <path id=\"diagnosticRawPath\" class=\"diagnostic-raw\"></path>\r\n              <path id=\"diagnosticFilteredPath\" class=\"diagnostic-filtered\"></path>\r\n              <path id=\"diagnosticCorrectedPath\" class=\"diagnostic-corrected\"></path>\r\n            </svg>\r\n            <div class=\"diagnostic-empty\" id=\"diagnosticEmpty\">Sin diagnostico cargado</div>\r\n          </article>\r\n        </section>\r\n      </section>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"settings\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Ajustes</div>\r\n            <h2>Audio y deteccion</h2>\r\n          </div>\r\n        </div>\r\n        <section class=\"settings-grid\">\r\n          <article class=\"session-card\">\r\n            <div class=\"section-label\">Dispositivos</div>\r\n            <div class=\"session-row\">\r\n              <span>Entrada</span>\r\n              <strong id=\"inputDeviceLabel\">Conectando</strong>\r\n            </div>\r\n            <div class=\"session-row\">\r\n              <span>Salida</span>\r\n              <strong id=\"outputDeviceLabel\">Conectando</strong>\r\n            </div>\r\n          </article>\r\n          <article class=\"session-card\">\r\n            <div class=\"section-label\">Diagnostico</div>\r\n            <div class=\"session-row\">\r\n              <span>Ruido</span>\r\n              <strong id=\"noiseLabel\">--</strong>\r\n            </div>\r\n            <div class=\"session-row\">\r\n              <span>Descartes</span>\r\n              <strong id=\"rejectLabel\">--</strong>\r\n            </div>\r\n          </article>\r\n          <article class=\"session-card\">\r\n            <div class=\"section-label\">Grafico</div>\r\n            <label class=\"setting-row\" for=\"notationSelect\">\r\n              <span>Notacion de notas</span>\r\n              <select id=\"notationSelect\">\r\n                <option value=\"es\" selected>Español</option>\r\n                <option value=\"en\">Internacional</option>\r\n              </select>\r\n            </label>\r\n          </article>\r\n          <article class=\"session-card\">\r\n            <div class=\"section-label\">Apariencia</div>\r\n            <div class=\"session-row\">\r\n              <span>Tema</span>\r\n              <button class=\"button theme-toggle\" id=\"themeToggleButton\" type=\"button\">Tema oscuro</button>\r\n            </div>\r\n          </article>\r\n        </section>\r\n      </section>\r\n    </section>\r\n  </main>\r\n\r\n  <div class=\"module-dock\" id=\"moduleDock\">\r\n    <section class=\"live-panel\" id=\"chartModule\">\r\n      <div class=\"live-header\">\r\n  return Boolean(window.pywebview?.api?.get_songs);\r\n}\r\n\r\nasync function loadBackendSongs() {\r\n  if (!hasBackendApi()) return false;\r\n  if (backendLoading) return false;\r\n\r\n  backendLoading = true;\r\n  backendReady = true;\r\n  setStatus(\"Cargando catalogo\", false);\r\n  try {\r\n    await loadBackendStatus();\r\n    songs = normalizeBackendSongs(await window.pywebview.api.get_songs());\r\n    state.selectedIndex = 0;\r\n    state.selectedTakeIndex = -1;\r\n    state.current = 0;\r\n    state.userPoints = [];\r\n    state.referenceDiagnostic = null;\r\n    state.referenceDiagnosticError = \"\";\r\n    resetReferenceBlockCache();\r\n    renderSongs();\r\n    if (!songs.length) {\r\n      setActiveView(\"library\");\r\n    }\r\n    await loadTakesForCurrentSong();\r\n    updateSongLabels();\r\n    renderChart();\r\n    return true;\r\n  } catch (error) {\r\n    backendReady = false;\r\n    setStatus(`Error: ${error}`, false);\r\n    return false;\r\n  } finally {\r\n    backendLoading = false;\r\n  }\r\n}\r\n\r\nasync function loadTakesForCurrentSong(selectLatest = false) {\r\n  const song = currentSong();\r\n  takes = [];\r\n  state.selectedTakeIndex = -1;\r\n  resetReferenceBlockCache();\r\n  stopTakePlayback();\r\n  renderTakes();\r\n  updateTakePlayer();\r\n\r\n  if (!backendReady || !song?.id || !window.pywebview?.api?.get_takes) {\r\n    return;\r\n  }\r\n\r\n  try {\r\n    const response = await window.pywebview.api.get_takes(song.id);\r\n    if (response && response.ok === false) {\r\n      throw new Error(response.error || \"No se pudieron cargar las tomas.\");\r\n    }\r\n    takes = normalizeBackendTakes(response);\r\n    if (selectLatest && takes.length) {\r\n      state.selectedTakeIndex = 0;\r\n      loadSelectedTakeIntoChart();\r\n    }\r\n    renderTakes();\r\n    updateTakePlayer();\r\n  } catch (error) {\r\n    setStatus(`Error: ${String(error.message || error)}`, false);\r\n  }\r\n}\r\n\r\nasync function loadBackendStatus() {\r\n  if (!window.pywebview?.api?.get_status) return;\r\n\r\n  const status = await window.pywebview.api.get_status();\r\n  els.inputDeviceLabel.textContent = status.input_device || \"No detectado\";\r\n  els.outputDeviceLabel.textContent = status.output_device || \"No detectado\";\r\n}\r\n\r\nfunction connectBackend(attempt = 0) {\r\n  if (backendReady || backendLoading) return;\r\n\r\n  if (hasBackendApi()) {\r\n    loadBackendSongs();\r\n    return;\r\n  }\r\n\r\n  if (attempt < 60) {\r\n    window.setTimeout(() => connectBackend(attempt + 1), 100);\r\n    return;\r\n  }\r\n\r\n  backendReady = false;\r\n  songs = [];\r\n  els.inputDeviceLabel.textContent = \"Backend no conectado\";\r\n  els.outputDeviceLabel.textContent = \"Backend no conectado\";\r\n  renderSongs();\r\n  updateSongLabels();\r\n  setStatus(\"Abre la app con iniciar_live.bat\", false);\r\n}\r\n\r\nfunction renderSongs() {\r\n  els.songList.innerHTML = \"\";\r\n\r\n178:const voiceAudio = new Audio();\n362:function setActiveView(view) {\n461:function normalizeBackendTakes(backendTakes) {\n518:async function loadTakesForCurrentSong(selectLatest = false) {\n608:function renderTakes() {\n841:function formatTakeDate(value) {\n853:function selectSong(index) {\n922:function selectedTake() {\n965:function selectTake(index) {\n976:function loadSelectedTakeIntoChart() {\n1013:function clearCurrentTake() {\n1772:function updateTakePlayer() {\n1793:function loadTakeAudio(take) {\n1807:async function toggleTakePlayback() {\n1836:function pauseTakePlayback() {\n1844:function stopTakePlayback(reset = true) {\n1864:function startTakePlaybackLoop() {\n1869:function stopTakePlaybackLoop() {\n1921:function updateTakeTimeLabel() {\n2239:function replaceSelectedTake(updatedTake) {\n2247:async function renameSelectedTake() {\n2292:async function toggleSelectedTakeFavorite() {\n2326:async function deleteSelectedTake() {\nimport os\r\nimport threading\r\nimport time\r\nimport tkinter as tk\r\nfrom tkinter import filedialog, messagebox, simpledialog, ttk\r\n\r\nfrom matplotlib.backends.backend_tkagg import FigureCanvasTkAgg\r\nfrom matplotlib.figure import Figure\r\n\r\nfrom audio.catalogo import (\r\n    agregar_cancion,\r\n    cargar_canciones,\r\n    eliminar_cancion,\r\n    leer_pitch_csv,\r\n    regenerar_pitch_referencia,\r\n)\r\nfrom audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\r\nfrom audio.visualizacion import (\r\n    aplicar_vista_detalle,\r\n    actualizar_usuario_tiempo_real,\r\n    actualizar_ventana_cursor,\r\n    configurar_grafico_diagnostico,\r\n    configurar_grafico_esperado,\r\n    configurar_grafico_notas,\r\n    rango_midi_grafico,\r\n)\r\n\r\n\r\nclass KaraokeApp(tk.Tk):\r\n    def __init__(self):\r\n        super().__init__()\r\n        self.title(\"Karaoke Afinacion\")\r\n        self.geometry(\"1080x680\")\r\n        self.minsize(920, 560)\r\n\r\n        self.canciones = []\r\n        self.cancion_actual = None\r\n        self.grabacion_actual = None\r\n        self.trabajando = False\r\n        self.grabando = False\r\n        self.detener_grabacion = threading.Event()\r\n        self.t_ref_actual = []\r\n        self.f_ref_actual = []\r\n        self.t_usr_tiempo_real = []\r\n        self.f_usr_tiempo_real = []\r\n        self.ventana_grafico = 12\r\n        self.ultimo_resultado_grafico = None\r\n        self.detalle_ventana_x = 12\r\n        self.detalle_rango_y = 14\r\n        self.detalle_x_inicio = 0\r\n        self.detalle_x_max = 0\r\n        self.detalle_y_inicio = 48\r\n        self.detalle_y_min = 48\r\n        self.detalle_y_max = 72\r\n        self.ultimo_redibujado = 0\r\n\r\n        self._crear_ui()\r\n        self.cargar_catalogo()\r\n\r\n    def _crear_ui(self):\r\n        contenedor = ttk.Frame(self, padding=16)\r\n        contenedor.pack(fill=tk.BOTH, expand=True)\r\n\r\n        panel_superior = ttk.Frame(contenedor)\r\n        panel_superior.pack(fill=tk.BOTH, expand=False)\r\n\r\n        panel_izq = ttk.Frame(panel_superior)\r\n        panel_izq.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)\r\n\r\n        ttk.Label(panel_izq, text=\"Canciones disponibles\").pack(anchor=tk.W)\r\n        self.lista = tk.Listbox(panel_izq, height=14)\r\n        self.lista.pack(fill=tk.BOTH, expand=True, pady=(6, 10))\r\n        self.lista.bind(\"<<ListboxSelect>>\", self.seleccionar_cancion)\r\n\r\n        botones_catalogo = ttk.Frame(panel_izq)\r\n        botones_catalogo.pack(fill=tk.X)\r\n        ttk.Button(botones_catalogo, text=\"Agregar cancion\", command=self.agregar_cancion).pack(\r\n            side=tk.LEFT\r\n        )\r\n        self.btn_eliminar = ttk.Button(\r\n            botones_catalogo,\r\n            text=\"Eliminar\",\r\n            command=self.eliminar_cancion,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_eliminar.pack(side=tk.LEFT, padx=(8, 0))\r\n        self.btn_reprocesar = ttk.Button(\r\n            botones_catalogo,\r\n            text=\"Reprocesar\",\r\n            command=self.reprocesar_cancion,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_reprocesar.pack(side=tk.LEFT, padx=(8, 0))\r\n        ttk.Button(botones_catalogo, text=\"Actualizar lista\", command=self.cargar_catalogo).pack(\r\n            side=tk.LEFT, padx=(8, 0)\r\n        )\r\n\r\n        panel_der = ttk.Frame(panel_superior, padding=(18, 0, 0, 0))\r\n        panel_der.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)\r\n\r\n        ttk.Label(panel_der, text=\"Cancion seleccionada\").pack(anchor=tk.W)\r\n        self.info = tk.StringVar(value=\"Selecciona una cancion para comenzar.\")\r\n        ttk.Label(panel_der, textvariable=self.info, justify=tk.LEFT, wraplength=320).pack(\r\n            anchor=tk.W, pady=(6, 14)\r\n        )\r\n\r\n        acciones = ttk.Frame(panel_der)\r\n        acciones.pack(fill=tk.X, pady=(0, 14))\r\n        self.btn_cantar = ttk.Button(\r\n            acciones,\r\n            text=\"Cantar y grabar\",\r\n            command=self.cantar,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_cantar.pack(fill=tk.X)\r\n        self.btn_detener = ttk.Button(\r\n            acciones,\r\n            text=\"Detener y comparar\",\r\n            command=self.detener_canto,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_detener.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_diagnostico = ttk.Button(\r\n            acciones,\r\n            text=\"Diagnosticar filtros\",\r\n            command=self.diagnosticar_filtros,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_diagnostico.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_ver_detalle = ttk.Button(\r\n            acciones,\r\n            text=\"Ver detalle\",\r\n            command=self.ver_detalle,\r\n            state=tk.DISABLED,\r\n        )\r\n        self.btn_ver_detalle.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_ver_completo = ttk.Button(\r\n            acciones,\r\n            text=\"Ver desempeño completo\",\r\n            command=self.ver_desempeno_completo,\r\n            state=tk.DISABLED,\r\n        )\r\n\r\n        self.resultado = tk.StringVar(value=\"\")\r\n        ttk.Label(panel_der, text=\"Resultado\").pack(anchor=tk.W)\r\n        ttk.Label(panel_der, textvariable=self.resultado, justify=tk.LEFT, wraplength=320).pack(\r\n            anchor=tk.W, pady=(6, 14)\r\n        )\r\n\r\n        self.estado = tk.StringVar(value=\"Listo.\")\r\n        ttk.Label(panel_der, textvariable=self.estado).pack(anchor=tk.W, side=tk.BOTTOM)\r\n\r\n        panel_grafico = ttk.Frame(contenedor, padding=(0, 16, 0, 0))\r\n        panel_grafico.pack(fill=tk.BOTH, expand=True)\r\n        panel_grafico.columnconfigure(0, weight=1)\r\n        panel_grafico.rowconfigure(0, weight=1)\r\n        self.figura = Figure(figsize=(8, 3.4), dpi=100)\r\n        self.eje_grafico = self.figura.add_subplot(111)\r\n        self.eje_grafico.text(\r\n            0.5,\r\n            0.5,\r\n            \"La comparacion visual aparecera despues de cantar.\",\r\n            ha=\"center\",\r\n            va=\"center\",\r\n        )\r\n        self.eje_grafico.set_axis_off()\r\n        self.canvas_grafico = FigureCanvasTkAgg(self.figura, master=panel_grafico)\r\n        self.canvas_grafico.get_tk_widget().grid(row=0, column=0, sticky=\"nsew\")\r\n        self.scroll_y = ttk.Scrollbar(\r\n            panel_grafico,\r\n            orient=tk.VERTICAL,\r\n            command=self.desplazar_detalle_y,\r\n        )\r\n        self.scroll_x = ttk.Scrollbar(\r\n            panel_grafico,\r\n            orient=tk.HORIZONTAL,\r\n            command=self.desplazar_detalle_x,\r\n        )\r\n        self.scroll_y.grid(row=0, column=1, sticky=\"ns\")\r\n        self.scroll_x.grid(row=1, column=0, sticky=\"ew\")\r\n        self.scroll_y.grid_remove()\r\n        self.scroll_x.grid_remove()\r\n\r\n    def set_trabajando(self, trabajando, texto):\r\n        self.trabajando = trabajando\r\n            \"preparing\",\r\n            \"recording\",\r\n            \"stopping\",\r\n            \"comparing\",\r\n            \"reprocessing\",\r\n            \"editing\",\r\n        ]\r\n\r\n    def _seleccionar_audio(self):\r\n        if not webview.windows:\r\n            return \"\"\r\n\r\n        rutas = webview.windows[0].create_file_dialog(\r\n            webview.FileDialog.OPEN,\r\n            allow_multiple=False,\r\n            file_types=(\r\n                \"Audio (*.wav;*.mp3;*.flac;*.ogg;*.m4a)\",\r\n                \"Todos los archivos (*.*)\",\r\n            ),\r\n        )\r\n        if not rutas:\r\n            return \"\"\r\n        return str(rutas[0])\r\n\r\n    def _archivo_url(self, ruta):\r\n        if not ruta:\r\n            return \"\"\r\n        try:\r\n            return Path(ruta).resolve().as_uri()\r\n        except ValueError:\r\n            return \"\"\r\n\r\n    def _dispositivos_por_defecto(self):\r\n        try:\r\n            default_input, default_output = sd.default.device\r\n        except Exception:\r\n            return \"No detectado\", \"No detectado\"\r\n\r\n        return (\r\n            self._nombre_dispositivo(default_input),\r\n            self._nombre_dispositivo(default_output),\r\n        )\r\n\r\n    def _nombre_dispositivo(self, indice):\r\n        try:\r\n            if indice is None or int(indice) < 0:\r\n                return \"No detectado\"\r\n            dispositivo = sd.query_devices(int(indice))\r\n            return dispositivo.get(\"name\", \"No detectado\")\r\n        except Exception:\r\n            return \"No detectado\"\r\n\r\n    def _calentar_pitch_tiempo_real(self):\r\n        try:\r\n            sr = 44100\r\n            t = np.arange(int(sr * 0.22), dtype=float) / sr\r\n            senal = 0.05 * np.sin(2 * np.pi * 440.0 * t)\r\n            extraer_pitch_ligero_desde_audio(senal, sr, usar_filtro_aprendido=True)\r\n        except Exception:\r\n            pass\r\n\r\n\r\ndef main():\r\n    os.chdir(Path(__file__).parent)\r\n    html_path = Path(__file__).parent / \"ui_live\" / \"index.html\"\r\n    backend = LiveBackend()\r\n    window = webview.create_window(\r\n        \"Karaoke Live\",\r\n        html_path.resolve().as_uri(),\r\n        js_api=backend,\r\n        width=1280,\r\n        height=820,\r\n        min_size=(980, 620),\r\n    )\r\n    webview.start(debug=False)\r\n    return window\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n:root {\r\n  --bg: #10110f;\r\n  --surface: #171916;\r\n  --surface-2: #1f221f;\r\n  --surface-3: #292d29;\r\n  --side-bg: #141613;\r\n  --ink: #f1f4ef;\r\n  --muted: #9da69b;\r\n  --soft: rgba(241, 244, 239, 0.07);\r\n  --line: rgba(241, 244, 239, 0.12);\r\n  --line-strong: rgba(241, 244, 239, 0.22);\r\n  --gold: #f1c55b;\r\n  --gold-ink: #18140b;\r\n  --orange: #e68a00;\r\n  --reference: #d9e0e8;\r\n  --blue: #65b7ff;\r\n  --red: #ff746d;\r\n  --green: #70d49e;\r\n  --near: #f0c74e;\r\n  --shadow: 0 28px 90px rgba(0, 0, 0, 0.34);\r\n  --body-glow: rgba(241, 244, 239, 0.04);\r\n  --nav-active-line: rgba(241, 197, 91, 0.34);\r\n  --recording-glow: rgba(255, 116, 109, 0.14);\r\n  --primary-hover: #ffd57e;\r\n  --danger-ink: #ffe7e4;\r\n  --danger-bg: rgba(255, 116, 109, 0.18);\r\n  --danger-line: rgba(255, 116, 109, 0.46);\r\n  --modal-backdrop: rgba(5, 6, 5, 0.72);\r\n  --modal-glow: rgba(241, 197, 91, 0.08);\r\n  --selected-file-bg: rgba(241, 244, 239, 0.06);\r\n  --focus-line: rgba(241, 197, 91, 0.76);\r\n  --focus-ring: rgba(241, 197, 91, 0.14);\r\n  --error-ink: #ffaaa4;\r\n  --song-active-bg: #20231f;\r\n  --song-active-line: rgba(241, 197, 91, 0.36);\r\n  --take-active-bg: #1d2225;\r\n  --take-active-line: rgba(101, 183, 255, 0.36);\r\n  --chart-bg: #0d0f0d;\r\n  --chart-ruler-bg: rgba(16, 17, 15, 0.9);\r\n  --chart-grid-y: rgba(241, 244, 239, 0.13);\r\n  --chart-grid-x: rgba(241, 244, 239, 0.08);\r\n  --grid-line: rgba(241, 244, 239, 0.14);\r\n  --reference-block-fill: rgba(217, 224, 232, 0.58);\r\n  --reference-block-stroke: rgba(246, 249, 252, 0.38);\r\n  --reference-line: rgba(217, 224, 232, 0.5);\r\n  --user-line: rgba(250, 252, 250, 0.9);\r\n  --user-line-shadow: rgba(241, 244, 239, 0.2);\r\n  --user-unknown-fill: rgba(241, 244, 239, 0.28);\r\n  --user-unknown-stroke: rgba(241, 244, 239, 0.48);\r\n  --note-chip-bg: #cbd3df;\r\n  --note-chip-ink: #171b1a;\r\n  --note-chip-hover: #e0e6ee;\r\n  --chart-legend-bg: rgba(13, 15, 13, 0.78);\r\n  --swatch-unknown: rgba(241, 244, 239, 0.72);\r\n  --swatch-raw: rgba(255, 255, 255, 0.55);\r\n  --timeline-bg: rgba(241, 244, 239, 0.12);\r\n  --diagnostic-chart-bg: #0d0f0d;\r\n  --diagnostic-grid-y: rgba(241, 244, 239, 0.1);\r\n  --diagnostic-grid-x: rgba(241, 244, 239, 0.07);\r\n  --diagnostic-legend-bg: rgba(13, 15, 13, 0.78);\r\nAPI key configured: False\r\nplaywright: False\r\n", "exitCode": 0, "durationMs": 798}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "rs_06f6aa8593d2a892016acaa52ac54487d284706ce6eedc70eb", "rollout_ordinal": 2465, "created_at_ms": 1791665449876, "item_type": "reasoning", "updated_at_ordinal": 2465, "started_at_ms": 1791665449876, "completed_at_ms": 1791665458496}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaa52ac54487d284706ce6eedc70eb", "summary": ["**Integrating LLM configuration**"], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "msg_06f6aa8593d2a892016acaa5335a0887d2a82e9dc0db0c371d", "rollout_ordinal": 2467, "created_at_ms": 1791665458536, "item_type": "agentMessage", "updated_at_ordinal": 2467, "started_at_ms": 1791665458536, "completed_at_ms": 1791665459877}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016acaa5335a0887d2a82e9dc0db0c371d", "text": "No hay una clave de OpenAI configurada en este entorno. Dejaré un ajuste para introducirla durante la sesión y probaré el flujo sin conexión y los errores con respuestas simuladas. La clave quedará en el backend y no se guardará junto a las grabaciones.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "exec-71d6580a-3c44-4695-b983-8be1a1d3a3f3", "rollout_ordinal": 2470, "created_at_ms": 1791665517444, "item_type": "fileChange", "updated_at_ordinal": 2470, "started_at_ms": 1791665517444, "completed_at_ms": 1791665517446}, "item": {"type": "fileChange", "id": "exec-71d6580a-3c44-4695-b983-8be1a1d3a3f3", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\explicaciones.py", "kind": {"type": "add"}, "diff": "\"\"\"Redacción con proveedor intercambiable, evidencia acotada y caché por toma.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport threading\nimport urllib.error\nimport urllib.request\n\nfrom audio.tomas import obtener_contexto_retroalimentacion, _buscar_toma\n\nVERSION_PROMPT = '1'\n_lock = threading.RLock()\n_session = {}\n\n\ndef configuracion():\n    return dict(proveedor=_session.get('proveedor', os.getenv('KARAOKE_LLM_PROVIDER', 'openai')),\n                modelo=_session.get('modelo', os.getenv('KARAOKE_LLM_MODEL', 'gpt-4.1-mini')),\n                api_key=_session.get('api_key', os.getenv('OPENAI_API_KEY', '')))\n\n\ndef estado_configuracion():\n    c = configuracion()\n    return dict(proveedor=c['proveedor'], modelo=c['modelo'], configurado=bool(c['api_key']),\n                activo=c['proveedor'] == 'openai' and bool(c['api_key']))\n\n\ndef configurar(proveedor='openai', modelo='gpt-4.1-mini', api_key=None):\n    if proveedor not in ('openai', 'plantillas'):\n        raise ValueError('Proveedor no admitido.')\n    if not isinstance(modelo, str) or not modelo.strip() or len(modelo) > 100:\n        raise ValueError('Modelo inválido.')\n    with _lock:\n        _session.update(proveedor=proveedor, modelo=modelo.strip())\n        if api_key is not None:\n            _session['api_key'] = str(api_key).strip()\n    return estado_configuracion()\n\n\ndef _obj(properties):\n    return dict(type='object', properties=properties, required=list(properties), additionalProperties=False)\n\n\nTEXTO = dict(type='string')\nITEM = _obj(dict(texto=TEXTO, evidencia_ids=dict(type='array', items=TEXTO)))\nESQUEMA = _obj(dict(resumen=TEXTO, aciertos=dict(type='array', items=ITEM),\n                    aspectos_a_revisar=dict(type='array', items=ITEM),\n                    practica_sugerida=dict(type='array', items=_obj(dict(\n                        texto=TEXTO, evidencia_ids=dict(type='array', items=TEXTO), accion_id=TEXTO))),\n                    limitaciones=dict(type='array', items=TEXTO)))\nINSTRUCCIONES = '''Redacta retroalimentación de afinación en español claro, amable y concreto.\nUsa exclusivamente el contexto y sus evidencias. No recalcules ni inventes números o tiempos.\nNo diagnostiques respiración, técnica, ritmo o salud. No afirmes progreso entre tomas.\nLa sincronización no está verificada: describe diferencias detectadas, no su causa.\nLa ausencia de pitch no demuestra que no se cantó. No valores partes sin evidencia.\nCada acierto o aspecto debe citar evidencia_ids de su categoría; cada práctica debe citar\nevidencia y una accion_id que esa evidencia incluya. Deja listas vacías cuando no haya respaldo.\nEl resumen debe describir alcance y cobertura sin una nota global. En alcance fragmento,\ndescribe exclusivamente ese fragmento. En alcance resumen, resume solo hallazgos suministrados.\nNo incluyas HTML ni Markdown. Como máximo tres elementos por lista y frases breves.\nExpresa límites relevantes, incluyendo la sincronización no verificada.'''\n\n\ndef _contexto(context, fragmento_id):\n    # No envía los 36 fragmentos para redactar un resumen ni datos globales en una consulta local.\n    if fragmento_id:\n        f = context['analisis_fragmentos'][0]\n        evidence = f['eventos_seleccionados']\n        return dict(alcance='fragmento', fragmento_id=f['id'], inicio_s=f['inicio_s'], fin_s=f['fin_s'],\n                    metricas=f['metricas'], suficiencia=f['suficiencia_evidencia'],\n                    evidencias=evidence, eventos_no_incluidos=f['eventos_no_incluidos'],\n                    limitaciones=context['calidad']['limitaciones'])\n    return dict(alcance='resumen', metricas=context['resumen_metricas'],\n                suficiencia=context['calidad']['suficiencia_evidencia'],\n                evidencias=context['hallazgos_seleccionados'], limitaciones=context['calidad']['limitaciones'])\n\n\ndef validar(respuesta, contexto):\n    if not isinstance(respuesta, dict) or set(respuesta) != set(ESQUEMA['properties']):\n        raise ValueError('Estructura de respuesta inválida.')\n    if not isinstance(respuesta['resumen'], str) or not respuesta['resumen'].strip() or len(respuesta['resumen']) > 3000:\n        raise ValueError('Resumen inválido.')\n    ev = {e['id']: e for e in contexto['evidencias']}\n    for key, category in [('aciertos', 'fortaleza'), ('aspectos_a_revisar', 'aspecto_por_mejorar'), ('practica_sugerida', None)]:\n        items = respuesta[key]\n        if not isinstance(items, list) or len(items) > 3:\n            raise ValueError('Lista inválida.')\n        for item in items:\n            keys = {'texto', 'evidencia_ids'} | ({'accion_id'} if category is None else set())\n            if not isinstance(item, dict) or set(item) != keys or not isinstance(item['texto'], str) or not 1 <= len(item['texto']) <= 2000:\n                raise ValueError('Elemento inválido.')\n            ids = item['evidencia_ids']\n            if not isinstance(ids, list) or not ids or not all(isinstance(i, str) and i in ev for i in ids):\n                raise ValueError('Evidencia inexistente o ajena al fragmento.')\n            if category and any(ev[i]['categoria'] != category for i in ids):\n                raise ValueError('La categoría no coincide con la evidencia.')\n            if category is None and (not isinstance(item['accion_id'], str) or not all(\n                (ev[i].get('accion_sugerida') or {}).get('id') == item['accion_id'] for i in ids)):\n                raise ValueError('Práctica sin respaldo.')\n    limits = respuesta['limitaciones']\n    if not isinstance(limits, list) or len(limits) > 10 or not all(isinstance(v, str) and len(v) <= 2000 for v in limits):\n        raise ValueError('Limitaciones inválidas.')\n    return respuesta\n\n\nETIQUETAS = dict(afinacion_cercana='Las notas detectadas estuvieron cerca de la referencia.',\n    tendencia_aguda='Se observó una tendencia por encima de la referencia.',\n    tendencia_grave='Se observó una tendencia por debajo de la referencia.',\n    desviacion_aguda='Las notas detectadas estuvieron por encima de la referencia.',\n    desviacion_grave='Las notas detectadas estuvieron por debajo de la referencia.',\n    desviaciones_frecuentes='Se observaron diferencias frecuentes respecto de la referencia.',\n    discrepancia_grande='Hay diferencias grandes que requieren revisar la detección y la sincronización.',\n    sin_deteccion_usuario='No se detectó suficiente pitch del usuario en este intervalo.',\n    sin_referencia='No hay referencia detectada suficiente para comparar este intervalo.',\n    referencia_insuficiente='La referencia detectada no es suficiente para evaluar este fragmento.',\n    deteccion_insuficiente='No hay suficiente tiempo comparable para valorar el fragmento.',\n    cobertura_parcial='Solo se pudo comparar una parte del fragmento.')\n\n\ndef plantilla(ctx):\n    m = ctx['metricas']\n    coverage = m['cobertura_comparable_pct']\n    resumen = ('No hay suficiente referencia detectada para evaluar.' if coverage is None else\n               f\"Se pudo comparar el {coverage:.1f}% del tiempo con referencia detectada.\")\n    if ctx['suficiencia'] == 'suficiente' and m['porcentaje_dentro_tolerancia'] is not None:\n        resumen += f\" De ese tiempo comparable, el {m['porcentaje_dentro_tolerancia']:.1f}% estuvo dentro del margen de afinación.\"\n    else:\n        resumen += ' La evidencia es limitada; revisa los intervalos observados sin generalizar a toda la interpretación.'\n    result = dict(resumen=resumen, aciertos=[], aspectos_a_revisar=[], practica_sugerida=[],\n                  limitaciones=['La sincronización no está verificada.', 'La falta de detección no demuestra que hayas dejado de cantar.'])\n    for e in ctx['evidencias']:\n        category = e['categoria']\n        text = ETIQUETAS.get(e['tipo'], 'Revisa este intervalo.')\n        text = f\"{e['inicio_s']:.2f}–{e['fin_s']:.2f} s: {text}\"\n        target = 'aciertos' if category == 'fortaleza' else 'aspectos_a_revisar' if category == 'aspecto_por_mejorar' else None\n        if target and len(result[target]) < 3:\n            result[target].append(dict(texto=text, evidencia_ids=[e['id']]))\n        if category == 'limitacion' and len(result['limitaciones']) < 8:\n            result['limitaciones'].append(text)\n        action = e.get('accion_sugerida')\n        if action and len(result['practica_sugerida']) < 3:\n            result['practica_sugerida'].append(dict(texto=action['descripcion'], evidencia_ids=[e['id']], accion_id=action['id']))\n    return validar(result, ctx)\n\n\nclass ErrorProveedor(Exception):\n    pass\n\n\nclass OpenAIProvider:\n    def generar(self, contexto, config):\n        payload = dict(model=config['modelo'], store=False, instructions=INSTRUCCIONES,\n            input=json.dumps(contexto, ensure_ascii=False, allow_nan=False), max_output_tokens=2200,\n            text=dict(format=dict(type='json_schema', name='retroalimentacion', strict=True, schema=ESQUEMA)))\n        request = urllib.request.Request('https://api.openai.com/v1/responses',\n            data=json.dumps(payload).encode('utf-8'),\n            headers={'Authorization': 'Bearer '+config['api_key'], 'Content-Type': 'application/json'}, method='POST')\n        try:\n            with urllib.request.urlopen(request, timeout=45) as response:\n                result = json.load(response)\n        except urllib.error.HTTPError as exc:\n            messages = {401: 'La clave de API no es válida.', 403: 'La cuenta no tiene acceso al modelo.',\n                        429: 'Se alcanzó el límite de uso o de solicitudes de la API.'}\n            raise ErrorProveedor(messages.get(exc.code, 'La API no pudo completar la explicación.')) from None\n        except (urllib.error.URLError, TimeoutError, OSError):\n            raise ErrorProveedor('No se pudo conectar con la API a tiempo.') from None\n        if result.get('status') != 'completed':\n            raise ErrorProveedor('La API devolvió una explicación incompleta.')\n        content = [c for item in result.get('output', []) if item.get('type') == 'message' for c in item.get('content', [])]\n        if any(c.get('type') == 'refusal' for c in content):\n            raise ErrorProveedor('El modelo no generó una explicación para estos datos.')\n        text = ''.join(c.get('text', '') for c in content if c.get('type') == 'output_text')\n        return json.loads(text)\n\n\nPROVEEDORES = {'openai': OpenAIProvider()}\n\n\ndef ruta_cache(ruta_audio):\n    return Path(ruta_audio).with_name(Path(ruta_audio).stem+'_explicaciones.json')\n\n\ndef explicar(cancion, toma_id, fragmento_id=None, generar=True):\n    # Serializa lectura/generación/escritura para no duplicar solicitudes simultáneas.\n    with _lock:\n        context = obtener_contexto_retroalimentacion(cancion, toma_id, fragmento_id)\n        ctx = _contexto(context, fragmento_id)\n        config = configuracion()\n        base = dict(origen='plantilla', guardada=False, aviso='', contenido=plantilla(ctx))\n        toma = _buscar_toma(cancion, toma_id)\n        path = ruta_cache(toma['voice_path'])\n        key = hashlib.sha256(json.dumps(dict(contexto=ctx, version=VERSION_PROMPT,\n            modelo=config['modelo'], proveedor=config['proveedor']), sort_keys=True, ensure_ascii=False).encode()).hexdigest()\n        try:\n            cache = json.loads(path.read_text(encoding='utf-8'))\n            if not isinstance(cache, dict):\n                cache = {}\n        except (OSError, ValueError):\n            cache = {}\n        if key in cache:\n            try:\n                validated = validar(cache[key], ctx)\n                return dict(origen='openai', modelo=config['modelo'], guardada=True, aviso='', contenido=validated)\n            except (ValueError, TypeError, KeyError):\n                cache.pop(key, None)\n        if not generar:\n            return base\n        if config['proveedor'] == 'plantillas' or not config['api_key']:\n            base['aviso'] = 'Explicación básica. Puedes activar la redacción con IA en Ajustes.'\n            return base\n        try:\n            response = PROVEEDORES[config['proveedor']].generar(ctx, config)\n            validated = validar(response, ctx)\n        except ErrorProveedor as exc:\n            base['aviso'] = str(exc)+' Se muestra la explicación básica.'\n            return base\n        except (ValueError, KeyError, TypeError):\n            base['aviso'] = 'La respuesta no pasó la validación. Se muestra la explicación básica.'\n            return base\n        response = dict(origen='openai', modelo=config['modelo'], guardada=False, aviso='', contenido=validated)\n        cache[key] = validated\n        # No recrear datos de una toma eliminada mientras se esperaba a la API.\n        if Path(toma['voice_path']).exists():\n            temp = path.with_suffix('.tmp')\n            try:\n                temp.write_text(json.dumps(cache, ensure_ascii=False, allow_nan=False), encoding='utf-8')\n                os.replace(temp, path)\n            except OSError:\n                response['aviso'] = 'La explicación se generó, pero no pudo guardarse.'\n                temp.unlink(missing_ok=True)\n        return response\n\n\ndef panel(cancion, toma_id):\n    context = obtener_contexto_retroalimentacion(cancion, toma_id)\n    return dict(configuracion=estado_configuracion(), metricas=context['resumen_metricas'],\n        calidad=context['calidad'], fragmentos=context['analisis_fragmentos'],\n        explicacion=explicar(cancion, toma_id, generar=False))\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "rs_06f6aa8593d2a892016acaa570dcc087d2b10f8b08d0f6ce72", "rollout_ordinal": 2474, "created_at_ms": 1791665520048, "item_type": "reasoning", "updated_at_ordinal": 2474, "started_at_ms": 1791665520048, "completed_at_ms": 1791665522423}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaa570dcc087d2b10f8b08d0f6ce72", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "exec-224167fc-e9ec-465d-9baf-88518d77ed3e", "rollout_ordinal": 2478, "created_at_ms": 1791665524953, "item_type": "commandExecution", "updated_at_ordinal": 2478, "started_at_ms": 1791665524953, "completed_at_ms": 1791665525575}, "item": {"type": "commandExecution", "id": "exec-224167fc-e9ec-465d-9baf-88518d77ed3e", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content ui_live/app.js | Select-Object -Skip 360 -First 48; Get-Content ui_live/app.js | Select-Object -Skip 960 -First 66; Get-Content ui_live/app.js | Select-Object -Skip 1770 -First 165; Get-Content ui_live/app.js | Select-Object -Skip 2540 -First 48; Get-Content ui_live/index.html | Select-Object -Skip 125 -First 35; Get-Content audio/catalogo.py | Select-Object -Skip 125 -First 35; Get-Content app.py | Select-Object -Skip 400 -First 42'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "28738", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content ui_live/app.js | Select-Object -Skip 360 -First 48; Get-Content ui_live/app.js | Select-Object -Skip 960 -First 66; Get-Content ui_live/app.js | Select-Object -Skip 1770 -First 165; Get-Content ui_live/app.js | Select-Object -Skip 2540 -First 48; Get-Content ui_live/index.html | Select-Object -Skip 125 -First 35; Get-Content audio/catalogo.py | Select-Object -Skip 125 -First 35; Get-Content app.py | Select-Object -Skip 400 -First 42"}], "aggregatedOutput": "\r\nfunction setActiveView(view) {\r\n  if (!viewMeta[view]) return;\r\n\r\n  const reviewViews = [\"result\", \"history\"];\r\n  if (state.takePlaying && !reviewViews.includes(view)) {\r\n    pauseTakePlayback();\r\n  }\r\n\r\n  state.activeView = view;\r\n  if (reviewViews.includes(view) && state.selectedTakeIndex < 0 && takes.length) {\r\n    state.selectedTakeIndex = 0;\r\n    loadSelectedTakeIntoChart();\r\n    loadTakeAudio(selectedTake());\r\n    renderTakes();\r\n  }\r\n\r\n  document.body.dataset.view = view;\r\n  els.navButtons.forEach((button) => {\r\n    button.classList.toggle(\"is-active\", button.dataset.viewTarget === view);\r\n  });\r\n  els.viewPanels.forEach((panel) => {\r\n    panel.classList.toggle(\"is-active\", panel.dataset.viewPanel === view);\r\n  });\r\n\r\n  mountSharedModules();\r\n  updateTopbar();\r\n  renderChart();\r\n  updateTakePlayer();\r\n}\r\n\r\nfunction mountSharedModules() {\r\n  const chartTargets = {\r\n    practice: els.practiceChartMount,\r\n    result: els.resultChartMount,\r\n    history: els.historyChartMount\r\n  };\r\n  const chartTarget = chartTargets[state.activeView] || els.moduleDock;\r\n  if (chartTarget && els.chartModule.parentElement !== chartTarget) {\r\n    chartTarget.appendChild(els.chartModule);\r\n  }\r\n\r\n  const playerTargets = {\r\n    result: els.resultPlayerMount,\r\n    history: els.historyPlayerMount\r\n  };\r\n  const playerTarget = playerTargets[state.activeView] || els.moduleDock;\r\n  if (playerTarget && els.takePlayer.parentElement !== playerTarget) {\r\n    els.fullButton.textContent = \"Ver cancion completa\";\r\n  }\r\n}\r\n\r\nfunction selectTake(index) {\r\n  if (state.playing || state.catalogWorking) return;\r\n  stopTakePlayback();\r\n  state.selectedTakeIndex = index;\r\n  loadSelectedTakeIntoChart();\r\n  loadTakeAudio(selectedTake());\r\n  renderTakes();\r\n  updateTakePlayer();\r\n  renderChart();\r\n}\r\n\r\nfunction loadSelectedTakeIntoChart() {\r\n  const take = selectedTake();\r\n  if (!take) return;\r\n\r\n  state.current = 0;\r\n  state.backendCurrent = 0;\r\n  state.viewStart = 0;\r\n  state.detail = false;\r\n  state.overview = false;\r\n  state.gridYMin = null;\r\n  state.gridYMax = null;\r\n  state.userPoints = take.pointsUser || [];\r\n  resetReferenceBlockCache();\r\n  els.chartShell.classList.remove(\"is-detail\");\r\n  els.detailButton.classList.remove(\"hidden\");\r\n  els.fullButton.classList.add(\"hidden\");\r\n  els.detailButton.disabled = !state.userPoints.length;\r\n  updateChartModeButtons();\r\n  renderMetrics(take.metrics || {});\r\n}\r\n\r\nfunction resetMetrics() {\r\n  state.currentNoteMidi = null;\r\n  els.currentNote.textContent = \"--\";\r\n  els.averageError.textContent = \"--\";\r\n  els.metricTight.textContent = \"--\";\r\n  els.metricLoose.textContent = \"--\";\r\n  els.metricTrend.textContent = \"--\";\r\n  els.metricPoints.textContent = \"--\";\r\n  els.metricTightNote.textContent = \"--\";\r\n  els.metricLooseNote.textContent = \"--\";\r\n  els.metricTrendNote.textContent = \"--\";\r\n  els.metricPointsNote.textContent = \"--\";\r\n  els.noiseLabel.textContent = \"--\";\r\n  els.rejectLabel.textContent = \"--\";\r\n}\r\n\r\nfunction clearCurrentTake() {\r\n  if (state.takePlaying) stopTakePlayback(false);\r\n  state.selectedTakeIndex = -1;\r\n  state.current = 0;\r\n  state.backendCurrent = 0;\r\n  state.viewStart = 0;\r\n  state.detail = false;\r\n  state.overview = false;\r\n  state.userPoints = [];\r\n  state.lastUserPitchAt = null;\r\n  state.gridYMin = null;\r\n  state.gridYMax = null;\r\n  resetReferenceBlockCache();\r\n  els.chartShell.classList.remove(\"is-detail\");\r\n\r\nfunction updateTakePlayer() {\r\n  const take = selectedTake();\r\n  const enabled = Boolean(take?.voiceUrl);\r\n  const canManage = Boolean(take?.id) && !state.playing && !state.catalogWorking;\r\n  els.selectedTakeLabel.textContent = take ? takeDisplayName(take) : \"Sin toma seleccionada\";\r\n  els.takePlayButton.disabled = !enabled || state.playing || state.catalogWorking;\r\n  els.takeStopButton.disabled = !enabled || state.playing || state.catalogWorking;\r\n  els.takeRenameButton.disabled = !canManage;\r\n  els.takeFavoriteButton.disabled = !canManage;\r\n  els.takeDeleteButton.disabled = !canManage;\r\n  els.voiceMuteButton.disabled = !enabled;\r\n  els.trackMuteButton.disabled = !enabled || !take?.instrumentalUrl;\r\n  els.voiceVolume.disabled = !enabled;\r\n  els.trackVolume.disabled = !enabled || !take?.instrumentalUrl;\r\n  els.syncOffset.disabled = !enabled || !take?.instrumentalUrl;\r\n  els.takePlayButton.textContent = state.takePlaying ? \"Pausar toma\" : \"Reproducir toma\";\r\n  els.takeFavoriteButton.textContent = take?.favorite ? \"Quitar favorita\" : \"Favorita\";\r\n  updateMixerButtons();\r\n  updateTakeTimeLabel();\r\n}\r\n\r\nfunction loadTakeAudio(take) {\r\n  if (!take) return;\r\n\r\n  if (voiceAudio.src !== take.voiceUrl) {\r\n    voiceAudio.src = take.voiceUrl;\r\n    voiceAudio.currentTime = 0;\r\n  }\r\n  if (trackAudio.src !== take.instrumentalUrl) {\r\n    trackAudio.src = take.instrumentalUrl || \"\";\r\n    trackAudio.currentTime = 0;\r\n  }\r\n  applyMixer();\r\n}\r\n\r\nasync function toggleTakePlayback() {\r\n  const take = selectedTake();\r\n  if (!take?.voiceUrl) return;\r\n\r\n  loadTakeAudio(take);\r\n  if (state.takePlaying) {\r\n    pauseTakePlayback();\r\n    return;\r\n  }\r\n\r\n  state.takePlaying = true;\r\n  syncTrackToVoice(true);\r\n  applyMixer();\r\n  els.takePlayButton.textContent = \"Pausar toma\";\r\n\r\n  try {\r\n    const plays = [voiceAudio.play()];\r\n    if (take.instrumentalUrl) plays.push(trackAudio.play());\r\n    await Promise.all(plays);\r\n    startTakePlaybackLoop();\r\n  } catch (error) {\r\n    voiceAudio.pause();\r\n    trackAudio.pause();\r\n    state.takePlaying = false;\r\n    setStatus(`Error: ${String(error.message || error)}`, false);\r\n    updateTakePlayer();\r\n  }\r\n}\r\n\r\nfunction pauseTakePlayback() {\r\n  voiceAudio.pause();\r\n  trackAudio.pause();\r\n  state.takePlaying = false;\r\n  stopTakePlaybackLoop();\r\n  updateTakePlayer();\r\n}\r\n\r\nfunction stopTakePlayback(reset = true) {\r\n  voiceAudio.pause();\r\n  trackAudio.pause();\r\n  state.takePlaying = false;\r\n  stopTakePlaybackLoop();\r\n\r\n  if (reset) {\r\n    try {\r\n      voiceAudio.currentTime = 0;\r\n      trackAudio.currentTime = Math.max(0, state.syncOffsetMs / 1000);\r\n    } catch (_error) {\r\n      // Some backends do not allow seeking before metadata is loaded.\r\n    }\r\n    state.current = 0;\r\n  }\r\n\r\n  updateTakePlayer();\r\n  renderChart();\r\n}\r\n\r\nfunction startTakePlaybackLoop() {\r\n  stopTakePlaybackLoop();\r\n  state.takeAnimationId = requestAnimationFrame(takePlaybackLoop);\r\n}\r\n\r\nfunction stopTakePlaybackLoop() {\r\n  if (state.takeAnimationId) {\r\n    cancelAnimationFrame(state.takeAnimationId);\r\n    state.takeAnimationId = null;\r\n  }\r\n}\r\n\r\nfunction takePlaybackLoop() {\r\n  if (!state.takePlaying) return;\r\n\r\n  state.current = voiceAudio.currentTime || 0;\r\n  syncTrackToVoice(false);\r\n  renderChartThrottled();\r\n\r\n  const duration = selectedTake()?.duration || voiceAudio.duration || 0;\r\n  if (duration && state.current >= duration - 0.05) {\r\n    stopTakePlayback(true);\r\n    return;\r\n  }\r\n\r\n  state.takeAnimationId = requestAnimationFrame(takePlaybackLoop);\r\n}\r\n\r\nfunction syncTrackToVoice(force) {\r\n  const take = selectedTake();\r\n  if (!take?.instrumentalUrl || !trackAudio.src) return;\r\n\r\n  const target = Math.max(0, (voiceAudio.currentTime || 0) + state.syncOffsetMs / 1000);\r\n  if (force || Math.abs((trackAudio.currentTime || 0) - target) > 0.08) {\r\n    try {\r\n      trackAudio.currentTime = target;\r\n    } catch (_error) {\r\n      // Metadata may still be loading; the next animation frame will retry.\r\n    }\r\n  }\r\n}\r\n\r\nfunction applyMixer() {\r\n  voiceAudio.volume = Number(els.voiceVolume.value || 0) / 100;\r\n  trackAudio.volume = Number(els.trackVolume.value || 0) / 100;\r\n  voiceAudio.muted = state.voiceMuted;\r\n  trackAudio.muted = state.trackMuted;\r\n}\r\n\r\nfunction updateMixerButtons() {\r\n  els.voiceMuteButton.classList.toggle(\"is-muted\", state.voiceMuted);\r\n  els.trackMuteButton.classList.toggle(\"is-muted\", state.trackMuted);\r\n  els.voiceMuteButton.textContent = state.voiceMuted ? \"Voz mute\" : \"Voz\";\r\n  els.trackMuteButton.textContent = state.trackMuted ? \"Pista mute\" : \"Pista\";\r\n  els.syncOffsetLabel.textContent = `${state.syncOffsetMs} ms`;\r\n}\r\n\r\nfunction updateTakeTimeLabel() {\r\n  const take = selectedTake();\r\n  const duration = take?.duration || 0;\r\n  els.takeTimeLabel.textContent = `${formatTime(state.current)} / ${formatTime(duration)}`;\r\n}\r\n\r\nfunction openSongMetadataModal(fileInfo) {\r\n  return new Promise((resolve) => {\r\n    let settled = false;\r\n    const fallbackTitle = \"Nueva canción\";\r\n    const suggestedTitle = String(fileInfo?.suggestedTitle || fileInfo?.suggested_title || \"\").trim();\r\n\r\n    els.songModalEyebrow.textContent = \"Biblioteca\";\r\n    els.songModalTitle.textContent = \"Agregar canción\";\r\n    els.songModalFileName.textContent = fileInfo?.filename || \"Audio seleccionado\";\r\n\r\nfunction finishBackendSession(result) {\r\n  state.playing = false;\r\n  state.sessionStatus = \"finished\";\r\n  stopAnimationLoop();\r\n  stopPollingBackend();\r\n\r\n  if (result?.points_ref?.length) {\r\n    currentSong().points = result.points_ref;\r\n    resetReferenceBlockCache();\r\n  }\r\n  if (Array.isArray(result?.points_user)) {\r\n    state.userPoints = result.points_user;\r\n    const last = state.userPoints[state.userPoints.length - 1];\r\n    if (last) state.current = last[0];\r\n  }\r\n  if (result?.take) {\r\n    const savedTake = normalizeBackendTakes([result.take])[0];\r\n    if (savedTake) {\r\n      takes = [savedTake, ...takes.filter((take) => take.id !== savedTake.id)];\r\n      state.selectedTakeIndex = 0;\r\n      resetReferenceBlockCache();\r\n      loadTakeAudio(savedTake);\r\n    }\r\n  }\r\n\r\n  setStatus(\"Comparacion lista\", false);\r\n  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\r\n  els.stopButton.disabled = true;\r\n  updateCatalogButtons();\r\n  els.detailButton.disabled = !state.userPoints.length;\r\n  updateChartModeButtons();\r\n  renderSongs();\r\n  renderTakes();\r\n  updateTakePlayer();\r\n  renderMetrics(result || {});\r\n  renderChart();\r\n  setActiveView(\"result\");\r\n}\r\n\r\nfunction failSession(message) {\r\n  state.playing = false;\r\n  state.sessionStatus = \"error\";\r\n  stopAnimationLoop();\r\n  stopPollingBackend();\r\n  setStatus(`Error: ${message}`, false);\r\n  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\r\n  els.stopButton.disabled = true;\r\n        </div>\r\n        <div class=\"history-layout\">\r\n          <section class=\"takes-panel\">\r\n            <div class=\"take-list\" id=\"takeList\"></div>\r\n          </section>\r\n          <section class=\"history-detail\">\r\n            <div id=\"historyChartMount\"></div>\r\n            <div id=\"historyPlayerMount\"></div>\r\n          </section>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"view-panel\" data-view-panel=\"diagnostics\">\r\n        <div class=\"section-head\">\r\n          <div>\r\n            <div class=\"section-label\">Diagnostico</div>\r\n            <h2>Lectura de referencia</h2>\r\n          </div>\r\n          <button class=\"button\" id=\"referenceDiagnosticButton\" type=\"button\">Analizar referencia</button>\r\n        </div>\r\n        <section class=\"diagnostic-layout\">\r\n          <article class=\"diagnostic-card\">\r\n            <div class=\"section-label\">Capas</div>\r\n            <div class=\"diagnostic-metrics\">\r\n              <div>\r\n                <span>Crudo</span>\r\n                <strong id=\"diagnosticRawCount\">--</strong>\r\n              </div>\r\n              <div>\r\n                <span>Filtrado</span>\r\n                <strong id=\"diagnosticFilteredCount\">--</strong>\r\n              </div>\r\n              <div>\r\n                <span>Corregido</span>\r\n                <strong id=\"diagnosticCorrectedCount\">--</strong>\r\n    metadata = cargar_cancion(cancion_id)\r\n    vocals_path, instrumental_path = preparar_pistas(\r\n        metadata[\"original\"],\r\n        forzar_separacion=forzar,\r\n    )\r\n\r\n    if forzar or not os.path.exists(metadata[\"pitch_referencia\"]):\r\n        tiempos, frecuencias = extraer_pitch(vocals_path)\r\n        guardar_csv(metadata[\"pitch_referencia\"], tiempos, frecuencias)\r\n\r\n    metadata[\"vocals\"] = vocals_path\r\n    metadata[\"instrumental\"] = instrumental_path\r\n    metadata[\"preparada\"] = True\r\n    guardar_metadata(metadata)\r\n    return metadata\r\n\r\n\r\ndef regenerar_pitch_referencia(cancion_id, forzar_separacion=False):\r\n    metadata = cargar_cancion(cancion_id)\r\n    vocals_path = metadata.get(\"vocals\") or \"\"\r\n\r\n    if forzar_separacion or not os.path.exists(vocals_path):\r\n        vocals_path, instrumental_path = preparar_pistas(\r\n            metadata[\"original\"],\r\n            forzar_separacion=forzar_separacion,\r\n        )\r\n        metadata[\"vocals\"] = vocals_path\r\n        metadata[\"instrumental\"] = instrumental_path\r\n\r\n    tiempos, frecuencias = extraer_pitch(metadata[\"vocals\"])\r\n    guardar_csv(metadata[\"pitch_referencia\"], tiempos, frecuencias)\r\n    metadata[\"preparada\"] = True\r\n    guardar_metadata(metadata)\r\n    return metadata\r\n\r\n        self.detener_grabacion.set()\r\n        self.estado.set(\"Deteniendo y comparando lo grabado...\")\r\n\r\n    def _cantar_background(self):\r\n        try:\r\n            self.grabacion_actual = grabar_con_instrumental(\r\n                self.cancion_actual,\r\n                detener_evento=self.detener_grabacion,\r\n                progreso_callback=self._programar_actualizacion_cursor,\r\n                pitch_callback=self._programar_actualizacion_pitch_usuario,\r\n                intervalo_pitch=0.1,\r\n                segundos_chunk_pitch=0.7,\r\n            )\r\n            resultado = comparar_grabacion(self.cancion_actual, self.grabacion_actual)\r\n            self.after(0, lambda: self._mostrar_resultado(resultado))\r\n        except Exception as exc:\r\n            self.after(0, lambda: self._mostrar_error(\"No se pudo completar la grabacion\", exc))\r\n\r\n    def _mostrar_resultado(self, resultado):\r\n        if resultado.get(\"error_prom\") is None:\r\n            texto = resultado.get(\"mensaje\", \"No se pudo comparar.\")\r\n        else:\r\n            texto = (\r\n                f\"Error promedio: {resultado['error_prom']:.2f} cents\\n\"\r\n                f\"Desviacion: {resultado['desviacion']:.2f} cents\\n\"\r\n                f\"Tendencia: {resultado['tendencia']}\\n\"\r\n                f\"Dentro de +/-50 cents: {resultado['porcentaje_50']:.1f}%\\n\"\r\n                f\"Dentro de +/-100 cents: {resultado['porcentaje_100']:.1f}%\"\r\n            )\r\n        self.resultado.set(texto)\r\n        self.ultimo_resultado_grafico = resultado.get(\"grafico\")\r\n        self.mostrar_grafico(self.ultimo_resultado_grafico)\r\n        self.btn_ver_detalle.config(\r\n            state=tk.NORMAL if self.ultimo_resultado_grafico else tk.DISABLED\r\n        )\r\n        self.set_grabando(False, \"Comparacion finalizada.\")\r\n\r\n    def limpiar_grafico(self):\r\n        self.figura.clear()\r\n        self.eje_grafico = self.figura.add_subplot(111)\r\n        self.eje_grafico.text(\r\n            0.5,\r\n", "exitCode": 0, "durationMs": 622}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "rs_06f6aa8593d2a892016acaa57818b087d29f5f712c2c295dbd", "rollout_ordinal": 2481, "created_at_ms": 1791665527235, "item_type": "reasoning", "updated_at_ordinal": 2481, "started_at_ms": 1791665527235, "completed_at_ms": 1791665529284}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaa57818b087d29f5f712c2c295dbd", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12794-bcaa-7830-9c20-3c3ab3739e8f", "item_id": "exec-dca0e766-0e03-4b0c-a435-e3c58697aed8", "rollout_ordinal": 2485, "created_at_ms": 1791665598980, "item_type": "fileChange", "updated_at_ordinal": 2485, "started_at_ms": 1791665598980, "completed_at_ms": 1791665598995}, "item": {"type": "fileChange", "id": "exec-dca0e766-0e03-4b0c-a435-e3c58697aed8", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\tomas.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -85,2 +85,3 @@\n     rutas = [\n+        os.path.splitext(toma['voice_path'])[0] + '_explicaciones.json',\n         toma.get(\"voice_path\", \"\"),\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\desktop_live.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -31,2 +31,27 @@\n class LiveBackend:\n+    def get_feedback(self, song_id, take_id):\n+        from audio.explicaciones import panel\n+        try:\n+            return {'ok': True, **panel(cargar_cancion(song_id), take_id)}\n+        except Exception:\n+            return {'ok': False, 'error': 'No se pudo leer el análisis de esta toma.'}\n+\n+    def explain_take(self, song_id, take_id, fragment_id=None):\n+        from audio.explicaciones import explicar\n+        try:\n+            return {'ok': True, **explicar(cargar_cancion(song_id), take_id, fragment_id)}\n+        except Exception:\n+            return {'ok': False, 'error': 'No se pudo preparar la explicación. Vuelve a intentarlo.'}\n+\n+    def get_llm_settings(self):\n+        from audio.explicaciones import estado_configuracion\n+        return estado_configuracion()\n+\n+    def configure_llm(self, provider, model, api_key=None):\n+        from audio.explicaciones import configurar\n+        try:\n+            return {'ok': True, **configurar(provider, model, api_key)}\n+        except ValueError as exc:\n+            return {'ok': False, 'error': str(exc)}\n+\n     def __init__(self):\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\app.js", "kind": {"type": "update", "move_path": null}, "diff": "@@ -1772,2 +1772,3 @@\n function updateTakePlayer() {\n+  window.feedbackUI?.refresh();\n   const take = selectedTake();\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\feedback.css", "kind": {"type": "add"}, "diff": ".feedback-panel { margin-top: 24px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); padding: 24px; }\n.feedback-panel h2, .feedback-panel h3 { margin: 4px 0 12px; }\n.feedback-panel p { line-height: 1.6; }\n.feedback-kicker { color: var(--gold); font-size: 11px; letter-spacing: .13em; text-transform: uppercase; }\n.feedback-note { color: var(--muted); font-size: 13px; line-height: 1.6; }\n.feedback-stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0; }\n.feedback-stat { flex: 1; min-width: 135px; padding: 16px; background: var(--surface-2); border-radius: 12px; }\n.feedback-stat strong { display: block; font-size: 24px; margin-top: 8px; }\n.feedback-layout { display: grid; grid-template-columns: minmax(170px, 230px) minmax(0, 1fr); gap: 24px; margin-top: 24px; }\n.feedback-list { display: flex; flex-direction: column; gap: 8px; max-height: 520px; overflow-y: auto; padding: 2px; }\n.feedback-fragment { text-align: left; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px; cursor: pointer; }\n.feedback-fragment[aria-pressed=\"true\"] { border-color: var(--gold); background: var(--surface-3); }\n.feedback-fragment span { display: block; font-size: 12px; color: var(--muted); margin-top: 6px; }\n.feedback-fragment:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }\n.feedback-copy { min-width: 0; overflow-wrap: anywhere; }\n.feedback-copy ul { padding-left: 20px; line-height: 1.65; }\n.feedback-copy li { margin: 8px 0; }\n.feedback-copy details { margin-top: 20px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; }\n.feedback-copy summary { cursor: pointer; color: var(--muted); }\n.feedback-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }\n.feedback-settings label { display: flex; flex-direction: column; gap: 6px; margin: 12px 0; }\n.feedback-settings input, .feedback-settings select { width: 100%; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); padding: 10px; border-radius: 8px; }\n.feedback-settings p { color: var(--muted); line-height: 1.5; font-size: 13px; }\n.feedback-tag { font-size: 12px; color: var(--muted); }\n@media (max-width: 1050px) { .feedback-layout { grid-template-columns: 1fr; } .feedback-list { max-height: 210px; } }\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\feedback.js", "kind": {"type": "add"}, "diff": "/* Backend compartido; todo texto externo se inserta como texto, nunca como HTML. */\n(() => {\n  const el = (tag, text, cls) => { const n = document.createElement(tag); if (text != null) n.textContent = text; if (cls) n.className = cls; return n; };\n  const api = () => window.pywebview?.api;\n  const root = el('section', null, 'feedback-panel');\n  root.id = 'feedbackPanel';\n  root.setAttribute('aria-label', 'Análisis por fragmentos');\n  let identity = '', revision = 0, detailRevision = 0, data = null, fragment = null;\n  let summaryBox, detailBox, fragmentList;\n  let audioEnd = null;\n  const button = (label, run) => { const b = el('button', label, 'button'); b.type = 'button'; b.onclick = run; return b; };\n  const pct = v => v == null ? 'Sin datos' : `${v.toFixed(1)}%`;\n  const time = v => `${Math.floor(v / 60).toString().padStart(2, '0')}:${(v % 60).toFixed(1).padStart(4, '0')}`;\n  function stats(parent, m) {\n    const row = el('div', null, 'feedback-stats');\n    [['Cobertura comparable', pct(m.cobertura_comparable_pct)], ['Dentro de ±50 cents', pct(m.porcentaje_dentro_tolerancia)], ['Tiempo comparable', `${m.comparable_s.toFixed(1)} s`]].forEach(([name, value]) => {\n      const card = el('div', name, 'feedback-stat'); card.append(el('strong', value)); row.append(card);\n    }); parent.append(row);\n  }\n  function narrative(parent, response) {\n    parent.replaceChildren();\n    parent.append(el('span', response.origen === 'openai' ? `Redacción con IA${response.guardada ? ' · Guardada' : ''}` : 'Explicación básica · Sin IA', 'feedback-tag'));\n    if (response.aviso) parent.append(el('p', response.aviso, 'feedback-note'));\n    const c = response.contenido;\n    parent.append(el('p', c.resumen));\n    [['Aciertos', c.aciertos], ['Aspectos a revisar', c.aspectos_a_revisar], ['Para practicar', c.practica_sugerida]].forEach(([title, items]) => {\n      if (!items.length) return;\n      parent.append(el('h3', title)); const ul = el('ul');\n      items.forEach(item => { const li = el('li', item.texto); li.title = `Evidencia: ${item.evidencia_ids.join(', ')}`; ul.append(li); }); parent.append(ul);\n    });\n    const d = el('details'); d.append(el('summary', 'Alcance y limitaciones'));\n    c.limitaciones.forEach(text => d.append(el('p', text, 'feedback-note'))); parent.append(d);\n  }\n  async function explain(target, fid, expectedRevision, expectedDetail) {\n    const songId = currentSong()?.id, takeId = selectedTake()?.id;\n    const pending = el('p', 'Preparando explicación…', 'feedback-note'); target.append(pending);\n    try {\n      const r = await api().explain_take(songId, takeId, fid);\n      if (revision !== expectedRevision || (fid && detailRevision !== expectedDetail)) return;\n      if (!r.ok) throw new Error(r.error);\n      narrative(target, r);\n      if (r.origen !== 'openai') target.append(button('Intentar redacción con IA', () => {\n        target.querySelector('button')?.remove(); explain(target, fid, expectedRevision, expectedDetail);\n      }));\n    } catch (error) {\n      if (revision !== expectedRevision || (fid && detailRevision !== expectedDetail)) return;\n      pending.remove(); target.append(el('p', error.message || 'No se pudo generar la explicación.', 'feedback-note'));\n      target.append(button('Reintentar', () => { target.replaceChildren(); explain(target, fid, expectedRevision, expectedDetail); }));\n    }\n  }\n  async function play(f) {\n    if (state.playing || state.catalogWorking) return;\n    pauseTakePlayback();\n    loadTakeAudio(selectedTake());\n    audioEnd = f.fin_s;\n    try {\n      voiceAudio.currentTime = f.inicio_s;\n      state.current = f.inicio_s;\n      state.viewStart = f.inicio_s;\n      await toggleTakePlayback();\n      renderChart();\n    } catch (_) { audioEnd = null; }\n  }\n  voiceAudio.addEventListener('timeupdate', () => {\n    if (audioEnd !== null && voiceAudio.currentTime >= audioEnd) {\n      audioEnd = null; pauseTakePlayback();\n    }\n  });\n  document.getElementById('takePlayButton').addEventListener('click', () => { audioEnd = null; });\n  document.getElementById('takeStopButton').addEventListener('click', () => { audioEnd = null; });\n  function openFragment(f) {\n    fragment = f; detailRevision += 1;\n    fragmentList.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.id === f.id)));\n    detailBox.replaceChildren(el('h3', `Fragmento ${Number(f.id.slice(1))} · ${time(f.inicio_s)}–${time(f.fin_s)}`));\n    const actions = el('div', null, 'feedback-actions');\n    actions.append(button('Escuchar mi fragmento', () => play(f)), button('Detener audio', () => { audioEnd = null; pauseTakePlayback(); }));\n    detailBox.append(actions); stats(detailBox, f.metricas);\n    const copy = el('div', null, 'feedback-copy'); detailBox.append(copy);\n    const details = el('details'); details.append(el('summary', 'Ver eventos detectados'));\n    f.eventos_seleccionados.forEach(e => details.append(el('p', `${time(e.inicio_s)}–${time(e.fin_s)} · ${e.tipo.replaceAll('_', ' ')}`, 'feedback-note')));\n    if (!f.eventos_seleccionados.length) details.append(el('p', 'Sin eventos continuos seleccionados. Consulta la cobertura del fragmento.'));\n    if (f.eventos_no_incluidos) details.append(el('p', `${f.eventos_no_incluidos} eventos adicionales no incluidos en esta selección.`, 'feedback-note'));\n    detailBox.append(details);\n    explain(copy, f.id, revision, detailRevision);\n  }\n  function render() {\n    root.replaceChildren(el('div', 'Tu interpretación', 'feedback-kicker'), el('h2', 'Análisis por fragmentos'));\n    root.append(el('p', 'Compara lo que se pudo detectar. La sincronización no está verificada; revisa los intervalos escuchando tu toma.', 'feedback-note'));\n    stats(root, data.metricas);\n    summaryBox = el('div', null, 'feedback-copy'); root.append(summaryBox); narrative(summaryBox, data.explicacion);\n    const layout = el('div', null, 'feedback-layout'); fragmentList = el('div', null, 'feedback-list');\n    fragmentList.setAttribute('aria-label', 'Fragmentos de la toma'); detailBox = el('div', null, 'feedback-copy');\n    detailBox.append(el('h3', 'Revisa una parte de tu interpretación'), el('p', 'Elige un fragmento para ver sus aciertos, diferencias detectadas y práctica sugerida.', 'feedback-note'));\n    data.fragmentos.forEach(f => {\n      const b = button(`Fragmento ${Number(f.id.slice(1))}`, () => openFragment(f)); b.className = 'feedback-fragment'; b.dataset.id = f.id;\n      b.setAttribute('aria-pressed', 'false'); b.append(el('span', `${time(f.inicio_s)}–${time(f.fin_s)} · ${pct(f.metricas.cobertura_comparable_pct)} comparable`)); fragmentList.append(b);\n    });\n    if (!data.fragmentos.length) detailBox.replaceChildren(el('p', 'No hay fragmentos de referencia dentro de la duración grabada.'));\n    layout.append(fragmentList, detailBox); root.append(layout);\n    if (data.configuracion.activo && data.explicacion.origen !== 'openai') explain(summaryBox, null, revision);\n  }\n  async function refresh(force = false) {\n    const mount = document.getElementById(state.activeView === 'result' ? 'resultFeedbackMount' : state.activeView === 'history' ? 'historyFeedbackMount' : '');\n    if (!mount) return;\n    mount.append(root);\n    const song = currentSong(), take = selectedTake(); const key = `${song?.id || ''}/${take?.id || ''}`;\n    if (identity === key && !force) return;\n    identity = key; const ticket = ++revision; detailRevision++; audioEnd = null; data = null; fragment = null;\n    root.replaceChildren(el('h2', 'Análisis por fragmentos'));\n    if (!take?.id || !api()?.get_feedback) { root.append(el('p', 'Selecciona una toma del historial o graba una interpretación.')); return; }\n    root.append(el('p', 'Preparando métricas y fragmentos…', 'feedback-note'));\n    try {\n      const r = await api().get_feedback(song.id, take.id);\n      if (ticket !== revision) return;\n      if (!r.ok) throw new Error(r.error);\n      data = r; render();\n    } catch (error) {\n      if (ticket !== revision) return;\n      root.replaceChildren(el('h2', 'Análisis por fragmentos'), el('p', error.message || 'No se pudo cargar el análisis.'));\n      root.append(button('Volver a cargar', () => refresh(true)));\n    }\n  }\n  async function settings() {\n    if (!api()?.get_llm_settings) return;\n    const c = await api().get_llm_settings();\n    document.getElementById('llmProvider').value = c.proveedor;\n    document.getElementById('llmModel').value = c.modelo;\n    document.getElementById('llmStatus').textContent = c.activo ? 'Redacción con IA activada. Se consultará al abrir resultados y fragmentos.' : 'Explicación básica disponible. IA sin activar.';\n  }\n  async function save(clear = false) {\n    const status = document.getElementById('llmStatus');\n    if (!api()?.configure_llm) { status.textContent = 'Abre la app de escritorio para configurar la conexión.'; return; }\n    const keyInput = document.getElementById('llmKey'); const secret = clear ? '' : keyInput.value.trim() || null; keyInput.value = '';\n    status.textContent = 'Aplicando ajustes…';\n    try {\n      const r = await api().configure_llm(document.getElementById('llmProvider').value, document.getElementById('llmModel').value, secret);\n      if (!r.ok) throw new Error(r.error); await settings(); identity = ''; refresh(true);\n    } catch (_) { status.textContent = 'No se pudieron aplicar los ajustes.'; }\n  }\n  document.getElementById('llmSave').onclick = () => save();\n  document.getElementById('llmClear').onclick = () => save(true);\n  window.feedbackUI = { refresh };\n  window.addEventListener('pywebviewready', () => { settings(); refresh(); });\n  settings(); refresh();\n})();\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\ui_live\\index.html", "kind": {"type": "update", "move_path": null}, "diff": "@@ -7,2 +7,3 @@\n   <link rel=\"stylesheet\" href=\"styles.css\">\n+  <link rel=\"stylesheet\" href=\"feedback.css\">\n </head>\n@@ -117,2 +118,3 @@\n         </div>\n+        <div id=\"resultFeedbackMount\"></div>\n       </section>\n@@ -133,2 +135,3 @@\n             <div id=\"historyPlayerMount\"></div>\n+            <div id=\"historyFeedbackMount\"></div>\n           </section>\n@@ -193,2 +196,14 @@\n         <section class=\"settings-grid\">\n+          <article class=\"session-card feedback-settings\">\n+            <div class=\"section-label\">Explicación de resultados</div>\n+            <h3>Redacción con IA</h3>\n+            <p>Se envían métricas y eventos, sin audio. La explicación se guarda con la toma.</p>\n+            <label>Modo<select id=\"llmProvider\"><option value=\"openai\">OpenAI</option><option value=\"plantillas\">Solo explicación básica</option></select></label>\n+            <label>Modelo<input id=\"llmModel\" value=\"gpt-4.1-mini\" autocomplete=\"off\"></label>\n+            <label>Clave de API para esta sesión<input id=\"llmKey\" type=\"password\" autocomplete=\"off\" placeholder=\"Dejar vacío para conservar la clave configurada\"></label>\n+            <p>La clave no se guarda en archivos. También puedes usar OPENAI_API_KEY al iniciar la app.</p>\n+            <button class=\"button button-primary\" id=\"llmSave\" type=\"button\">Aplicar ajustes</button>\n+            <button class=\"button\" id=\"llmClear\" type=\"button\">Quitar clave de la sesión</button>\n+            <p id=\"llmStatus\" role=\"status\">Conectando…</p>\n+          </article>\n           <article class=\"session-card\">\n@@ -385,2 +400,3 @@\n   <script src=\"app.js\"></script>\n+  <script src=\"feedback.js\"></script>\n </body>\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "01a128b0-eab5-7de2-a419-12033515c015", "rollout_ordinal": 2494, "created_at_ms": 1791684045513, "item_type": "userMessage", "updated_at_ordinal": 2494, "started_at_ms": 1791684045513, "completed_at_ms": 1791684045513}, "item": {"type": "userMessage", "id": "01a128b0-eab5-7de2-a419-12033515c015", "clientId": "d692118f-258b-455b-96b4-7c17bbbdd10b", "content": [{"type": "text", "text": "Hay varias cosas que hacer, primero necesito una barra de carga cuando se están separando las voces, tambien en cuanto a la metricas por segmentos hay una diferencia enorme en cuanto a la precisión de las notas con respecto a la evaluación anterior, debe ser por el problema de alineación\n", "text_elements": []}]}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "rs_06f6aa8593d2a892016acaedd60abc87d2b65a6a82ea45f3be", "rollout_ordinal": 2495, "created_at_ms": 1791684052570, "item_type": "reasoning", "updated_at_ordinal": 2495, "started_at_ms": 1791684052570, "completed_at_ms": 1791684052967}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaedd60abc87d2b65a6a82ea45f3be", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "msg_06f6aa8593d2a892016acaedd6933887d28ffb6d8f510ac0a3", "rollout_ordinal": 2497, "created_at_ms": 1791684053008, "item_type": "agentMessage", "updated_at_ordinal": 2497, "started_at_ms": 1791684053008, "completed_at_ms": 1791684055033}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016acaedd6933887d28ffb6d8f510ac0a3", "text": "Lo incorporo: añadiré un indicador de carga durante la separación de voces y revisaré la diferencia entre ambas evaluaciones antes de presentar la nueva como equivalente. Puede influir la alineación, pero también que la evaluación anterior usa DTW y descarta diferencias grandes; voy a comprobar ambas causas con tus grabaciones.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "exec-65d8566a-985e-4492-bf5d-d049d4608962", "rollout_ordinal": 2501, "created_at_ms": 1791684057052, "item_type": "commandExecution", "updated_at_ordinal": 2501, "started_at_ms": 1791684057052, "completed_at_ms": 1791684058260}, "item": {"type": "commandExecution", "id": "exec-65d8566a-985e-4492-bf5d-d049d4608962", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content audio/comparacion.py; Get-Content audio/separacion.py; Get-Content desktop_live.py | Select-Object -Skip 155 -First 220; Get-Content ui_live/app.js | Select-Object -Skip 2070 -First 78; Get-Content audio/catalogo.py -TotalCount 130; Get-Content audio/karaoke.py -TotalCount 130'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "16546", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content audio/comparacion.py; Get-Content audio/separacion.py; Get-Content desktop_live.py | Select-Object -Skip 155 -First 220; Get-Content ui_live/app.js | Select-Object -Skip 2070 -First 78; Get-Content audio/catalogo.py -TotalCount 130; Get-Content audio/karaoke.py -TotalCount 130"}], "aggregatedOutput": "import numpy as np\r\nfrom dtw import dtw\r\n\r\nfrom audio.metricas import calcular_metricas_errores, hz_to_cents\r\n\r\ndef comparar(f_ref, f_usr):\r\n    if len(f_ref) == 0 or len(f_usr) == 0:\r\n        return {\r\n            \"error_prom\": None,\r\n            \"desviacion\": None,\r\n            \"tendencia\": \"sin datos\",\r\n            \"mensaje\": \"No se detecto pitch suficiente para comparar.\",\r\n        }\r\n\r\n    alignment = dtw(f_ref, f_usr, keep_internals=True)\r\n\r\n    errors = []\r\n\r\n    for i, j in zip(alignment.index1, alignment.index2):\r\n        if f_ref[i] > 0 and f_usr[j] > 0:\r\n            error = hz_to_cents(f_usr[j], f_ref[i])\r\n            if abs(error) < 1000:\r\n                errors.append(error)\r\n\r\n    errors = np.array(errors)\r\n    return calcular_metricas_errores(errors)\r\nimport os\r\nimport subprocess\r\nimport sys\r\n\r\nimport librosa\r\nimport soundfile as sf\r\n\r\n\r\ndef _venv_site_packages():\r\n    raiz = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\n    return os.path.join(raiz, \"venv\", \"Lib\", \"site-packages\")\r\n\r\n\r\ndef _entorno_subproceso():\r\n    env = os.environ.copy()\r\n    site_packages = _venv_site_packages()\r\n    if os.path.exists(site_packages):\r\n        pythonpath = env.get(\"PYTHONPATH\", \"\")\r\n        rutas = [site_packages]\r\n        if pythonpath:\r\n            rutas.append(pythonpath)\r\n        env[\"PYTHONPATH\"] = os.pathsep.join(rutas)\r\n    return env\r\n\r\n\r\ndef _comando_python_demucs():\r\n    if os.path.exists(_venv_site_packages()):\r\n        return [\"py\", \"-3.10\", \"-m\", \"demucs\"]\r\n    return [sys.executable, \"-m\", \"demucs\"]\r\n\r\n\r\ndef rutas_demucs(ruta_audio, output_dir=\"output\"):\r\n    nombre = os.path.splitext(os.path.basename(ruta_audio))[0]\r\n    base_path = os.path.join(output_dir, \"htdemucs\", nombre)\r\n    return {\r\n        \"base\": base_path,\r\n        \"vocals\": os.path.join(base_path, \"vocals.wav\"),\r\n        \"drums\": os.path.join(base_path, \"drums.wav\"),\r\n        \"bass\": os.path.join(base_path, \"bass.wav\"),\r\n        \"other\": os.path.join(base_path, \"other.wav\"),\r\n        \"instrumental\": os.path.join(base_path, \"instrumental.wav\"),\r\n    }\r\n\r\n\r\ndef separar_voz(ruta_audio, forzar_separacion=False):\r\n    \"\"\"\r\n    Si ya existe vocals.wav y no se fuerza, lo reutiliza.\r\n    Si no, ejecuta Demucs.\r\n    \"\"\"\r\n    output_dir = \"output\"\r\n    paths = rutas_demucs(ruta_audio, output_dir)\r\n    vocals_path = paths[\"vocals\"]\r\n\r\n    if os.path.exists(vocals_path) and not forzar_separacion:\r\n        print(\"Usando separacion ya existente\")\r\n        return vocals_path\r\n\r\n    print(\"Separando audio con Demucs...\")\r\n    subprocess.run(\r\n        _comando_python_demucs() + [\"-o\", output_dir, ruta_audio],\r\n        check=True,\r\n        env=_entorno_subproceso(),\r\n    )\r\n\r\n    return vocals_path\r\n\r\n\r\ndef preparar_pistas(ruta_audio, forzar_separacion=False):\r\n    vocals_path = separar_voz(ruta_audio, forzar_separacion=forzar_separacion)\r\n    paths = rutas_demucs(ruta_audio)\r\n\r\n    if os.path.exists(paths[\"instrumental\"]) and not forzar_separacion:\r\n        return vocals_path, paths[\"instrumental\"]\r\n\r\n    stems = [paths[\"drums\"], paths[\"bass\"], paths[\"other\"]]\r\n    if not all(os.path.exists(stem) for stem in stems):\r\n        raise FileNotFoundError(\"Faltan pistas instrumentales generadas por Demucs.\")\r\n\r\n    mezclas = []\r\n    sr_objetivo = None\r\n    for stem in stems:\r\n        y, sr = librosa.load(stem, sr=sr_objetivo, mono=False)\r\n        if sr_objetivo is None:\r\n            sr_objetivo = sr\r\n        mezclas.append(y)\r\n\r\n    instrumental = sum(mezclas)\r\n    sf.write(paths[\"instrumental\"], instrumental.T, sr_objetivo)\r\n    return vocals_path, paths[\"instrumental\"]\r\n                **self._estado_inicial(),\r\n                \"status\": \"deleting\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            eliminar_toma(cancion, take_id)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"takes\": self.get_takes(song_id)}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def select_audio_file(self):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n\r\n        ruta_audio = self._seleccionar_audio()\r\n        if not ruta_audio:\r\n            return {\"ok\": False, \"cancelled\": True}\r\n\r\n        ruta = Path(ruta_audio)\r\n        return {\r\n            \"ok\": True,\r\n            \"path\": str(ruta),\r\n            \"filename\": ruta.name,\r\n            \"suggested_title\": ruta.stem.replace(\"_\", \" \").replace(\"-\", \" \").strip(),\r\n        }\r\n\r\n    def add_song_from_file(self, audio_path, title, artist=\"\"):\r\n        title = str(title or \"\").strip()\r\n        artist = str(artist or \"\").strip()\r\n        audio_path = str(audio_path or \"\").strip()\r\n        if not title:\r\n            return {\"ok\": False, \"error\": \"Ingresa un titulo para la cancion.\"}\r\n        if not audio_path:\r\n            return {\"ok\": False, \"error\": \"Selecciona un archivo de audio.\"}\r\n        if not Path(audio_path).exists():\r\n            return {\"ok\": False, \"error\": \"El archivo seleccionado ya no esta disponible.\"}\r\n\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"adding\",\r\n            }\r\n\r\n        try:\r\n            cancion = agregar_cancion(audio_path, title, artist)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def add_song(self, title, artist=\"\"):\r\n        title = str(title or \"\").strip()\r\n        artist = str(artist or \"\").strip()\r\n        if not title:\r\n            return {\"ok\": False, \"error\": \"Ingresa un titulo para la cancion.\"}\r\n\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"adding\",\r\n            }\r\n\r\n        try:\r\n            ruta_audio = self._seleccionar_audio()\r\n            if not ruta_audio:\r\n                with self._lock:\r\n                    self._estado = self._estado_inicial()\r\n                return {\"ok\": False, \"cancelled\": True}\r\n\r\n            cancion = agregar_cancion(ruta_audio, title, artist)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def delete_song(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"deleting\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            eliminar_cancion(song_id)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"songs\": self.get_songs()}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def edit_song(self, song_id, title, artist=\"\"):\r\n        title = str(title or \"\").strip()\r\n        artist = str(artist or \"\").strip()\r\n        if not title:\r\n            return {\"ok\": False, \"error\": \"Ingresa un titulo para la cancion.\"}\r\n\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"editing\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = editar_cancion(song_id, title, artist)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui, \"songs\": self.get_songs()}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def reprocess_song(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"reprocessing\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = regenerar_pitch_referencia(song_id)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def start_session(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Ya hay una tarea de audio en curso.\"}\r\n\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            if not cancion.get(\"preparada\"):\r\n                return {\"ok\": False, \"error\": \"La cancion no esta preparada.\"}\r\n            if not os.path.exists(cancion.get(\"instrumental\", \"\")):\r\n                return {\"ok\": False, \"error\": \"No existe la pista instrumental.\"}\r\n        except Exception as exc:\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n        self._detener.clear()\r\n        with self._lock:\r\n            self._pitch_pendiente = []\r\n            self._ultimo_punto_usuario = None\r\n            self._estado = {\r\n                \"status\": \"calibrating\",\r\n                \"current\": 0.0,\r\n                \"duration\": self._duracion_cancion(cancion),\r\n                \"song_id\": song_id,\r\n                \"recording_path\": None,\r\n                \"result\": None,\r\n                \"error\": None,\r\n                \"diagnostics\": self._diagnostico_inicial(),\r\n            }\r\n\r\n        self._hilo = threading.Thread(\r\n            target=self._ejecutar_sesion,\r\n            args=(cancion,),\r\n            daemon=True,\r\n        )\r\n        self._hilo.start()\r\n        els.genericModalInput.select();\r\n      }, 0);\r\n    } else {\r\n      window.setTimeout(() => els.genericModalSubmit.focus(), 0);\r\n    }\r\n  });\r\n}\r\n\r\nasync function addSong() {\r\n  if (state.playing || state.catalogWorking) return;\r\n\r\n  if (!backendReady || !window.pywebview?.api?.select_audio_file || !window.pywebview?.api?.add_song_from_file) {\r\n    setStatus(\"Backend no conectado\", false);\r\n    return;\r\n  }\r\n\r\n  state.catalogWorking = true;\r\n  let finalStatus = null;\r\n  let finalRecording = false;\r\n  resetMetrics();\r\n  updateCatalogButtons();\r\n  renderSongs();\r\n  setStatus(\"Selecciona un archivo de audio\", true);\r\n\r\n  try {\r\n    const selectedFile = await window.pywebview.api.select_audio_file();\r\n    if (selectedFile.cancelled) {\r\n   