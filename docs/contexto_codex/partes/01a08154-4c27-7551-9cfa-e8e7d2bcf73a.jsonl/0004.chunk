1);\r\n2368:    setStatus(takes.length ? \"Toma eliminada\" : \"Sin tomas guardadas\", false);\r\n2383:  if (!backendReady || !window.pywebview?.api?.reprocess_song) {\r\n2402:    const response = await window.pywebview.api.reprocess_song(song.id);\r\n2445:    const session = await window.pywebview.api.get_session_state();\r\n2490:    finishBackendSession(session.result);\r\n2542:function finishBackendSession(result) {\r\n2548:  if (result?.points_ref?.length) {\r\n2549:    currentSong().points = result.points_ref;\r\n2552:  if (Array.isArray(result?.points_user)) {\r\n2553:    state.userPoints = result.points_user;\r\n2557:  if (result?.take) {\r\n2558:    const savedTake = normalizeBackendTakes([result.take])[0];\r\n2560:      takes = [savedTake, ...takes.filter((take) => take.id !== savedTake.id)];\r\n2576:  renderMetrics(result || {});\r\n2578:  setActiveView(\"result\");\r\n2595:function renderMetrics(result) {\r\n2596:  if (result.error_prom == null) {\r\n2598:    els.metricTight.textContent = \"Sin toma\";\r\n2602:    els.metricTightNote.textContent = result.mensaje || \"No hay suficiente voz para comparar.\";\r\n2609:  const close = Number(result.porcentaje_50 || 0);\r\n2610:  const loose = Number(result.porcentaje_100 || 0);\r\n2611:  const average = Number(result.error_prom || 0);\r\n2612:  const signed = Number(result.error_medio_firmado || 0);\r\n2613:  const points = Number(result.puntos_comparados || state.userPoints.length || 0);\r\n2616:  const trend = trendSummary(result.tendencia, signed);\r\n2651:    note: \"La toma se alejo bastante de la referencia.\"\r\n2756:els.takePlayButton.addEventListener(\"click\", toggleTakePlayback);\r\n2757:els.takeStopButton.addEventListener(\"click\", () => stopTakePlayback(true));\r\n2758:els.takeRenameButton.addEventListener(\"click\", renameSelectedTake);\r\n2759:els.takeFavoriteButton.addEventListener(\"click\", toggleSelectedTakeFavorite);\r\n2760:els.takeDeleteButton.addEventListener(\"click\", deleteSelectedTake);\r\n2813:window.addEventListener(\"pywebviewready\", loadBackendSongs);\r\n30:    def __init__(self):\r\n47:        self.ultimo_resultado_grafico = None\r\n60:    def _crear_ui(self):\r\n144:        self.resultado = tk.StringVar(value=\"\")\r\n146:        ttk.Label(panel_der, textvariable=self.resultado, justify=tk.LEFT, wraplength=320).pack(\r\n184:    def set_trabajando(self, trabajando, texto):\r\n194:    def set_grabando(self, grabando, texto):\r\n205:    def cargar_catalogo(self):\r\n219:    def seleccionar_cancion(self, _event=None):\r\n233:        self.resultado.set(\"\")\r\n234:        self.ultimo_resultado_grafico = None\r\n242:    def agregar_cancion(self):\r\n266:    def _agregar_cancion_background(self, ruta, titulo, artista):\r\n273:    def _finalizar_agregado_ok(self):\r\n278:    def eliminar_cancion(self):\r\n298:            self.resultado.set(\"\")\r\n299:            self.ultimo_resultado_grafico = None\r\n308:    def reprocesar_cancion(self):\r\n327:    def _reprocesar_background(self):\r\n334:    def _finalizar_reprocesado_ok(self, cancion):\r\n337:        self.resultado.set(\"\")\r\n338:        self.ultimo_resultado_grafico = None\r\n344:    def diagnosticar_filtros(self):\r\n352:    def _diagnosticar_background(self):\r\n359:    def _mostrar_diagnostico(self, diagnostico):\r\n366:        self.resultado.set(\"\\n\".join(lineas))\r\n371:    def _resumen_diagnostico(self, nombre, datos):\r\n377:    def cantar(self):\r\n391:        self.ultimo_resultado_grafico = None\r\n398:    def detener_canto(self):\r\n404:    def _cantar_background(self):\r\n414:            resultado = comparar_grabacion(self.cancion_actual, self.grabacion_actual)\r\n415:            self.after(0, lambda: self._mostrar_resultado(resultado))\r\n419:    def _mostrar_resultado(self, resultado):\r\n420:        if resultado.get(\"error_prom\") is None:\r\n421:            texto = resultado.get(\"mensaje\", \"No se pudo comparar.\")\r\n424:                f\"Error promedio: {resultado['error_prom']:.2f} cents\\n\"\r\n425:                f\"Desviacion: {resultado['desviacion']:.2f} cents\\n\"\r\n426:                f\"Tendencia: {resultado['tendencia']}\\n\"\r\n427:                f\"Dentro de +/-50 cents: {resultado['porcentaje_50']:.1f}%\\n\"\r\n428:                f\"Dentro de +/-100 cents: {resultado['porcentaje_100']:.1f}%\"\r\n430:        self.resultado.set(texto)\r\n431:        self.ultimo_resultado_grafico = resultado.get(\"grafico\")\r\n432:        self.mostrar_grafico(self.ultimo_resultado_grafico)\r\n434:            state=tk.NORMAL if self.ultimo_resultado_grafico else tk.DISABLED\r\n438:    def limpiar_grafico(self):\r\n451:    def ocultar_controles_detalle(self):\r\n458:    def ver_detalle(self):\r\n459:        if not self.ultimo_resultado_grafico:\r\n470:        datos = self.ultimo_resultado_grafico\r\n482:    def ver_desempeno_completo(self):\r\n483:        if not self.ultimo_resultado_grafico:\r\n491:        self.mostrar_grafico(self.ultimo_resultado_grafico)\r\n493:    def desplazar_detalle_x(self, *args):\r\n494:        if not self.ultimo_resultado_grafico:\r\n507:    def desplazar_detalle_y(self, *args):\r\n508:        if not self.ultimo_resultado_grafico:\r\n522:    def _mover_scroll(self, args, valor_actual, minimo, maximo, unidad, pagina):\r\n538:    def mostrar_grafico_detalle(self):\r\n539:        datos = self.ultimo_resultado_grafico\r\n555:    def actualizar_scrollbars_detalle(self):\r\n570:    def mostrar_grafico(self, datos):\r\n587:    def mostrar_notas_esperadas(self, cursor_t=0):\r\n614:    def _programar_actualizacion_cursor(self, tiempo):\r\n617:    def actualizar_cursor_reproduccion(self, tiempo):\r\n623:    def _programar_actualizacion_pitch_usuario(self, tiempos, frecuencias):\r\n626:    def actualizar_pitch_usuario(self, tiempos, frecuencias):\r\n641:    def redibujar_grafico_suave(self):\r\n647:    def _mostrar_error(self, titulo, exc):\r\nimport json\r\nimport os\r\nfrom datetime import datetime\r\n\r\nimport soundfile as sf\r\n\r\nfrom audio.catalogo import carpeta_grabaciones\r\nfrom audio.retroalimentacion import generar_retroalimentacion, preparar_contexto_modelo\r\n\r\n\r\ndef guardar_toma(cancion, ruta_grabacion, resultado, diagnostico=None):\r\n    toma = _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico)\r\n    _guardar_metadata_toma(toma)\r\n    return toma\r\n\r\n\r\ndef obtener_contexto_retroalimentacion(cancion, toma_id, fragmento_id=None):\r\n    \"\"\"Lee una toma y prepara datos para el LLM; admite resultados históricos.\r\n\r\n    No reextrae audio ni reescribe archivos al consultar una toma antigua.\r\n    \"\"\"\r\n    toma = _buscar_toma(cancion, toma_id)\r\n    path = toma['result_path']\r\n    resultado = _leer_json(path) if os.path.exists(path) else {}\r\n    feedback = resultado.get('retroalimentacion')\r\n    if feedback is None or feedback.get('version') == '1.0.0':\r\n        from audio.segmentacion import preparar_segmentacion\r\n        from audio.catalogo import leer_pitch_csv\r\n        graph = resultado.get('grafico') or toma.get('graph') or {}\r\n        tr, fr = graph.get('t_ref', []), graph.get('f_ref', [])\r\n        if cancion.get('vocals') and cancion.get('pitch_referencia'):\r\n            tr, fr = leer_pitch_csv(cancion['pitch_referencia'])\r\n        segmentos = preparar_segmentacion(cancion, tr, fr)\r\n        feedback = generar_retroalimentacion(\r\n            tr, fr,\r\n            graph.get('t_usr', []), graph.get('f_usr', []),\r\n            _duracion(toma['voice_path']),\r\n            segmentos=segmentos,\r\n        )\r\n    return preparar_contexto_modelo(feedback, fragmento_id=fragmento_id)\r\n\r\n\r\ndef listar_tomas(cancion):\r\n    carpeta = carpeta_grabaciones(cancion[\"id\"])\r\n    tomas = []\r\n    for nombre in os.listdir(carpeta):\r\n        if not nombre.lower().endswith(\".wav\"):\r\n            continue\r\n        ruta_grabacion = os.path.join(carpeta, nombre)\r\n        toma = cargar_toma_desde_audio(cancion, ruta_grabacion)\r\n        if toma:\r\n            tomas.append(toma)\r\n\r\n    return sorted(tomas, key=lambda item: item.get(\"created_at\", \"\"), reverse=True)\r\n\r\n\r\ndef cargar_toma_desde_audio(cancion, ruta_grabacion):\r\n    metadata_path = _metadata_toma_path(ruta_grabacion)\r\n    if os.path.exists(metadata_path):\r\n        with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\r\n            toma = json.load(f)\r\n        toma[\"voice_path\"] = ruta_grabacion\r\n        toma[\"metadata_path\"] = metadata_path\r\n        toma[\"result_path\"] = _resultado_path(ruta_grabacion)\r\n        toma[\"instrumental_path\"] = cancion.get(\"instrumental\", \"\")\r\n        return toma\r\n\r\n    resultado_path = _resultado_path(ruta_grabacion)\r\n    resultado = _leer_json(resultado_path) if os.path.exists(resultado_path) else {}\r\n    return _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico=None)\r\n\r\n\r\ndef actualizar_toma(cancion, toma_id, nombre=None, favorita=None):\r\n    toma = _buscar_toma(cancion, toma_id)\r\n    if nombre is not None:\r\n        toma[\"name\"] = str(nombre or \"\").strip()\r\n    if favorita is not None:\r\n        toma[\"favorite\"] = bool(favorita)\r\n    _guardar_metadata_toma(toma)\r\n    return cargar_toma_desde_audio(cancion, toma[\"voice_path\"])\r\n\r\n\r\ndef eliminar_toma(cancion, toma_id):\r\n    toma = _buscar_toma(cancion, toma_id)\r\n    rutas = [\r\n        toma.get(\"voice_path\", \"\"),\r\n        toma.get(\"metadata_path\", \"\"),\r\n        toma.get(\"result_path\", \"\"),\r\n    ]\r\n    for ruta in rutas:\r\n        if ruta and os.path.exists(ruta):\r\n            os.remove(ruta)\r\n    return True\r\n\r\n\r\ndef _crear_metadata_toma(cancion, ruta_grabacion, resultado, diagnostico=None):\r\n    resultado = resultado or {}\r\n    return {\r\n        \"id\": os.path.splitext(os.path.basename(ruta_grabacion))[0],\r\n        \"song_id\": cancion[\"id\"],\r\n", "exitCode": 0, "durationMs": 706}}
