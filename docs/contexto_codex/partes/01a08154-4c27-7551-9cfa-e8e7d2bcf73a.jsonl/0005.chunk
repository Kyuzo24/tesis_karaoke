{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "exec-a356f1fc-9972-4be9-b080-05014032be99", "rollout_ordinal": 2665, "created_at_ms": 1791684782131, "item_type": "fileChange", "updated_at_ordinal": 2665, "started_at_ms": 1791684782131, "completed_at_ms": 1791684782134}, "item": {"type": "fileChange", "id": "exec-a356f1fc-9972-4be9-b080-05014032be99", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\probar_segmentacion_pausas.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -44,3 +44,3 @@\n         song=json.loads(metadata.read_text(encoding='utf-8'))\n-        if song['id'] in IDS_EXCLUIDOS:\n+        if song['id'] in IDS_EXCLUIDOS and (ROOT/'canciones/que_gano_olvidandote_a7c974ca/metadata.json').exists():\n             continue\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\verificar_feedback_fragmentos.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -22,7 +22,15 @@\n     audit = []\n-    for approved in aprobados['canciones']:\n-        song = json.loads((ROOT/'canciones'/approved['id']/'metadata.json').read_text(encoding='utf-8'))\n+    approved_by_id = {c['id']: c for c in aprobados['canciones']}\n+    for metadata in sorted((ROOT/'canciones').glob('*/metadata.json')):\n+        song = json.loads(metadata.read_text(encoding='utf-8'))\n+        if not song.get('preparada') or not Path(song.get('pitch_referencia', '')).is_file():\n+            audit.append(dict(id=song['id'], omitida='Referencia todavía no preparada'))\n+            continue\n+        if song['id'] == 'qué_gano_olvidandote_84dce906' and (ROOT/'canciones/que_gano_olvidandote_a7c974ca/metadata.json').exists():\n+            continue\n+        approved = approved_by_id.get(song['id'])\n         tr, fr = leer_pitch_csv(song['pitch_referencia'])\n         segments = segmentar_referencia(song['vocals'], tr, fr)\n-        assert segments == [{k: s[k] for k in ['inicio_s','fin_s']} for s in approved['segmentos']]\n+        if approved:\n+            assert segments == [{k: s[k] for k in ['inicio_s','fin_s']} for s in approved['segmentos']]\n         checked = 0\n@@ -47,3 +55,3 @@\n             checked += 1\n-        audit.append(dict(id=song['id'], segmentos=len(segments), tomas_verificadas=checked,\n+        audit.append(dict(id=song['id'], segmentos=len(segments), tomas_verificadas=checked, cortes_con_baseline=approved is not None,\n                           audio_sha256=hashlib.sha256(Path(song['vocals']).read_bytes()).hexdigest()))\n"}], "status": "completed"}}
