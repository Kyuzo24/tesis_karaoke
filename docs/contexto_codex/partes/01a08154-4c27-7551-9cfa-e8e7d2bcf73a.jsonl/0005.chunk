{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-cd498584-72c4-4ed1-a06d-021866e16733", "rollout_ordinal": 2786, "created_at_ms": 1791685855801, "item_type": "fileChange", "updated_at_ordinal": 2786, "started_at_ms": 1791685855801, "completed_at_ms": 1791685855802}, "item": {"type": "fileChange", "id": "exec-cd498584-72c4-4ed1-a06d-021866e16733", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\scripts\\instalar_ollama_cpu.py", "kind": {"type": "add"}, "diff": "\"\"\"Extrae solo el runtime CPU del ZIP oficial para evitar descargar librerías CUDA.\"\"\"\nimport concurrent.futures\nimport io\nimport os\nfrom pathlib import Path\nimport struct\nimport urllib.request\nimport zipfile\nimport zlib\n\nURL = 'https://github.com/ollama/ollama/releases/download/v0.40.2/ollama-windows-amd64.zip'\nSIZE = 1468085195\n\n\ndef rango(a, b):\n    request = urllib.request.Request(URL, headers={'Range': f'bytes={a}-{b}'})\n    with urllib.request.urlopen(request, timeout=90) as response:\n        if response.status != 206 or response.headers.get('Content-Range') != f'bytes {a}-{b}/{SIZE}':\n            raise RuntimeError('El servidor no devolvió el rango esperado del archivo oficial.')\n        data = response.read()\n    if len(data) != b-a+1:\n        raise RuntimeError('Descarga incompleta.')\n    return data\n\n\ndef main():\n    root = Path(os.environ['LOCALAPPDATA'])/'KaraokeStudio/ollama'\n    root.mkdir(parents=True, exist_ok=True)\n    tail = rango(SIZE-65536, SIZE-1)\n    with zipfile.ZipFile(io.BytesIO(tail)) as archive:\n        files = [i for i in archive.infolist() if not i.is_dir() and\n                 not any(p in ('cuda_v12', 'cuda_v13', 'vulkan') for p in Path(i.filename).parts)]\n    print(f'Descarga CPU: {sum(i.compress_size for i in files)/1e6:.1f} MB desde el ZIP oficial.', flush=True)\n    def extract(info):\n        target = (root/info.filename).resolve()\n        if root.resolve() not in target.parents:\n            raise RuntimeError('Ruta inesperada en el archivo.')\n        if target.exists() and zlib.crc32(target.read_bytes()) == info.CRC:\n            return\n        offset = info.header_offset + SIZE-65536\n        header = rango(offset, offset+29)\n        if header[:4] != b'PK\\x03\\x04':\n            raise RuntimeError('Cabecera ZIP inválida.')\n        name_length, extra_length = struct.unpack_from('<HH', header, 26)\n        start = offset+30+name_length+extra_length\n        raw = rango(start, start+info.compress_size-1)\n        content = zlib.decompress(raw, -15) if info.compress_type == zipfile.ZIP_DEFLATED else raw\n        if len(content) != info.file_size or zlib.crc32(content) != info.CRC:\n            raise RuntimeError('CRC o tamaño incorrecto.')\n        target.parent.mkdir(parents=True, exist_ok=True)\n        temp = target.with_suffix(target.suffix+'.tmp')\n        temp.write_bytes(content)\n        os.replace(temp, target)\n    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\n        list(pool.map(extract, files))\n    print('Motor CPU extraído. Origen HTTPS oficial; integridad CRC de cada archivo verificada.', flush=True)\n\n\nif __name__ == '__main__':\n    main()\n"}], "status": "completed"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-e59364a5-6c3a-4b68-a49d-85684c5dd85b", "rollout_ordinal": 2789, "created_at_ms": 1791685856009, "item_type": "commandExecution", "updated_at_ordinal": 2789, "started_at_ms": 1791685856009, "completed_at_ms": 1791685893267}, "item": {"type": "commandExecution", "id": "exec-e59364a5-6c3a-4b68-a49d-85684c5dd85b", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'python scripts/instalar_ollama_cpu.py'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "62763", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "python scripts/instalar_ollama_cpu.py"}], "aggregatedOutput": "Descarga CPU: 24.6 MB desde el ZIP oficial.\r\nMotor CPU extra�do. Origen HTTPS oficial; integridad CRC de cada archivo verificada.\r\n", "exitCode": 0, "durationMs": 37257}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "01a128cc-b249-7142-8f3f-9b84ede2b748", "rollout_ordinal": 2796, "created_at_ms": 1791685866057, "item_type": "contextCompaction", "updated_at_ordinal": 2796, "started_at_ms": 1791685866057, "completed_at_ms": 1791686011450}, "item": {"type": "contextCompaction", "id": "01a128cc-b249-7142-8f3f-9b84ede2b748"}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-ea7fa5d3-69b1-43e5-9e12-cf5c3e3cd5d8", "rollout_ordinal": 2799, "created_at_ms": 1791686017004, "item_type": "commandExecution", "updated_at_ordinal": 2799, "started_at_ms": 1791686017004, "completed_at_ms": 1791686017680}, "item": {"type": "commandExecution", "id": "exec-ea7fa5d3-69b1-43e5-9e12-cf5c3e3cd5d8", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content preparar_ia_local.ps1; Get-Content scripts/verificar_interfaz.cjs -Tail 90'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "81608", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content preparar_ia_local.ps1; Get-Content scripts/verificar_interfaz.cjs -Tail 90"}], "aggregatedOutput": "param([string]$Modelo = 'qwen3:4b', [switch]$SoloIniciar)\r\n$ErrorActionPreference = 'Stop'\r\n$carpetaIA = Join-Path $env:LOCALAPPDATA 'KaraokeStudio/ollama'\r\n$ejecutableIA = Join-Path $carpetaIA 'ollama.exe'\r\n$carpetaModelos = Join-Path $env:LOCALAPPDATA 'KaraokeStudio/modelos'\r\nNew-Item -ItemType Directory -Force -Path $carpetaIA, $carpetaModelos | Out-Null\r\nif (!(Test-Path -LiteralPath $ejecutableIA)) {\r\n    if ($SoloIniciar) { throw 'Primero ejecuta preparar_ia_local.ps1 sin -SoloIniciar.' }\r\n    $archivoZipIA = Join-Path $carpetaIA 'ollama-windows-amd64.zip'\r\n    $hashEsperadoIA = 'e29ad1d5063dd4b54b2492d9b00adab2cff9621bfa654b6c92aa8d6f1fdfe7fc'\r\n    Write-Host 'Descargando Ollama portable (aproximadamente 1,5 GB), sin cuenta...'\r\n    if (!(Test-Path -LiteralPath $archivoZipIA)) {\r\n        & curl.exe --fail --location --retry 3 --output $archivoZipIA 'https://github.com/ollama/ollama/releases/download/v0.40.2/ollama-windows-amd64.zip'\r\n        if ($LASTEXITCODE -ne 0) { throw 'No se pudo descargar Ollama.' }\r\n    }\r\n    if ((Get-FileHash -LiteralPath $archivoZipIA -Algorithm SHA256).Hash.ToLowerInvariant() -ne $hashEsperadoIA) {\r\n        throw \"La descarga no coincide con el hash oficial. Revisa o elimina solamente este archivo y reintenta: $archivoZipIA\"\r\n    }\r\n    Write-Host 'Extrayendo el motor local...'\r\n    Expand-Archive -LiteralPath $archivoZipIA -DestinationPath $carpetaIA -Force\r\n}\r\n$servidorListoIA = $false\r\ntry { Invoke-RestMethod 'http://127.0.0.1:11434/api/tags' -TimeoutSec 2 | Out-Null; $servidorListoIA = $true } catch {}\r\nif (!$servidorListoIA) {\r\n    $entornoAnteriorIA = @{}\r\n    foreach ($nombreIA in @('OLLAMA_HOST','OLLAMA_MODELS','OLLAMA_NO_CLOUD')) { $entornoAnteriorIA[$nombreIA] = [Environment]::GetEnvironmentVariable($nombreIA, 'Process') }\r\n    try {\r\n        $env:OLLAMA_HOST = '127.0.0.1:11434'\r\n        $env:OLLAMA_MODELS = $carpetaModelos\r\n        $env:OLLAMA_NO_CLOUD = '1'\r\n        Start-Process -FilePath $ejecutableIA -ArgumentList 'serve' -WindowStyle Hidden -RedirectStandardOutput (Join-Path $carpetaIA 'servidor.log') -RedirectStandardError (Join-Path $carpetaIA 'servidor-error.log') | Out-Null\r\n    } finally {\r\n        foreach ($nombreIA in $entornoAnteriorIA.Keys) { [Environment]::SetEnvironmentVariable($nombreIA, $entornoAnteriorIA[$nombreIA], 'Process') }\r\n    }\r\n    for ($intentoIA = 0; $intentoIA -lt 30; $intentoIA++) {\r\n        try { Invoke-RestMethod 'http://127.0.0.1:11434/api/tags' -TimeoutSec 2 | Out-Null; $servidorListoIA = $true; break } catch { Start-Sleep -Seconds 1 }\r\n    }\r\n}\r\nif (!$servidorListoIA) { throw 'El servidor local no pudo iniciarse.' }\r\nif (!$SoloIniciar) {\r\n    Write-Host \"Descargando el modelo $Modelo (aproximadamente 2,5 GB la primera vez)...\"\r\n    $resultadoIA = Start-Process -FilePath $ejecutableIA -ArgumentList @('pull', $Modelo) -WindowStyle Hidden -Wait -PassThru -RedirectStandardOutput (Join-Path $carpetaIA 'descarga.log') -RedirectStandardError (Join-Path $carpetaIA 'descarga-error.log')\r\n    if ($resultadoIA.ExitCode -ne 0) { throw \"No se pudo descargar el modelo. Revisa $carpetaIA/descarga-error.log\" }\r\n}\r\n$modelosIA = Invoke-RestMethod 'http://127.0.0.1:11434/api/tags' -TimeoutSec 5\r\nif ($modelosIA.models.name -contains $Modelo) { Write-Host 'IA local lista. Abre Karaoke Studio; no necesitas ninguna cuenta.' }\r\nelse { Write-Host 'Servidor iniciado. Falta descargar el modelo con preparar_ia_local.ps1.' }\r\n// Prueba de interfaz con datos reales y puente de escritorio simulado; sin llamadas de pago.\r\nconst {chromium} = require('playwright');\r\nconst fs = require('fs');\r\nconst path = require('path');\r\nconst {pathToFileURL} = require('url');\r\n(async () => {\r\n  const root = path.resolve(__dirname, '..');\r\n  const fixture = JSON.parse(fs.readFileSync(path.join(root, 'output/prueba_interfaz/fixture.json'), 'utf8'));\r\n  const browser = await chromium.launch({headless:true, executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe'});\r\n  const page = await browser.newPage({viewport:{width:1280,height:900}});\r\n  const errors = []; page.on('pageerror', e => errors.push(e.message));\r\n  await page.addInitScript(f => {\r\n    window._fixture = f; window._explanations = 0;\r\n    let cfg = {proveedor:'plantillas',modelo:'gpt-4.1-mini',configurado:false,activo:false};\r\n    window.pywebview = {api:{\r\n      get_songs: async () => f.songs, get_takes: async () => f.takes,\r\n      get_status: async () => ({input_device:'Prueba',output_device:'Prueba'}),\r\n      get_feedback: async () => ({ok:true,...f.panel}),\r\n      get_llm_settings: async () => cfg,\r\n      configure_llm: async (provider,model,key) => {cfg={proveedor:provider,modelo:model,configurado:!!key,activo:provider==='openai'&&!!key};return {ok:true,...cfg};},\r\n      explain_take: async (_s,_t,fid) => {\r\n        window._explanations++;\r\n        if(window._delayExplanation) await new Promise(r=>setTimeout(r,500));\r\n        return {ok:true,...(fid?f.fragment:f.summary)};\r\n      },\r\n      get_preparation_state: async () => ({status:'adding',message:'Separando voz y acompañamiento…'}),\r\n      suggest_alignment: async () => ({ok:true,disponible:true,desfase_ms:280,motivo:'Estimación para revisión.'}),\r\n      set_alignment: async (_s,_t,ms) => {f.panel.desfase_ms=ms;return {ok:true};}\r\n    }};\r\n  }, fixture);\r\n  await page.goto(pathToFileURL(path.join(root,'ui_live/index.html')).href);\r\n  await page.waitForFunction(() => document.querySelectorAll('#songList button').length > 0);\r\n  await page.getByRole('button',{name:'Resultado',exact:true}).click();\r\n  await page.waitForSelector('.feedback-fragment');\r\n  await page.locator('.feedback-fragment').first().click();\r\n  await page.waitForFunction(() => document.querySelectorAll('.feedback-copy .feedback-tag').length >= 2);\r\n  await page.getByRole('button',{name:'Escuchar mi fragmento',exact:true}).click();\r\n  await page.waitForFunction(() => state.takePlaying);\r\n  await page.getByRole('button',{name:'Detener audio',exact:true}).click();\r\n  if(await page.evaluate(() => state.takePlaying)) throw new Error('No se detuvo la reproducción');\r\n  await page.locator('#feedbackPanel').screenshot({path:path.join(root,'output/prueba_interfaz/fragmentos.png')});\r\n  await page.locator('.feedback-alignment summary').click();\r\n  await page.getByRole('button',{name:'Estimar desfase',exact:true}).click();\r\n  await page.waitForFunction(() => document.querySelector('.feedback-alignment input').value === '280');\r\n  await page.getByRole('button',{name:'Aplicar y recalcular',exact:true}).click();\r\n  await page.waitForFunction(() => document.querySelector('.feedback-alignment summary').textContent.includes('280 ms'));\r\n  // Una respuesta tardía no debe restaurar el detalle de una toma anterior.\r\n  await page.evaluate(() => {window._delayExplanation=true;});\r\n  await page.locator('.feedback-fragment').first().click();\r\n  await page.evaluate(() => selectTake(1));\r\n  await page.waitForTimeout(650);\r\n  if(await page.locator('.feedback-fragment[aria-pressed=\"true\"]').count()) throw new Error('Detalle obsoleto después de cambiar de toma');\r\n  await page.evaluate(() => window.preparationUI.start());\r\n  await page.waitForFunction(() => document.querySelector('#preparationMessage').textContent.includes('Separando'));\r\n  await page.locator('#preparationProgress').screenshot({path:path.join(root,'output/prueba_interfaz/carga.png')});\r\n  await page.evaluate(() => window.preparationUI.stop());\r\n  if(await page.locator('#preparationProgress').isVisible()) throw new Error('Barra de carga no se ocultó');\r\n  await page.getByRole('button',{name:'Ajustes',exact:true}).click();\r\n  await page.locator('#llmProvider').selectOption('openai');\r\n  await page.locator('#llmKey').fill('clave-simulada');\r\n  await page.getByRole('button',{name:'Aplicar ajustes',exact:true}).click();\r\n  await page.waitForFunction(() => document.querySelector('#llmStatus').textContent.includes('activada'));\r\n  if(await page.locator('#llmKey').inputValue()) throw new Error('Clave no se limpió');\r\n  await page.getByRole('button',{name:'Quitar clave de la sesión'}).click();\r\n  await page.waitForFunction(() => document.querySelector('#llmStatus').textContent.includes('sin activar'));\r\n  if(errors.length) throw new Error(errors.join('\\n'));\r\n  await browser.close();\r\n  console.log('OK: resumen, fragmentos, desfase, cambio de toma, barra de carga y ajustes; sin errores JS.');\r\n})().catch(e=>{console.error(e);process.exit(1);});\r\n", "exitCode": 0, "durationMs": 676}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-2f0278f5-5cf5-43cd-9e85-df8df63e46ad", "rollout_ordinal": 2804, "created_at_ms": 1791686022637, "item_type": "commandExecution", "updated_at_ordinal": 2804, "started_at_ms": 1791686022637, "completed_at_ms": 1791686025874}, "item": {"type": "commandExecution", "id": "exec-2f0278f5-5cf5-43cd-9e85-df8df63e46ad", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-AuthenticodeSignature -LiteralPath \"$env:LOCALAPPDATA/KaraokeStudio/ollama/ollama.exe\" | Select-Object Status,StatusMessage; Get-Content audio/explicaciones.py -Head 140; Get-Content ui_live/feedback.js -Tail 60; Get-Content tests/test_explicaciones.py -Head 60'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "28791", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-AuthenticodeSignature -LiteralPath \"$env:LOCALAPPDATA/KaraokeStudio/ollama/ollama.exe\" | Select-Object Status,StatusMessage; Get-Content audio/explicaciones.py -Head 140; Get-Content ui_live/feedback.js -Tail 60; Get-Content tests/test_explicaciones.py -Head 60"}], "aggregatedOutput": "\r\nStatus StatusMessage\r\n------ -------------\r\n Valid Signature verified.\r\n\"\"\"Redacción con proveedor intercambiable, evidencia acotada y caché por toma.\"\"\"\r\nimport hashlib\r\nimport json\r\nimport os\r\nfrom pathlib import Path\r\nimport threading\r\nimport urllib.error\r\nimport urllib.request\r\nfrom urllib.parse import urlsplit\r\n\r\nfrom audio.tomas import obtener_contexto_retroalimentacion, _buscar_toma\r\n\r\nVERSION_PROMPT = '1'\r\n_lock = threading.RLock()\r\n_session = {}\r\n\r\n\r\ndef configuracion():\r\n    proveedor = _session.get('proveedor', os.getenv('KARAOKE_LLM_PROVIDER', 'ollama'))\r\n    return dict(proveedor=proveedor,\r\n                modelo=_session.get('modelo', os.getenv('KARAOKE_LLM_MODEL', 'qwen3:4b' if proveedor == 'ollama' else 'gpt-4.1-mini')),\r\n                servidor=_session.get('servidor', os.getenv('KARAOKE_OLLAMA_URL', 'http://127.0.0.1:11434')),\r\n                api_key=_session.get('api_key', os.getenv('OPENAI_API_KEY', '')))\r\n\r\n\r\ndef estado_configuracion():\r\n    c = configuracion()\r\n    return dict(proveedor=c['proveedor'], modelo=c['modelo'], configurado=bool(c['api_key']),\r\n                servidor=c['servidor'],\r\n                activo=c['proveedor'] == 'ollama' or (c['proveedor'] == 'openai' and bool(c['api_key'])))\r\n\r\n\r\ndef configurar(proveedor='ollama', modelo='qwen3:4b', api_key=None, servidor=None):\r\n    if proveedor not in ('ollama', 'openai', 'plantillas'):\r\n        raise ValueError('Proveedor no admitido.')\r\n    if not isinstance(modelo, str) or not modelo.strip() or len(modelo) > 100:\r\n        raise ValueError('Modelo inválido.')\r\n    with _lock:\r\n        if servidor is not None:\r\n            parsed = urlsplit(servidor)\r\n            if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment or parsed.path not in ('', '/'):\r\n                raise ValueError('Introduce la dirección del servidor Ollama, sin rutas ni credenciales.')\r\n            if parsed.hostname.lower() in ('ollama.com', 'api.ollama.com'):\r\n                raise ValueError('Usa un servidor propio de Ollama, no el servicio cloud.')\r\n            _session['servidor'] = servidor.rstrip('/')\r\n        _session.update(proveedor=proveedor, modelo=modelo.strip())\r\n        if api_key is not None:\r\n            _session['api_key'] = str(api_key).strip()\r\n    return estado_configuracion()\r\n\r\n\r\ndef _obj(properties):\r\n    return dict(type='object', properties=properties, required=list(properties), additionalProperties=False)\r\n\r\n\r\nTEXTO = dict(type='string')\r\nITEM = _obj(dict(texto=TEXTO, evidencia_ids=dict(type='array', items=TEXTO)))\r\nESQUEMA = _obj(dict(resumen=TEXTO, aciertos=dict(type='array', items=ITEM),\r\n                    aspectos_a_revisar=dict(type='array', items=ITEM),\r\n                    practica_sugerida=dict(type='array', items=_obj(dict(\r\n                        texto=TEXTO, evidencia_ids=dict(type='array', items=TEXTO), accion_id=TEXTO))),\r\n                    limitaciones=dict(type='array', items=TEXTO)))\r\nINSTRUCCIONES = '''Redacta retroalimentación de afinación en español claro, amable y concreto.\r\nUsa exclusivamente el contexto y sus evidencias. No recalcules ni inventes números o tiempos.\r\nNo diagnostiques respiración, técnica, ritmo o salud. No afirmes progreso entre tomas.\r\nRespeta el método: puede haber un ajuste manual de sincronización, que no demuestra\r\nuna medición de latencia. Describe diferencias detectadas, no su causa.\r\nLa ausencia de pitch no demuestra que no se cantó. No valores partes sin evidencia.\r\nCada acierto o aspecto debe citar evidencia_ids de su categoría; cada práctica debe citar\r\nevidencia y una accion_id que esa evidencia incluya. Deja listas vacías cuando no haya respaldo.\r\nEl resumen debe describir alcance y cobertura sin una nota global. En alcance fragmento,\r\ndescribe exclusivamente ese fragmento. En alcance resumen, resume solo hallazgos suministrados.\r\nNo incluyas HTML ni Markdown. Como máximo tres elementos por lista y frases breves.\r\nExpresa límites relevantes, incluyendo el estado de sincronización.'''\r\n\r\n\r\ndef _contexto(context, fragmento_id):\r\n    # No envía los 36 fragmentos para redactar un resumen ni datos globales en una consulta local.\r\n    if fragmento_id:\r\n        f = context['analisis_fragmentos'][0]\r\n        evidence = f['eventos_seleccionados']\r\n        return dict(alcance='fragmento', fragmento_id=f['id'], inicio_s=f['inicio_s'], fin_s=f['fin_s'],\r\n                    metricas=f['metricas'], suficiencia=f['suficiencia_evidencia'],\r\n                    evidencias=evidence, eventos_no_incluidos=f['eventos_no_incluidos'],\r\n                    metodo=context['metodo'], limitaciones=context['calidad']['limitaciones'])\r\n    return dict(alcance='resumen', metricas=context['resumen_metricas'],\r\n                suficiencia=context['calidad']['suficiencia_evidencia'],\r\n                metodo=context['metodo'], evidencias=context['hallazgos_seleccionados'], limitaciones=context['calidad']['limitaciones'])\r\n\r\n\r\ndef validar(respuesta, contexto):\r\n    if not isinstance(respuesta, dict) or set(respuesta) != set(ESQUEMA['properties']):\r\n        raise ValueError('Estructura de respuesta inválida.')\r\n    if not isinstance(respuesta['resumen'], str) or not respuesta['resumen'].strip() or len(respuesta['resumen']) > 3000:\r\n        raise ValueError('Resumen inválido.')\r\n    ev = {e['id']: e for e in contexto['evidencias']}\r\n    for key, category in [('aciertos', 'fortaleza'), ('aspectos_a_revisar', 'aspecto_por_mejorar'), ('practica_sugerida', None)]:\r\n        items = respuesta[key]\r\n        if not isinstance(items, list) or len(items) > 3:\r\n            raise ValueError('Lista inválida.')\r\n        for item in items:\r\n            keys = {'texto', 'evidencia_ids'} | ({'accion_id'} if category is None else set())\r\n            if not isinstance(item, dict) or set(item) != keys or not isinstance(item['texto'], str) or not 1 <= len(item['texto']) <= 2000:\r\n                raise ValueError('Elemento inválido.')\r\n            ids = item['evidencia_ids']\r\n            if not isinstance(ids, list) or not ids or not all(isinstance(i, str) and i in ev for i in ids):\r\n                raise ValueError('Evidencia inexistente o ajena al fragmento.')\r\n            if category and any(ev[i]['categoria'] != category for i in ids):\r\n                raise ValueError('La categoría no coincide con la evidencia.')\r\n            if category is None and (not isinstance(item['accion_id'], str) or not all(\r\n                (ev[i].get('accion_sugerida') or {}).get('id') == item['accion_id'] for i in ids)):\r\n                raise ValueError('Práctica sin respaldo.')\r\n    limits = respuesta['limitaciones']\r\n    if not isinstance(limits, list) or len(limits) > 10 or not all(isinstance(v, str) and len(v) <= 2000 for v in limits):\r\n        raise ValueError('Limitaciones inválidas.')\r\n    return respuesta\r\n\r\n\r\nETIQUETAS = dict(afinacion_cercana='Las notas detectadas estuvieron cerca de la referencia.',\r\n    tendencia_aguda='Se observó una tendencia por encima de la referencia.',\r\n    tendencia_grave='Se observó una tendencia por debajo de la referencia.',\r\n    desviacion_aguda='Las notas detectadas estuvieron por encima de la referencia.',\r\n    desviacion_grave='Las notas detectadas estuvieron por debajo de la referencia.',\r\n    desviaciones_frecuentes='Se observaron diferencias frecuentes respecto de la referencia.',\r\n    discrepancia_grande='Hay diferencias grandes que requieren revisar la detección y la sincronización.',\r\n    sin_deteccion_usuario='No se detectó suficiente pitch del usuario en este intervalo.',\r\n    sin_referencia='No hay referencia detectada suficiente para comparar este intervalo.',\r\n    referencia_insuficiente='La referencia detectada no es suficiente para evaluar este fragmento.',\r\n    deteccion_insuficiente='No hay suficiente tiempo comparable para valorar el fragmento.',\r\n    cobertura_parcial='Solo se pudo comparar una parte del fragmento.')\r\n\r\n\r\ndef plantilla(ctx):\r\n    m = ctx['metricas']\r\n    coverage = m['cobertura_comparable_pct']\r\n    resumen = ('No hay suficiente referencia detectada para evaluar.' if coverage is None else\r\n               f\"Se pudo comparar el {coverage:.1f}% del tiempo con referencia detectada.\")\r\n    if ctx['suficiencia'] == 'suficiente' and m['porcentaje_dentro_tolerancia'] is not None:\r\n        resumen += f\" De ese tiempo comparable, el {m['porcentaje_dentro_tolerancia']:.1f}% estuvo dentro del margen de afinación.\"\r\n    else:\r\n    root.replaceChildren(el('h2', 'Análisis por fragmentos'));\r\n    if (!take?.id || !api()?.get_feedback) { root.append(el('p', 'Selecciona una toma del historial o graba una interpretación.')); return; }\r\n    root.append(el('p', 'Preparando métricas y fragmentos…', 'feedback-note'));\r\n    try {\r\n      const r = await api().get_feedback(song.id, take.id);\r\n      if (ticket !== revision) return;\r\n      if (!r.ok) throw new Error(r.error);\r\n      data = r; render();\r\n    } catch (error) {\r\n      if (ticket !== revision) return;\r\n      root.replaceChildren(el('h2', 'Análisis por fragmentos'), el('p', error.message || 'No se pudo cargar el análisis.'));\r\n      root.append(button('Volver a cargar', () => refresh(true)));\r\n    }\r\n  }\r\n  async function settings() {\r\n    if (!api()?.get_llm_settings) return;\r\n    const c = await api().get_llm_settings();\r\n    document.getElementById('llmProvider').value = c.proveedor;\r\n    document.getElementById('llmModel').value = c.modelo;\r\n    document.getElementById('llmServer').value = c.servidor || 'http://127.0.0.1:11434';\r\n    document.getElementById('llmStatus').textContent = c.proveedor === 'ollama' ? (c.mensaje || 'Conexión local configurada.') : 'Modo básico: no se consulta ningún modelo.';\r\n  }\r\n  async function save() {\r\n    const status = document.getElementById('llmStatus');\r\n    if (!api()?.configure_llm) { status.textContent = 'Abre la app de escritorio para configurar la conexión.'; return; }\r\n    status.textContent = 'Aplicando ajustes…';\r\n    try {\r\n      const r = await api().configure_llm(document.getElementById('llmProvider').value, document.getElementById('llmModel').value, null, document.getElementById('llmServer').value.trim());\r\n      if (!r.ok) throw new Error(r.error); await settings(); identity = ''; refresh(true);\r\n    } catch (_) { status.textContent = 'No se pudieron aplicar los ajustes.'; }\r\n  }\r\n  document.getElementById('llmSave').onclick = () => save();\r\n  document.getElementById('llmCheck').onclick = () => settings();\r\n  window.feedbackUI = { refresh };\r\n  window.addEventListener('pywebviewready', () => { settings(); refresh(); });\r\n  settings(); refresh();\r\n})();\r\n\r\n(() => {\r\n  const panel = document.getElementById('preparationProgress');\r\n  let timer = null, generation = 0;\r\n  window.preparationUI = {\r\n    start() {\r\n      this.stop(); const current = ++generation, since = Date.now();\r\n      panel.classList.remove('hidden');\r\n      document.getElementById('preparationMessage').textContent = 'Preparando canción…';\r\n      const poll = async () => {\r\n        if (current !== generation) return;\r\n        try {\r\n          const r = await window.pywebview.api.get_preparation_state();\r\n          if (current !== generation) return;\r\n          document.getElementById('preparationMessage').textContent = r.message;\r\n          document.getElementById('preparationElapsed').textContent = `${Math.floor((Date.now()-since)/1000)} s transcurridos · La separación puede tardar varios minutos.`;\r\n        } catch (_) { /* Mantener barra mientras la operación principal sigue en curso. */ }\r\n        if (current === generation) timer = setTimeout(poll, 700);\r\n      }; poll();\r\n    },\r\n    stop() { generation++; clearTimeout(timer); timer = null; panel.classList.add('hidden'); }\r\n  };\r\n})();\r\nimport copy\r\nimport json\r\nfrom pathlib import Path\r\nimport tempfile\r\nimport unittest\r\nfrom unittest.mock import patch, Mock\r\nimport urllib.error\r\nimport numpy as np\r\n\r\nfrom audio import explicaciones as ex\r\nfrom audio.alineacion import sugerir_desfase, guardar_ajuste, leer_ajuste\r\nfrom audio.retroalimentacion import generar_retroalimentacion, preparar_contexto_modelo\r\n\r\n\r\ndef contexto():\r\n    t = np.arange(0, 5, .01)\r\n    f = np.full(len(t), 440.)\r\n    return preparar_contexto_modelo(generar_retroalimentacion(t, f, t, f, 5))\r\n\r\n\r\nclass ExplanationTests(unittest.TestCase):\r\n    def setUp(self):\r\n        self.saved = dict(ex._session)\r\n        ex._session.clear()\r\n\r\n    def tearDown(self):\r\n        ex._session.clear(); ex._session.update(self.saved)\r\n\r\n    def test_configuration_never_returns_secret(self):\r\n        state = ex.configurar('openai', 'gpt-4.1-mini', api_key='test-secret')\r\n        self.assertTrue(state['activo'])\r\n        self.assertNotIn('test-secret', json.dumps(state))\r\n        self.assertNotIn('api_key', state)\r\n\r\n    def test_missing_key_never_calls_provider(self):\r\n        with tempfile.TemporaryDirectory() as folder:\r\n            audio = Path(folder)/'take.wav'; audio.touch()\r\n            with patch.object(ex, 'obtener_contexto_retroalimentacion', return_value=contexto()), \\\r\n                 patch.object(ex, '_buscar_toma', return_value={'voice_path': str(audio)}), \\\r\n                 patch.object(ex.PROVEEDORES['openai'], 'generar') as provider:\r\n                ex.configurar('openai', 'gpt-4.1-mini', api_key='')\r\n                r = ex.explicar({}, 'take')\r\n                self.assertEqual(r['origen'], 'plantilla'); provider.assert_not_called()\r\n                self.assertFalse(ex.ruta_cache(audio).exists())\r\n\r\n    def test_cache_hit_and_context_invalidation(self):\r\n        c = contexto()\r\n        with tempfile.TemporaryDirectory() as folder:\r\n            audio = Path(folder)/'take.wav'; audio.touch()\r\n            with patch.object(ex, 'obtener_contexto_retroalimentacion', return_value=c), \\\r\n                 patch.object(ex, '_buscar_toma', return_value={'voice_path': str(audio)}), \\\r\n                 patch.object(ex.PROVEEDORES['openai'], 'generar', side_effect=lambda ctx,cfg: ex.plantilla(ctx)) as provider:\r\n                ex.configurar('openai', 'gpt-4.1-mini', api_key='test-secret')\r\n                self.assertFalse(ex.explicar({}, 'take')['guardada'])\r\n                self.assertTrue(ex.explicar({}, 'take')['guardada'])\r\n                self.assertEqual(provider.call_count, 1)\r\n                c['metodo']['sincronizacion'] = 'ajuste_manual'\r\n                c['metodo']['latencia_estimada_s'] = .24\r\n                ex.explicar({}, 'take')\r\n                self.assertEqual(provider.call_count, 2)\r\n\r\n", "exitCode": 0, "durationMs": 3236}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "rs_06f6aa8593d2a892016acaf5977b5087d2a53604d1f45ce96a", "rollout_ordinal": 2807, "created_at_ms": 1791686038028, "item_type": "reasoning", "updated_at_ordinal": 2807, "started_at_ms": 1791686038028, "completed_at_ms": 1791686039471}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaf5977b5087d2a53604d1f45ce96a", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "msg_06f6aa8593d2a892016acaf598082487d2a93e83ebdefae37b", "rollout_ordinal": 2809, "created_at_ms": 1791686039514, "item_type": "agentMessage", "updated_at_ordinal": 2809, "started_at_ms": 1791686039514, "completed_at_ms": 1791686040411}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016acaf598082487d2a93e83ebdefae37b", "text": "El motor local ya está instalado y su firma digital es válida. Ahora se está descargando el modelo; esta descarga se hace una sola vez. También estoy ajustando la interfaz para que los participantes no tengan que introducir ninguna clave.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-04279cea-1985-4d5d-a5b2-fcdcaa4c1198", "rollout_ordinal": 2813, "created_at_ms": 1791686043912, "item_type": "commandExecution", "updated_at_ordinal": 2813, "started_at_ms": 1791686043912, "completed_at_ms": 1791686045079}, "item": {"type": "commandExecution", "id": "exec-04279cea-1985-4d5d-a5b2-fcdcaa4c1198", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content scripts/instalar_ollama_cpu.py -Head 110; rg -n \"OpenAI|API|LLM|clave\" docs/retroalimentacion_backend.md; Get-Content audio/explicaciones.py | Select-Object -Skip 235 -First 105; Get-Content \"$env:LOCALAPPDATA/KaraokeStudio/ollama/descarga-error.log\" -Tail 2'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "97068", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content scripts/instalar_ollama_cpu.py -Head 110; rg -n \"OpenAI|API|LLM|clave\" docs/retroalimentacion_backend.md; Get-Content audio/explicaciones.py | Select-Object -Skip 235 -First 105; Get-Content \"$env:LOCALAPPDATA/KaraokeStudio/ollama/descarga-error.log\" -Tail 2"}], "aggregatedOutput": "\"\"\"Extrae solo el runtime CPU del ZIP oficial para evitar descargar librerías CUDA.\"\"\"\r\nimport concurrent.futures\r\nimport io\r\nimport os\r\nfrom pathlib import Path\r\nimport struct\r\nimport urllib.request\r\nimport zipfile\r\nimport zlib\r\n\r\nURL = 'https://github.com/ollama/ollama/releases/download/v0.40.2/ollama-windows-amd64.zip'\r\nSIZE = 1468085195\r\n\r\n\r\ndef rango(a, b):\r\n    request = urllib.request.Request(URL, headers={'Range': f'bytes={a}-{b}'})\r\n    with urllib.request.urlopen(request, timeout=90) as response:\r\n        if response.status != 206 or response.headers.get('Content-Range') != f'bytes {a}-{b}/{SIZE}':\r\n            raise RuntimeError('El servidor no devolvió el rango esperado del archivo oficial.')\r\n        data = response.read()\r\n    if len(data) != b-a+1:\r\n        raise RuntimeError('Descarga incompleta.')\r\n    return data\r\n\r\n\r\ndef main():\r\n    root = Path(os.environ['LOCALAPPDATA'])/'KaraokeStudio/ollama'\r\n    root.mkdir(parents=True, exist_ok=True)\r\n    tail = rango(SIZE-65536, SIZE-1)\r\n    with zipfile.ZipFile(io.BytesIO(tail)) as archive:\r\n        files = [i for i in archive.infolist() if not i.is_dir() and\r\n                 not any(p in ('cuda_v12', 'cuda_v13', 'vulkan') for p in Path(i.filename).parts)]\r\n    print(f'Descarga CPU: {sum(i.compress_size for i in files)/1e6:.1f} MB desde el ZIP oficial.', flush=True)\r\n    def extract(info):\r\n        target = (root/info.filename).resolve()\r\n        if root.resolve() not in target.parents:\r\n            raise RuntimeError('Ruta inesperada en el archivo.')\r\n        if target.exists() and zlib.crc32(target.read_bytes()) == info.CRC:\r\n            return\r\n        offset = info.header_offset + SIZE-65536\r\n        header = rango(offset, offset+29)\r\n        if header[:4] != b'PK\\x03\\x04':\r\n            raise RuntimeError('Cabecera ZIP inválida.')\r\n        name_length, extra_length = struct.unpack_from('<HH', header, 26)\r\n        start = offset+30+name_length+extra_length\r\n        raw = rango(start, start+info.compress_size-1)\r\n        content = zlib.decompress(raw, -15) if info.compress_type == zipfile.ZIP_DEFLATED else raw\r\n        if len(content) != info.file_size or zlib.crc32(content) != info.CRC:\r\n            raise RuntimeError('CRC o tamaño incorrecto.')\r\n        target.parent.mkdir(parents=True, exist_ok=True)\r\n        temp = target.with_suffix(target.suffix+'.tmp')\r\n        temp.write_bytes(content)\r\n        os.replace(temp, target)\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:\r\n        list(pool.map(extract, files))\r\n    print('Motor CPU extraído. Origen HTTPS oficial; integridad CRC de cada archivo verificada.', flush=True)\r\n\r\n\r\nif __name__ == '__main__':\r\n    main()\r\n37:Este módulo de análisis no llama a servicios externos. La capa `audio.explicaciones` consume el contexto y conecta la redacción con OpenAI o plantillas; ambas interfaces ya permiten consultar resultados. La configuración, caché y sincronización se describen en [conexion_llm_interfaz.md](conexion_llm_interfaz.md). No hay lectura en voz alta.\n42:- `metodo`: comparación, fuente, unidades implícitas en las claves, denominadores, parámetros y latencia no estimada.\n57:La comparación histórica `audio.comparacion.comparar` usa DTW sobre frecuencias y excluye diferencias de 1.000 cents o más. Sus campos siguen intactos para compatibilidad. **No se deben pasar esos campos al LLM como si fueran las métricas de este nuevo contexto.**\n    with _lock:\r\n        context = obtener_contexto_retroalimentacion(cancion, toma_id, fragmento_id)\r\n        ctx = _contexto(context, fragmento_id)\r\n        config = configuracion()\r\n        base = dict(origen='plantilla', guardada=False, aviso='', contenido=plantilla(ctx))\r\n        toma = _buscar_toma(cancion, toma_id)\r\n        path = ruta_cache(toma['voice_path'])\r\n        key = hashlib.sha256(json.dumps(dict(contexto=ctx, version=VERSION_PROMPT, instrucciones=INSTRUCCIONES,\r\n            modelo=config['modelo'], proveedor=config['proveedor'],\r\n            servidor=config['servidor'] if config['proveedor'] == 'ollama' else None), sort_keys=True, ensure_ascii=False).encode()).hexdigest()\r\n        try:\r\n            cache = json.loads(path.read_text(encoding='utf-8'))\r\n            if not isinstance(cache, dict):\r\n                cache = {}\r\n        except (OSError, ValueError):\r\n            cache = {}\r\n        if key in cache:\r\n            try:\r\n                validated = validar(cache[key], ctx)\r\n                return dict(origen=config['proveedor'], modelo=config['modelo'], guardada=True, aviso='', contenido=validated)\r\n            except (ValueError, TypeError, KeyError):\r\n                cache.pop(key, None)\r\n        if not generar:\r\n            return base\r\n        if config['proveedor'] == 'plantillas' or (config['proveedor'] == 'openai' and not config['api_key']):\r\n            base['aviso'] = 'Explicación básica. Puedes activar la redacción con IA en Ajustes.'\r\n            return base\r\n        try:\r\n            response = PROVEEDORES[config['proveedor']].generar(ctx, config)\r\n            validated = validar(response, ctx)\r\n        except ErrorProveedor as exc:\r\n            base['aviso'] = str(exc)+' Se muestra la explicación básica.'\r\n            return base\r\n        except (ValueError, KeyError, TypeError):\r\n            base['aviso'] = 'La respuesta no pasó la validación. Se muestra la explicación básica.'\r\n            return base\r\n        response = dict(origen=config['proveedor'], modelo=config['modelo'], guardada=False, aviso='', contenido=validated)\r\n        cache[key] = validated\r\n        # No recrear datos de una toma eliminada mientras se esperaba a la API.\r\n        if Path(toma['voice_path']).exists():\r\n            temp = path.with_suffix('.tmp')\r\n            try:\r\n                temp.write_text(json.dumps(cache, ensure_ascii=False, allow_nan=False), encoding='utf-8')\r\n                os.replace(temp, path)\r\n            except OSError:\r\n                response['aviso'] = 'La explicación se generó, pero no pudo guardarse.'\r\n                temp.unlink(missing_ok=True)\r\n        return response\r\n\r\n\r\ndef panel(cancion, toma_id):\r\n    from audio.alineacion import leer_ajuste\r\n    toma = _buscar_toma(cancion, toma_id)\r\n    context = obtener_contexto_retroalimentacion(cancion, toma_id)\r\n    return dict(configuracion=estado_configuracion(), metricas=context['resumen_metricas'],\r\n        calidad=context['calidad'], fragmentos=context['analisis_fragmentos'],\r\n        desfase_ms=round(leer_ajuste(toma['voice_path'])*1000),\r\n        explicacion=explicar(cancion, toma_id, generar=False))\r\npulling 3e4cb1417446:   0% ▕                  ▏ 8.5 MB/2.5 GB  1.3 MB/s  32m35s\u001b[K\u001b[A\u001b[1Gpulling manifest \u001b[K\r\npulling 3e4cb1417446:   0% ▕                  ▏ 8.6 MB/2.5 GB  1.3 MB/s  32m35s\u001b[K\u001b[A\u001b[1Gpulling manifest \u001b[K\r\npulling 3e4cb1417446:   0% ▕                  ▏ 8.9 MB/2.5 GB  1.3 MB/s  32m35s\u001b[K\r\n", "exitCode": 0, "durationMs": 1166}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "rs_06f6aa8593d2a892016acaf5a20a5087d28f4da37ec2486513", "rollout_ordinal": 2816, "created_at_ms": 1791686048534, "item_type": "reasoning", "updated_at_ordinal": 2816, "started_at_ms": 1791686048534, "completed_at_ms": 1791686052532}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaf5a20a5087d28f4da37ec2486513", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-6acafed6-b68c-4ef5-be4b-10be2b11c233", "rollout_ordinal": 2820, "created_at_ms": 1791686062625, "item_type": "commandExecution", "updated_at_ordinal": 2820, "started_at_ms": 1791686062625, "completed_at_ms": 1791686063277}, "item": {"type": "commandExecution", "id": "exec-6acafed6-b68c-4ef5-be4b-10be2b11c233", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content docs/conexion_llm_interfaz.md; Get-Content audio/explicaciones.py | Select-Object -Skip 170 -First 68; Get-Content iniciar.bat -ErrorAction SilentlyContinue'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "84817", "source": "unifiedExecStartup", "status": "failed", "commandActions": [{"type": "unknown", "command": "Get-Content docs/conexion_llm_interfaz.md; Get-Content audio/explicaciones.py | Select-Object -Skip 170 -First 68; Get-Content iniciar.bat -ErrorAction SilentlyContinue"}], "aggregatedOutput": "# Explicaciones, interfaz y sincronización\r\n\r\n## Uso\r\n\r\nReiniciar la aplicación con `iniciar_live.bat`. En **Resultado** o **Historial**, seleccionar una toma. Debajo del gráfico aparece **Análisis por fragmentos**: cobertura, porcentaje temporal dentro de ±50 cents, resumen y lista de intervalos. Al abrir un intervalo se carga su explicación y se puede escuchar la parte correspondiente de la voz grabada. Los eventos y las limitaciones están desplegables.\r\n\r\nEn **Ajustes → Redacción con IA**, elegir OpenAI, modelo e introducir una clave de API. La clave queda únicamente en memoria durante esa ejecución; el campo se vacía tras enviarla al backend. Sin clave, o en modo básico, se usan plantillas deterministas. La interfaz Tkinter tiene **Ver retroalimentación por fragmentos**, selector de tomas y configuración de clave para la sesión.\r\n\r\nTambién se puede iniciar la aplicación con las variables `OPENAI_API_KEY`, `KARAOKE_LLM_MODEL` (por defecto `gpt-4.1-mini`) y `KARAOKE_LLM_PROVIDER` (`openai` o `plantillas`). No escribir claves en archivos del proyecto. El entorno actual no tenía clave, por lo que la integración externa se probó con respuestas simuladas, no con una llamada de pago.\r\n\r\n## Flujo y almacenamiento\r\n\r\n`audio.explicaciones` usa Responses API y un esquema de salida estricto. Envía únicamente métricas, hallazgos/eventos seleccionados, método y limitaciones. El resumen no envía todos los fragmentos; una consulta individual solo incluye el fragmento elegido. No se envían audios, nombres, rutas ni claves dentro del contexto.\r\n\r\nLa respuesta contiene `resumen`, `aciertos`, `aspectos_a_revisar`, `practica_sugerida` y `limitaciones`. Se validan estructura, longitudes, IDs de evidencia, categoría y acciones respaldadas. Esto no demuestra por sí solo fidelidad semántica de toda frase; requiere evaluación con respuestas reales antes de considerar estable la calidad de redacción.\r\n\r\nEl proveedor está separado en `OpenAIProvider` y el registro `PROVEEDORES`. Añadir otro requiere un adaptador que implemente `generar(contexto, config)` y configuración correspondiente. No hay clientes Gemini/Ollama implementados.\r\n\r\nLas respuestas válidas se guardan en `*_explicaciones.json`, con clave hash del contexto, modelo, proveedor, versión e instrucciones. Cambiar el desfase o evidencia invalida naturalmente la entrada anterior. Se reutilizan respuestas sin nuevas llamadas; los fallos y las plantillas no se guardan como éxitos de IA. Las escrituras son atómicas y las solicitudes se serializan en el proceso. Eliminar una toma elimina también esta caché y su ajuste de alineación. Cerrar o cambiar de toma impide mostrar respuestas tardías de otra toma, aunque una solicitud ya enviada puede terminar y quedar guardada.\r\n\r\nEl timeout externo es de 45 segundos. Fallos de conexión, credenciales, cuota, rechazo, respuesta incompleta o inválida dejan disponible una explicación básica y reintento explícito. No se muestran cuerpos de error remotos ni secretos. No hay reintentos automáticos de pago.\r\n\r\n## Diferencias entre métricas y alineación\r\n\r\nEl indicador histórico usa DTW sobre secuencias de frecuencia y excluye diferencias ≥1000 cents. La comparación por fragmentos usa tiempo compartido, conserva discrepancias grandes y cuenta solo intervalos evaluables. Son métricas diferentes: no se deben comparar como si midieran lo mismo. El panel histórico queda etiquetado como tal.\r\n\r\n**Revisar sincronización** ofrece una estimación entre −2000 y +2000 ms (paso de exploración de 40 ms). Busca coincidencias de pitch penalizando falta de coincidencia, sobre un denominador fijo de referencia detectada. Requiere al menos cinco segundos de referencia y una mejora mínima de 0,03 en el objetivo; candidatos cercanos al extremo se descartan. Estos son criterios heurísticos de exploración, no confianza calibrada. La estimación puede confundir latencia y retraso interpretativo; no se aplica automáticamente ni demuestra mejora de afinación.\r\n\r\nUn valor positivo significa voz atrasada: se resta ese tiempo de sus timestamps. **Aplicar y recalcular** guarda la decisión en `*_alineacion.json` y recalcula la retroalimentación sin modificar audio, pitch ni resultado histórico. Cero restaura la comparación sin ajuste. Se recortan extremos no capturados. No se estira el tiempo ni se buscan ajustes distintos por fragmento. La lectura de la toma devuelve `sincronizacion: ajuste_manual` y registra el valor; el campo heredado `latencia_estimada_s` contiene aquí el ajuste elegido, no una medida instrumental de latencia.\r\n\r\nEl ajuste visual del gráfico y el mezclador ya existentes siguen siendo controles de visualización/reproducción, no correcciones de las métricas. La escucha de un fragmento toma sus límites de referencia y añade el desfase para localizar el audio original del usuario. El mezclador conserva su ajuste independiente.\r\n\r\nDiagnóstico exploratorio sobre las últimas tomas de Destello encontró candidatos de +240 y +280 ms. Mejoraron la coincidencia temporal, pero no igualaron el indicador histórico. El archivo `output/diagnostico_alineacion.json` registra el barrido exploratorio en la línea temporal completa, fuera de la selección de fragmentos. No se han aplicado estos valores a las tomas del usuario.\r\n\r\n## Preparación de canciones\r\n\r\nLa barra indeterminada muestra la etapa real: separación Demucs, mezcla instrumental o extracción de pitch. No muestra porcentajes ficticios ni estima duración restante. La interfaz web consulta el estado cada 700 ms mientras dura la operación y oculta la barra al terminar o fallar. Tkinter muestra la misma actividad mediante callbacks. Las pistas reutilizadas omiten las etapas que no se ejecutan.\r\n\r\n## Verificación\r\n\r\n`python -m unittest discover -s tests` cubre caché e invalidación, clave ausente, errores externos simulados, contrato Responses, referencias de evidencia inválidas, desfase conocido y persistencia, recálculo sin modificar resultados y etapas de preparación.\r\n\r\n`scripts/verificar_interfaz.cjs` prueba la interfaz real en Edge sin ventana con un puente de escritorio simulado y datos reales: resumen, fragmentos, ajuste de desfase, respuestas tardías, barra y configuración. Las imágenes se guardan en `output/prueba_interfaz`. El fichero `fixture.json` es un artefacto de prueba local, no parte del funcionamiento de la aplicación.\r\n\r\nDocumentación oficial consultada: [Responses y salidas estructuradas](https://developers.openai.com/api/docs/guides/structured-outputs), [GPT-4.1 mini](https://developers.openai.com/api/docs/models/gpt-4.1-mini).\r\n        request = urllib.request.Request('https://api.openai.com/v1/responses',\r\n            data=json.dumps(payload).encode('utf-8'),\r\n            headers={'Authorization': 'Bearer '+config['api_key'], 'Content-Type': 'application/json'}, method='POST')\r\n        try:\r\n            with urllib.request.urlopen(request, timeout=45) as response:\r\n                result = json.load(response)\r\n        except urllib.error.HTTPError as exc:\r\n            messages = {401: 'La clave de API no es válida.', 403: 'La cuenta no tiene acceso al modelo.',\r\n                        429: 'Se alcanzó el límite de uso o de solicitudes de la API.'}\r\n            raise ErrorProveedor(messages.get(exc.code, 'La API no pudo completar la explicación.')) from None\r\n        except (urllib.error.URLError, TimeoutError, OSError):\r\n            raise ErrorProveedor('No se pudo conectar con la API a tiempo.') from None\r\n        if result.get('status') != 'completed':\r\n            raise ErrorProveedor('La API devolvió una explicación incompleta.')\r\n        content = [c for item in result.get('output', []) if item.get('type') == 'message' for c in item.get('content', [])]\r\n        if any(c.get('type') == 'refusal' for c in content):\r\n            raise ErrorProveedor('El modelo no generó una explicación para estos datos.')\r\n        text = ''.join(c.get('text', '') for c in content if c.get('type') == 'output_text')\r\n        return json.loads(text)\r\n\r\n\r\nclass OllamaProvider:\r\n    def generar(self, contexto, config):\r\n        if 'cloud' in config['modelo'].lower():\r\n            raise ErrorProveedor('Elige un modelo descargado localmente, no un modelo cloud.')\r\n        payload = dict(model=config['modelo'], stream=False, think=False, format=ESQUEMA,\r\n            keep_alive='5m', options=dict(temperature=0, num_ctx=8192, num_predict=1800),\r\n            messages=[dict(role='system', content=INSTRUCCIONES),\r\n                      dict(role='user', content=json.dumps(contexto, ensure_ascii=False, allow_nan=False))])\r\n        request = urllib.request.Request(config['servidor'].rstrip('/')+'/api/chat',\r\n            data=json.dumps(payload).encode('utf-8'), headers={'Content-Type': 'application/json'}, method='POST')\r\n        try:\r\n            with urllib.request.urlopen(request, timeout=180) as response:\r\n                result = json.load(response)\r\n        except urllib.error.HTTPError as exc:\r\n            raise ErrorProveedor('El modelo no está instalado en Ollama.' if exc.code == 404 else\r\n                                 'Ollama no pudo generar la explicación.') from None\r\n        except (urllib.error.URLError, TimeoutError, OSError):\r\n            raise ErrorProveedor('No se pudo conectar con Ollama o la generación tardó demasiado. Comprueba que el servidor local esté iniciado.') from None\r\n        if not result.get('done') or result.get('done_reason') == 'length':\r\n            raise ErrorProveedor('El modelo local devolvió una explicación incompleta.')\r\n        return json.loads(result.get('message', {}).get('content', ''))\r\n\r\n\r\nPROVEEDORES = {'openai': OpenAIProvider(), 'ollama': OllamaProvider()}\r\n\r\n\r\ndef comprobar_ollama():\r\n    config = configuracion()\r\n    try:\r\n        with urllib.request.urlopen(config['servidor'].rstrip('/')+'/api/tags', timeout=3) as response:\r\n            models = [m['name'] for m in json.load(response).get('models', [])]\r\n        ready = config['modelo'] in models or config['modelo']+':latest' in models\r\n        return dict(disponible=ready, modelos=models, mensaje='Modelo local listo.' if ready else\r\n                    f\"Servidor conectado. Falta descargar el modelo {config['modelo']}.\")\r\n    except (OSError, ValueError, KeyError, TypeError):\r\n        return dict(disponible=False, modelos=[], mensaje='No se encuentra Ollama. Inicia el servidor local para activar la IA sin cuenta.')\r\n\r\n\r\ndef ruta_cache(ruta_audio):\r\n    return Path(ruta_audio).with_name(Path(ruta_audio).stem+'_explicaciones.json')\r\n\r\n\r\ndef explicar(cancion, toma_id, fragmento_id=None, generar=True):\r\n    # Serializa lectura/generación/escritura para no duplicar solicitudes simultáneas.\r\n    with _lock:\r\n        context = obtener_contexto_retroalimentacion(cancion, toma_id, fragmento_id)\r\n        ctx = _contexto(context, fragmento_id)\r\n", "exitCode": 1, "durationMs": 651}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128c8-0d7a-7d20-84a4-e8fb3efa294f", "item_id": "exec-c88f41a9-42eb-425b-a864-9623a29982b0", "rollout_ordinal": 2821, "created_at_ms": 1791686063307, "item_type": "fileChange", "updated_at_ordinal": 2821, "started_at_ms": 1791686063307, "completed_at_ms": 1791686063310}, "item": {"type": "fileChange", "id": "exec-c88f41a9-42eb-425b-a864-9623a29982b0", "changes": [{"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\explicaciones.py", "kind": {"type": "update", "move_path": null}, "diff": "@@ -27,3 +27,3 @@\n     c = configuracion()\n-    return dict(proveedor=c['proveedor'], modelo=c['modelo'], configurado=bool(c['api_key']),\n+    return dict(proveedor=c['proveedor'], modelo=c['modelo'], configurado=c['proveedor'] == 'ollama' or bool(c['api_key']),\n                 servidor=c['servidor'],\n"}, {"path": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\preparar_ia_local.ps1", "kind": {"type": "update", "move_path": null}, "diff": "@@ -8,14 +8,7 @@\n     if ($SoloIniciar) { throw 'Primero ejecuta preparar_ia_local.ps1 sin -SoloIniciar.' }\n-    $archivoZipIA = Join-Path $carpetaIA 'ollama-windows-amd64.zip'\n-    $hashEsperadoIA = 'e29ad1d5063dd4b54b2492d9b00adab2cff9621bfa654b6c92aa8d6f1fdfe7fc'\n-    Write-Host 'Descargando Ollama portable (aproximadamente 1,5 GB), sin cuenta...'\n-    if (!(Test-Path -LiteralPath $archivoZipIA)) {\n-        & curl.exe --fail --location --retry 3 --output $archivoZipIA 'https://github.com/ollama/ollama/releases/download/v0.40.2/ollama-windows-amd64.zip'\n-        if ($LASTEXITCODE -ne 0) { throw 'No se pudo descargar Ollama.' }\n-    }\n-    if ((Get-FileHash -LiteralPath $archivoZipIA -Algorithm SHA256).Hash.ToLowerInvariant() -ne $hashEsperadoIA) {\n-        throw \"La descarga no coincide con el hash oficial. Revisa o elimina solamente este archivo y reintenta: $archivoZipIA\"\n+    & py -3.10 (Join-Path $PSScriptRoot 'scripts/instalar_ollama_cpu.py')\n+    if ($LASTEXITCODE -ne 0) { throw 'No se pudo instalar el motor CPU de Ollama.' }\n+    if ((Get-AuthenticodeSignature -LiteralPath $ejecutableIA).Status -ne 'Valid') {\n+        throw 'No se pudo verificar la firma digital de Ollama.'\n     }\n-    Write-Host 'Extrayendo el motor local...'\n-    Expand-Archive -LiteralPath $archivoZipIA -DestinationPath $carpetaIA -Force\n }\n"}], "status": "completed"}}
