ast - first + 1);\n1588-  const pixelsPerNote = (PLOT_BOTTOM - PLOT_TOP) / noteCount;\n1589-  if (pixelsPerNote >= 22) return 1;\n1590-  if (pixelsPerNote >= 13) return 2;\n1591-  if (pixelsPerNote >= 9) return 3;\n1592-  return 4;\n1593-}\n1594-\n1595-function renderNoteRulerLabel(midi, y) {\n1596-  const group = document.createElementNS(\"http://www.w3.org/2000/svg\", \"g\");\n1597-  const background = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n1598-  const label = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n1599-\n1600-  background.setAttribute(\"class\", \"note-ruler-label-bg\");\n1601-  background.setAttribute(\"x\", \"2\");\n1602-  background.setAttribute(\"y\", (y - 13).toFixed(1));\n1603-  background.setAttribute(\"width\", \"58\");\n1604-  background.setAttribute(\"height\", \"26\");\n1605-  background.setAttribute(\"rx\", \"2\");\n1606-\n1607-  label.setAttribute(\"class\", \"note-ruler-label\");\n1608-  label.setAttribute(\"x\", \"31\");\n1609-  label.setAttribute(\"y\", y.toFixed(1));\n1610-  label.setAttribute(\"text-anchor\", \"middle\");\n1611-  label.setAttribute(\"dominant-baseline\", \"middle\");\n1612-  label.textContent = noteName(midi);\n1613-\n1614-  group.appendChild(background);\n1615-  group.appendChild(label);\n1616-  els.gridLayer.appendChild(group);\n1617-}\n1618-\n1619-function updateDetailYBounds(preferredCenter = null) {\n1620-  const values = [\n1621-    ...referencePoints().map(([, midi]) => midi),\n1622-    ...userPointsForChart().map(([, midi]) => midi)\n1623-  ].filter((midi) => Number.isFinite(midi));\n1624-\n1625-  let min = 0;\n1626-  let max = 100;\n1627-  if (values.length) {\n1628-    min = Math.max(0, Math.floor(Math.min(...values) - 4));\n310:        <input id=\"visualOffset\" type=\"range\" min=\"-700\" max=\"700\" step=\"10\" value=\"0\">\n311:        <strong id=\"visualOffsetLabel\">0 ms</strong>\n312-        <button class=\"button button-small\" id=\"visualAutoAlignBut