   finalStatus = \"Agregar cancelado\";\r\n      return;\r\n    }\r\n    if (!selectedFile.ok) {\r\n      throw new Error(selectedFile.error || \"No se pudo seleccionar el archivo.\");\r\n    }\r\n\r\n    setStatus(\"Completa los datos de la canción\", false);\r\n    const details = await openSongMetadataModal(selectedFile);\r\n    if (!details) {\r\n      finalStatus = \"Agregar cancelado\";\r\n      return;\r\n    }\r\n\r\n    setStatus(\"Preparando canción\", true);\r\n    const response = await window.pywebview.api.add_song_from_file(selectedFile.path, details.title, details.artist);\r\n    if (!response.ok) {\r\n      throw new Error(response.error || \"No se pudo agregar la canción.\");\r\n    }\r\n\r\n    const added = normalizeBackendSongs([response.song])[0];\r\n    if (added) {\r\n      songs.push(added);\r\n      songs.sort((a, b) => a.title.localeCompare(b.title));\r\n      state.selectedIndex = Math.max(0, songs.findIndex((song) => song.id === added.id));\r\n      takes = [];\r\n      clearCurrentTake();\r\n      renderChart();\r\n      renderTakes();\r\n      updateTakePlayer();\r\n      setActiveView(\"practice\");\r\n    }\r\n    finalStatus = \"Canción agregada\";\r\n  } catch (error) {\r\n    finalStatus = `Error: ${String(error.message || error)}`;\r\n  } finally {\r\n    state.catalogWorking = false;\r\n    updateSongLabels();\r\n    renderSongs();\r\n    if (finalStatus) setStatus(finalStatus, finalRecording);\r\n  }\r\n}\r\n\r\nasync function editSelectedSong() {\r\n  const song = currentSong();\r\n  if (!song || state.playing || state.catalogWorking) return;\r\n\r\n  if (!backendReady || !window.pywebview?.api?.edit_song) {\r\n    setStatus(\"Backend no conectado\", false);\r\n    return;\r\n  }\r\nimport csv\r\nimport json\r\nimport os\r\nimport shutil\r\nimport uuid\r\nfrom datetime import datetime\r\n\r\nfrom audio.guardar import guardar_csv\r\nfrom audio.pitch import extraer_pitch\r\nfrom audio.separacion import preparar_pistas\r\n\r\n\r\nCATALOGO_DIR = \"canciones\"\r\nGRABACIONES_DIR = \"grabaciones\"\r\n\r\n\r\ndef asegurar_directorios():\r\n    os.makedirs(CATALOGO_DIR, exist_ok=True)\r\n    os.makedirs(GRABACIONES_DIR, exist_ok=True)\r\n\r\n\r\ndef _slug(texto):\r\n    limpio = \"\".join(c.lower() if c.isalnum() else \"_\" for c in texto.strip())\r\n    partes = [p for p in limpio.split(\"_\") if p]\r\n    return \"_\".join(partes) or \"cancion\"\r\n\r\n\r\ndef _metadata_path(cancion_id):\r\n    return os.path.join(CATALOGO_DIR, cancion_id, \"metadata.json\")\r\n\r\n\r\ndef guardar_metadata(metadata):\r\n    with open(_metadata_path(metadata[\"id\"]), \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(metadata, f, indent=2, ensure_ascii=False)\r\n\r\n\r\ndef cargar_canciones():\r\n    asegurar_directorios()\r\n    canciones = []\r\n    for nombre in os.listdir(CATALOGO_DIR):\r\n        metadata_path = _metadata_path(nombre)\r\n        if os.path.exists(metadata_path):\r\n            with open(metadata_path, \"r\", encoding=\"utf-8\") as f:\r\n                canciones.append(json.load(f))\r\n    return sorted(canciones, key=lambda item: item.get(\"titulo\", \"\").lower())\r\n\r\n\r\ndef cargar_cancion(cancion_id):\r\n    with open(_metadata_path(cancion_id), \"r\", encoding=\"utf-8\") as f:\r\n        return json.load(f)\r\n\r\n\r\ndef eliminar_cancion(cancion_id):\r\n    asegurar_directorios()\r\n    metadata = cargar_cancion(cancion_id)\r\n\r\n    carpeta = os.path.join(CATALOGO_DIR, cancion_id)\r\n    demucs_dir = \"\"\r\n    original = metadata.get(\"original\") or \"\"\r\n    if original:\r\n        nombre_original = os.path.splitext(os.path.basename(original))[0]\r\n        demucs_dir = os.path.join(\"output\", \"htdemucs\", nombre_original)\r\n\r\n    grabaciones_dir = os.path.join(GRABACIONES_DIR, cancion_id)\r\n\r\n    for ruta in [carpeta, demucs_dir, grabaciones_dir]:\r\n        if ruta and os.path.exists(ruta):\r\n            shutil.rmtree(ruta)\r\n\r\n\r\ndef editar_cancion(cancion_id, titulo, artista=\"\"):\r\n    metadata = cargar_cancion(cancion_id)\r\n    metadata[\"titulo\"] = titulo\r\n    metadata[\"artista\"] = artista\r\n    guardar_metadata(metadata)\r\n    _actualizar_tomas_cancion(cancion_id, titulo, artista)\r\n    return metadata\r\n\r\n\r\ndef _actualizar_tomas_cancion(cancion_id, titulo, artista=\"\"):\r\n    grabaciones_dir = os.path.join(GRABACIONES_DIR, cancion_id)\r\n    if not os.path.isdir(grabaciones_dir):\r\n        return\r\n\r\n    for nombre in os.listdir(grabaciones_dir):\r\n        if not nombre.endswith(\"_toma.json\"):\r\n            continue\r\n        ruta = os.path.join(grabaciones_dir, nombre)\r\n        try:\r\n            with open(ruta, \"r\", encoding=\"utf-8\") as f:\r\n                toma = json.load(f)\r\n            toma[\"song_title\"] = titulo\r\n            toma[\"artist\"] = artista or \"Sin artista\"\r\n            with open(ruta, \"w\", encoding=\"utf-8\") as f:\r\n                json.dump(toma, f, indent=2, ensure_ascii=False)\r\n        except (OSError, json.JSONDecodeError):\r\n            continue\r\n\r\n\r\ndef agregar_cancion(ruta_audio, titulo, artista=\"\", forzar=False):\r\n    asegurar_directorios()\r\n    cancion_id = f\"{_slug(titulo)}_{uuid.uuid4().hex[:8]}\"\r\n    carpeta = os.path.join(CATALOGO_DIR, cancion_id)\r\n    os.makedirs(carpeta, exist_ok=True)\r\n\r\n    extension = os.path.splitext(ruta_audio)[1].lower() or \".wav\"\r\n    original_path = os.path.join(carpeta, f\"{cancion_id}{extension}\")\r\n    shutil.copy2(ruta_audio, original_path)\r\n\r\n    metadata = {\r\n        \"id\": cancion_id,\r\n        \"titulo\": titulo,\r\n        \"artista\": artista,\r\n        \"original\": original_path,\r\n        \"vocals\": \"\",\r\n        \"instrumental\": \"\",\r\n        \"pitch_referencia\": os.path.join(carpeta, \"ref_pitch.csv\"),\r\n        \"creada_en\": datetime.now().isoformat(timespec=\"seconds\"),\r\n        \"preparada\": False,\r\n    }\r\n    guardar_metadata(metadata)\r\n    return preparar_cancion(cancion_id, forzar=forzar)\r\n\r\n\r\ndef preparar_cancion(cancion_id, forzar=False):\r\n    metadata = cargar_cancion(cancion_id)\r\n    vocals_path, instrumental_path = preparar_pistas(\r\n        metadata[\"original\"],\r\n        forzar_separacion=forzar,\r\n    )\r\nimport json\r\nimport os\r\nimport queue\r\nimport threading\r\nimport time\r\nfrom datetime import datetime\r\n\r\nimport librosa\r\nimport numpy as np\r\nimport sounddevice as sd\r\nimport soundfile as sf\r\n\r\nfrom audio.catalogo import carpeta_grabaciones, leer_pitch_csv\r\nfrom audio.comparacion import comparar\r\nfrom audio.metricas import hz_to_midi\r\nfrom audio.retroalimentacion import generar_retroalimentacion\r\nfrom audio.segmentacion import preparar_segmentacion\r\nfrom audio.pitch import extraer_pitch, extraer_pitch_ligero_desde_audio, extraer_pitch_detallado\r\n\r\n\r\ndef grabar_con_instrumental(\r\n    cancion,\r\n    samplerate=44100,\r\n    detener_evento=None,\r\n    progreso_callback=None,\r\n    pitch_callback=None,\r\n    diagnostico_callback=None,\r\n    intervalo_pitch=0.06,\r\n    segundos_chunk_pitch=0.38,\r\n    duracion_calibracion_ruido=0.6,\r\n    usar_filtro_aprendido=False,\r\n):\r\n    instrumental_path = cancion[\"instrumental\"]\r\n    if not os.path.exists(instrumental_path):\r\n        raise FileNotFoundError(\"No existe la pista instrumental de la cancion.\")\r\n\r\n    reproduccion = _cargar_reproduccion(instrumental_path, samplerate)\r\n\r\n    duracion_frames = reproduccion.shape[0]\r\n    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\r\n    salida = os.path.join(carpeta_grabaciones(cancion[\"id\"]), f\"usuario_{timestamp}.wav\")\r\n\r\n    ruido_base = medir_ruido_ambiente(samplerate, duracion_calibracion_ruido)\r\n    if diagnostico_callback is not None:\r\n        diagnostico_callback({\r\n            \"noise_floor\": ruido_base,\r\n            \"rms\": ruido_base,\r\n            \"energy_threshold\": 0.0,\r\n            \"raw_points\": 0,\r\n            \"filtered_points\": 0,\r\n            \"rejected_points\": 0,\r\n        })\r\n\r\n    grabacion = sd.playrec(\r\n        reproduccion,\r\n        samplerate=samplerate,\r\n        channels=1,\r\n        dtype=\"float32\",\r\n        blocking=False,\r\n    )\r\n\r\n    inicio = time.monotonic()\r\n    ultimo_analisis = 0\r\n    pitch_queue = None\r\n    pitch_stop = None\r\n    pitch_worker = None\r\n\r\n    if pitch_callback is not None:\r\n        pitch_queue = queue.Queue(maxsize=2)\r\n        pitch_stop = threading.Event()\r\n        pitch_worker = threading.Thread(\r\n            target=_worker_pitch_tiempo_real,\r\n            args=(pitch_queue, pitch_stop, pitch_callback, diagnostico_callback, samplerate, ruido_base,\r\n                  usar_filtro_aprendido),\r\n            daemon=True,\r\n        )\r\n        pitch_worker.start()\r\n\r\n    try:\r\n        while True:\r\n            transcurrido = time.monotonic() - inicio\r\n            frames_grabados = int(transcurrido * samplerate)\r\n            if frames_grabados >= duracion_frames:\r\n                break\r\n            if detener_evento is not None and detener_evento.is_set():\r\n                break\r\n            if progreso_callback is not None:\r\n                progreso_callback(transcurrido)\r\n            if pitch_callback is not None and transcurrido - ultimo_analisis >= intervalo_pitch:\r\n                inicio_chunk_t = max(0, transcurrido - segundos_chunk_pitch)\r\n                inicio_chunk = int(inicio_chunk_t * samplerate)\r\n                fin_chunk = min(frames_grabados, duracion_frames)\r\n                chunk = np.asarray(grabacion[inicio_chunk:fin_chunk]).reshape(-1)\r\n                _encolar_pitch_reciente(pitch_queue, inicio_chunk_t, chunk)\r\n                ultimo_analisis = transcurrido\r\n            sd.sleep(18)\r\n    finally:\r\n        sd.stop()\r\n        if pitch_stop is not None:\r\n            pitch_stop.set()\r\n        if pitch_worker is not None:\r\n            pitch_worker.join(timeout=0.4)\r\n\r\n    frames_grabados = min(max(int((time.monotonic() - inicio) * samplerate), 1), duracion_frames)\r\n    if progreso_callback is not None:\r\n        progreso_callback(frames_grabados / samplerate)\r\n    grabacion = np.asarray(grabacion[:frames_grabados]).reshape(frames_grabados, 1)\r\n    sf.write(salida, grabacion, samplerate)\r\n    return salida\r\n\r\n\r\ndef medir_ruido_ambiente(samplerate=44100, duracion=0.6):\r\n    muestras = max(1, int(samplerate * duracion))\r\n    grabacion = sd.rec(\r\n        muestras,\r\n        samplerate=samplerate,\r\n        channels=1,\r\n        dtype=\"float32\",\r\n    )\r\n    sd.wait()\r\n    datos = np.asarray(grabacion, dtype=float).reshape(-1)\r\n    return float(np.sqrt(np.mean(datos * datos))) if len(datos) else 0.0\r\n\r\n\r\ndef _cargar_reproduccion(ruta_audio, samplerate):\r\n    try:\r\n        audio, sr = sf.read(ruta_audio, dtype=\"float32\", always_2d=True)\r\n        if audio.shape[1] > 2:\r\n            audio = audio[:, :2]\r\n\r\n", "exitCode": 0, "durationMs": 1208}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "rs_06f6aa8593d2a892016acaede0eb9887d29416f6069963c3d8", "rollout_ordinal": 2504, "created_at_ms": 1791684063303, "item_type": "reasoning", "updated_at_ordinal": 2504, "started_at_ms": 1791684063303, "completed_at_ms": 1791684072024}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acaede0eb9887d29416f6069963c3d8", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a128b0-e98e-7232-bb0a-a1f637b5e12e", "item_id": "exec-3d0cac72-c2aa-4758-93dc-3bdb1162842f", "rollout_ordinal": 2508, "created_at_ms": 1791684080682, "item_type": "commandExecution", "updated_at_ordinal": 2508, "started_at_ms": 1791684080682, "completed_at_ms": 1791684081839}, "item": {"type": "commandExecution", "id": "exec-3d0cac72-c2aa-4758-93dc-3bdb1162842f", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom audio.retroalimentacion import _muestrear\nfor folder in ['fdsofdisj_9425509d','que_gano_olvidandote_a7c974ca']:\n rows=[]\n for p in sorted((Path('grabaciones')/folder).glob('*_resultado.json')):\n  r=json.loads(p.read_text(encoding='utf-8'));g=r.get('grafico',{})\n  if not g or not g['t_usr']:continue\n  t=np.arange(0,min(max(g['t_usr']),max(g['t_ref'])),.04)\n  ref=_muestrear(np.array(g['t_ref']),np.array(g['f_ref']),t,.025)\n  vals=[]\n  for lag in np.arange(-2,2.001,.04):\n   usr=_muestrear(np.array(g['t_usr'])-lag,np.array(g['f_usr']),t,.025)\n   mask=(ref>0)&(usr>0)\n   errs=1200*np.log2(usr[mask]/ref[mask])\n   score=np.sum(np.clip(1-abs(errs)/300,0,1))/max(1,np.sum(ref>0))\n   vals.append((score,float(lag),float(np.mean(abs(errs)<=50)*100) if len(errs) else None,int(mask.sum())))\n  best=max(vals);base=vals[50]\n  rows.append(dict(toma=p.stem,anterior=r.get('porcentaje_50'),temporal=base[2],mejor_desfase_s=round(best[1],2),afinacion_ajustada=best[2],ganancia_score=best[0]-base[0]))\n print(folder,json.dumps(rows,ensure_ascii=True))\n'@ | python -\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "42938", "source": "unifiedExecStartup", "status": "failed", "commandActions": [{"type": "unknown", "command": "@'\nimport json\nfrom pathlib import Path\nimport numpy as np\nfrom audio.retroalimentacion import _muestrear\nfor folder in ['fdsofdisj_9425509d','que_gano_olvidandote_a7c974ca']:\n rows=[]\n for p in sorted((Path('grabaciones')/folder).glob('*_resultado.json')):\n  r=json.loads(p.read_text(encoding='utf-8'));g=r.get('grafico',{})\n  if not g or not g['t_usr']:continue\n  t=np.arange(0,min(max(g['t_usr']),max(g['t_ref'])),.04)\n  ref=_muestrear(np.array(g['t_ref']),np.array(g['f_ref']),t,.025)\n  vals=[]\n  for lag in np.arange(-2,2.001,.04):\n   usr=_muestrear(np.array(g['t_usr'])-lag,np.array(g['f_usr']),t,.025)\n   mask=(ref>0)&(usr>0)\n   errs=1200*np.log2(usr[mask]/ref[mask])\n   score=np.sum(np.clip(1-abs(errs)/300,0,1))/max(1,np.sum(ref>0))\n   vals.append((score,float(lag),float(np.mean(abs(errs)<=50)*100) if len(errs) else None,int(mask.sum())))\n  best=max(vals);base=vals[50]\n  rows.append(dict(toma=p.stem,anterior=r.get('porcentaje_50'),temporal=base[2],mejor_desfase_s=round(best[1],2),afinacion_ajustada=best[2],ganancia_score=best[0]-base[0]))\n print(folder,json.dumps(rows,ensure_ascii=True))\n'@ | python -"}], "aggregatedOutput": "Traceback (most recent call last):\r\n  File \"<stdin>\", line 10, in <module>\r\nValueError: max() iterable argument is empty\r\n", "exitCode": 1, "durationMs": 1156}}
