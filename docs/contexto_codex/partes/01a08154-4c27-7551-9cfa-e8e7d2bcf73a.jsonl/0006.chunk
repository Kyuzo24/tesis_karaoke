{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12e0a-5ef3-7252-8a59-c56f2a4333c8", "item_id": "exec-176777e0-fa86-43b7-b51a-cd977a951e04", "rollout_ordinal": 3357, "created_at_ms": 1791773819553, "item_type": "commandExecution", "updated_at_ordinal": 3357, "started_at_ms": 1791773819553, "completed_at_ms": 1791773822012}, "item": {"type": "commandExecution", "id": "exec-176777e0-fa86-43b7-b51a-cd977a951e04", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content audio/notas_musicales.py -Tail 58; Get-Content scripts/verificar_interfaz.cjs -Tail 14; Get-Content ui_live/feedback.js -Tail 39; Get-Content docs/conexion_llm_interfaz.md -Head 10; rg -n 'Sin ref|Afinado|visualOffset.value|data = r' ui_live/index.html ui_live/app.js ui_live/feedback.js\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "91325", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content audio/notas_musicales.py -Tail 58; Get-Content scripts/verificar_interfaz.cjs -Tail 14; Get-Content ui_live/feedback.js -Tail 39; Get-Content docs/conexion_llm_interfaz.md -Head 10; rg -n 'Sin ref|Afinado|visualOffset.value|data = r' ui_live/index.html ui_live/app.js ui_live/feedback.js"}], "aggregatedOutput": "                dp[i,j]=dp[i,j-1]; choice[i,j]=2\r\n            delta=abs(u['inicio_s']-r['inicio_s'])\r\n            overlap=max(0.,min(r['fin_s'],u['fin_s'])-max(r['inicio_s'],u['inicio_s']))\r\n            support=overlap/min(r['fin_s']-r['inicio_s'],u['fin_s']-u['inicio_s'])\r\n            if delta <= .25+1e-8 and support >= .25:\r\n                score=dp[i-1,j-1]+1+support-.5*delta/.25\r\n                if score > dp[i,j]:\r\n                    dp[i,j]=score; choice[i,j]=3\r\n    pairs=[]; i,j=n,m\r\n    while i and j:\r\n        if choice[i,j]==3:\r\n            pairs.append((ref[i-1],usr[j-1]));i-=1;j-=1\r\n        elif choice[i,j]==1: i-=1\r\n        else: j-=1\r\n    return pairs[::-1]\r\n\r\n\r\ndef resumir(notas):\r\n    paired=[n for n in notas if n['usuario'] is not None]\r\n    errors=np.array([n['error_cents'] for n in paired])\r\n    def pct(condition):\r\n        return float(np.mean(condition)*100) if len(errors) else None\r\n    return dict(notas_referencia=len(notas), notas_comparadas=len(paired),\r\n                notas_sin_correspondencia=len(notas)-len(paired),\r\n                cobertura_notas_pct=100*len(paired)/len(notas) if notas else None,\r\n                porcentaje_50=pct(abs(errors)<=50+1e-8), porcentaje_100=pct(abs(errors)<=100+1e-8),\r\n                error_mediano_cents=float(np.median(errors)) if len(errors) else None,\r\n                diferencia_inicio_mediana_ms=float(np.median([n['diferencia_inicio_ms'] for n in paired])) if paired else None)\r\n\r\n\r\ndef analizar_notas(tr,fr,tu,fu,fragmentos):\r\n    all_notes=[]; fragments={}; extras=[]\r\n    for fragment in fragmentos:\r\n        a,b,fid=fragment['inicio_s'],fragment['fin_s'],fragment['id']\r\n        # Cortes definidos por referencia: no se emparejan notas entre frases distintas.\r\n        ref=detectar_notas(tr,fr,a,b,f'r_{fid}_')\r\n        usr=detectar_notas(tu,fu,a,b,f'u_{fid}_')\r\n        # Limita memoria por bloques largos: partición temporal para candidatos,\r\n        # conservando el orden y sin reutilizar usuarios.\r\n        pairs=[]; used=set(); last_start=float(\"-inf\")\r\n        for start in range(0,len(ref),100):\r\n            batch=ref[start:start+100]\r\n            candidates=[u for u in usr if u['id'] not in used and u['inicio_s'] > last_start and batch[0]['inicio_s']-.25 <= u['inicio_s'] <= batch[-1]['inicio_s']+.25]\r\n            found=emparejar(batch,candidates);pairs.extend(found);used.update(u['id'] for _,u in found)\r\n            if found: last_start=found[-1][1]['inicio_s']\r\n        matches={r['id']:u for r,u in pairs}\r\n        notes=[]\r\n        for r in ref:\r\n            u=matches.get(r['id']); error=100*(u['midi']-r['midi']) if u else None\r\n            notes.append(dict(id=r['id'], fragmento_id=fid, referencia=r, usuario=u,\r\n                              error_cents=error, diferencia_inicio_ms=1000*(u['inicio_s']-r['inicio_s']) if u else None,\r\n                              diferencia_duracion_ms=1000*((u['fin_s']-u['inicio_s'])-(r['fin_s']-r['inicio_s'])) if u else None,\r\n                              clase='sin_correspondencia' if u is None else 'cerca' if abs(error)<=50+1e-8 else 'margen' if abs(error)<=100+1e-8 else 'fuera'))\r\n        unmatched=[dict(u,fragmento_id=fid) for u in usr if u['id'] not in used]\r\n        fragments[fid]=dict(metricas=resumir(notes), notas=notes, usuario_sin_correspondencia=unmatched)\r\n        all_notes.extend(notes);extras.extend(unmatched)\r\n    return dict(version=VERSION, parametros=PARAMETROS, metricas=resumir(all_notes), notas=all_notes,\r\n                usuario_sin_correspondencia=extras),fragments\r\n  await page.waitForTimeout(650);\r\n  if(await page.locator('.feedback-fragment[aria-pressed=\"true\"]').count()) throw new Error('Detalle obsoleto después de cambiar de toma');\r\n  await page.evaluate(() => window.preparationUI.start());\r\n  await page.waitForFunction(() => document.querySelector('#preparationMessage').textContent.includes('Separando'));\r\n  await page.locator('#preparationProgress').screenshot({path:path.join(root,'output/prueba_interfaz/carga.png')});\r\n  await page.evaluate(() => window.preparationUI.stop());\r\n  if(await page.locator('#preparationProgress').isVisible()) throw new Error('Barra de carga no se ocultó');\r\n  await page.getByRole('button',{name:'Ajustes',exact:true}).click();\r\n  await page.getByRole('heading',{name:'Retroalimentación local',exact:true}).waitFor();\r\n  if(await page.locator('#llmKey, #llmProvider, #llmServer').count()) throw new Error('Quedan controles de IA');\r\n  if(errors.length) throw new Error(errors.join('\\n'));\r\n  await browser.close();\r\n  console.log('OK: resumen, fragmentos, desfase, cambio de toma, barra de carga y ajustes; sin errores JS.');\r\n})().catch(e=>{console.error(e);process.exit(1);});\r\n      const r = await api().get_feedback(song.id, take.id);\r\n      if (ticket !== revision) return;\r\n      if (!r.ok) throw new Error(r.error);\r\n      data = r; render(); renderMetrics({}); renderChart();\r\n    } catch (error) {\r\n      if (ticket !== revision) return;\r\n      root.replaceChildren(el('h2', 'Análisis por fragmentos'), el('p', error.message || 'No se pudo cargar el análisis.'));\r\n      root.append(button('Volver a cargar', () => refresh(true)));\r\n    }\r\n  }\r\n  // Durante un fragmento, la mezcla usa la misma compensación que el análisis.\r\n  // Fuera de ese modo vuelve al ajuste independiente del mezclador.\r\n  window.feedbackUI = { refresh, analysis: () => !state.playing && data && identity === `${currentSong()?.id || ''}/${selectedTake()?.id || ''}` ? data : null, playbackOffset: () => audioEnd !== null && data ? -data.desfase_ms : null };\r\n  window.addEventListener('pywebviewready', () => refresh());\r\n  refresh();\r\n})();\r\n\r\n(() => {\r\n  const panel = document.getElementById('preparationProgress');\r\n  let timer = null, generation = 0;\r\n  window.preparationUI = {\r\n    start() {\r\n      this.stop(); const current = ++generation, since = Date.now();\r\n      panel.classList.remove('hidden');\r\n      document.getElementById('preparationMessage').textContent = 'Preparando canción…';\r\n      const poll = async () => {\r\n        if (current !== generation) return;\r\n        try {\r\n          const r = await window.pywebview.api.get_preparation_state();\r\n          if (current !== generation) return;\r\n          document.getElementById('preparationMessage').textContent = r.message;\r\n          document.getElementById('preparationElapsed').textContent = `${Math.floor((Date.now()-since)/1000)} s transcurridos · La separación puede tardar varios minutos.`;\r\n        } catch (_) { /* Mantener barra mientras la operación principal sigue en curso. */ }\r\n        if (current === generation) timer = setTimeout(poll, 700);\r\n      }; poll();\r\n    },\r\n    stop() { generation++; clearTimeout(timer); timer = null; panel.classList.add('hidden'); }\r\n  };\r\n})();\r\n# Retroalimentación local y compensación temporal\r\n\r\nVersión de análisis 3.0.0; reglas de redacción 1.0.0. 11 de octubre de 2026.\r\n\r\n## Uso\r\n\r\nReiniciar con `iniciar_live.bat` o `iniciar_app.bat`. Resultado e Historial muestran las métricas, la explicación y los fragmentos. Ambas interfaces utilizan el mismo backend. No hay llamadas a Ollama, OpenAI u otros servicios, ni configuración de claves o modelos. Los lanzadores ya no arrancan servidores de IA. Las variables antiguas de proveedor no reactivan servicios.\r\n\r\nLa compensación se calcula y aplica antes del análisis de cada grabación nueva. Al consultar una toma antigua se recalcula a partir del pitch guardado y la referencia del catálogo, sin extraer nuevamente pitch ni modificar el WAV o su resultado histórico. Se guardan únicamente archivos derivados de ajuste y explicaciones. Las versiones anteriores 1 y 2 se adaptan al contrato 3.\r\n\r\nui_live/feedback.js:155:      data = r; render(); renderMetrics({}); renderChart();\r\nui_live/app.js:322:  els.visualOffset.value = String(next);\r\nui_live/app.js:2791:  setVisualOffset(Number(els.visualOffset.value || 0));\r\nui_live/index.html:288:          <span><i class=\"swatch good\"></i> Afinado</span>\r\nui_live/index.html:291:          <span><i class=\"swatch unknown\"></i> Sin ref.</span>\r\n", "exitCode": 0, "durationMs": 2458}}
