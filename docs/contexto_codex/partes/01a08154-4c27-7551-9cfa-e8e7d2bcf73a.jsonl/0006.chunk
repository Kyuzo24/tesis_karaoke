{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "rs_06f6aa8593d2a892016acbf04d774087d2a2b271a6a98911f1", "rollout_ordinal": 3297, "created_at_ms": 1791750220300, "item_type": "reasoning", "updated_at_ordinal": 3297, "started_at_ms": 1791750220300, "completed_at_ms": 1791750230435}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acbf04d774087d2a2b271a6a98911f1", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "exec-9605f159-e87c-44f1-af26-b5fe595b2196", "rollout_ordinal": 3301, "created_at_ms": 1791750231432, "item_type": "commandExecution", "updated_at_ordinal": 3301, "started_at_ms": 1791750231432, "completed_at_ms": 1791750231703}, "item": {"type": "commandExecution", "id": "exec-9605f159-e87c-44f1-af26-b5fe595b2196", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content audio/visualizacion.py -Head 90; Get-Content ui_live/app.js | Select-Object -Skip 1093 -First 12'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "54182", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content audio/visualizacion.py -Head 90; Get-Content ui_live/app.js | Select-Object -Skip 1093 -First 12"}], "aggregatedOutput": "import numpy as np\r\n\r\nfrom audio.metricas import hz_to_midi\r\n\r\n\r\nNOMBRES_NOTAS = [\"C\", \"C#\", \"D\", \"D#\", \"E\", \"F\", \"F#\", \"G\", \"G#\", \"A\", \"A#\", \"B\"]\r\n\r\n\r\ndef midi_to_nota(midi):\r\n    midi = int(round(midi))\r\n    nombre = NOMBRES_NOTAS[midi % 12]\r\n    octava = midi // 12 - 1\r\n    return f\"{nombre}{octava}\"\r\n\r\n\r\ndef _insertar_cortes_por_silencio(tiempos, valores, max_gap=0.25):\r\n    tiempos = list(tiempos)\r\n    valores = list(valores)\r\n    if len(tiempos) < 2:\r\n        return tiempos, valores\r\n\r\n    t_plot = [tiempos[0]]\r\n    v_plot = [valores[0]]\r\n    for i in range(1, len(tiempos)):\r\n        if tiempos[i] - tiempos[i - 1] > max_gap:\r\n            t_plot.append(np.nan)\r\n            v_plot.append(np.nan)\r\n        t_plot.append(tiempos[i])\r\n        v_plot.append(valores[i])\r\n    return t_plot, v_plot\r\n\r\n\r\ndef configurar_grafico_notas(ax, t_ref, f_ref, t_usr, f_usr):\r\n    ax.clear()\r\n\r\n    y_ref = hz_to_midi(f_ref)\r\n    y_usr = hz_to_midi(f_usr)\r\n    t_ref_plot, y_ref_plot = _insertar_cortes_por_silencio(t_ref, y_ref)\r\n    t_usr_plot, y_usr_plot = _insertar_cortes_por_silencio(t_usr, y_usr)\r\n\r\n    ax.plot(t_ref_plot, y_ref_plot, label=\"Esperado\", color=\"#1f77b4\", linewidth=1.8)\r\n    ax.plot(t_usr_plot, y_usr_plot, label=\"Obtenido\", color=\"#d62728\", linewidth=1.5, alpha=0.9)\r\n\r\n    _configurar_ejes_notas(ax, [(t_ref, y_ref), (t_usr, y_usr)], \"Comparacion visual de afinacion\")\r\n    ax.legend(loc=\"upper right\")\r\n\r\n\r\ndef configurar_grafico_esperado(ax, t_ref, f_ref, cursor_t=0, ventana=18, t_usr=None, f_usr=None):\r\n    ax.clear()\r\n\r\n    y_ref = hz_to_midi(f_ref)\r\n    t_ref_plot, y_ref_plot = _insertar_cortes_por_silencio(t_ref, y_ref)\r\n    ax.plot(t_ref_plot, y_ref_plot, label=\"Esperado\", color=\"#1f77b4\", linewidth=1.8)\r\n    if t_usr is not None and f_usr is not None and len(t_usr):\r\n        y_usr = hz_to_midi(f_usr)\r\n        t_usr_plot, y_usr_plot = _insertar_cortes_por_silencio(t_usr, y_usr)\r\n        usuario = ax.plot(\r\n            t_usr_plot,\r\n            y_usr_plot,\r\n            label=\"Usuario\",\r\n            color=\"#d62728\",\r\n            linewidth=1.6,\r\n            alpha=0.95,\r\n        )[0]\r\n\r\n    cursor = ax.axvline(cursor_t, color=\"#111111\", linewidth=1.5, alpha=0.85)\r\n    cursor.set_label(\"_cursor_karaoke\")\r\n\r\n    _configurar_ejes_notas(\r\n        ax,\r\n        [\r\n            (t_ref, y_ref),\r\n            ([] if t_usr is None else t_usr, hz_to_midi([] if f_usr is None else f_usr)),\r\n        ],\r\n        \"Notas esperadas\",\r\n        ventana,\r\n        cursor_t,\r\n    )\r\n    ax.legend(loc=\"upper right\")\r\n\r\n\r\ndef actualizar_ventana_cursor(ax, cursor_t, ventana=18):\r\n    for linea in ax.lines:\r\n        if linea.get_label() == \"_cursor_karaoke\":\r\n            linea.set_xdata([cursor_t, cursor_t])\r\n            break\r\n    else:\r\n        linea = ax.axvline(cursor_t, color=\"#111111\", linewidth=1.5, alpha=0.85)\r\n        linea.set_label(\"_cursor_karaoke\")\r\n\r\nfunction clamp(value, min, max) {\r\n  return Math.min(max, Math.max(min, value));\r\n}\r\n\r\nfunction cursorXForDomain(domain) {\r\n  const span = Math.max(0.001, domain.xMax - domain.xMin);\r\n  const rawX = PLOT_LEFT + ((state.current - domain.xMin) / span) * (PLOT_RIGHT - PLOT_LEFT);\r\n  return clamp(rawX, PLOT_LEFT, PLOT_RIGHT);\r\n}\r\n\r\nfunction yScale(midi) {\r\n  return PLOT_BOTTOM - ((midi - state.yMin) / (state.yMax - state.yMin)) * (PLOT_BOTTOM - PLOT_TOP);\r\n", "exitCode": 0, "durationMs": 271}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "rs_06f6aa8593d2a892016acbf05dc4d887d2b1c0d61e63eba7e9", "rollout_ordinal": 3304, "created_at_ms": 1791750236578, "item_type": "reasoning", "updated_at_ordinal": 3304, "started_at_ms": 1791750236578, "completed_at_ms": 1791750244377}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acbf05dc4d887d2b1c0d61e63eba7e9", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "exec-fced0a60-fdfb-42da-b758-38a1fd4f66a1", "rollout_ordinal": 3308, "created_at_ms": 1791750270542, "item_type": "commandExecution", "updated_at_ordinal": 3308, "started_at_ms": 1791750270542, "completed_at_ms": 1791750270802}, "item": {"type": "commandExecution", "id": "exec-fced0a60-fdfb-42da-b758-38a1fd4f66a1", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nfrom pathlib import Path\np=Path('ui_live/app.js');s=p.read_text(encoding='utf-8').replace(\\\"document.getElementById('autoAlignButton')\\\",\\\"els.visualAutoAlignButton\\\")\ns=s.replace('  (musical ? [] : userBlocks).forEach((block) => {', \\\"  if (\"'!musical && selectedTake() && !state.playing) blocksByClass.unknown.push(...userBlocks);'\"\\\\n  (musical || (selectedTake() && \"'!state.playing) ? [] : userBlocks).forEach((block) => {\")\ns=s.replace('\"'  const rawX = PLOT_LEFT + ((state.current - domain.xMin)', '  const cursorTime = state.current - (window.feedbackUI?.analysis?.()?.desfase_ms || 0)/1000;\\\\n  const rawX = PLOT_LEFT + ((cursorTime - domain.xMin)')\np.write_text(s,encoding='utf-8')\np=Path('ui_feedback.py');s=p.read_text(encoding='utf-8');s=s.replace(\\\"        self.show(data['explicacion'])\\\", \\\"        self.show(data['explicacion'])\\\\n        if hasattr(self.master, 'mostrar_resultado_musical'):\\\\n            self.master.mostrar_resultado_musical(data)\\\")\ns=s.replace(\\\"lines += ['Alcance y limitaciones']+c['limitaciones']+['', 'Detalle de las métricas']\\\", \\\"lines += ['Alcance y limitaciones']+c['limitaciones']+['', 'Detalle técnico: comparación instantánea (otro denominador)']\\\\n        musical = f['musical'] if f else self.data['musical']\\\\n        nm = musical['metricas']\\\\n        lines += [f\\\\\\\"Notas sin correspondencia: {nm['notas_sin_correspondencia']}\\\\\\\", f\\\\\\\"Diferencia mediana de entradas: {nm['diferencia_inicio_mediana_ms']} ms (no es una nota de ritmo)\\\\\\\"]\\\")\np.write_text(s,encoding='utf-8')\np=Path('app.py');s=p.read_text(encoding='utf-8');a=s.index('        if resultado.get(\\\"error_prom\\\")',s.index('    def _mostrar_resultado'));b=s.index('        self.btn_ver_detalle.config(',a)\ns=s[:a]+'''        feedback = resultado.get('retroalimentacion', {})\n        if feedback.get('musical'):\n            self.mostrar_resultado_musical(feedback)\n        else:\n            self.resultado.set('Abre el análisis por fragmentos para recalcular la comparación por notas.')\n            self.ultimo_resultado_grafico = resultado.get('grafico')\n            self.mostrar_grafico(self.ultimo_resultado_grafico)\n'''+s[b:]\na=s.index('    def _progreso_preparacion')\ns=s[:a]+'''    def mostrar_resultado_musical(self, data):\n        musical = data['musical']; m = musical['metricas']\n        pct = lambda value: '--' if value is None else f'{value:.1f}%'\n        self.resultado.set(f\\\"Notas comparadas: {m['notas_comparadas']} de {m['notas_referencia']}\\\\\\\\n\\\"\n                          f\\\"Dentro de medio semitono: {pct(m['porcentaje_50'])}\\\\\\\\n\\\"\n                          f\\\"Dentro de un semitono: {pct(m['porcentaje_100'])}\\\\\\\\n\\\"\n                          f\\\"Cobertura de notas: {pct(m['cobertura_notas_pct'])}. No es una calificación global.\\\")\n        refs = [n['referencia'] for n in musical['notas']]\n        users = [n['usuario'] for n in musical['notas'] if n['usuario']] + musical['usuario_sin_correspondencia']\n        self.ultimo_resultado_grafico = dict(musical=musical,\n            t_ref=[n['inicio_s'] for n in refs], f_ref=[440*2**((n['midi']-69)/12) for n in refs],\n            t_usr=[n['inicio_s'] for n in users], f_usr=[440*2**((n['midi']-69)/12) for n in users])\n        self.mostrar_grafico(self.ultimo_resultado_grafico)\n\n'''+s[a:]\ns=s.replace('        configurar_grafico_notas(\\\\n', '''        if datos.get('musical'):\n            from audio.visualizacion import configurar_grafico_musical\n            configurar_grafico_musical(self.eje_grafico, datos['musical'])\n            self.figura.tight_layout(); self.canvas_grafico.draw()\n            return\n        configurar_grafico_notas(\n''',1)\np.write_text(s,encoding='utf-8')\n'@ | python -\n@'\n\n\ndef configurar_grafico_musical(ax, musical):\n    \\\"\\\"\\\"Mismos núcleos y clases que el informe y la interfaz web.\\\"\\\"\\\"\n    ax.clear(); labels=set(); points=[]\n    def draw(note,color,label,width):\n        ax.hlines(note['midi'],note['inicio_s'],note['fin_s'],color=color,linewidth=width,\n                  label=label if label not in labels else '_nolegend_')\n        labels.add(label);points.append(([note['inicio_s'],note['fin_s']],[note['midi'],note['midi']]))\n    colors={'cerca':('#21966c','Hasta 50 cents'),'margen':('#d49a00','Hasta 100 cents'),'fuera':('#cf4545','Más de 100 cents')}\n    for pair in musical['notas']:\n        draw(pair['referencia'],'#aaaaaa','Referencia',7)\n        if pair['usuario']:\n            color,label=colors[pair['clase']];draw(pair['usuario'],color,label,3)\n    for note in musical['usuario_sin_correspondencia']:\n        draw(note,'#777777','Sin correspondencia',3)\n    _configurar_ejes_notas(ax,points,'Afinación por notas estables · Sin calificación global')\n    if labels: ax.legend(loc='upper right',fontsize=8)\n'@ | Add-Content -Encoding UTF8 audio/visualizacion.py\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "27206", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "@'\nfrom pathlib import Path\np=Path('ui_live/app.js');s=p.read_text(encoding='utf-8').replace(\"document.getElementById('autoAlignButton')\",\"els.visualAutoAlignButton\")\ns=s.replace('  (musical ? [] : userBlocks).forEach((block) => {', \"  if (!musical && selectedTake() && !state.playing) blocksByClass.unknown.push(...userBlocks);\\n  (musical || (selectedTake() && !state.playing) ? [] : userBlocks).forEach((block) => {\")\ns=s.replace('  const rawX = PLOT_LEFT + ((state.current - domain.xMin)', '  const cursorTime = state.current - (window.feedbackUI?.analysis?.()?.desfase_ms || 0)/1000;\\n  const rawX = PLOT_LEFT + ((cursorTime - domain.xMin)')\np.write_text(s,encoding='utf-8')\np=Path('ui_feedback.py');s=p.read_text(encoding='utf-8');s=s.replace(\"        self.show(data['explicacion'])\", \"        self.show(data['explicacion'])\\n        if hasattr(self.master, 'mostrar_resultado_musical'):\\n            self.master.mostrar_resultado_musical(data)\")\ns=s.replace(\"lines += ['Alcance y limitaciones']+c['limitaciones']+['', 'Detalle de las métricas']\", \"lines += ['Alcance y limitaciones']+c['limitaciones']+['', 'Detalle técnico: comparación instantánea (otro denominador)']\\n        musical = f['musical'] if f else self.data['musical']\\n        nm = musical['metricas']\\n        lines += [f\\\"Notas sin correspondencia: {nm['notas_sin_correspondencia']}\\\", f\\\"Diferencia mediana de entradas: {nm['diferencia_inicio_mediana_ms']} ms (no es una nota de ritmo)\\\"]\")\np.write_text(s,encoding='utf-8')\np=Path('app.py');s=p.read_text(encoding='utf-8');a=s.index('        if resultado.get(\"error_prom\")',s.index('    def _mostrar_resultado'));b=s.index('        self.btn_ver_detalle.config(',a)\ns=s[:a]+'''        feedback = resultado.get('retroalimentacion', {})\n        if feedback.get('musical'):\n            self.mostrar_resultado_musical(feedback)\n        else:\n            self.resultado.set('Abre el análisis por fragmentos para recalcular la comparación por notas.')\n            self.ultimo_resultado_grafico = resultado.get('grafico')\n            self.mostrar_grafico(self.ultimo_resultado_grafico)\n'''+s[b:]\na=s.index('    def _progreso_preparacion')\ns=s[:a]+'''    def mostrar_resultado_musical(self, data):\n        musical = data['musical']; m = musical['metricas']\n        pct = lambda value: '--' if value is None else f'{value:.1f}%'\n        self.resultado.set(f\"Notas comparadas: {m['notas_comparadas']} de {m['notas_referencia']}\\\\n\"\n                          f\"Dentro de medio semitono: {pct(m['porcentaje_50'])}\\\\n\"\n                          f\"Dentro de un semitono: {pct(m['porcentaje_100'])}\\\\n\"\n                          f\"Cobertura de notas: {pct(m['cobertura_notas_pct'])}. No es una calificación global.\")\n        refs = [n['referencia'] for n in musical['notas']]\n        users = [n['usuario'] for n in musical['notas'] if n['usuario']] + musical['usuario_sin_correspondencia']\n        self.ultimo_resultado_grafico = dict(musical=musical,\n            t_ref=[n['inicio_s'] for n in refs], f_ref=[440*2**((n['midi']-69)/12) for n in refs],\n            t_usr=[n['inicio_s'] for n in users], f_usr=[440*2**((n['midi']-69)/12) for n in users])\n        self.mostrar_grafico(self.ultimo_resultado_grafico)\n\n'''+s[a:]\ns=s.replace('        configurar_grafico_notas(\\n', '''        if datos.get('musical'):\n            from audio.visualizacion import configurar_grafico_musical\n            configurar_grafico_musical(self.eje_grafico, datos['musical'])\n            self.figura.tight_layout(); self.canvas_grafico.draw()\n            return\n        configurar_grafico_notas(\n''',1)\np.write_text(s,encoding='utf-8')\n'@ | python -\n@'\n\n\ndef configurar_grafico_musical(ax, musical):\n    \"\"\"Mismos núcleos y clases que el informe y la interfaz web.\"\"\"\n    ax.clear(); labels=set(); points=[]\n    def draw(note,color,label,width):\n        ax.hlines(note['midi'],note['inicio_s'],note['fin_s'],color=color,linewidth=width,\n                  label=label if label not in labels else '_nolegend_')\n        labels.add(label);points.append(([note['inicio_s'],note['fin_s']],[note['midi'],note['midi']]))\n    colors={'cerca':('#21966c','Hasta 50 cents'),'margen':('#d49a00','Hasta 100 cents'),'fuera':('#cf4545','Más de 100 cents')}\n    for pair in musical['notas']:\n        draw(pair['referencia'],'#aaaaaa','Referencia',7)\n        if pair['usuario']:\n            color,label=colors[pair['clase']];draw(pair['usuario'],color,label,3)\n    for note in musical['usuario_sin_correspondencia']:\n        draw(note,'#777777','Sin correspondencia',3)\n    _configurar_ejes_notas(ax,points,'Afinación por notas estables · Sin calificación global')\n    if labels: ax.legend(loc='upper right',fontsize=8)\n'@ | Add-Content -Encoding UTF8 audio/visualizacion.py"}], "aggregatedOutput": null, "exitCode": 0, "durationMs": 260}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "rs_06f6aa8593d2a892016acbf08214d887d2b3c72157548c481a", "rollout_ordinal": 3311, "created_at_ms": 1791750272847, "item_type": "reasoning", "updated_at_ordinal": 3311, "started_at_ms": 1791750272847, "completed_at_ms": 1791750273647}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acbf08214d887d2b3c72157548c481a", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "msg_06f6aa8593d2a892016acbf082e54487d2b992360cf56c0a20", "rollout_ordinal": 3313, "created_at_ms": 1791750273671, "item_type": "agentMessage", "updated_at_ordinal": 3313, "started_at_ms": 1791750273671, "completed_at_ms": 1791750275286}, "item": {"type": "agentMessage", "id": "msg_06f6aa8593d2a892016acbf082e54487d2b992360cf56c0a20", "text": "El gráfico de las tomas guardadas ya usa las mismas notas y correspondencias que el resumen. También unifiqué su alineación con la del análisis y dejé el DTW anterior en un detalle desplegable, para evitar que dos evaluaciones distintas aparezcan como si fueran la misma.\n", "phase": "commentary", "memoryCitation": null, "delivery": null, "questions": null}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9e-6565-78e1-8902-a1f57ace8025", "item_id": "exec-120ded12-e273-4f3d-88d3-9d03eaf37b2b", "rollout_ordinal": 3317, "created_at_ms": 1791750295358, "item_type": "commandExecution", "updated_at_ordinal": 3317, "started_at_ms": 1791750295358, "completed_at_ms": 1791750300267}, "item": {"type": "commandExecution", "id": "exec-120ded12-e273-4f3d-88d3-9d03eaf37b2b", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport unittest\nimport numpy as np\nfrom audio.notas_musicales import detectar_notas, emparejar, analizar_notas\n\n\ndef note(i,start,end,midi):\n return dict(id=i,inicio_s=start,fin_s=end,midi=midi)\n\nclass MusicalTests(unittest.TestCase):\n def test_vibrato_and_short_transition_have_stable_center(self):\n  t=np.arange(0,2,.01);m=69+.5*np.sin(2*np.pi*5*t)\n  notes=detectar_notas(t,440*2**((m-69)/12),0,2,'r')\n  self.assertEqual(len(notes),1);self.assertAlmostEqual(notes[0]['midi'],69,delta=.1)\n def test_semitone_change_creates_distinct_notes(self):\n  t=np.arange(0,2,.01);f=np.where(t<1,440,440*2**(1/12))\n  notes=detectar_notas(t,f,0,2,'r')\n  self.assertEqual(len(notes),2)\n  self.assertAlmostEqual(notes[1]['midi']-notes[0]['midi'],1,places=5)\n def test_pairing_ignores_pitch_and_keeps_octave_errors(self):\n  refs=[note('r',0,1,69)]\n  users=[note('wrong',0,1,81),note('right',.2,1,69)]\n  paired=emparejar(refs,users)\n  self.assertEqual(paired[0][1]['id'],'wrong')\n def test_no_reuse_and_no_large_temporal_warp(self):\n  refs=[note('r1',0,1,69),note('r2',1,2,69)]\n  self.assertEqual(len(emparejar(refs,[note('u',0,2,69)])),1)\n  self.assertEqual(emparejar([refs[0]],[note('late',.4,1.4,69)]),[])\n def test_missing_notes_reduce_coverage_not_count_as_success(self):\n  t=np.arange(0,4,.01);f=np.where(t<2,440,660.)\n  u=f.copy();u[t>=2]=0\n  report,_=analizar_notas(t,f,t,u,[dict(id='f0001',inicio_s=0,fin_s=4)])\n  self.assertEqual(report['metricas']['notas_referencia'],2)\n  self.assertEqual(report['metricas']['notas_comparadas'],1)\n  self.assertEqual(report['metricas']['cobertura_notas_pct'],50)\n  self.assertEqual(report['metricas']['porcentaje_50'],100)\n def test_octaves_are_counted_as_wrong_without_correction(self):\n  t=np.arange(0,2,.01);f=np.full(len(t),440.)\n  report,_=analizar_notas(t,f,t,f*2,[dict(id='f0001',inicio_s=0,fin_s=2)])\n  self.assertEqual(report['metricas']['porcentaje_100'],0)\n  self.assertAlmostEqual(report['notas'][0]['error_cents'],1200)\n def test_global_totals_equal_fragment_counts(self):\n  t=np.arange(0,4,.01);f=np.where(t<2,440,660.)\n  report,parts=analizar_notas(t,f,t,f,[dict(id='f0001',inicio_s=0,fin_s=2),dict(id='f0002',inicio_s=2,fin_s=4)])\n  self.assertEqual(report['metricas']['notas_comparadas'],sum(p['metricas']['notas_comparadas'] for p in parts.values()))\n  ids=[n['usuario']['id'] for n in report['notas'] if n['usuario']]\n  self.assertEqual(len(ids),len(set(ids)))\n def test_empty_and_too_short_notes_have_no_percentage(self):\n  report,_=analizar_notas([],[],[],[],[dict(id='f0001',inicio_s=0,fin_s=2)])\n  self.assertIsNone(report['metricas']['porcentaje_50'])\n  self.assertEqual(detectar_notas([0,.01,.02],[440]*3,0,.04,'r'),[])\n\nif __name__=='__main__':unittest.main()\n'@ | Set-Content -Encoding UTF8 tests/test_notas_musicales.py\n\"'$env:PYTHONPATH=(Join-Path (Get-Location) '\"'venv/Lib/site-packages')\npy -3.10 -m unittest discover -s tests\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "51509", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "@'\nimport unittest\nimport numpy as np\nfrom audio.notas_musicales import detectar_notas, emparejar, analizar_notas\n\n\ndef note(i,start,end,midi):\n return dict(id=i,inicio_s=start,fin_s=end,midi=midi)\n\nclass MusicalTests(unittest.TestCase):\n def test_vibrato_and_short_transition_have_stable_center(self):\n  t=np.arange(0,2,.01);m=69+.5*np.sin(2*np.pi*5*t)\n  notes=detectar_notas(t,440*2**((m-69)/12),0,2,'r')\n  self.assertEqual(len(notes),1);self.assertAlmostEqual(notes[0]['midi'],69,delta=.1)\n def test_semitone_change_creates_distinct_notes(self):\n  t=np.arange(0,2,.01);f=np.where(t<1,440,440*2**(1/12))\n  notes=detectar_notas(t,f,0,2,'r')\n  self.assertEqual(len(notes),2)\n  self.assertAlmostEqual(notes[1]['midi']-notes[0]['midi'],1,places=5)\n def test_pairing_ignores_pitch_and_keeps_octave_errors(self):\n  refs=[note('r',0,1,69)]\n  users=[note('wrong',0,1,81),note('right',.2,1,69)]\n  paired=emparejar(refs,users)\n  self.assertEqual(paired[0][1]['id'],'wrong')\n def test_no_reuse_and_no_large_temporal_warp(self):\n  refs=[note('r1',0,1,69),note('r2',1,2,69)]\n  self.assertEqual(len(emparejar(refs,[note('u',0,2,69)])),1)\n  self.assertEqual(emparejar([refs[0]],[note('late',.4,1.4,69)]),[])\n def test_missing_notes_reduce_coverage_not_count_as_success(self):\n  t=np.arange(0,4,.01);f=np.where(t<2,440,660.)\n  u=f.copy();u[t>=2]=0\n  report,_=analizar_notas(t,f,t,u,[dict(id='f0001',inicio_s=0,fin_s=4)])\n  self.assertEqual(report['metricas']['notas_referencia'],2)\n  self.assertEqual(report['metricas']['notas_comparadas'],1)\n  self.assertEqual(report['metricas']['cobertura_notas_pct'],50)\n  self.assertEqual(report['metricas']['porcentaje_50'],100)\n def test_octaves_are_counted_as_wrong_without_correction(self):\n  t=np.arange(0,2,.01);f=np.full(len(t),440.)\n  report,_=analizar_notas(t,f,t,f*2,[dict(id='f0001',inicio_s=0,fin_s=2)])\n  self.assertEqual(report['metricas']['porcentaje_100'],0)\n  self.assertAlmostEqual(report['notas'][0]['error_cents'],1200)\n def test_global_totals_equal_fragment_counts(self):\n  t=np.arange(0,4,.01);f=np.where(t<2,440,660.)\n  report,parts=analizar_notas(t,f,t,f,[dict(id='f0001',inicio_s=0,fin_s=2),dict(id='f0002',inicio_s=2,fin_s=4)])\n  self.assertEqual(report['metricas']['notas_comparadas'],sum(p['metricas']['notas_comparadas'] for p in parts.values()))\n  ids=[n['usuario']['id'] for n in report['notas'] if n['usuario']]\n  self.assertEqual(len(ids),len(set(ids)))\n def test_empty_and_too_short_notes_have_no_percentage(self):\n  report,_=analizar_notas([],[],[],[],[dict(id='f0001',inicio_s=0,fin_s=2)])\n  self.assertIsNone(report['metricas']['porcentaje_50'])\n  self.assertEqual(detectar_notas([0,.01,.02],[440]*3,0,.04,'r'),[])\n\nif __name__=='__main__':unittest.main()\n'@ | Set-Content -Encoding UTF8 tests/test_notas_musicales.py\n$env:PYTHONPATH=(Join-Path (Get-Location) 'venv/Lib/site-packages')\npy -3.10 -m unittest discover -s tests"}], "aggregatedOutput": "..............................................................\r\n----------------------------------------------------------------------\r\nRan 62 tests in 4.130s\r\n\r\nOK\r\nSeparando audio con Demucs...\r\n", "exitCode": 0, "durationMs": 4908}}
