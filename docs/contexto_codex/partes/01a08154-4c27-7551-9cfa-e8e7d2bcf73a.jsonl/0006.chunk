ción compartida con el análisis de la toma.</span>\r\n      </div>\r\n\r\n            return\r\n\r\n        self.btn_ver_detalle.config(state=tk.DISABLED)\r\n        if not self.btn_ver_completo.winfo_ismapped():\r\n            self.btn_ver_completo.pack(fill=tk.X, pady=(8, 0))\r\n        self.btn_ver_completo.config(state=tk.NORMAL)\r\n\r\n        self.scroll_x.grid()\r\n        self.scroll_y.grid()\r\n\r\n        datos = self.ultimo_resultado_grafico\r\n        duracion = max(datos[\"t_ref\"] + datos[\"t_usr\"]) if datos[\"t_ref\"] or datos[\"t_usr\"] else 1\r\n        self.detalle_x_max = max(0, duracion - self.detalle_ventana_x)\r\n        self.detalle_x_inicio = 0\r\n\r\n        self.detalle_y_min, self.detalle_y_max = rango_midi_grafico(\r\n            datos[\"f_ref\"],\r\n            datos[\"f_usr\"],\r\n        )\r\n        self.detalle_y_inicio = self.detalle_y_min\r\n        self.mostrar_grafico_detalle()\r\n\r\n    def ver_desempeno_completo(self):\r\n        if not self.ultimo_resultado_grafico:\r\n            return\r\n\r\n        self.scroll_x.grid_remove()\r\n        self.scroll_y.grid_remove()\r\n        self.btn_ver_completo.pack_forget()\r\n        self.btn_ver_completo.config(state=tk.DISABLED)\r\n        self.btn_ver_detalle.config(state=tk.NORMAL)\r\n        self.mostrar_grafico(self.ultimo_resultado_grafico)\r\n\r\n    def desplazar_detalle_x(self, *args):\r\n        if not self.ultimo_resultado_grafico:\r\n            return\r\n\r\n        self.detalle_x_inicio = self._mover_scroll(\r\n            args,\r\n            self.detalle_x_inicio,\r\n            0,\r\n            self.detalle_x_max,\r\n            unidad=1,\r\n            pagina=self.detalle_ventana_x * 0.85,\r\n        )\r\n        self.mostrar_grafico_detalle()\r\n\r\n    def desplazar_detalle_y(self, *args):\r\n        if not self.ultimo_resultado_grafico:\r\n            return\r\n\r\n        y_max_inicio = max(self.detalle_y_min, self.detalle_y_max - self.detalle_rango_y)\r\n        self.detalle_y_inicio = self._mover_scroll(\r\n            args,\r\n            self.detalle_y_inicio,\r\n            self.detalle_y_min,\r\n            y_max_inicio,\r\n            unidad=1,\r\n            pagina=max(1, self.detalle_rango_y * 0.8),\r\n        )\r\n        self.mostrar_grafico_detalle()\r\n\r\n    def _mover_scroll(self, args, valor_actual, minimo, maximo, unidad, pagina):\r\n        if not args:\r\n            return valor_actual\r\n  cursorLine: document.getElementById(\"cursorLine\"),\r\n  timelineFill: document.getElementById(\"timelineFill\"),\r\n  visualOffset: document.getElementById(\"visualOffset\"),\r\n  visualOffsetLabel: document.getElementById(\"visualOffsetLabel\"),\r\n  visualAutoAlignButton: document.getElementById(\"visualAutoAlignButton\"),\r\n  visualOffsetResetButton: document.getElementById(\"visualOffsetResetButton\"),\r\n  addButton: document.getElementById(\"addButton\"),\r\n  editButton: document.getElementById(\"editButton\"),\r\n  startButton: document.getElementById(\"startButton\"),\r\n  stopButton: document.getElementById(\"stopButton\"),\r\n554:    def mostrar_grafico_detalle(self):\r\n586:    def mostrar_grafico(self, datos):\r\n", "exitCode": 1, "durationMs": 384}}
