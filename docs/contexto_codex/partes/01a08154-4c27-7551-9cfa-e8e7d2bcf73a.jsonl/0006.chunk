{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9b-f976-75a2-a310-f2abcb6b8840", "item_id": "exec-93601e70-3e49-484f-9cd7-80c0d98fede1", "rollout_ordinal": 3185, "created_at_ms": 1791749798989, "item_type": "commandExecution", "updated_at_ordinal": 3185, "started_at_ms": 1791749798989, "completed_at_ms": 1791749799559}, "item": {"type": "commandExecution", "id": "exec-93601e70-3e49-484f-9cd7-80c0d98fede1", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"Get-Content ui_live/app.js | Select-Object -Skip 1150 -First 128; Get-Content ui_live/app.js | Select-Object -Skip 1300 -First 155; rg -n 'normaliz|octav|points' desktop_live.py | Select-Object -Last 35; @'\nimport json\nfrom pathlib import Path\nfor p in Path('grabaciones').glob('*/*_resultado.json'):\n d=json.loads(p.read_text(encoding='utf-8'))\n if d.get('puntos_comparados')==11679 or (d.get('porcentaje_50') and round(d['porcentaje_50'])==83):\n  print(p, {k:d.get(k) for k in ['porcentaje_50','porcentaje_100','puntos_comparados']})\n'@ | python -\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "70725", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content ui_live/app.js | Select-Object -Skip 1150 -First 128; Get-Content ui_live/app.js | Select-Object -Skip 1300 -First 155; rg -n 'normaliz|octav|points' desktop_live.py | Select-Object -Last 35; @'\nimport json\nfrom pathlib import Path\nfor p in Path('grabaciones').glob('*/*_resultado.json'):\n d=json.loads(p.read_text(encoding='utf-8'))\n if d.get('puntos_comparados')==11679 or (d.get('porcentaje_50') and round(d['porcentaje_50'])==83):\n  print(p, {k:d.get(k) for k in ['porcentaje_50','porcentaje_100','puntos_comparados']})\n'@ | python -"}], "aggregatedOutput": "\r\nfunction percentile(values, ratio) {\r\n  if (!values.length) return 0;\r\n  const sorted = [...values].sort((a, b) => a - b);\r\n  const index = Math.max(0, Math.min(sorted.length - 1, Math.round((sorted.length - 1) * ratio)));\r\n  return sorted[index];\r\n}\r\n\r\nfunction finitePitchPoints(points) {\r\n  return (points || [])\r\n    .filter(([time, midi]) => Number.isFinite(time) && Number.isFinite(midi))\r\n    .sort((a, b) => a[0] - b[0]);\r\n}\r\n\r\nfunction normalizeRegisterOctaves(points) {\r\n  const cleanPoints = finitePitchPoints(points);\r\n  if (cleanPoints.length < 30) return cleanPoints;\r\n\r\n  const corrected = cleanPoints.map(([time, midi]) => [time, midi]);\r\n  const values = cleanPoints.map(([, midi]) => midi);\r\n  const highOctaveThreshold = Math.max(70.5, percentile(values, 0.9) + 4);\r\n  const segments = pitchContinuitySegments(cleanPoints);\r\n\r\n  segments.forEach((segment, index) => {\r\n    if (segment.median < highOctaveThreshold || segment.duration > 0.9) return;\r\n    const neighbors = neighboringSegmentMedians(segments, index, 1.5)\r\n      .filter((note) => note < highOctaveThreshold);\r\n    if (!neighbors.length) return;\r\n\r\n    const currentScore = median(neighbors.map((note) => Math.abs(note - segment.median)));\r\n    const octaveDownScore = median(neighbors.map((note) => Math.abs(note - (segment.median - 12))));\r\n    if (currentScore >= 8 && octaveDownScore <= 5.5 && octaveDownScore + 2 < currentScore) {\r\n      for (let i = segment.start; i < segment.end; i += 1) {\r\n        if (corrected[i][1] >= highOctaveThreshold) corrected[i][1] -= 12;\r\n      }\r\n    }\r\n  });\r\n\r\n  return removeErraticReferenceSegments(corrected);\r\n}\r\n\r\nfunction pitchContinuitySegments(points, maxGap = 0.18, maxJump = 4.5) {\r\n  if (!points.length) return [];\r\n\r\n  const segments = [];\r\n  let start = 0;\r\n  for (let i = 1; i < points.length; i += 1) {\r\n    const gap = points[i][0] - points[i - 1][0];\r\n    const jump = Math.abs(points[i][1] - points[i - 1][1]);\r\n    if (gap > maxGap || jump > maxJump) {\r\n      segments.push(describePitchSegment(points, start, i));\r\n      start = i;\r\n    }\r\n  }\r\n  segments.push(describePitchSegment(points, start, points.length));\r\n  return segments.filter(Boolean);\r\n}\r\n\r\nfunction describePitchSegment(points, start, end) {\r\n  if (end <= start) return null;\r\n  const values = points.slice(start, end).map(([, midi]) => midi);\r\n  return {\r\n    start,\r\n    end,\r\n    median: median(values),\r\n    duration: Math.max(0, points[end - 1][0] - points[start][0]),\r\n    startTime: points[start][0],\r\n    endTime: points[end - 1][0]\r\n  };\r\n}\r\n\r\nfunction neighboringSegmentMedians(segments, index, maxDistance = 1) {\r\n  const segment = segments[index];\r\n  const neighbors = [];\r\n\r\n  for (let i = index - 1; i >= Math.max(0, index - 3); i -= 1) {\r\n    const distance = Math.max(0, segment.startTime - segments[i].endTime);\r\n    if (distance > maxDistance) break;\r\n    neighbors.push(segments[i].median);\r\n  }\r\n\r\n  for (let i = index + 1; i <= Math.min(segments.length - 1, index + 3); i += 1) {\r\n    const distance = Math.max(0, segments[i].startTime - segment.endTime);\r\n    if (distance > maxDistance) break;\r\n    neighbors.push(segments[i].median);\r\n  }\r\n\r\n  return neighbors;\r\n}\r\n\r\nfunction removeErraticReferenceSegments(points) {\r\n  if (points.length < 30) return points;\r\n\r\n  const values = points.map(([, midi]) => midi);\r\n  const highOctaveThreshold = Math.max(70.5, percentile(values, 0.9) + 4);\r\n  const segments = pitchContinuitySegments(points);\r\n  const keep = new Array(points.length).fill(true);\r\n\r\n  segments.forEach((segment, index) => {\r\n    const neighbors = neighboringSegmentMedians(segments, index, 1.5);\r\n    const neighborDistance = neighbors.length\r\n      ? median(neighbors.map((note) => Math.abs(note - segment.median)))\r\n      : 99;\r\n    const veryHighAndShort = segment.median >= highOctaveThreshold + 5 && segment.duration <= 0.45 && neighborDistance >= 7;\r\n    const tinyHighBlip = segment.median >= highOctaveThreshold && segment.duration <= 0.06 && neighborDistance >= 5;\r\n\r\n    if (!veryHighAndShort && !tinyHighBlip) return;\r\n    for (let i = segment.start; i < segment.end; i += 1) {\r\n      keep[i] = false;\r\n    }\r\n  });\r\n\r\n  return points.filter((_point, index) => keep[index]);\r\n}\r\n\r\nfunction lowerBoundPitch(points, targetTime) {\r\n  let low = 0;\r\n  let high = points.length;\r\n  while (low < high) {\r\n    const mid = Math.floor((low + high) / 2);\r\n    if ((points[mid]?.[0] ?? 0) < targetTime) {\r\n      low = mid + 1;\r\n    } else {\r\n      high = mid;\r\n    }\r\n  }\r\n  return low;\r\n}\r\n  const startIndex = lowerBoundPitch(state.userPoints, cutoff);\r\n  state.userPoints = state.userPoints.slice(startIndex);\r\n}\r\n\r\nfunction referenceBlocksFromPoints(points) {\r\n  return noteBlocksFromPitchPoints(finitePitchPoints(points), {\r\n    gapBreak: PATH_GAP_BREAK_SECONDS,\r\n    maxTail: 0.18,\r\n    mergeGap: 0.12,\r\n    minDuration: 0.055,\r\n    smoothRadius: 4\r\n  });\r\n}\r\n\r\nfunction userBlocksFromPoints(points) {\r\n  return noteBlocksFromPitchPoints(points, {\r\n    gapBreak: USER_BLOCK_GAP_SECONDS,\r\n    maxTail: 0.12,\r\n    mergeGap: 0.12,\r\n    minDuration: 0.018,\r\n    smoothRadius: 1\r\n  });\r\n}\r\n\r\nfunction currentReferenceBlocks() {\r\n  const source = referencePoints();\r\n  if (referenceBlockCache.source !== source) {\r\n    referenceBlockCache.source = source;\r\n    referenceBlockCache.blocks = referenceBlocksFromPoints(source);\r\n  }\r\n  return referenceBlockCache.blocks;\r\n}\r\n\r\nfunction noteBlocksFromPitchPoints(points, options) {\r\n  const cleanPoints = points.filter(([time, midi]) => Number.isFinite(time) && Number.isFinite(midi));\r\n  if (!cleanPoints.length) return [];\r\n\r\n  const deltas = [];\r\n  for (let i = 1; i < cleanPoints.length; i += 1) {\r\n    const delta = cleanPoints[i][0] - cleanPoints[i - 1][0];\r\n    if (delta > 0 && delta <= 0.4) deltas.push(delta);\r\n  }\r\n\r\n  const tail = Math.min(options.maxTail, deltas.length ? median(deltas) : options.maxTail);\r\n  const blocks = [];\r\n  let current = null;\r\n  let previous = null;\r\n\r\n  cleanPoints.forEach(([time, midi], index) => {\r\n    const note = smoothedNoteAt(cleanPoints, index, options.smoothRadius);\r\n    if (!current) {\r\n      current = createNoteBlock(time, time + tail, note, midi);\r\n      previous = { time, note };\r\n      return;\r\n    }\r\n\r\n    const gap = time - previous.time;\r\n    if (gap > options.gapBreak) {\r\n      current.end = previous.time + tail;\r\n      blocks.push(finalizeNoteBlock(current));\r\n      current = createNoteBlock(time, time + tail, note, midi);\r\n    } else if (note !== current.note) {\r\n      const boundary = (previous.time + time) / 2;\r\n      current.end = boundary;\r\n      blocks.push(finalizeNoteBlock(current));\r\n      current = createNoteBlock(boundary, time + tail, note, midi);\r\n    } else {\r\n      current.end = time + tail;\r\n      current.midiSum += midi;\r\n      current.weight += 1;\r\n    }\r\n\r\n    previous = { time, note };\r\n  });\r\n\r\n  if (current) blocks.push(finalizeNoteBlock(current));\r\n  return mergeNoteBlocks(blocks, options.mergeGap, options.minDuration);\r\n}\r\n\r\nfunction smoothedNoteAt(points, index, radius) {\r\n  const values = [];\r\n  for (let i = Math.max(0, index - radius); i <= Math.min(points.length - 1, index + radius); i += 1) {\r\n    values.push(points[i][1]);\r\n  }\r\n  return Math.round(median(values));\r\n}\r\n\r\nfunction createNoteBlock(start, end, note, midi) {\r\n  return {\r\n    start,\r\n    end,\r\n    note,\r\n    midiSum: midi,\r\n    weight: 1\r\n  };\r\n}\r\n\r\nfunction finalizeNoteBlock(block) {\r\n  const weight = Math.max(1, block.weight || 1);\r\n  return {\r\n    start: block.start,\r\n    end: block.end,\r\n    note: block.note,\r\n    midi: block.midiSum / weight,\r\n    weight\r\n  };\r\n}\r\n\r\nfunction mergeNoteBlocks(blocks, maxGap, minDuration) {\r\n  const merged = [];\r\n  blocks.forEach((block) => {\r\n    if (block.end - block.start < minDuration) return;\r\n\r\n    const previous = merged[merged.length - 1];\r\n    if (previous && previous.note === block.note && block.start - previous.end <= maxGap) {\r\n      const totalWeight = (previous.weight || 1) + (block.weight || 1);\r\n      previous.midi = ((previous.midi || previous.note) * (previous.weight || 1) + (block.midi || block.note) * (block.weight || 1)) / totalWeight;\r\n      previous.weight = totalWeight;\r\n      previous.end = Math.max(previous.end, block.end);\r\n      return;\r\n    }\r\n\r\n    merged.push({ ...block });\r\n  });\r\n  return merged;\r\n}\r\n\r\nfunction buildReferenceBlockPath(blocks) {\r\n  return buildNoteBlockPath(blocks, REFERENCE_BLOCK_HALF_STEPS);\r\n}\r\n\r\nfunction buildNoteBlockPath(blocks, halfSteps) {\r\n  const domain = visibleDomain();\r\n  const commands = [];\r\n\r\n  blocks.forEach((block) => {\r\n    if (block.end < domain.xMin || block.start > domain.xMax) return;\r\n    if (block.note < state.yMin - 1 || block.note > state.yMax + 1) return;\r\n\r\n    const start = Math.max(domain.xMin, block.start);\r\n    const end = Math.min(domain.xMax, block.end);\r\n    if (end <= start) return;\r\n\r\n    const x1 = xScale(start);\r\n    const x2 = xScale(end);\r\n    const y1 = yScale(block.note + halfSteps);\r\n    const y2 = yScale(block.note - halfSteps);\r\n    commands.push(`M ${x1.toFixed(1)} ${y1.toFixed(1)} H ${x2.toFixed(1)} V ${y2.toFixed(1)} H ${x1.toFixed(1)} Z`);\r\n  });\r\n\r\n  return commands.join(\" \");\r\n}\r\n\r\nfunction accuracyClass(cents) {\r\n  if (cents == null) return \"unknown\";\r\n91:            \"raw_points\": 0,\r\n92:            \"filtered_points\": 0,\r\n93:            \"accepted_points\": 0,\r\n94:            \"rejected_points\": 0,\r\n396:            estado[\"pitch_points\"] = list(self._pitch_pendiente)\r\n482:            diagnostico[\"accepted_points\"] += len(aceptados)\r\n484:            diagnostico[\"rejected_points\"] += rechazados_salto\r\n512:            diagnostico[\"raw_points\"] += int(info.get(\"raw_points\", 0))\r\n513:            diagnostico[\"filtered_points\"] += int(info.get(\"filtered_points\", 0))\r\n514:            diagnostico[\"rejected_points\"] += int(info.get(\"rejected_points\", 0))\r\n529:            \"points_ref\": self._puntos_hz_a_midi(\r\n533:            \"points_user\": self._puntos_hz_a_midi(\r\n566:            \"octave_corrections\": int(diagnostico.get(\"correcciones_octava\", 0)),\r\n568:            \"points_raw\": self._reducir_puntos(crudos, max_puntos=3500),\r\n569:            \"points_filtered\": self._reducir_puntos(filtrados, max_puntos=3500),\r\n570:            \"points_corrected\": self._reducir_puntos(corregidos, max_puntos=3500),\r\n610:            \"points\": self._puntos_referencia(cancion),\r\n634:            \"points_ref\": self._reducir_puntos(puntos_ref, max_puntos=3500),\r\n635:            \"points_user\": self._reducir_puntos(puntos_user, max_puntos=3500),\r\ngrabaciones\\chasin_you_bc15f480\\usuario_20261010_182938_resultado.json {'porcentaje_50': 82.53275109170306, 'porcentaje_100': 90.70125866940663, 'puntos_comparados': 11679}\r\ngrabaciones\\fdsofdisj_9425509d\\usuario_20261010_183449_resultado.json {'porcentaje_50': 82.54172487317109, 'porcentaje_100': 91.27637673700463, 'puntos_comparados': 27202}\r\n", "exitCode": 0, "durationMs": 569}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9b-f976-75a2-a310-f2abcb6b8840", "item_id": "rs_06f6aa8593d2a892016acbeeaadb3c87d2a64aa2466e861e9d", "rollout_ordinal": 3188, "created_at_ms": 1791749801545, "item_type": "reasoning", "updated_at_ordinal": 3188, "started_at_ms": 1791749801545, "completed_at_ms": 1791749802097}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acbeeaadb3c87d2a64aa2466e861e9d", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9b-f976-75a2-a310-f2abcb6b8840", "item_id": "exec-65c8fcf3-7811-4666-8de1-1ba94b6f46b1", "rollout_ordinal": 3192, "created_at_ms": 1791749803939, "item_type": "commandExecution", "updated_at_ordinal": 3192, "started_at_ms": 1791749803939, "completed_at_ms": 1791749804214}, "item": {"type": "commandExecution", "id": "exec-65c8fcf3-7811-4666-8de1-1ba94b6f46b1", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content ui_live/app.js | Select-Object -Skip 1450 -First 130; Get-Content desktop_live.py | Select-Object -Skip 615 -First 60; Get-Content audio/pitch.py | Select-Object -Skip 110 -First 85'", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "42465", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "Get-Content ui_live/app.js | Select-Object -Skip 1450 -First 130; Get-Content desktop_live.py | Select-Object -Skip 615 -First 60; Get-Content audio/pitch.py | Select-Object -Skip 110 -First 85"}], "aggregatedOutput": "  return commands.join(\" \");\r\n}\r\n\r\nfunction accuracyClass(cents) {\r\n  if (cents == null) return \"unknown\";\r\n  if (cents <= USER_GOOD_CENTS) return \"good\";\r\n  if (cents <= USER_NEAR_CENTS) return \"near\";\r\n  return \"far\";\r\n}\r\n\r\nfunction blockDistanceToTime(block, time) {\r\n  if (time < block.start) return block.start - time;\r\n  if (time > block.end) return time - block.end;\r\n  return 0;\r\n}\r\n\r\nfunction nearestReferenceBlock(referenceBlocks, time, startIndex) {\r\n  let best = null;\r\n  const from = Math.max(0, startIndex - 4);\r\n  const to = Math.min(referenceBlocks.length - 1, startIndex + 4);\r\n  for (let index = from; index <= to; index += 1) {\r\n    const block = referenceBlocks[index];\r\n    if (!block) continue;\r\n    const distance = blockDistanceToTime(block, time);\r\n    if (distance > REFERENCE_TIME_TOLERANCE_SECONDS) continue;\r\n    if (!best || distance < best.distance) {\r\n      best = { block, distance };\r\n    }\r\n  }\r\n  return best?.block || null;\r\n}\r\n\r\nfunction renderUserAccuracy(referenceBlocks) {\r\n  const domain = visibleDomain();\r\n  const points = visibleShiftedUserPoints(domain, 0.45);\r\n  const userBlocks = userBlocksFromPoints(points);\r\n  const blocksByClass = {\r\n    good: [],\r\n    near: [],\r\n    far: [],\r\n    unknown: []\r\n  };\r\n  const lineCommands = [];\r\n  let blockIndex = 0;\r\n\r\n  for (let i = 1; i < points.length; i += 1) {\r\n    const [t1, m1] = points[i - 1];\r\n    const [t2, m2] = points[i];\r\n    if (t2 < domain.xMin - 0.4 || t1 > domain.xMax + 0.4) continue;\r\n    if (t2 - t1 > PATH_GAP_BREAK_SECONDS) continue;\r\n    if (Math.abs(m2 - m1) > PITCH_LINE_JUMP_BREAK_STEPS) continue;\r\n\r\n    lineCommands.push(`M ${xScale(t1).toFixed(1)} ${yScale(m1).toFixed(1)} L ${xScale(t2).toFixed(1)} ${yScale(m2).toFixed(1)}`);\r\n  }\r\n\r\n  userBlocks.forEach((block) => {\r\n    const midpoint = (block.start + block.end) / 2;\r\n    while (\r\n      blockIndex < referenceBlocks.length &&\r\n      referenceBlocks[blockIndex].end < midpoint - REFERENCE_TIME_TOLERANCE_SECONDS\r\n    ) {\r\n      blockIndex += 1;\r\n    }\r\n    const expected = nearestReferenceBlock(referenceBlocks, midpoint, blockIndex);\r\n    const cents = expected ? Math.abs(((block.midi || block.note) - expected.note) * 100) : null;\r\n    const className = accuracyClass(cents);\r\n    blocksByClass[className].push(block);\r\n  });\r\n\r\n  els.userBlockLayer.innerHTML = Object.entries(blocksByClass)\r\n    .filter(([, blocks]) => blocks.length)\r\n    .map(([className, blocks]) => `<path class=\"user-note-blocks user-${className}\" d=\"${buildNoteBlockPath(blocks, USER_BLOCK_HALF_STEPS)}\"></path>`)\r\n    .join(\"\");\r\n  els.userSegmentLayer.innerHTML = \"\";\r\n  els.userPath.setAttribute(\"d\", lineCommands.join(\" \"));\r\n}\r\n\r\nfunction alignmentScore(offsetMs) {\r\n  const referenceBlocks = currentReferenceBlocks();\r\n  const rawPoints = finitePitchPoints(userPointsForChart());\r\n  if (!referenceBlocks.length || rawPoints.length < 4) return Number.NEGATIVE_INFINITY;\r\n\r\n  const step = Math.max(1, Math.floor(rawPoints.length / 900));\r\n  let blockIndex = 0;\r\n  let matched = 0;\r\n  let score = 0;\r\n\r\n  for (let i = 0; i < rawPoints.length; i += step) {\r\n    const [rawTime, midi] = rawPoints[i];\r\n    const time = rawTime + offsetMs / 1000;\r\n    while (\r\n      blockIndex < referenceBlocks.length &&\r\n      referenceBlocks[blockIndex].end < time - REFERENCE_TIME_TOLERANCE_SECONDS\r\n    ) {\r\n      blockIndex += 1;\r\n    }\r\n\r\n    const expected = nearestReferenceBlock(referenceBlocks, time, blockIndex);\r\n    if (!expected) continue;\r\n\r\n    const cents = Math.abs((midi - expected.note) * 100);\r\n    matched += 1;\r\n    if (cents <= USER_GOOD_CENTS) {\r\n      score += 2;\r\n    } else if (cents <= USER_NEAR_CENTS) {\r\n      score += 1;\r\n    } else {\r\n      score += 0.15;\r\n    }\r\n  }\r\n\r\n  if (matched < 8) return Number.NEGATIVE_INFINITY;\r\n  return score / matched + Math.min(0.4, matched / rawPoints.length);\r\n}\r\n\r\nfunction autoAlignVisualOffset() {\r\n  if (!currentReferenceBlocks().length || !userPointsForChart().length) return;\r\n\r\n  let bestOffset = state.visualOffsetMs;\r\n  let bestScore = Number.NEGATIVE_INFINITY;\r\n\r\n  for (let offset = -700; offset <= 700; offset += 10) {\r\n    const score = alignmentScore(offset);\r\n    if (score > bestScore) {\r\n      bestScore = score;\r\n      bestOffset = offset;\r\n    }\r\n  }\r\n\r\n  setVisualOffset(bestOffset);\r\n        puntos_ref = self._puntos_hz_a_midi(\r\n            grafico.get(\"t_ref\", []),\r\n            grafico.get(\"f_ref\", []),\r\n        )\r\n        puntos_user = self._puntos_hz_a_midi(\r\n            grafico.get(\"t_usr\", []),\r\n            grafico.get(\"f_usr\", []),\r\n        )\r\n        return {\r\n            \"id\": toma[\"id\"],\r\n            \"song_id\": cancion[\"id\"],\r\n            \"name\": toma.get(\"name\", \"\"),\r\n            \"favorite\": bool(toma.get(\"favorite\")),\r\n            \"created_at\": toma.get(\"created_at\", \"\"),\r\n            \"duration\": float(toma.get(\"duration\") or 0),\r\n            \"voice_url\": self._archivo_url(toma.get(\"voice_path\", \"\")),\r\n            \"instrumental_url\": self._archivo_url(cancion.get(\"instrumental\", \"\")),\r\n            \"metrics\": metricas,\r\n            \"points_ref\": self._reducir_puntos(puntos_ref, max_puntos=3500),\r\n            \"points_user\": self._reducir_puntos(puntos_user, max_puntos=3500),\r\n            \"preview_ref\": self._reducir_puntos(puntos_ref, max_puntos=80),\r\n            \"preview_user\": self._reducir_puntos(puntos_user, max_puntos=80),\r\n        }\r\n\r\n    def _tarea_en_curso(self):\r\n        return self._estado[\"status\"] in [\r\n            \"adding\",\r\n            \"deleting\",\r\n            \"calibrating\",\r\n            \"preparing\",\r\n            \"recording\",\r\n            \"stopping\",\r\n            \"comparing\",\r\n            \"reprocessing\",\r\n            \"editing\",\r\n        ]\r\n\r\n    def _seleccionar_audio(self):\r\n        if not webview.windows:\r\n            return \"\"\r\n\r\n        rutas = webview.windows[0].create_file_dialog(\r\n            webview.FileDialog.OPEN,\r\n            allow_multiple=False,\r\n            file_types=(\r\n                \"Audio (*.wav;*.mp3;*.flac;*.ogg;*.m4a)\",\r\n                \"Todos los archivos (*.*)\",\r\n            ),\r\n        )\r\n        if not rutas:\r\n            return \"\"\r\n        return str(rutas[0])\r\n\r\n    def _archivo_url(self, ruta):\r\n        if not ruta:\r\n            return \"\"\r\n        try:\r\n            return Path(ruta).resolve().as_uri()\r\n        except ValueError:\r\n            return \"\"\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n    if corregir_octavas:\r\n        return _corregir_octavas_por_registro(t_filtrado, f_filtrado)\r\n    return t_filtrado, f_filtrado\r\n\r\n\r\ndef _energia_por_tiempo(y, sr, tiempos, ventana=1024):\r\n    y = np.asarray(y, dtype=float).reshape(-1)\r\n    tiempos = np.asarray(tiempos, dtype=float)\r\n    if len(y) == 0 or len(tiempos) == 0:\r\n        return np.array([])\r\n\r\n    cuadrado = y * y\r\n    acumulado = np.concatenate(([0.0], np.cumsum(cuadrado)))\r\n    centros = np.clip((tiempos * sr).astype(int), 0, len(y) - 1)\r\n    radio = ventana // 2\r\n    inicios = np.maximum(0, centros - radio)\r\n    fines = np.minimum(len(y), centros + radio)\r\n    muestras = np.maximum(1, fines - inicios)\r\n    energia = (acumulado[fines] - acumulado[inicios]) / muestras\r\n    return np.sqrt(np.maximum(energia, 0.0))\r\n\r\n\r\ndef _filtrar_pitch_tiempo_real(t, f0, y, sr, config=None, ruido_base=None, devolver_info=False,\r\n                             periodicidad=None):\r\n    config = config or FILTRO_TIEMPO_REAL\r\n    f0 = np.nan_to_num(np.asarray(f0, dtype=float), nan=0.0)\r\n    t = np.asarray(t, dtype=float)\r\n    raw_points = int(np.sum(f0 > 0))\r\n    candidatos = f0.copy()\r\n    rms_chunk = float(np.sqrt(np.mean(np.asarray(y, dtype=float) ** 2))) if len(y) else 0.0\r\n\r\n    f_min = librosa.note_to_hz(config[\"nota_min\"])\r\n    f_max = librosa.note_to_hz(config[\"nota_max\"])\r\n    f0[(f0 < f_min) | (f0 > f_max)] = 0\r\n\r\n    energia = _energia_por_tiempo(y, sr, t)\r\n    umbral_energia = 0.0\r\n    if len(energia):\r\n        umbral_energia = max(\r\n            float(np.max(energia)) * config[\"factor_rms_max\"],\r\n            config[\"min_rms_absoluto\"],\r\n        )\r\n        if ruido_base is not None and ruido_base > 0:\r\n            umbral_energia = max(umbral_energia, float(ruido_base) * config[\"factor_ruido\"])\r\n        f0[energia < umbral_energia] = 0\r\n\r\n    periodicos = None\r\n    if periodicidad is not None:\r\n        periodicos = np.asarray(periodicidad) >= config.get(\"min_periodicidad\", 0.7)\r\n        if config.get(\"usar_filtro_aprendido\", False):\r\n            aprendidos = aceptar_candidatos(candidatos, periodicidad, energia)\r\n            if aprendidos is not None:\r\n                periodicos = aprendidos\r\n        f0[~periodicos] = 0\r\n\r\n    f0 = _rellenar_huecos_cortos(f0, max_gap=config[\"max_gap\"])\r\n    # Un hueco rechazado por falta de periodicidad no debe volver a ser una nota.\r\n    if periodicos is not None:\r\n        f0[~periodicos] = 0\r\n    f0 = _quitar_segmentos_cortos(f0, min_frames=config[\"min_frames\"])\r\n\r\n    mask = f0 > 0\r\n    if np.sum(mask) >= config[\"ventana_mediana\"]:\r\n        midi = np.full_like(f0, np.nan, dtype=float)\r\n        midi[mask] = 69 + 12 * np.log2(f0[mask] / 440.0)\r\n        mediana = _mediana_movil(midi, ventana=config[\"ventana_mediana\"])\r\n        saltos = np.abs(midi - mediana) > config[\"max_salto_midi\"]\r\n        f0[saltos & mask] = 0\r\n\r\n    mask = f0 > 0\r\n    t_filtrado = t[mask]\r\n    f_filtrado = f0[mask]\r\n\r\n    if devolver_info:\r\n        return t_filtrado, f_filtrado, {\r\n            \"raw_points\": raw_points,\r\n            \"filtered_points\": int(len(f_filtrado)),\r\n            \"rejected_points\": max(0, raw_points - int(len(f_filtrado))),\r\n            \"rms\": rms_chunk,\r\n            \"energy_threshold\": float(umbral_energia),\r\n            \"noise_floor\": float(ruido_base or 0.0),\r\n        }\r\n", "exitCode": 0, "durationMs": 274}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9b-f976-75a2-a310-f2abcb6b8840", "item_id": "rs_06f6aa8593d2a892016acbeeb21d1487d2a06a9a1f90f3906b", "rollout_ordinal": 3195, "created_at_ms": 1791749808956, "item_type": "reasoning", "updated_at_ordinal": 3195, "started_at_ms": 1791749808956, "completed_at_ms": 1791749815612}, "item": {"type": "reasoning", "id": "rs_06f6aa8593d2a892016acbeeb21d1487d2a06a9a1f90f3906b", "summary": [], "content": []}}
{"record_type": "item", "metadata": {"thread_id": "01a08154-4c27-7551-9cfa-e8e7d2bcf73a", "turn_id": "01a12c9b-f976-75a2-a310-f2abcb6b8840", "item_id": "exec-35df7f9d-e631-4f94-8f4b-8bf74c794b97", "rollout_ordinal": 3199, "created_at_ms": 1791749828296, "item_type": "commandExecution", "updated_at_ordinal": 3199, "started_at_ms": 1791749828296, "completed_at_ms": 1791749829279}, "item": {"type": "commandExecution", "id": "exec-35df7f9d-e631-4f94-8f4b-8bf74c794b97", "pluginId": null, "scriptPath": null, "command": "\"C:\\\\Users\\\\Diego Tapia\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command \"@'\nimport json,numpy as np\nfrom pathlib import Path\nfrom audio.catalogo import cargar_cancion,leer_pitch_csv\nfrom audio.segmentacion import preparar_segmentacion\nfrom audio.alineacion import analizar_alineado\nfrom audio.retroalimentacion import _muestrear\nsong=cargar_cancion('chasin_you_bc15f480'); p=Path('grabaciones/chasin_you_bc15f480/usuario_20261010_182938_resultado.json');d=json.loads(p.read_text(encoding='utf-8'));g=d['grafico'];tr,fr=leer_pitch_csv(song['pitch_referencia']);tu=np.array(g['t_usr']);fu=np.array(g['f_usr']); seg=preparar_segmentacion(song,tr,fr)\nimport soundfile as sf\nduration=sf.info(str(p).replace('_resultado.json','.wav')).duration\nresults=[]\nfor lag in [0,.24,.255,.28,.3]:\n r=analizar_alineado(tr,fr,tu,fu,duration,seg,dict(modo='manual',estado='manual',desfase_s=lag,motivo='Prueba'))\n m=r['resumen_metricas'];results.append(dict(ms=lag*1000,**m))\n print(lag,{k:round(v,2) if isinstance(v,float) else v for k,v in m.items()})\nprint('ref_same', len(tr),len(g['t_ref']),np.max(abs(np.array(fr[:len(g['f_ref'])])-g['f_ref'])))\nfor a,b in [(0,duration),(34,53)]:\n times=np.arange(a,b,.02);ref=_muestrear(np.array(tr),np.array(fr),times,.025);usr=_muestrear(tu-.255,fu,times,.025);mask=(ref>0)&(usr>0);errs=1200*np.log2(usr[mask]/ref[mask]); print('interval',a,b,'n',mask.sum(),'pct',[(v,float(np.mean(abs(errs)<=v)*100)) for v in [25,50,100,150,200,600,1000]],'quantiles',np.percentile(errs,[10,25,50,75,90]).tolist())\n midi_ref=69+12*np.log2(ref[mask]/440);midi_usr=69+12*np.log2(usr[mask]/440);err_round=100*(midi_usr-np.round(midi_ref));print('vs rounded ref',float(np.mean(abs(err_round)<=50)*100),float(np.mean(abs(err_round)<=100)*100))\nPath('output/diagnostico_toma_182938.json').write_text(json.dumps(dict(toma=str(p),historico={k:d[k] for k in ['porcentaje_50','porcentaje_100','puntos_comparados']},barrido=results),indent=2),encoding='utf-8')\n'@ | python -\"", "cwd": "C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke", "processId": "32687", "source": "unifiedExecStartup", "status": "completed", "commandActions": [{"type": "unknown", "command": "@'\nimport json,numpy as np\nfrom pathlib import Path\nfrom audio.catalogo import cargar_cancion,leer_pitch_csv\nfrom audio.segmentacion import preparar_segmentacion\nfrom audio.alineacion import analizar_alineado\nfrom audio.retroalimentacion import _muestrear\nsong=cargar_cancion('chasin_you_bc15f480'); p=Path('grabaciones/chasin_you_bc15f480/usuario_20261010_182938_resultado.json');d=json.loads(p.read_text(encoding='utf-8'));g=d['grafico'];tr,fr=leer_pitch_csv(song['pitch_referencia']);tu=np.array(g['t_usr']);fu=np.array(g['f_usr']); seg=preparar_segmentacion(song,tr,fr)\nimport soundfile as sf\nduration=sf.info(str(p).replace('_resultado.json','.wav')).duration\nresults=[]\nfor lag in [0,.24,.255,.28,.3]:\n r=analizar_alineado(tr,fr,tu,fu,duration,seg,dict(modo='manual',estado='manual',desfase_s=lag,motivo='Prueba'))\n m=r['resumen_metricas'];results.append(dict(ms=lag*1000,**m))\n print(lag,{k:round(v,2) if isinstance(v,float) else v for k,v in m.items()})\nprint('ref_same', len(tr),len(g['t_ref']),np.max(abs(np.array(fr[:len(g['f_ref'])])-g['f_ref'])))\nfor a,b in [(0,duration),(34,53)]:\n times=np.arange(a,b,.02);ref=_muestrear(np.array(tr),np.array(fr),times,.025);usr=_muestrear(tu-.255,fu,times,.025);mask=(ref>0)&(usr>0);errs=1200*np.log2(usr[mask]/ref[mask]); print('interval',a,b,'n',mask.sum(),'pct',[(v,float(np.mean(abs(errs)<=v)*100)) for v in [25,50,100,150,200,600,1000]],'quantiles',np.percentile(errs,[10,25,50,75,90]).tolist())\n midi_ref=69+12*np.log2(ref[mask]/440);midi_usr=69+12*np.log2(usr[mask]/440);err_round=100*(midi_usr-np.round(midi_ref));print('vs rounded ref',float(np.mean(abs(err_round)<=50)*100),float(np.mean(abs(err_round)<=100)*100))\nPath('output/diagnostico_toma_182938.json').write_text(json.dumps(dict(toma=str(p),historico={k:d[k] for k in ['porcentaje_50','porcentaje_100','puntos_comparados']},barrido=results),indent=2),encoding='utf-8')\n'@ | python -"}], "aggregatedOutput": "0 {'duracion_s': 38.77, 'referencia_detectada_s': 36.67, 'usuario_detectado_s': 29.54, 'comparable_s': 28.14, 'referencia_sin_deteccion_usuario_s': 8.53, 'usuario_sin_referencia_detectada_s': 1.4, 'cobertura_comparable_pct': 76.74, 'puntos_comparados': 1409, 'error_absoluto_medio_cents': 247.76, 'error_mediano_firmado_cents': -36.44, 'error_absoluto_p90_cents': 645.92, 'porcentaje_dentro_tolerancia': 24.45, 'porcentaje_dentro_tolerancia_amplia': 40.72, 'porcentaje_agudo': 29.78, 'porcentaje_grave': 45.77, 'porcentaje_desviacion_grande': 10.87}\r\n0.24 {'duracion_s': 38.53, 'referencia_detectada_s': 36.43, 'usuario_detectado_s': 31.42, 'comparable_s': 30.08, 'referencia_sin_deteccion_usuario_s': 6.35, 'usuario_sin_referencia_detectada_s': 1.34, 'cobertura_comparable_pct': 82.57, 'puntos_comparados': 1506, 'error_absoluto_medio_cents': 135.18, 'error_mediano_firmado_cents': -38.28, 'error_absoluto_p90_cents': 361.93, 'porcentaje_dentro_tolerancia': 42.62, 'porcentaje_dentro_tolerancia_amplia': 64.49, 'porcentaje_agudo': 12.5, 'porcentaje_grave': 44.88, 'porcentaje_desviacion_grande': 4.12}\r\n0.255 {'duracion_s': 38.51, 'referencia_detectada_s': 36.41, 'usuario_detectado_s': 31.56, 'comparable_s': 30.38, 'referencia_sin_deteccion_usuario_s': 6.0