<= 0:\r\n            self.scroll_x.set(0, 1)\r\n        else:\r\n            self.scroll_x.set(\r\n                self.detalle_x_inicio / x_total,\r\n                min((self.detalle_x_inicio + self.detalle_ventana_x) / x_total, 1),\r\n            )\r\n\r\n        y_total = max(self.detalle_y_max - self.detalle_y_min, self.detalle_rango_y)\r\n        y_start = (self.detalle_y_inicio - self.detalle_y_min) / y_total\r\n        y_end = min((self.detalle_y_inicio + self.detalle_rango_y - self.detalle_y_min) / y_total, 1)\r\n        self.scroll_y.set(y_start, y_end)\r\n\r\n    def mostrar_grafico(self, datos):\r\n        if not datos:\r\n            self.limpiar_grafico()\r\n            return\r\n\r\n        self.figura.clear()\r\n        self.eje_grafico = self.figura.add_subplot(111)\r\n        configurar_grafico_notas(\r\n            self.eje_grafico,\r\n            datos[\"t_ref\"],\r\n            datos[\"f_ref\"],\r\n            datos[\"t_usr\"],\r\n            datos[\"f_usr\"],\r\n        )\r\n        self.figura.tight_layout()\r\n        self.canvas_grafico.draw()\r\n\r\n    def mostrar_notas_esperadas(self, cursor_t=0):\r\n        if self.cancion_actual is None:\r\n            self.limpiar_grafico()\r\n            return\r\n\r\n        try:\r\n            self.t_ref_actual, self.f_ref_actual = leer_pitch_csv(\r\n                self.cancion_actual[\"pitch_referencia\"]\r\n            )\r\n        except Exception:\r\n            self.limpiar_grafico()\r\n            return\r\n\r\n        self.figura.clear()\r\n        self.eje_grafico = self.figura.add_subplot(111)\r\n        configurar_grafico_esperado(\r\n            self.eje_grafico,\r\n            self.t_ref_actual,\r\n            self.f_ref_actual,\r\n            cursor_t=cursor_t,\r\n            ventana=self.ventana_grafico,\r\n            t_usr=self.t_usr_tiempo_real,\r\n            f_usr=self.f_usr_tiempo_real,\r\n        )\r\n        self.figura.tight_layout()\r\n        self.canvas_grafico.draw()\r\na