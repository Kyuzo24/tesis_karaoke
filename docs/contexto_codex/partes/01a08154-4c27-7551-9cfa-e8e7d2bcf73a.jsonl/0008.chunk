x; max-height: 520px; overflow-y: auto; padding: 2px; }\r\n.feedback-fragment { text-align: left; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px; cursor: pointer; }\r\n.feedback-fragment[aria-pressed=\"true\"] { border-color: var(--gold); background: var(--surface-3); }\r\n.feedback-fragment span { display: block; font-size: 12px; color: var(--muted); margin-top: 6px; }\r\n.feedback-fragment:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }\r\n.feedback-copy { min-width: 0; overflow-wrap: anywhere; }\r\n.feedback-copy ul { padding-left: 20px; line-height: 1.65; }\r\n.feedback-copy li { margin: 8px 0; }\r\n.feedback-copy details { margin-top: 20px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; }\r\n.feedback-copy summary { cursor: pointer; color: var(--muted); }\r\n.feedback-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }\r\n.feedback-settings label { display: flex; flex-direction: column; gap: 6px; margin: 12px 0; }\r\n.feedback-settings input, .feedback-settings select { width: 100%; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); padding: 10px; border-radius: 8px; }\r\n.feedback-settings p { color: var(--muted); line-height: 1.5; font-size: 13px; }\r\n.feedback-tag { font-size: 12px; color: var(--muted); }\r\n@media (max-width: 1050px) { .feedback-layout { grid-template-columns: 1fr; } .feedback-list { max-height: 210px; } }\r\n.preparation-progress { position: fixed; z-index: 100; bottom: 28px; right: 28px; width: min(420px, 85vw); padding: 22px; border: 1px solid var(--gold); background: var(--surface); border-radius: 14px; box-shadow: var(--shadow); }\r\n.preparation-progress progress { display: block; width: 100%; height: 12px; margin: 16px 0; accent-color: var(--gold); }\r\n.preparation-progress span { color: var(--muted); font-size: 13px; }\r\n.feedback-alignment { border: 1px solid var(--line); padding: 14px; border-radius: 12px; margin: 18px 0; }\r\n.feedback-alignment input { width: 100px; background: var(--surface-2); color: var(--ink); border: 1px solid var(--line); padding: 8px; border-radius: 6px; margin: 0 8px; }\r\n229:.metric-tile span,\n275:.metric-tile,\n1011:.metrics-grid {\n1018:.metric-tile {\n1022:.metric-tile strong {\n1029:.metric-tile p {\n1280:  .metrics-grid {\n1362:  .metrics-grid {\n", "exitCode": 0, "durationMs": 679}}
