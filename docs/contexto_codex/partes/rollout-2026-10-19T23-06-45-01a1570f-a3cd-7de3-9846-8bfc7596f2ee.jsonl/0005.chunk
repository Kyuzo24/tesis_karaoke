utagen-1.48.1 pycryptodomex-3.24.1 requests-2.34.2 urllib3-2.8.0 websockets-17.4 yt-dlp-2026.10.26 yt-dlp-ejs-0.8.0\r\n\r\n[notice] A new release of pip is available: 26.1.1 -> 26.3\r\n[notice] To update, run: C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\.youtube-env\\Scripts\\python.exe -m pip install --upgrade pip\r\n","exit_code":0,"duration":{"secs":52,"nanos":895844800}},"started_at_ms":1793672864304,"completed_at_ms":1793672917200}}
{"timestamp":"2026-11-03T02:28:44.403Z","ordinal":440,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_077583884d8d8ef9016ae946af8a948191b58d55b74a1b2ec9","status":"completed","call_id":"call_f75dddfb185f4dcaad85574fbc9ccf90","name":"exec","input":"text(await tools.apply_patch(\"*** Begin Patch\\n*** Add File: audio/youtube.py\\n+\\\"\\\"\\\"YouTube search/import isolated from the application's Python/audio environment.\\n+\\n+The worker runs in .youtube-env (Python 3.11+) and emits JSON lines only.\\n+No credentials, browser cookies or restricted-content workarounds are used.\\n+\\\"\\\"\\\"\\n+import json\\n+import os\\n+from pathlib import Path\\n+import re\\n+import shutil\\n+import subprocess\\n+import sys\\n+import threading\\n+\\n+ROOT = Path(__file__).resolve().parents[1]\\n+MAX_SECONDS = 1200\\n+MAX_BYTES = 100 * 1024 * 1024\\n+\\n+\\n+def validar_id(video_id):\\n+    value = str(video_id or '')\\n+    if not re.fullmatch(r'[A-Za-z0-9_-]{11}', value):\\n+        raise ValueError('Selecciona un resultado válido de YouTube.')\\n+    return value\\n+\\n+\\n+def _ejecutar(action, value, destination='', progreso_callback=None):\\n+    executable = ROOT / '.youtube-env' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')\\n+    if not executable.is_file():\\n+        raise RuntimeError('Falta instalar el componente de YouTube. Ejecuta instalar_youtube.bat.')\\n+    env = os.environ.copy()\\n+    env.pop('PYTHONPATH', None)\\n+    env.pop('PYTHONHOME', None)\\n+    env['PYTHONIOENCODING'] = 'utf-8'\\n+    flags = {'creationflags': subprocess.CREATE_NO_WINDOW} if os.name == 'nt' else {}\\n+    process = subprocess.Popen(\\n+        [str(executable), str(Path(__file__).resolve()), action, value, str(destination)],\\n+        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,\\n+        encoding='utf-8', errors='replace', env=env, **flags,\\n+    )\\n+    timed_out = threading.Event()\\n+    def expire():\\n+        timed_out.set()\\n+        process.kill()\\n+    timer = threading.Timer(90 if action == 'search' else 900, expire)\\n+    timer.start()\\n+    result = None\\n+    try:\\n+        for line in process.stdout:\\n+            try:\\n+                event = json.loads(line)\\n+            except ValueError:\\n+                continue\\n+            if 'progress' in event and progreso_callback:\\n+                progreso_callback(event['progress'])\\n+            if 'result' in event:\\n+                result = event['result']\\n+            if 'error' in event:\\n+                raise RuntimeError(event['error'])\\n+        process.wait()\\n+        if timed_out.is_set():\\n+            raise RuntimeError('YouTube tardó demasiado en responder. Intenta nuevamente.')\\n+        if process.returncode or result is None:\\n+            raise RuntimeError('No se pudo completar la operación con YouTube. Revisa tu conexión e intenta nuevamente.')\\n+        return result\\n+    finally:\\n+        timer.cancel()\\n+        if process.poll() is None:\\n+            process.kill()\\n+        process.wait()\\n+        process.stdout.close()\\n+\\n+\\n+def buscar_videos(query):\\n+    query = str(query or '').strip()\\n+    if not 2 <= len(query) <= 200:\\n+        raise ValueError('Escribe entre 2 y 200 caracteres para buscar una canción.')\\n+    return _ejecutar('search', query)\\n+\\n+\\n+def descargar_audio(video_id, destination, progreso_callback=None):\\n+    return _ejecutar('download', validar_id(video_id), destination, progreso_callback)\\n+\\n+\\n+class _Logger:\\n+    def debug(self, message):\\n+        pass\\n+    def warning(self, message):\\n+        pass\\n+    def error(self, message):\\n+        pass\\n+\\n+\\n+def _options():\\n+    options = dict(quiet=True, no_warnings=True, logger=_Logger(), noplaylist=True,\\n+                   socket_timeout=20, retries=2, extractor_retries=2, cachedir=False)\\n+    node = shutil.which('node')\\n+    if node:\\n+        options['js_runtimes'] = {'node': {'path': node}}\\n+    return options\\n+\\n+\\n+def _resumen(entry):\\n+    if not entry or not re.fullmatch(r'[A-Za-z0-9_-]{11}', str(entry.get('id', ''))):\\n+        return None\\n+    duration = entry.get('duration')\\n+    if entry.get('live_status') in ('is_live', 'is_upcoming', 'post_live') or entry.get('is_live'):\\n+        return None\\n+    if duration is not None and (duration <= 0 or duration > MAX_SECONDS):\\n+        return None\\n+    return dict(id=entry['id'], title=entry.get('title') or 'Sin título',\\n+                channel=entry.get('channel') or entry.get('uploader') or '',\\n+                duration=duration, url='https://www.youtube.com/watch?v=' + entry['id'])\\n+\\n+\\n+def _buscar(query, factory):\\n+    options = {**_options(), 'extract_flat': True, 'skip_download': True}\\n+    with factory(options) as ydl:\\n+        info = ydl.extract_info('ytsearch10:' + query, download=False)\\n+    results, seen = [], set()\\n+    for entry in (info or {}).get('entries') or []:\\n+        item = _resumen(entry)\\n+        if item and item['id'] not in seen:\\n+            results.append(item)\\n+            seen.add(item['id'])\\n+    return results\\n+\\n+\\n+def _descargar(video_id, destination, factory, emit):\\n+    import imageio_ffmpeg\\n+    video_id = validar_id(video_id)\\n+    destination = Path(destination).resolve()\\n+    destination.mkdir(parents=True, exist_ok=True)\\n+    url = 'https://www.youtube.com/watch?v=' + video_id\\n+    last_percent = [-1]\\n+    def progress(data):\\n+        downloaded = data.get('downloaded_bytes') or 0\\n+        if downloaded > MAX_BYTES:\\n+            raise ValueError('El audio supera el límite de 100 MB.')\\n+        if data.get('status') == 'downloading':\\n+            total = data.get('total_bytes') or data.get('total_bytes_estimate')\\n+            percent = min(100, int(downloaded * 100 / total)) if total else 0\\n+            if percent != last_percent[0]:\\n+                emit({'progress': f'Descargando audio: {percent}%'})\\n+                last_percent[0] = percent\\n+    options = {**_options(), 'format': 'bestaudio/best', 'max_filesize': MAX_BYTES,\\n+               'outtmpl': str(destination / 'source.%(ext)s'), 'progress_hooks': [progress]}\\n+    with factory(options) as ydl:\\n+        info = ydl.extract_info(url, download=False)\\n+        if not _resumen(info) or not info.get('duration'):\\n+            raise ValueError('Selecciona un video de duración conocida, de hasta 20 minutos y que no esté en directo.')\\n+        emit({'progress': 'Descargando audio…'})\\n+        ydl.process_info(info)\\n+        source = Path(ydl.prepare_filename(info)).resolve()\\n+    if source.parent != destination or not source.is_file():\\n+        raise ValueError('No se obtuvo un archivo de audio completo.')\\n+    if source.stat().st_size > MAX_BYTES:\\n+        raise ValueError('El audio supera el límite de 100 MB.')\\n+    emit({'progress': 'Convirtiendo audio para preparar la canción…'})\\n+    output = destination / 'audio.wav'\\n+    flags = {'creationflags': subprocess.CREATE_NO_WINDOW} if os.name == 'nt' else {}\\n+    subprocess.run([imageio_ffmpeg.get_ffmpeg_exe(), '-nostdin', '-y', '-i', str(source),\\n+                    '-vn', '-ac', '2', '-ar', '44100', '-c:a', 'pcm_s16le', str(output)],\\n+                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=True, timeout=120, **flags)\\n+    if not output.is_file() or output.stat().st_size <= 44:\\n+        raise ValueError('El audio descargado está vacío.')\\n+    return dict(path=str(output), source=dict(provider='youtube', video_id=video_id,\\n+                url=url, title=info.get('title', ''), channel=info.get('channel') or info.get('uploader', '')))\\n+\\n+\\n+def _main():\\n+    def emit(event):\\n+        print(json.dumps(event, ensure_ascii=False), flush=True)\\n+    try:\\n+        from yt_dlp import YoutubeDL\\n+        action, value = sys.argv[1:3]\\n+        if action == 'search':\\n+            result = _buscar(value, YoutubeDL)\\n+        elif action == 'download':\\n+            result = _descargar(value, sys.argv[3], YoutubeDL, emit)\\n+        else:\\n+            raise ValueError('Operación no válida.')\\n+        emit({'result': result})\\n+    except ValueError as exc:\\n+        emit({'error': str(exc)})\\n+    except Exception:\\n+        emit({'error': 'No se pudo obtener el contenido de YouTube. Comprueba tu conexión. '\\n+              'El video podría no estar disponible o requerir acceso restringido. '\\n+              'Si persiste, actualiza el componente con instalar_youtube.bat.'})\\n+\\n+\\n+if __name__ == '__main__':\\n+    _main()\\n*** Add File: instalar_youtube.bat\\n+@echo off\\n+setlocal\\n+cd /d \\\"%~dp0\\\"\\n+set \\\"PYTHONPATH=\\\"\\n+set \\\"PYTHONHOME=\\\"\\n+if not exist \\\".youtube-env\\\\Scripts\\\\python.exe\\\" (\\n+    py -3 -m venv .youtube-env\\n+    if errorlevel 1 exit /b 1\\n+)\\n+.youtube-env\\\\Scripts\\\\python.exe -m pip install --upgrade -r requirements-youtube.txt\\n+if errorlevel 1 exit /b 1\\n+echo Componente de YouTube instalado. Reinicia la aplicacion.\\n*** Add File: requirements-youtube.txt\\n+# Entorno separado, Python 3.11 o superior. No instalar en el entorno de audio.\\n+yt-dlp[default]>=2026.3.17\\n+imageio-ffmpeg>=0.6.0\\n*** End Patch\"));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672879.5480757}}}
{"timestamp":"2026-11-03T02:28:44.437Z","ordinal":441,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1570f-a3cd-7de3-9846-8bfc7596f2ee","turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","item":{"type":"FileChange","id":"exec-6e9c3b91-459c-4470-85bf-fdfc7e5a04a9","changes":{"C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\requirements-youtube.txt":{"type":"add","content":"# Entorno separado, Python 3.11 o superior. No instalar en el entorno de audio.\nyt-dlp[default]>=2026.3.17\nimageio-ffmpeg>=0.6.0\n"},"C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\instalar_youtube.bat":{"type":"add","content":"@echo off\nsetlocal\ncd /d \"%~dp0\"\nset \"PYTHONPATH=\"\nset \"PYTHONHOME=\"\nif not exist \".youtube-env\\Scripts\\python.exe\" (\n    py -3 -m venv .youtube-env\n    if errorlevel 1 exit /b 1\n)\n.youtube-env\\Scripts\\python.exe -m pip install --upgrade -r requirements-youtube.txt\nif errorlevel 1 exit /b 1\necho Componente de YouTube instalado. Reinicia la aplicacion.\n"},"C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\youtube.py":{"type":"add","content":"\"\"\"YouTube search/import isolated from the application's Python/audio environment.\n\nThe worker runs in .youtube-env (Python 3.11+) and emits JSON lines only.\nNo credentials, browser cookies or restricted-content workarounds are used.\n\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport threading\n\nROOT = Path(__file__).resolve().parents[1]\nMAX_SECONDS = 1200\nMAX_BYTES = 100 * 1024 * 1024\n\n\ndef validar_id(video_id):\n    value = str(video_id or '')\n    if not re.fullmatch(r'[A-Za-z0-9_-]{11}', value):\n        raise ValueError('Selecciona un resultado válido de YouTube.')\n    return value\n\n\ndef _ejecutar(action, value, destination='', progreso_callback=None):\n    executable = ROOT / '.youtube-env' / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')\n    if not executable.is_file():\n        raise RuntimeError('Falta instalar el componente de YouTube. Ejecuta instalar_youtube.bat.')\n    env = os.environ.copy()\n    env.pop('PYTHONPATH', None)\n    env.pop('PYTHONHOME', None)\n    env['PYTHONIOENCODING'] = 'utf-8'\n    flags = {'creationflags': subprocess.CREATE_NO_WINDOW} if os.name == 'nt' else {}\n    process = subprocess.Popen(\n        [str(executable), str(Path(__file__).resolve()), action, value, str(destination)],\n        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,\n        encoding='utf-8', errors='replace', env=env, **flags,\n    )\n    timed_out = threading.Event()\n    def expire():\n        timed_out.set()\n        process.kill()\n    timer = threading.Timer(90 if action == 'search' else 900, expire)\n    timer.start()\n    result = None\n    try:\n        for line in process.stdout:\n            try:\n                event = json.loads(line)\n            except ValueError:\n                continue\n            if 'progress' in event and progreso_callback:\n                progreso_callback(event['progress'])\n            if 'result' in event:\n                result = event['result']\n            if 'error' in event:\n                raise RuntimeError(event['error'])\n        process.wait()\n        if timed_out.is_set():\n            raise RuntimeError('YouTube tardó demasiado en responder. Intenta nuevamente.')\n        if process.returncode or result is None:\n            raise RuntimeError('No se pudo completar la operación con YouTube. Revisa tu conexión e intenta nuevamente.')\n        return result\n    finally:\n        timer.cancel()\n        if process.poll() is None:\n            process.kill()\n        process.wait()\n        process.stdout.close()\n\n\ndef buscar_videos(query):\n    query = str(query or '').strip()\n    if not 2 <= len(query) <= 200:\n        raise ValueError('Escribe entre 2 y 200 caracteres para buscar una canción.')\n    return _ejecutar('search', query)\n\n\ndef descargar_audio(video_id, destination, progreso_callback=None):\n    return _ejecutar('download', validar_id(video_id), destination, progreso_callback)\n\n\nclass _Logger:\n    def debug(self, message):\n        pass\n    def warning(self, message):\n        pass\n    def error(self, message):\n        pass\n\n\ndef _options():\n    options = dict(quiet=True, no_warnings=True, logger=_Logger(), noplaylist=True,\n                   socket_timeout=20, retries=2, extractor_retries=2, cachedir=False)\n    node = shutil.which('node')\n    if node:\n        options['js_runtimes'] = {'node': {'path': node}}\n    return options\n\n\ndef _resumen(entry):\n    if not entry or not re.fullmatch(r'[A-Za-z0-9_-]{11}', str(entry.get('id', ''))):\n        return None\n    duration = entry.get('duration')\n    if entry.get('live_status') in ('is_live', 'is_upcoming', 'post_live') or entry.get('is_live'):\n        return None\n    if duration is not None and (duration <= 0 or duration > MAX_SECONDS):\n        return None\n    return dict(id=entry['id'], title=entry.get('title') or 'Sin título',\n                channel=entry.get('channel') or entry.get('uploader') or '',\n                duration=duration, url='https://www.youtube.com/watch?v=' + entry['id'])\n\n\ndef _buscar(query, factory):\n    options = {**_options(), 'extract_flat': True, 'skip_download': True}\n    with factory(options) as ydl:\n        info = ydl.extract_info('ytsearch10:' + query, download=False)\n    results, seen = [], set()\n    for entry in (info or {}).get('entries') or []:\n        item = _resumen(entry)\n        if item and item['id'] not in seen:\n            results.append(item)\n            seen.add(item['id'])\n    return results\n\n\ndef _descargar(video_id, destination, factory, emit):\n    import imageio_ffmpeg\n    video_id = validar_id(video_id)\n    destination = Path(destination).resolve()\n    destination.mkdir(parents=True, exist_ok=True)\n    url = 'https://www.youtube.com/watch?v=' + video_id\n    last_percent = [-1]\n    def progress(data):\n        downloaded = data.get('downloaded_bytes') or 0\n        if downloaded > MAX_BYTES:\n            raise ValueError('El audio supera el límite de 100 MB.')\n        if data.get('status') == 'downloading':\n            total = data.get('total_bytes') or data.get('total_bytes_estimate')\n            percent = min(100, int(downloaded * 100 / total)) if total else 0\n            if percent != last_percent[0]:\n                emit({'progress': f'Descargando audio: {percent}%'})\n                last_percent[0] = percent\n    options = {**_options(), 'format': 'bestaudio/best', 'max_filesize': MAX_BYTES,\n               'outtmpl': str(destination / 'source.%(ext)s'), 'progress_hooks': [progress]}\n    with factory(options) as ydl:\n        info = ydl.extract_info(url, download=False)\n        if not _resumen(info) or not info.get('duration'):\n            raise ValueError('Selecciona un video de duración conocida, de hasta 20 minutos y que no esté en directo.')\n        emit({'progress': 'Descargando audio…'})\n        ydl.process_info(info)\n        source = Path(ydl.prepare_filename(info)).resolve()\n    if source.parent != destination or not source.is_file():\n        raise ValueError('No se obtuvo un archivo de audio completo.')\n    if source.stat().st_size > MAX_BYTES:\n        raise ValueError('El audio supera el límite de 100 MB.')\n    emit({'progress': 'Convirtiendo audio para preparar la canción…'})\n    output = destination / 'audio.wav'\n    flags = {'creationflags': subprocess.CREATE_NO_WINDOW} if os.name == 'nt' else {}\n    subprocess.run([imageio_ffmpeg.get_ffmpeg_exe(), '-nostdin', '-y', '-i', str(source),\n                    '-vn', '-ac', '2', '-ar', '44100', '-c:a', 'pcm_s16le', str(output)],\n                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=True, timeout=120, **flags)\n    if not output.is_file() or output.stat().st_size <= 44:\n        raise ValueError('El audio descargado está vacío.')\n    return dict(path=str(output), source=dict(provider='youtube', video_id=video_id,\n                url=url, title=info.get('title', ''), channel=info.get('channel') or info.get('uploader', '')))\n\n\ndef _main():\n    def emit(event):\n        print(json.dumps(event, ensure_ascii=False), flush=True)\n    try:\n        from yt_dlp import YoutubeDL\n        action, value = sys.argv[1:3]\n        if action == 'search':\n            result = _buscar(value, YoutubeDL)\n        elif action == 'download':\n            result = _descargar(value, sys.argv[3], YoutubeDL, emit)\n        else:\n            raise ValueError('Operación no válida.')\n        emit({'result': result})\n    except ValueError as exc:\n        emit({'error': str(exc)})\n    except Exception:\n        emit({'error': 'No se pudo obtener el contenido de YouTube. Comprueba tu conexión. '\n              'El video podría no estar disponible o requerir acceso restringido. '\n              'Si persiste, actualiza el componente con instalar_youtube.bat.'})\n\n\nif __name__ == '__main__':\n    _main()\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA audio/youtube.py\nA instalar_youtube.bat\nA requirements-youtube.txt\n","stderr":""},"started_at_ms":1793672924432,"completed_at_ms":1793672924437}}
