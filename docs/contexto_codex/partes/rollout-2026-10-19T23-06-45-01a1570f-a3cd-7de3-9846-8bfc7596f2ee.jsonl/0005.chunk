cy_rnn\\\\rnn_cell_wrapper_impl.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\layers\\\\legacy_rnn\\\\rnn_cell_impl.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\layers\\\\legacy_rnn\\\\__init__.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\distributed_file_utils.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\distributed_training_utils.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\distribute_coordinator_utils.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\initializers\\\\initializers_v2.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\worker_training_state.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\__init__.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\initializers\\\\initializers_v1.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\initializers\\\\__init__.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\keras\\\\distribute\\\\distributed_training_utils_v1.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\data\\\\experimental\\\\kernel_tests\\\\service\\\\test_base.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\data\\\\experimental\\\\kernel_tests\\\\service\\\\multi_process_cluster.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\data\\\\experimental\\\\kernel_tests\\\\service\\\\__init__.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\compiler\\\\tensorrt\\\\test\\\\tf_trt_integration_test_base.py\\nvenv\\\\Lib\\\\site-packages\\\\tensorflow\\\\python\\\\compiler\\\\tensorrt\\\\test\\\\__init__.py\\nPath\\r\\n----\\r\\nC:\\\\Users\\\\Diego Tapia\\\\Desktop\\\\Pene\\\\U\\\\Tesis\\\\tesis_karaoke\\r\\n\\r\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922