{"timestamp":"2026-11-03T02:26:35.576Z","ordinal":404,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a1570f-a3cd-7de3-9846-8bfc7596f2ee","turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","item":{"type":"CommandExecution","id":"exec-e26e80fc-fd6f-4058-be58-21dd2112b9ed","process_id":"94895","command":["C:\\Users\\Diego Tapia\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\native\\powershell\\pwsh.exe","-Command","Get-Content desktop_live.py -TotalCount 80; Get-Content desktop_live.py | Select-Object -Skip 275 -First 150; rg -n 'addSong|add-song|audioPath|audio-path|prepar|modal|busy' ui_live/app.js ui_live/index.html | Select-Object -First 90; Get-Content iniciar_live.bat; Get-Content tests/test_preparacion.py -TotalCount 80; Get-Content audio/separacion.py -TotalCount 70; Get-Item ../AGENTS.md,../../AGENTS.md,AGENTS.md -ErrorAction SilentlyContinue"],"cwd":"file:///C:/Users/Diego%20Tapia/Desktop/Pene/U/Tesis/tesis_karaoke","parsed_cmd":[{"type":"unknown","cmd":"Get-Content desktop_live.py -TotalCount 80; Get-Content desktop_live.py | Select-Object -Skip 275 -First 150; rg -n 'addSong|add-song|audioPath|audio-path|prepar|modal|busy' ui_live/app.js ui_live/index.html | Select-Object -First 90; Get-Content iniciar_live.bat; Get-Content tests/test_preparacion.py -TotalCount 80; Get-Content audio/separacion.py -TotalCount 70; Get-Item ../AGENTS.md,../../AGENTS.md,AGENTS.md -ErrorAction SilentlyContinue"}],"source":"unified_exec_startup","status":"failed","aggregated_output":"import os\r\nimport threading\r\nimport logging\r\nimport time\r\nimport json\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport numpy as np\r\nimport sounddevice as sd\r\nimport soundfile as sf\r\nimport webview\r\n\r\nfrom audio.catalogo import (\r\n    agregar_cancion,\r\n    cargar_cancion,\r\n    cargar_canciones,\r\n    editar_cancion,\r\n    eliminar_cancion,\r\n    leer_pitch_csv,\r\n    regenerar_pitch_referencia,\r\n)\r\nfrom audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\r\nfrom audio.metricas import hz_to_midi\r\nfrom audio.pitch import extraer_pitch_ligero_desde_audio\r\nfrom audio.tomas import actualizar_toma, eliminar_toma, guardar_toma, listar_tomas\r\n\r\n\r\nLIVE_PITCH_INTERVAL = 0.10\r\nLIVE_PITCH_CHUNK = 0.24\r\nLIVE_MAX_JUMP_MIDI = 7\r\nLIVE_JUMP_RESET_SECONDS = 0.55\r\n\r\n\r\nclass LiveBackend:\r\n    def library_info(self):\r\n        from audio.biblioteca import informacion\r\n        try:\r\n            return {'ok':True, **informacion()}\r\n        except Exception as exc:\r\n            return {'ok':False,'error':str(exc)}\r\n\r\n    def change_collection(self, action, collection_id='', name='', song_id='', included=True):\r\n        from audio.biblioteca import cambiar\r\n        try:\r\n            return {'ok':True,'collections':cambiar(action,collection_id,name,song_id,included)}\r\n        except Exception as exc:\r\n            return {'ok':False,'error':str(exc)}\r\n\r\n    def audio_devices(self, refresh=False):\r\n        with self._lock:\r\n            if self._estado['status'] in ('calibrating', 'preparing', 'recording', 'stopping'):\r\n                return {'ok': False, 'error': 'Detén la grabación antes de actualizar dispositivos.'}\r\n            try:\r\n                # PortAudio on Windows retains the device inventory until reinitialized.\r\n                if refresh:\r\n                    sd._terminate()\r\n                    sd._initialize()\r\n                    self._restore_audio_selection()\r\n                hosts = sd.query_hostapis()\r\n                devices = [dict(id=i, name=d['name'], host=hosts[d['hostapi']]['name'],\r\n                                input=d['max_input_channels']>0, output=d['max_output_channels']>0)\r\n                           for i,d in enumerate(sd.query_devices())]\r\n                # Windows exposes the same endpoint via MME, DirectSound and WASAPI.\r\n                # Prefer the active WASAPI inventory, avoiding duplicate/legacy entries.\r\n                wasapi=[d for d in devices if d['host']=='Windows WASAPI']\r\n                if wasapi:\r\n                    devices=wasapi\r\n                selected=list(sd.default.device)\r\n                for direction in range(2):\r\n                    kind='input' if direction==0 else 'output'\r\n                    if not any(d['id']==selected[direction] for d in devices):\r\n                        host=next((h for h in hosts if h['name']=='Windows WASAPI'),None)\r\n                        selected[direction]=host['default_'+kind+'_device'] if host else selected[direction]\r\n                return dict(ok=True, devices=devices, selected=selected)\r\n            except Exception as exc:\r\n                return {'ok': False, 'error': str(exc)}\r\n\r\n    def _restore_audio_selection(self):\r\n        devices=sd.query_devices(); hosts=sd.query_hostapis()\r\n        try:\r\n            cancion = cargar_cancion(song_id)\r\n            eliminar_toma(cancion, take_id)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"takes\": self.get_takes(song_id)}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def select_audio_file(self):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n\r\n        ruta_audio = self._seleccionar_audio()\r\n        if not ruta_audio:\r\n            return {\"ok\": False, \"cancelled\": True}\r\n\r\n        ruta = Path(ruta_audio)\r\n        return {\r\n            \"ok\": True,\r\n            \"path\": str(ruta),\r\n            \"filename\": ruta.name,\r\n            \"suggested_title\": ruta.stem.replace(\"_\", \" \").replace(\"-\", \" \").strip(),\r\n        }\r\n\r\n    def add_song_from_file(self, audio_path, title, artist=\"\"):\r\n        title = str(title or \"\").strip()\r\n        artist = str(artist or \"\").strip()\r\n        audio_path = str(audio_path or \"\").strip()\r\n        if not title:\r\n            return {\"ok\": False, \"error\": \"Ingresa un titulo para la cancion.\"}\r\n        if not audio_path:\r\n            return {\"ok\": False, \"error\": \"Selecciona un archivo de audio.\"}\r\n        if not Path(audio_path).exists():\r\n            return {\"ok\": False, \"error\": \"El archivo seleccionado ya no esta disponible.\"}\r\n\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"adding\",\r\n            }\r\n\r\n        try:\r\n            cancion = agregar_cancion(audio_path, title, artist, progreso_callback=self._progreso_preparacion)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n\r\n    def delete_song(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"deleting\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            eliminar_cancion(song_id)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"songs\": self.get_songs()}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def edit_song(self, song_id, title, artist=\"\"):\r\n        title = str(title or \"\").strip()\r\n        artist = str(artist or \"\").strip()\r\n        if not title:\r\n            return {\"ok\": False, \"error\": \"Ingresa un titulo para la cancion.\"}\r\n\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"editing\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = editar_cancion(song_id, title, artist)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui, \"songs\": self.get_songs()}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def reprocess_song(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Hay una tarea de audio en curso.\"}\r\n            self._estado = {\r\n                **self._estado_inicial(),\r\n                \"status\": \"reprocessing\",\r\n                \"song_id\": song_id,\r\n            }\r\n\r\n        try:\r\n            cancion = regenerar_pitch_referencia(song_id, progreso_callback=self._progreso_preparacion)\r\n            song_ui = self._cancion_para_ui(cancion)\r\n            with self._lock:\r\n                self._estado = self._estado_inicial()\r\n            return {\"ok\": True, \"song\": song_ui}\r\n        except Exception as exc:\r\n            with self._lock:\r\n                self._estado = {\r\n                    **self._estado_inicial(),\r\n                    \"status\": \"error\",\r\n                    \"error\": str(exc),\r\n                }\r\n            return {\"ok\": False, \"error\": str(exc)}\r\n\r\n    def start_session(self, song_id):\r\n        with self._lock:\r\n            if self._tarea_en_curso():\r\n                return {\"ok\": False, \"error\": \"Ya hay una tarea de audio en curso.\"}\r\nui_live/index.html:253:  <section id=\"preparationProgress\" class=\"preparation-progress hidden\" role=\"status\" aria-live=\"polite\">\r\nui_live/index.html:254:    <strong id=\"preparationMessage\">Preparando canción…</strong>\r\nui_live/index.html:256:    <span id=\"preparationElapsed\">La separación puede tardar varios minutos.</span>\r\nui_live/index.html:371:  <div class=\"modal-backdrop hidden\" id=\"songModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"songModalTitle\">\r\nui_live/index.html:372:    <form class=\"song-modal\" id=\"songModalForm\">\r\nui_live/index.html:373:      <div class=\"modal-head\">\r\nui_live/index.html:378:        <button class=\"button modal-close\" id=\"songModalCancelX\" type=\"button\" aria-label=\"Cerrar\">×</button>\r\nui_live/index.html:384:      <label class=\"modal-field\" for=\"songTitleInput\">\r\nui_live/index.html:388:      <label class=\"modal-field\" for=\"songArtistInput\">\r\nui_live/index.html:392:      <p class=\"modal-error\" id=\"songModalError\"></p>\r\nui_live/index.html:393:      <div class=\"modal-actions\">\r\nui_live/index.html:400:  <div class=\"modal-backdrop hidden\" id=\"genericModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"genericModalTitle\">\r\nui_live/index.html:401:    <form class=\"song-modal\" id=\"genericModalForm\">\r\nui_live/index.html:402:      <div class=\"modal-head\">\r\nui_live/index.html:407:        <button class=\"button modal-close\" id=\"genericModalCancelX\" type=\"button\" aria-label=\"Cerrar\">×</button>\r\nui_live/index.html:409:      <p class=\"modal-message\" id=\"genericModalMessage\"></p>\r\nui_live/index.html:410:      <label class=\"modal-field hidden\" id=\"genericModalInputRow\" for=\"genericModalInput\">\r\nui_live/index.html:414:      <p class=\"modal-error\" id=\"genericModalError\"></p>\r\nui_live/index.html:415:      <div class=\"modal-actions\">\r\nui_live/app.js:448:  els.librarySongMeta.textContent = `${song.artist} / ${formatTime(song.duration)} / ${song.prepared ? \"Lista\" : \"Sin procesar\"} / ${song.lyrics?.lines?.length ? \"Con letra\" : \"Sin letra\"}`;\r\nui_live/app.js:449:  els.libraryPracticeButton.disabled = !backendReady || state.catalogWorking || !song.prepared || !song.id;\r\nui_live/app.js:459:    prepared: Boolean(song.prepared),\r\nui_live/app.js:608:        <span>${song.prepared ? \"Lista\" : \"Sin procesar\"}</span>\r\nui_live/app.js:746:  els.referenceDiagnosticButton.disabled = !backendReady || state.playing || state.catalogWorking || state.diagnosticLoading || !song?.prepared;\r\nui_live/app.js:913:  els.startButton.disabled = !backendReady || state.catalogWorking || !song.prepared || !song.id;\r\nui_live/app.js:917:  setStatus(song.prepared ? \"Listo\" : \"Sin procesar\", false);\r\nui_live/app.js:923:  const busy = state.playing || state.catalogWorking;\r\nui_live/app.js:924:  els.addButton.disabled = !backendReady || busy;\r\nui_live/app.js:925:  els.libraryPracticeButton.disabled = !backendReady || busy || !song?.prepared || !song?.id;\r\nui_live/app.js:958:  return Boolean(song?.id && song?.prepared && hasReferenceForChart());\r\nui_live/app.js:1984:    document.body.classList.add(\"modal-open\");\r\nui_live/app.js:1999:      document.body.classList.remove(\"modal-open\");\r\nui_live/app.js:2057:    document.body.classList.add(\"modal-open\");\r\nui_live/app.js:2072:      document.body.classList.remove(\"modal-open\");\r\nui_live/app.js:2121:async function addSong() {\r\nui_live/app.js:2157:    window.preparationUI?.start();\r\nui_live/app.js:2175:    window.preparationUI?.stop();\r\nui_live/app.js:2245:    `Se eliminara \"${song.title}\" del catalogo, junto con sus archivos preparados y grabaciones.\\n\\nQuieres continuar?`\r\nui_live/app.js:2445:  window.preparationUI?.start();\r\nui_live/app.js:2466:    window.preparationUI?.stop();\r\nui_live/app.js:2467:    els.startButton.disabled = !backendReady || !currentSong()?.prepared;\r\nui_live/app.js:2529:  } else if (session.status === \"preparing\") {\r\nui_live/app.js:2622:  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\r\nui_live/app.js:2641:  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\r\nui_live/app.js:2697:els.addButton.addEventListener(\"click\", addSong);\r\n@echo off\r\nsetlocal\r\ncd /d \"%~dp0\"\r\nset \"PYTHONPATH=%CD%\\venv\\Lib\\site-packages\"\r\npy -3.10 desktop_live.py\r\nimport unittest\r\nfrom unittest.mock import patch\r\n\r\nfrom audio.separacion import separar_voz, progreso_demucs\r\nfrom audio import catalogo\r\n\r\n\r\nclass PreparationTests(unittest.TestCase):\r\n    def test_phase_is_reported_before_demucs_and_failure_propagates(self):\r\n        phases = []\r\n        with patch('audio.separacion.os.path.exists', return_value=False), \\\r\n             patch('audio.separacion.subprocess.Popen', side_effect=RuntimeError('fallo')):\r\n            with self.assertRaises(RuntimeError):\r\n                separar_voz('song.wav', progreso_callback=phases.append)\r\n        self.assertEqual(phases, ['Separando voz y acompañamiento…'])\r\n\r\n    def test_real_progress_and_eta(self):\r\n        self.assertEqual(progreso_demucs('19%|### | 52.65/280.8 [01:37<07:02, 1.85s/seconds]'),\r\n                         'Separando voz y acompañamiento: 19% · Restante estimado: 07:02')\r\n        self.assertIsNone(progreso_demucs('Loading model'))\r\n\r\n    def test_catalog_reports_pitch_phase_and_preserves_callback(self):\r\n        phases = []\r\n        metadata = dict(original='song.wav', pitch_referencia='pitch.csv')\r\n        with patch.object(catalogo, 'cargar_cancion', return_value=metadata), \\\r\n             patch.object(catalogo, 'preparar_pistas', return_value=('vocals.wav', 'track.wav')) as preparation, \\\r\n             patch.object(catalogo.os.path, 'exists', return_value=False), \\\r\n             patch.object(catalogo, 'extraer_pitch', return_value=([], [])), \\\r\n             patch.object(catalogo, 'guardar_csv'), patch.object(catalogo, 'guardar_metadata'):\r\n            catalogo.preparar_cancion('song', progreso_callback=phases.append)\r\n        self.assertEqual(phases, ['Detectando las notas de referencia…'])\r\n        self.assertEqual(preparation.call_args.kwargs['progreso_callback'], phases.append)\r\n\r\n\r\nif __name__ == '__main__':\r\n    unittest.main()\r\nimport os\r\nimport subprocess\r\nimport sys\r\nimport re\r\n\r\nimport librosa\r\nimport soundfile as sf\r\n\r\n\r\ndef _venv_site_packages():\r\n    raiz = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\n    return os.path.join(raiz, \"venv\", \"Lib\", \"site-packages\")\r\n\r\n\r\ndef _entorno_subproceso():\r\n    env = os.environ.copy()\r\n    site_packages = _venv_site_packages()\r\n    if os.path.exists(site_packages):\r\n        pythonpath = env.get(\"PYTHONPATH\", \"\")\r\n        rutas = [site_packages]\r\n        if pythonpath:\r\n            rutas.append(pythonpath)\r\n        env[\"PYTHONPATH\"] = os.pathsep.join(rutas)\r\n    return env\r\n\r\n\r\ndef _comando_python_demucs():\r\n    if os.path.exists(_venv_site_packages()):\r\n        return [\"py\", \"-3.10\", \"-m\", \"demucs\"]\r\n    return [sys.executable, \"-m\", \"demucs\"]\r\n\r\n\r\ndef rutas_demucs(ruta_audio, output_dir=\"output\"):\r\n    nombre = os.path.splitext(os.path.basename(ruta_audio))[0]\r\n    base_path = os.path.join(output_dir, \"htdemucs\", nombre)\r\n    return {\r\n        \"base\": base_path,\r\n        \"vocals\": os.path.join(base_path, \"vocals.wav\"),\r\n        \"drums\": os.path.join(base_path, \"drums.wav\"),\r\n        \"bass\": os.path.join(base_path, \"bass.wav\"),\r\n        \"other\": os.path.join(base_path, \"other.wav\"),\r\n        \"instrumental\": os.path.join(base_path, \"instrumental.wav\"),\r\n    }\r\n\r\n\r\ndef separar_voz(ruta_audio, forzar_separacion=False, progreso_callback=None):\r\n    \"\"\"\r\n    Si ya existe vocals.wav y no se fuerza, lo reutiliza.\r\n    Si no, ejecuta Demucs.\r\n    \"\"\"\r\n    output_dir = \"output\"\r\n    paths = rutas_demucs(ruta_audio, output_dir)\r\n    vocals_path = paths[\"vocals\"]\r\n\r\n    if os.path.exists(vocals_path) and not forzar_separacion:\r\n        print(\"Usando separacion ya existente\")\r\n        return vocals_path\r\n\r\n    print(\"Separando audio con Demucs...\")\r\n    if progreso_callback:\r\n        progreso_callback('Separando voz y acompañamiento…')\r\n    opciones = {}\r\n    if os.name == 'nt':\r\n        opciones['creationflags'] = subprocess.CREATE_NO_WINDOW\r\n    proceso = subprocess.Popen(\r\n        _comando_python_demucs() + [\"-o\", output_dir, ruta_audio],\r\n        env=_entorno_subproceso(),\r\n        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\r\n        text=True, encoding='utf-8', errors='replace', **opciones,\r\n    )\r\n","exit_code":1,"duration":{"secs":0,"nanos":633532000}},"started_at_ms":1793672794942,"completed_at_ms":1793672795576}}
{"timestamp":"2026-11-03T02:26:35.600Z","ordinal":405,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a19f3a-d5d0-75c2-aa2f-f66ce91f6fa9","call_id":"call_bcb6cbf5e9c643e88c74dac49d502ea8","output":[{"type":"input_text","text":"Script completed\nWall time 1.0 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"8f99e0\",\"wall_time_seconds\":0.6336102,\"exit_code\":1,\"original_token_count\":4330,\"output\":\"import os\\r\\nimport threading\\r\\nimport logging\\r\\nimport time\\r\\nimport json\\r\\nimport re\\r\\nfrom pathlib import Path\\r\\n\\r\\nimport numpy as np\\r\\nimport sounddevice as sd\\r\\nimport soundfile as sf\\r\\nimport webview\\r\\n\\r\\nfrom audio.catalogo import (\\r\\n    agregar_cancion,\\r\\n    cargar_cancion,\\r\\n    cargar_canciones,\\r\\n    editar_cancion,\\r\\n    eliminar_cancion,\\r\\n    leer_pitch_csv,\\r\\n    regenerar_pitch_referencia,\\r\\n)\\r\\nfrom audio.karaoke import comparar_grabacion, diagnosticar_filtros, grabar_con_instrumental\\r\\nfrom audio.metricas import hz_to_midi\\r\\nfrom audio.pitch import extraer_pitch_ligero_desde_audio\\r\\nfrom audio.tomas import actualizar_toma, eliminar_toma, guardar_toma, listar_tomas\\r\\n\\r\\n\\r\\nLIVE_PITCH_INTERVAL = 0.10\\r\\nLIVE_PITCH_CHUNK = 0.24\\r\\nLIVE_MAX_JUMP_MIDI = 7\\r\\nLIVE_JUMP_RESET_SECONDS = 0.55\\r\\n\\r\\n\\r\\nclass LiveBackend:\\r\\n    def library_info(self):\\r\\n        from audio.biblioteca import informacion\\r\\n        try:\\r\\n            return {'ok':True, **informacion()}\\r\\n        except Exception as exc:\\r\\n            return {'ok':False,'error':str(exc)}\\r\\n\\r\\n    def change_collection(self, action, collection_id='', name='', song_id='', included=True):\\r\\n        from audio.biblioteca import cambiar\\r\\n        try:\\r\\n            return {'ok':True,'collections':cambiar(action,collection_id,name,song_id,included)}\\r\\n        except Exception as exc:\\r\\n            return {'ok':False,'error':str(exc)}\\r\\n\\r\\n    def audio_devices(self, refresh=False):\\r\\n        with self._lock:\\r\\n            if self._estado['status'] in ('calibrating', 'preparing', 'recording', 'stopping'):\\r\\n                return {'ok': False, 'error': 'Detén la grabación antes de actualizar dispositivos.'}\\r\\n            try:\\r\\n                # PortAudio on Windows retains the device inventory until reinitialized.\\r\\n                if refresh:\\r\\n                    sd._terminate()\\r\\n                    sd._initialize()\\r\\n                    self._restore_audio_selection()\\r\\n                hosts = sd.query_hostapis()\\r\\n                devices = [dict(id=i, name=d['name'], host=hosts[d['hostapi']]['name'],\\r\\n                                input=d['max_input_channels']>0, output=d['max_output_channels']>0)\\r\\n                           for i,d in enumerate(sd.query_devices())]\\r\\n                # Windows exposes the same endpoint via MME, DirectSound and WASAPI.\\r\\n                # Prefer the active WASAPI inventory, avoiding duplicate/legacy entries.\\r\\n                wasapi=[d for d in devices if d['host']=='Windows WASAPI']\\r\\n                if wasapi:\\r\\n                    devices=wasapi\\r\\n                selected=list(sd.default.device)\\r\\n                for direction in range(2):\\r\\n                    kind='input' if direction==0 else 'output'\\r\\n                    if not any(d['id']==selected[direction] for d in devices):\\r\\n                        host=next((h for h in hosts if h['name']=='Windows WASAPI'),None)\\r\\n                        selected[direction]=host['default_'+kind+'_device'] if host else selected[direction]\\r\\n                return dict(ok=True, devices=devices, selected=selected)\\r\\n            except Exception as exc:\\r\\n                return {'ok': False, 'error': str(exc)}\\r\\n\\r\\n    def _restore_audio_selection(self):\\r\\n        devices=sd.query_devices(); hosts=sd.query_hostapis()\\r\\n        try:\\r\\n            cancion = cargar_cancion(song_id)\\r\\n            eliminar_toma(cancion, take_id)\\r\\n            with self._lock:\\r\\n                self._estado = self._estado_inicial()\\r\\n            return {\\\"ok\\\": True, \\\"takes\\\": self.get_takes(song_id)}\\r\\n        except Exception as exc:\\r\\n            with self._lock:\\r\\n                self._estado = {\\r\\n                    **self._estado_inicial(),\\r\\n                    \\\"status\\\": \\\"error\\\",\\r\\n                    \\\"error\\\": str(exc),\\r\\n                }\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": str(exc)}\\r\\n\\r\\n    def select_audio_file(self):\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Hay una tarea de audio en curso.\\\"}\\r\\n\\r\\n        ruta_audio = self._seleccionar_audio()\\r\\n        if not ruta_audio:\\r\\n            return {\\\"ok\\\": False, \\\"cancelled\\\": True}\\r\\n\\r\\n        ruta = Path(ruta_audio)\\r\\n        return {\\r\\n            \\\"ok\\\": True,\\r\\n            \\\"path\\\": str(ruta),\\r\\n            \\\"filename\\\": ruta.name,\\r\\n            \\\"suggested_title\\\": ruta.stem.replace(\\\"_\\\", \\\" \\\").replace(\\\"-\\\", \\\" \\\").strip(),\\r\\n        }\\r\\n\\r\\n    def add_song_from_file(self, audio_path, title, artist=\\\"\\\"):\\r\\n        title = str(title or \\\"\\\").strip()\\r\\n        artist = str(artist or \\\"\\\").strip()\\r\\n        audio_path = str(audio_path or \\\"\\\").strip()\\r\\n        if not title:\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": \\\"Ingresa un titulo para la cancion.\\\"}\\r\\n        if not audio_path:\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": \\\"Selecciona un archivo de audio.\\\"}\\r\\n        if not Path(audio_path).exists():\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": \\\"El archivo seleccionado ya no esta disponible.\\\"}\\r\\n\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Hay una tarea de audio en curso.\\\"}\\r\\n            self._estado = {\\r\\n                **self._estado_inicial(),\\r\\n                \\\"status\\\": \\\"adding\\\",\\r\\n            }\\r\\n\\r\\n        try:\\r\\n            cancion = agregar_cancion(audio_path, title, artist, progreso_callback=self._progreso_preparacion)\\r\\n            song_ui = self._cancion_para_ui(cancion)\\r\\n            with self._lock:\\r\\n                self._estado = self._estado_inicial()\\r\\n            return {\\\"ok\\\": True, \\\"song\\\": song_ui}\\r\\n        except Exception as exc:\\r\\n            with self._lock:\\r\\n                self._estado = {\\r\\n                    **self._estado_inicial(),\\r\\n                    \\\"status\\\": \\\"error\\\",\\r\\n                    \\\"error\\\": str(exc),\\r\\n                }\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": str(exc)}\\r\\n\\r\\n\\r\\n    def delete_song(self, song_id):\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Hay una tarea de audio en curso.\\\"}\\r\\n            self._estado = {\\r\\n                **self._estado_inicial(),\\r\\n                \\\"status\\\": \\\"deleting\\\",\\r\\n                \\\"song_id\\\": song_id,\\r\\n            }\\r\\n\\r\\n        try:\\r\\n            eliminar_cancion(song_id)\\r\\n            with self._lock:\\r\\n                self._estado = self._estado_inicial()\\r\\n            return {\\\"ok\\\": True, \\\"songs\\\": self.get_songs()}\\r\\n        except Exception as exc:\\r\\n            with self._lock:\\r\\n                self._estado = {\\r\\n                    **self._estado_inicial(),\\r\\n                    \\\"status\\\": \\\"error\\\",\\r\\n                    \\\"error\\\": str(exc),\\r\\n                }\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": str(exc)}\\r\\n\\r\\n    def edit_song(self, song_id, title, artist=\\\"\\\"):\\r\\n        title = str(title or \\\"\\\").strip()\\r\\n        artist = str(artist or \\\"\\\").strip()\\r\\n        if not title:\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": \\\"Ingresa un titulo para la cancion.\\\"}\\r\\n\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Hay una tarea de audio en curso.\\\"}\\r\\n            self._estado = {\\r\\n                **self._estado_inicial(),\\r\\n                \\\"status\\\": \\\"editing\\\",\\r\\n                \\\"song_id\\\": song_id,\\r\\n            }\\r\\n\\r\\n        try:\\r\\n            cancion = editar_cancion(song_id, title, artist)\\r\\n            song_ui = self._cancion_para_ui(cancion)\\r\\n            with self._lock:\\r\\n                self._estado = self._estado_inicial()\\r\\n            return {\\\"ok\\\": True, \\\"song\\\": song_ui, \\\"songs\\\": self.get_songs()}\\r\\n        except Exception as exc:\\r\\n            with self._lock:\\r\\n                self._estado = {\\r\\n                    **self._estado_inicial(),\\r\\n                    \\\"status\\\": \\\"error\\\",\\r\\n                    \\\"error\\\": str(exc),\\r\\n                }\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": str(exc)}\\r\\n\\r\\n    def reprocess_song(self, song_id):\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Hay una tarea de audio en curso.\\\"}\\r\\n            self._estado = {\\r\\n                **self._estado_inicial(),\\r\\n                \\\"status\\\": \\\"reprocessing\\\",\\r\\n                \\\"song_id\\\": song_id,\\r\\n            }\\r\\n\\r\\n        try:\\r\\n            cancion = regenerar_pitch_referencia(song_id, progreso_callback=self._progreso_preparacion)\\r\\n            song_ui = self._cancion_para_ui(cancion)\\r\\n            with self._lock:\\r\\n                self._estado = self._estado_inicial()\\r\\n            return {\\\"ok\\\": True, \\\"song\\\": song_ui}\\r\\n        except Exception as exc:\\r\\n            with self._lock:\\r\\n                self._estado = {\\r\\n                    **self._estado_inicial(),\\r\\n                    \\\"status\\\": \\\"error\\\",\\r\\n                    \\\"error\\\": str(exc),\\r\\n                }\\r\\n            return {\\\"ok\\\": False, \\\"error\\\": str(exc)}\\r\\n\\r\\n    def start_session(self, song_id):\\r\\n        with self._lock:\\r\\n            if self._tarea_en_curso():\\r\\n                return {\\\"ok\\\": False, \\\"error\\\": \\\"Ya hay una tarea de audio en curso.\\\"}\\r\\nui_live/index.html:253:  <section id=\\\"preparationProgress\\\" class=\\\"preparation-progress hidden\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">\\r\\nui_live/index.html:254:    <strong id=\\\"preparationMessage\\\">Preparando canción…</strong>\\r\\nui_live/index.html:256:    <span id=\\\"preparationElapsed\\\">La separación puede tardar varios minutos.</span>\\r\\nui_live/index.html:371:  <div class=\\\"modal-backdrop hidden\\\" id=\\\"songModal\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-labelledby=\\\"songModalTitle\\\">\\r\\nui_live/index.html:372:    <form class=\\\"song-modal\\\" id=\\\"songModalForm\\\">\\r\\nui_live/index.html:373:      <div class=\\\"modal-head\\\">\\r\\nui_live/index.html:378:        <button class=\\\"button modal-close\\\" id=\\\"songModalCancelX\\\" type=\\\"button\\\" aria-label=\\\"Cerrar\\\">×</button>\\r\\nui_live/index.html:384:      <label class=\\\"modal-field\\\" for=\\\"songTitleInput\\\">\\r\\nui_live/index.html:388:      <label class=\\\"modal-field\\\" for=\\\"songArtistInput\\\">\\r\\nui_live/index.html:392:      <p class=\\