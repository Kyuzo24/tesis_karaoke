  info.append(title, meta);\n        const button = document.createElement('button');button.type = 'button';button.className = 'button';button.textContent = 'Seleccionar';\n        button.onclick = () => close({ok:true,video_id:item.id,filename:item.title,\n          suggested_title:item.title,suggested_artist:''});\n        row.append(info,button);results.append(row);\n      });\n    } catch (error) {\n      if (finish && request === generation) status.textContent = error.message || String(error);\n    } finally {\n      if (request === generation) submit.disabled = false;\n    }\n  };\n  window.chooseSongSource = async () => {\n    const selected = await new Promise(resolve => {\n      finish = resolve;generation++;submit.disabled = false;\n      status.textContent = '';results.replaceChildren();query.value = '';\n      dialog.showModal();query.focus();\n    });\n    return selected.local ? window.pywebview.api.select_audio_file() : selected;\n  };\n})();\n"},"C:\\Users\\Diego Tapia\\Desktop\\Pene\\U\\Tesis\\tesis_karaoke\\audio\\catalogo.py":{"type":"update","unified_diff":"@@ -99,3 +99,3 @@\n \n-def agregar_cancion(ruta_audio, titulo, artista=\"\", forzar=False, progreso_callback=None):\n+def agregar_cancion(ruta_audio, titulo, artista=\"\", forzar=False, progreso_callback=None, fuente=None):\n     asegurar_directorios()\n@@ -120,2 +120,4 @@\n     }\n+    if fuente:\n+        metadata['fuente'] = dict(fuente)\n     guardar_metadata(metadata)\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nA ui_live/youtube.js\nM audio/catalogo.py\nM desktop_live.py\nM ui_live/app.js\nM ui_live/index.html\n","stderr":""},"started_at_ms":1793672978207,"completed_at_ms":1793672978217}}
