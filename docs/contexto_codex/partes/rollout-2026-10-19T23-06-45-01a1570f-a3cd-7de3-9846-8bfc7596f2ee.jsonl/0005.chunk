\\": \\\"gr51aVj-mLg\\\", \\\"title\\\": \\\"Youtube-dl Annotation Test\\\", \\\"channel\\\": \\\"Jaiz000\\\", \\\"duration\\\": 11, \\\"url\\\": \\\"https://www.youtube.com/watch?v=gr51aVj-mLg\\\"}, {\\\"id\\\": \\\"Qw4-0GfcFYA\\\", \\\"title\\\": \\\"Drive Test #1: Pre-test\\\", \\\"channel\\\": \\\"Washington State Department of Licensing\\\", \\\"duration\\\": 176, \\\"url\\\": \\\"https://www.youtube.com/watch?v=Qw4-0GfcFYA\\\"}, {\\\"id\\\": \\\"l7afy7SGZxE\\\", \\\"title\\\": \\\"The biggest fails from Driving Test | Driving Test 2020\\\", \\\"channel\\\": \\\"Channel 9\\\", \\\"duration\\\": 640, \\\"url\\\": \\\"https://www.youtube.com/watch?v=l7afy7SGZxE\\\"}]\\r\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"5f197f\",\"wall_time_seconds\":1.1733911,\"exit_code\":0,\"original_token_count\":35,\"output\":\"...\\r\\n----------------------------------------------------------------------\\r\\nRan 3 tests in 0.003s\\r\\n\\r\\nOK\\r\\nSeparando audio con Demucs...\\r\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793673002.2438028}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
