ed","r2":"C:/Users/Diego Tapia/.codex/plugins/cache/openai-curated-remote","r3":"C:/Users/Diego Tapia/.codex/plugins/cache/openai-curated-remote/sites/1.1.2/skills","r4":"C:/Users/Diego Tapia/.codex/plugins/cache/openai-curated-remote/work-pets/0.1.6/skills","r5":"C:/Users/Diego Tapia/.codex/plugins/cache/openai-primary-runtime","r6":"C:/Users/Diego Tapia/.codex/plugins/cache/openai-primary-runtime/spreadsheets/26.1026.10807/skills"},"usage":{"tokens":1680,"characters":6689},"instructionsSent":true,"omitDescriptions":false},"managed_developer_instructions":{},"model":{"model":"gpt-6-astra","instructions":"8ec084575b01d7693b0e8ae48c16d60b8e9fc22d"},"model_catalog":"ea1a55de2973a50e2e404222c5499c24df5591ed","multi_agent_mode":{"mode":"explicitRequestOnly","usage_hint_hash":"288fbaaba4ce0b63e4443b2df37dce92bfe45839"},"multi_agent_usage_hint":"288fbaaba4ce0b63e4443b2df37dce92bfe45839","permissions":{"instructions":"32ca25d6d85edaeb6f1e19b2a5cc4e08d2a631cd","approved_command_prefixes":[]},"persistent_mode":{},"plugins_instructions":false,"realtime":{"active":false},"skills":{"version":1,"entries":{},"roots":{},"usage":{"tokens":0,"characters":0},"instructionsSent":false,"omitDescriptions":false},"tools":{"mcp__artifact_session":"Use this first-party JavaScript tool for persistent spreadsheet and presentation authoring and editing an existing bound canvas. The global artifactSession client edits the same CRDT state shown in the live viewer. For spreadsheets, call artifactS...","mcp__codex_app":"Manage the Codex desktop app: find, create, and update chats; organize projects, sidebar, and pinned items; schedule automations; manage worktrees; open app panels; and locate bundled libraries for documents, spreadsheets, slides, and PDFs.","mcp__codex_apps__codex_document_control":"Use Codex Document Control to find connected document sessions, inspect the tools supported by a selected session, and execute one supported tool against that session. Call `list_document_sessions` first to choose the intended connected session, c...","mcp__codex_apps__hotline":"Look up local helpline information for the user based on country inferred from the conversation. You must use this tool before providing a suicide or self-harm helpline; do not use web search or guess.","mcp__codex_apps__pets":"Create and manage the user's animated companion pets inside ChatGPT Work mode. Use only for ChatGPT Pets, not real-world animal advice, generic pet images, or pets in other apps.","mcp__codex_apps__plugin_management":"Manage plugins, settings, permissions, and connections. Prefer available built-in tools or connected plugins when they fit the task. Proactively search for plugins when an external app, account, or service would materially help, even if the user d...","mcp__codex_apps__safety_settings":"For ChatGPT Parental Controls (your child or teen's settings, features, Study Mode, quiet hours, family setup) and Trusted Contact (setup, status, privacy). Read account state first. Before updates, read the child's controls; prepare only can_upda...","mcp__codex_apps__search_service":"Tool for accessing the internet.","mcp__codex_apps__sites":"Use Sites to build or modify websites, including landing pages, portfolios, dashboards, portals, trackers, hubs, and internal tools. For repository-based sites, use Sites skills for local implementation, source preparation, and artifact packaging....","mcp__node_repl":"Use `js` for `node_repl` execution with persistent, redeclarable top-level bindings, `js_reset` to clear bindings, and `js_add_node_module_dir` to add package directories."},"top_level_tools":{"clock":"056c51947a5ff3696d9903c0056dda49a7b4a700","clock.sleep":"d950878350d3930efdf6960ff2a2209affa5961f","collaboration":"1a57bec22b804d9b7cd49b48ad24adfd4a1feea1","collaboration.followup_task":"8af28fd0b803a052209ece91fc9f67d124318928","collaboration.interrupt_agent":"2267464134322564b477c2071a43759fd536efa3","collaboration.list_agents":"d987d2a1e82acbbae7443d42e8f2d9519