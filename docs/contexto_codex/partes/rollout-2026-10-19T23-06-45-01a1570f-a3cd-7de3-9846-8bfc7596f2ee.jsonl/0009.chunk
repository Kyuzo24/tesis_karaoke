a_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672815.7558577,"content_item_kinds":["unknown"]},"guardian_metadata":{"client_authored":false,"user_input_order":52}},{"type":"custom_tool_call","id":"ctc_077583884d8d8ef9016ae9467248548191b9720903c3b77ae8","status":"completed","call_id":"call_20386dc3865f48ddbc60b7c32c51432c","name":"exec","input":"text(await tools.exec_command({cmd:\"Get-Content desktop_live.py | Select-Object -Skip 125 -First 18; Get-Content desktop_live.py | Select-Object -Skip 710 -First 22; Get-Content ui_live/app.js | Select-Object -Skip 1955 -First 80; rg -n 'preparationUI|preparation_status' ui_live/*.js desktop_live.py; $env:PYTHONPATH=\\\"$PWD\\\\venv\\\\Lib\\\\site-packages\\\"; py -3.10 -c \\\"import importlib.util; print('imageio_ffmpeg',bool(importlib.util.find_spec('imageio_ffmpeg'))); import sys; print(sys.executable)\\\"; Get-ChildItem venv/Scripts -Name | Select-Object -First 12\",\"max_output_tokens\":2200}));\ntext(await tools.web__run({find:[{ref_id:\"https://github.com/yt-dlp/yt-dlp\",pattern:\"js_runtimes\"},{ref_id:\"https://github.com/yt-dlp/yt-dlp\",pattern:\"yt-dlp-ejs\"}],response_length:\"short\"}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672818.2852786}},{"type":"custom_tool_call_output","id":"ctco_01a19f3b-42b4-75b2-809b-3d038cff7a9a","call_id":"call_20386dc3865f48ddbc60b7c32c51432c","output":[{"type":"input_text","text":"Script completed\nWall time 2.5 seconds\nOutput:\n"},{"type":"input_text","text":"{\"chunk_id\":\"62a1d9\",\"wall_time_seconds\":0.5122698,\"exit_code\":0,\"original_token_count\":1237,\"output\":\"            guardar_ajuste(toma['voice_path'], milliseconds, modo=mode)\\r\\n            return {'ok': True}\\r\\n        except (ValueError, TypeError):\\r\\n            return {'ok': False, 'error': 'Introduce un desfase entre −2000 y 2000 ms.'}\\r\\n        except Exception:\\r\\n            return {'ok': False, 'error': 'No se pudo guardar el desfase.'}\\r\\n    def _progreso_preparacion(self, mensaje):\\r\\n        with self._lock:\\r\\n            self._estado['preparation_message'] = mensaje\\r\\n\\r\\n    def get_preparation_state(self):\\r\\n        with self._lock:\\r\\n            message = self._estado.get('preparation_message', 'Preparando canción…')\\r\\n            match = re.search(r': (\\\\d+)%', message)\\r\\n            return {'status': self._estado['status'], 'message': message,\\r\\n                    'percent': int(match[1]) if match else None}\\r\\n\\r\\n    def get_feedback(self, song_id, take_id):\\r\\n            \\\"preview_ref\\\": self._reducir_puntos(puntos_ref, max_puntos=80),\\r\\n            \\\"preview_user\\\": self._reducir_puntos(puntos_user, max_puntos=80),\\r\\n        }\\r\\n\\r\\n    def _tarea_en_curso(self):\\r\\n        return self._estado[\\\"status\\\"] in [\\r\\n            \\\"adding\\\",\\r\\n            \\\"deleting\\\",\\r\\n            \\\"calibrating\\\",\\r\\n            \\\"preparing\\\",\\r\\n            \\\"recording\\\",\\r\\n            \\\"stopping\\\",\\r\\n            \\\"comparing\\\",\\r\\n            \\\"reprocessing\\\",\\r\\n            \\\"editing\\\",\\r\\n        ]\\r\\n\\r\\n    def _seleccionar_audio(self):\\r\\n        if not webview.windows:\\r\\n            return \\\"\\\"\\r\\n\\r\\n        rutas = webview.windows[0].create_file_dialog(\\r\\nfunction updateMixerButtons() {\\r\\n  els.voiceMuteButton.classList.toggle(\\\"is-muted\\\", state.voiceMuted);\\r\\n  els.trackMuteButton.classList.toggle(\\\"is-muted\\\", state.trackMuted);\\r\\n  els.voiceMuteButton.textContent = state.voiceMuted ? \\\"Voz mute\\\" : \\\"Voz\\\";\\r\\n  els.trackMuteButton.textContent = state.trackMuted ? \\\"Pista mute\\\" : \\\"Pista\\\";\\r\\n  els.syncOffsetLabel.textContent = `${state.syncOffsetMs} ms`;\\r\\n}\\r\\n\\r\\nfunction updateTakeTimeLabel() {\\r\\n  const take = selectedTake();\\r\\n  const duration = take?.duration || 0;\\r\\n  els.takeTimeLabel.textContent = `${formatTime(state.current)} / ${formatTime(duration)}`;\\r\\n}\\r\\n\\r\\nfunction openSongMetadataModal(fileInfo) {\\r\\n  return new Promise((resolve) => {\\r\\n    let settled = false;\\r\\n    const fallbackTitle = \\\"Nueva canción\\\";\\r\\n    const suggestedTitle = String(fileInfo?.suggestedTitle || fileInfo?.suggested_title || \\\"\\\").trim();\\r\\n\\r\\n    els.songModalEyebrow.textContent = \\\"Biblioteca\\\";\\r\\n    els.songModalTitle.textContent = \\\"Agregar canción\\\";\\r\\n    els.songModalFileName.textContent = fileInfo?.filename || \\\"Audio seleccionado\\\";\\r\\n    els.songTitleInput.value = suggestedTitle || fallbackTitle;\\r\\n    els.songArtistInput.value = \\\"\\\";\\r\\n    els.songModalSubmit.textContent = \\\"Agregar\\\";\\r\\n    els.songModalError.textContent = \\\"\\\";\\r\\n    els.songModal.classList.remove(\\\"hidden\\\");\\r\\n    document.body.classList.add(\\\"modal-open\\\");\\r\\n\\r\\n    const cleanup = () => {\\r\\n      els.songModalForm.removeEventListener(\\\"submit\\\", handleSubmit);\\r\\n      els.songModalCancel.removeEventListener(\\\"click\\\", handleCancel);\\r\\n      els.songModalCancelX.removeEventListener(\\\"click\\\", handleCancel);\\r\\n      els.songModal.removeEventListener(\\\"mousedown\\\", handleBackdrop);\\r\\n      window.removeEventListener(\\\"keydown\\\", handleKeydown);\\r\\n    };\\r\\n\\r\\n    const close = (value) => {\\r\\n      if (settled) return;\\r\\n      settled = true;\\r\\n      cleanup();\\r\\n      els.songModal.classList.add(\\\"hidden\\\");\\r\\n      document.body.classList.remove(\\\"modal-open\\\");\\r\\n      resolve(value);\\r\\n    };\\r\\n\\r\\n    function handleSubmit(event) {\\r\\n      event.preventDefault();\\r\\n      const title = els.songTitleInput.value.trim();\\r\\n      if (!title) {\\r\\n        els.songModalError.textContent = \\\"Ingresa un título para agregar la canción.\\\";\\r\\n        els.songTitleInput.focus();\\r\\n        return;\\r\\n      }\\r\\n\\r\\n      close({\\r\\n        title,\\r\\n        artist: els.songArtistInput.value.trim()\\r\\n      });\\r\\n    }\\r\\n\\r\\n    function handleCancel() {\\r\\n      close(null);\\r\\n    }\\r\\n\\r\\n    function handleBackdrop(event) {\\r\\n      if (event.target === els.songModal) close(null);\\r\\n    }\\r\\n\\r\\n    function handleKeydown(event) {\\r\\n      if (event.key === \\\"Escape\\\") close(null);\\r\\n    }\\r\\n\\r\\n    els.songModalForm.addEventListener(\\\"submit\\\", handleSubmit);\\r\\n    els.songModalCancel.addEventListener(\\\"click\\\", handleCancel);\\r\\n    els.songModalCancelX.addEventListener(\\\"click\\\", handleCancel);\\r\\n    els.songModal.addEventListener(\\\"mousedown\\\", handleBackdrop);\\r\\n    window.addEventListener(\\\"keydown\\\", handleKeydown);\\r\\n    window.setTimeout(() => els.songTitleInput.focus(), 0);\\r\\nrg: ui_live/*.js: El nombre de archivo, el nombre de directorio o la sintaxis de la etiqueta del volumen no son correctos. (os error 123)\\nimageio_ffmpeg False\\r\\nC:\\\\Users\\\\Diego Tapia\\\\AppData\\\\Local\\\\Programs\\\\Python\\\\Python310\\\\python.exe\\r\\nactivate\\r\\nactivate.bat\\r\\nActivate.ps1\\r\\nconvert-caffe2-to-onnx.exe\\r\\nconvert-onnx-to-caffe2.exe\\r\\ndeactivate.bat\\r\\ndemucs.exe\\r\\ndora.exe\\r\\ndtw.exe\\r\\nestimator_ckpt_converter.exe\\r\\nf2py.exe\\r\\nfonttools.exe\\r\\n\"}"},{"type":"input_text","text":"GitHub - yt-dlp/yt-dlp: A feature-rich command-line audio/video downloader · GitHub (https://github.com/yt-dlp/yt-dlp)\nciteturn4view0 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"https://github.com/yt-dlp/yt-dlp\",\"pattern\":\"js_runtimes\"}); Total lines: 2556\nNo matching text found for \"js_runtimes\"--------------------------------------------------------------------------------\nGitHub - yt-dlp/yt-dlp: A feature-rich command-line audio/video downloader · GitHub (https://github.com/yt-dlp/yt-dlp)\nciteturn4view1 [wordlim: 200] Crawled: today; Content type: text/html; Source: find({\"ref_id\":\"https://github.com/yt-dlp/yt-dlp\",\"pattern\":\"yt-dlp-ejs\"}); Total lines: 2556\nL303: The public key that can be used to verify the GPG signatures is 【93†available here】 Example usage:\nL304: \nL309: #### Licensing\nL310: \nL311: While yt-dlp is licensed under the 【88†Unlicense】, many of the release files contain code from other projects with different licenses.\nL312: \nL313: Most notably, the PyInstaller-bundled executables include GPLv3+ licensed code, and as such the combined work is licensed under 【177†GPLv3+†www.gnu.org】.\nL314: \nL315: The zipimport Unix executable (`yt-dlp`) and release tarball (`yt-dlp.tar.gz`) contain 【178†ISC】 licensed code from 【179†`meriyah`】 and 【180†MIT】 licensed code from 【181†`astring`】.\nL321: ## UPDATE\nL322: \nL323: You can use `yt-dlp -U` to update if you are using the 【104†release binaries】\nL324: \nL325: If you 【182†installed with pip】, simply re-run the same command that was used to install the program\nL326: \nL327: For other third-party package managers, see 【183†the wiki】 or refer to their documentation\nL328: \nL329: There are currently three release channels for binaries: `stable`, `nightly` and `master`.\nL330:   * `stable` is the default channel, which offers releases published on a (mostly) monthly schedule. While it is named `stable` due to many of its changes having been tested by users of the `nightly` or `master` release channels, the latest `stable` release is often \"stale\" and prone to external breakage (i.e. sites changing things on their end and breaking yt-dlp).\nL331:   * The `nightly` channel offers releases that publish shortly before midnight UTC on any day that sees changes to the codebase. This channel serves as a snapshot of the project's development, and it is the recommended channel for regular users of yt-dlp. The `nightly` releases are available from 【184†yt-dlp/yt-dlp-nightly-builds】 or as development releases of the `yt-dlp` PyPI package (which can be installed with pip's `--pre` flag).\nL332:   * The `master` channel offers \"canary\" releases that publish after each push to the master branch. This channel will always provide the very latest fixes and features, but may be prone to bugs or regressions. The `master` releases are available from 【185†yt-dlp/yt-dlp-master-builds】.\nL333: When using `--update`/`-U`, a release binary will only update to its current channel. `--update-to CHANNEL` can be used to switch to a different channel when a newer version is available. `--update-to [CHANNEL@]TAG` can also be used to upgrade or downgrade to specific tags from a channel.\nL334: You may also use `--update-to <repository>` (`<owner>/<repository>`) to update to a channel on a completely different repository. Be careful with what repository you are updating to though, there is no verification done for binaries from different repositories.\nL335: \nL336: Example usage:\nL337:   * `yt-dlp --update-to master` switch to the `master` channel and update to its latest release\nL338:   * `yt-dlp --update-to stable@2023.07.06` upgrade/downgrade to release to `stable` channel tag `2023.07.06`\nL339:   * `yt-dlp --update-to 2023.10.07` upgrade/downgrade to tag `2023.10.07` if it exists on the current channel\nL340:   * `yt-dlp --update-to example/yt-dlp@2023.09.24` upgrade/downgrade to the release from the `example/yt-dlp` repository, tag `2023.09.24`\nL341: Important: Any user experiencing an issue with the `stable` release should install or update to the `nightly` release before submitting a bug report:\nL342: \nL343:     `# To update to nightly from stable executable/binary:\nL344:     yt-dlp --update-to nightly\nL345: \nL346:     # To install nightly with pip:\nL347:     python -m pip install -U --pre \"yt-dlp[default]\"\nL348:     `\nL349: When running a yt-dlp version that is older than 90 days, you will see a warning message suggesting to update to the latest version. You can suppress this warning by adding `--no-update` to your command or configuration file.\nL350: ## DEPENDENCIES\nL351: \nL352: Python versions 3.11+ (CPython and PyPy) are supported. Other versions and implementations may or may not work correctly.\nL353: \nL354: While all the other dependencies are optional, `ffmpeg`, `ffprobe`, `yt-dlp-ejs` and a supported JavaScript runtime/engine are highly recommended\nL355: ### Strongly recommended\nL356: \nL357:   * 【186†ffmpeg and ffprobe†www.ffmpeg.org】 - Required for 【132†merging separate video and audio files】, as well as for various 【122†post-processing】 tasks. License 【187†depends on the build†www.ffmpeg.org】\nL358: Since ffmpeg is such an important dependency, we provide our own builds at 【188†yt-dlp/FFmpeg-Builds】. In the past, patches were applied to these builds in order to fix common issues for yt-dlp users, but currently our builds are equivalent to upstream ffmpeg. See 【189†the readme】 for details\nL359: \nL360: Important: What you need is ffmpeg binary, NOT 【190†the Python package of the same name†pypi.org】\nL361:   * 【191†yt-dlp-ejs】 - Required for full YouTube support. Licensed under 【192†Unlicense】, bundles 【180†MIT】 and 【178†ISC】 components.\nL362: \nL363: A JavaScript runtime/engine like 【193†deno†deno.land】 (recommended), 【194†node.js†nodejs.org】, 【195†bun†bun.sh】, or 【196†QuickJS†bellard.org】 is also required to run yt-dlp-ejs. See 【197†the wiki】.\nL364: ### Networking\nL365: \nL366:   * 【198†certifi】* - Provides Mozilla's root certificate bundle. Licensed under 【199†MPLv2】\nL367:   * 【200†brotli】* or 【201†brotlicffi】 - 【202†Brotli†en.wikipedia.org】 content encoding support. Both licensed under MIT ^{【203†1】 【204†2】 }\nL368:   * 【205†websockets】* - For downloading over websocket. Licensed under 【206†BSD-3-Clause】\nL369:   * 【207†requests】* - HTTP library. For HTTPS proxy and persistent connections support. Licensed under 【208†Apache-2.0】\nL373:   * 【209†curl_cffi】 (recommended) - Python binding for 【210†curl-impersonate】. Provides impersonation targets for Chrome, Edge and Safari. Licensed under 【211†MIT】\nL374:     * Can be installed with the `curl-cffi` extra, e.g. `pip install \"yt-dlp[default,curl-cffi]\"`\nL375:     * Currently included in most builds except `yt-dlp` (Unix zipimport binary) and `yt-dlp_x86` (Windows 32-bit)\nL1339:      * `${XDG_CONFIG_HOME}/yt-dlp.conf`\nL1340:      * `${XDG_CONFIG_HOME}/yt-dlp/config` (recommended on Linux/macOS)\nL1341:      * `${XDG_CONFIG_HOME}/yt-dlp/config.txt`\nL1342:      * `${APPDATA}/yt-dlp.conf`\nL1343:      * `${APPDATA}/yt-dlp/config` (recommended on Windows)\nL1344:      * `${APPDATA}/yt-dlp/config.txt`\nL1345:      * `~/yt-dlp.conf`\nL1346:      * `~/yt-dlp.conf.txt`\nL1347:      * `~/.yt-dlp/config`\nL1348:      * `~/.yt-dlp/config.txt`\nL1349: \nL1350: See also: 【129†Notes about environment variables】\nL1351: \nL1352:   5. System Configuration:\nL1356: E.g. with the following configuration file, yt-dlp will always extract the audio, copy the mtime, use a proxy and save all videos under `YouTube` directory in your home directory:\nL1357: \nL1358:     `# Lines starting with # are comments\nL1359: \nL1360:     # Always extract audio\nL1361:     -x\nL1362: \nL1363:     # Copy the mtime\nL1364:     --mtime\nL1365: \nL1366:     # Use this proxy\nL1367:     --proxy 127.0.0.1:3128\nL1368: \nL1369:     # Save all videos under YouTube directory in your home directory\nL1370:     -o ~/YouTube/%(title)s.%(ext)s\nL1371:     `\nL1604:     $ yt-dlp -P \"C:/MyVideos\" -o \"%(series)s/%(season_number)s - %(season)s/%(episode_number)s - %(episode)s.%(ext)s\" \"https://videomore.ru/kino_v_detalayah/5_sezon/367617\"\nL1605: \nL1606:     # Download video as \"C:\\MyVideos\\uploader\\title.ext\", subtitles as \"C:\\MyVideos\\subs\\uploader\\title.ext\"\nL1607:     # and put all temporary files in \"C:\\MyVideos\\tmp\"\nL1608:     $ yt-dlp -P \"C:/MyVideos\" -P \"temp:tmp\" -P \"subtitle:subs\" -o \"%(uploader)s/%(title)s.%(ext)s\" YE7VzlLtp-4 --write-subs\nL1782:     # Resolution is determined by using the smallest dimension.\nL1783:     # So this works correctly for vertical videos as well\nL1784:     $ yt-dlp -S \"res:480\"\nL1785: \nL1786: \nL1787: \nL1788:     # Download the best video (that also has audio) but no bigger than 50 MB,\nL1789:     # or the worst video (that also has audio) if there is no video under 50 MB\nL1790:     $ yt-dlp -f \"b[filesize<50M] / w\"\nL1791: \nL1792:     # Download the largest video (that also has audio) but no bigger than 50 MB,\nL1793:     # or the smallest video (that also has audio) if there is no video under 50 MB\nL1794:     $ yt-dlp -f \"b\" -S \"filesize:50M\"\nL1795: \nL1796:     # Download the best video (that also has audio) that is closest in size to 50 MB\nL1797:     $ yt-dlp -f \"b\" -S \"filesize~50M\"\nL1798: \nL1799: \nL1800: \nL1801:     # Download best video available via direct link over HTTP/HTTPS protocol,\nL1802:     # or the best video available via any protocol if there is no such video\nL1803:     $ yt-dlp -f \"(bv*+ba/b)[protocol^=http][protocol!*=dash] / (bv*+ba/b)\"\nL1804:     # Download best video available via the best protocol\nL1805:     # (https/ftps > http/ftp > m3u8_native > m3u8 > http_dash_segments ...)\nL1806:     $ yt-dlp -S \"proto\"\nL1807: \nL1808: \nL1809: \nL1810:     # Download the best video with either h264 or h265 codec,\nL1811:     # or the best video if there is no such video\nL1812:     $ yt-dlp -f \"(bv*[vcodec~='^((he|a)vc|h26[45])']+ba) / (bv*+ba/b)\"\nL1813: \nL1814:     # Download the best video with best codec no better than h264,\nL1815:     # or the best video with worst codec if there is no such video\nL1816:     $ yt-dlp -S \"codec:h264\"\nL1817: \nL1818:     # Download the best video with worst codec no worse than h264,\nL1819:     # or the best video with best codec if there is no such video\nL1820:     $ yt-dlp -S \"+codec:h264\"\nL1821: \nL1822: \nL1823: \nL1824:     # More complex examples\nL1825: \nL1826:     # Download the best video no better than 720p preferring framerate greater than 30,\nL1827:     # or the worst video (still preferring framerate greater than 30) if there is no such video\nL1828:     $ yt-dlp -f \"((bv*[fps>30]/bv*)[height<=720]/(wv*[fps>30]/wv*)) + ba / (b[fps>30]/b)[height<=720]/(w[fps>30]/w)\"\nL1829: \nL1830:     # Download the video with the largest resolution no better than 720p,\nL1831:     # or the video with the smallest resolution available if there is no such video,\nL1832:     # preferring larger framerate for formats with the same resolution\nL1833:     $ yt-dlp -S \"res:720,fps\"\nL1834: \nL1835: \nL1836: \nL1837:     # Download the video with smallest resolution no worse than 480p,\nL2093:      * Plugin packages can be installed and managed using `pip`. See 【253†yt-dlp-sample-plugins】 for an example.\nL2094:        * Note: plugin files between plugin packages installed with pip must have unique filenames.\nL2095:      * Any path in `PYTHONPATH` is searched in for the `yt_dlp_plugins` namespace folder.\nL2096:        * Note: This does not apply for Pyinstaller builds.\nL2097: \nL2098: `.zip`, `.egg` and `.whl` archives containing a `yt_dlp_plugins` namespace folder in their root are also supported as plugin packages.\nL2099:   * e.g. `${XDG_CONFIG_HOME}/yt-dlp/plugins/mypluginpkg.zip` where `mypluginpkg.zip` contains `yt_dlp_plugins/<type>/myplugin.py`\nL2100: \nL2101: Run yt-dlp with `--verbose` to check if the plugin has been loaded.\nL2102: ## Developing Plugins\nL2103: \nL2104: See the 【253†yt-dlp-sample-plugins】 repo for a template plugin package and the 【254†Plugin Development】 section of the wiki for a plugin development guide.\nL2105: \nL2106: All public classes with a name ending in `IE`/`PP` are imported from each file for extractors and postprocessors respectively. This respects underscore prefix (e.g. `_MyBasePluginIE` is private) and `__all__`. Modules can similarly be excluded by prefixing the module name with an underscore (e.g. `_myplugin.py`).\nL2107: To replace an existing extractor with a subclass of one, set the `plugin_name` class keyword argument (e.g. `class MyPluginIE(ABuiltInIE, plugin_name='myplugin')` will replace `ABuiltInIE` with `MyPluginIE`). Since the extractor replaces the parent, you should exclude the subclass extractor from being imported separately by making it private using one of the methods described above.\nL2108: \nL2109: If you are a plugin author, add 【255†yt-dlp-plugins】 as a topic to your repository for discoverability.\nL2111: # EMBEDDING YT-DLP\nL2112: \nL2113: yt-dlp makes the best effort to be a good command-line program, and thus should be callable from any programming language.\nL2114: \nL2115: Your program should avoid parsing the normal stdout since they may change in future versions. Instead, they should use options such as `-J`, `--print`, `--progress-template`, `--exec` etc to create console output that you can reliably reproduce and parse.\nL2116: From a Python program, you can embed yt-dlp in a more powerful fashion, like this:\nL2117: \nL2118:     from yt_dlp import YoutubeDL\nL2119: \nL2120:     URLS = ['https://www.youtube.com/watch?v=YE7VzlLtp-4']\nL2121:     with YoutubeDL() as ydl:\nL2122:         ydl.download(URLS)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672823.4769366},"guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000}},{"type":"reasoning","id":"rs_077583884d8d8ef9016ae9467baf6c8191b9c1fb0ab7069676","summary":[{"type":"summary_text","text":"**Preparing yt-dlp setup**"}],"encrypted_content":"gAAAAABq6UaHlL3bc6xC6tUJz2uJOJHm6D9HtMMvI9S5EnY9R3D-zuT1RcMhbhJ2AcY1v0AZ7mG9ObF0TgyZz-vyZXZuUk5sINvQEkBcXUN6yhtE1Pt5lvF3e6XfRKYc3c-e9yAjMYepd6BGqLDJke8z6cd19H5ipGvTIoLs5T9zwBxDTcPAtKvLD4La_-gVOzS5DYkWOxPVGnliOEIRIe9lnkhYSGE5EZa2lp2mP_mhurENfiM3_Kmgp21TOsCubQ_9