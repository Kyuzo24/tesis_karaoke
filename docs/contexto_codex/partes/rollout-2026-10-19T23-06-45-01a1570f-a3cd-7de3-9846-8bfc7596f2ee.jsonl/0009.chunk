ared ? \\\"Lista\\\" : \\\"Sin procesar\\\"} / ${song.lyrics?.lines?.length ? \\\"Con letra\\\" : \\\"Sin letra\\\"}`;\\r\\nui_live/app.js:449:  els.libraryPracticeButton.disabled = !backendReady || state.catalogWorking || !song.prepared || !song.id;\\r\\nui_live/app.js:459:    prepared: Boolean(song.prepared),\\r\\nui_live/app.js:608:        <span>${song.prepared ? \\\"Lista\\\" : \\\"Sin procesar\\\"}</span>\\r\\nui_live/app.js:746:  els.referenceDiagnosticButton.disabled = !backendReady || state.playing || state.catalogWorking || state.diagnosticLoading || !song?.prepared;\\r\\nui_live/app.js:913:  els.startButton.disabled = !backendReady || state.catalogWorking || !song.prepared || !song.id;\\r\\nui_live/app.js:917:  setStatus(song.prepared ? \\\"Listo\\\" : \\\"Sin procesar\\\", false);\\r\\nui_live/app.js:923:  const busy = state.playing || state.catalogWorking;\\r\\nui_live/app.js:924:  els.addButton.disabled = !backendReady || busy;\\r\\nui_live/app.js:925:  els.libraryPracticeButton.disabled = !backendReady || busy || !song?.prepared || !song?.id;\\r\\nui_live/app.js:958:  return Boolean(song?.id && song?.prepared && hasReferenceForChart());\\r\\nui_live/app.js:1984:    document.body.classList.add(\\\"modal-open\\\");\\r\\nui_live/app.js:1999:      document.body.classList.remove(\\\"modal-open\\\");\\r\\nui_live/app.js:2057:    document.body.classList.add(\\\"modal-open\\\");\\r\\nui_live/app.js:2072:      document.body.classList.remove(\\\"modal-open\\\");\\r\\nui_live/app.js:2121:async function addSong() {\\r\\nui_live/app.js:2157:    window.preparationUI?.start();\\r\\nui_live/app.js:2175:    window.preparationUI?.stop();\\r\\nui_live/app.js:2245:    `Se eliminara \\\"${song.title}\\\" del catalogo, junto con sus archivos preparados y grabaciones.\\\\n\\\\nQuieres continuar?`\\r\\nui_live/app.js:2445:  window.preparationUI?.start();\\r\\nui_live/app.js:2466:    window.preparationUI?.stop();\\r\\nui_live/app.js:2467:    els.startButton.disabled = !backendReady || !currentSong()?.prepared;\\r\\nui_live/app.js:2529:  } else if (session.status === \\\"preparing\\\") {\\r\\nui_live/app.js:2622:  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\\r\\nui_live/app.js:2641:  els.startButton.disabled = !backendReady || !currentSong()?.prepared;\\r\\nui_live/app.js:2697:els.addButton.addEventListener(\\\"click\\\", addSong);\\r\\n@echo off\\r\\nsetlocal\\r\\ncd /d \\\"%~dp0\\\"\\r\\nset \\\"PYTHONPATH=%CD%\\\\venv\\\\Lib\\\\site-packages\\\"\\r\\npy -3.10 desktop_live.py\\r\\nimport unittest\\r\\nfrom unittest.mock import patch\\r\\n\\r\\nfrom audio.separacion import separar_voz, progreso_demucs\\r\\nfrom audio import catalogo\\r\\n\\r\\n\\r\\nclass PreparationTests(unittest.TestCase):\\r\\n    def test_phase_is_reported_before_demucs_and_failure_propagates(self):\\r\\n        phases = []\\r\\n        with patch('audio.separacion.os.path.exists', return_value=False), \\\\\\r\\n             patch('audio.separacion.subprocess.Popen', side_effect=RuntimeError('fallo')):\\r\\n            with self.assertRaises(RuntimeError):\\r\\n                separar_voz('song.wav', progreso_callback=phases.append)\\r\\n        self.assertEqual(phases, ['Separando voz y acompañamiento…'])\\r\\n\\r\\n    def test_real_progress_and_eta(self):\\r\\n        self.assertEqual(progreso_demucs('19%|### | 52.65/280.8 [01:37<07:02, 1.85s/seconds]'),\\r\\n                         'Separando voz y acompañamiento: 19% · Restante estimado: 07:02')\\r\\n        self.assertIsNone(progreso_demucs('Loading model'))\\r\\n\\r\\n    def test_catalog_reports_pitch_phase_and_preserves_callback(self):\\r\\n        phases = []\\r\\n        metadata = dict(original='song.wav', pitch_referencia='pitch.csv')\\r\\n        with patch.object(catalogo, 'cargar_cancion', return_value=metadata), \\\\\\r\\n             patch.object(catalogo, 'preparar_pistas', return_value=('vocals.wav', 'track.wav')) as preparation, \\\\\\r\\n             patch.object(catalogo.os.path, 'exists', return_value=False), \\\\\\r\\n             patch.object(catalogo, 'extraer_pitch', return_value=([], [])), \\\\\\r\\n             patch.object(catalogo, 'guardar_csv'), patch.object(catalogo, 'guardar_metadata'):\\r\\n            catalogo.preparar_cancion('song', progreso_callback=phases.append)\\r\\n        self.assertEqual(phases, ['Detectando las notas de referencia…'])\\r\\n        self.assertEqual(preparation.call_args.kwargs['progreso_callback'], phases.append)\\r\\n\\r\\n\\r\\nif __name__ == '__main__':\\r\\n    unittest.main()\\r\\nimport os\\r\\nimport subprocess\\r\\nimport sys\\r\\nimport re\\r\\n\\r\\nimport librosa\\r\\nimport soundfile as sf\\r\\n\\r\\n\\r\\ndef _venv_site_packages():\\r\\n    raiz = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\r\\n    return os.path.join(raiz, \\\"venv\\\", \\\"Lib\\\", \\\"site-packages\\\")\\r\\n\\r\\n\\r\\ndef _entorno_subproceso():\\r\\n    env = os.environ.copy()\\r\\n    site_packages = _venv_site_packages()\\r\\n    if os.path.exists(site_packages):\\r\\n        pythonpath = env.get(\\\"PYTHONPATH\\\", \\\"\\\")\\r\\n        rutas = [site_packages]\\r\\n        if pythonpath:\\r\\n            rutas.append(pythonpath)\\r\\n        env[\\\"PYTHONPATH\\\"] = os.pathsep.join(rutas)\\r\\n    return env\\r\\n\\r\\n\\r\\ndef _comando_python_demucs():\\r\\n    if os.path.exists(_venv_site_packages()):\\r\\n        return [\\\"py\\\", \\\"-3.10\\\", \\\"-m\\\", \\\"demucs\\\"]\\r\\n    return [sys.executable, \\\"-m\\\", \\\"demucs\\\"]\\r\\n\\r\\n\\r\\ndef rutas_demucs(ruta_audio, output_dir=\\\"output\\\"):\\r\\n    nombre = os.path.splitext(os.path.basename(ruta_audio))[0]\\r\\n    base_path = os.path.join(output_dir, \\\"htdemucs\\\", nombre)\\r\\n    return {\\r\\n        \\\"base\\\": base_path,\\r\\n        \\\"vocals\\\": os.path.join(base_path, \\\"vocals.wav\\\"),\\r\\n        \\\"drums\\\": os.path.join(base_path, \\\"drums.wav\\\"),\\r\\n        \\\"bass\\\": os.path.join(base_path, \\\"bass.wav\\\"),\\r\\n        \\\"other\\\": os.path.join(base_path, \\\"other.wav\\\"),\\r\\n        \\\"instrumental\\\": os.path.join(base_path, \\\"instrumental.wav\\\"),\\r\\n    }\\r\\n\\r\\n\\r\\ndef separar_voz(ruta_audio, forzar_separacion=False, progreso_callback=None):\\r\\n    \\\"\\\"\\\"\\r\\n    Si ya existe vocals.wav y no se fuerza, lo reutiliza.\\r\\n    Si no, ejecuta Demucs.\\r\\n    \\\"\\\"\\\"\\r\\n    output_dir = \\\"output\\\"\\r\\n    paths = rutas_demucs(ruta_audio, output_dir)\\r\\n    vocals_path = paths[\\\"vocals\\\"]\\r\\n\\r\\n    if os.path.exists(vocals_path) and not forzar_separacion:\\r\\n        print(\\\"Usando separacion ya existente\\\")\\r\\n        return vocals_path\\r\\n\\r\\n    print(\\\"Separando audio con Demucs...\\\")\\r\\n    if progreso_callback:\\r\\n        progreso_callback('Separando voz y acompañamiento…')\\r\\n    opciones = {}\\r\\n    if os.name == 'nt':\\r\\n        opciones['creationflags'] = subprocess.CREATE_NO_WINDOW\\r\\n    proceso = subprocess.Popen(\\r\\n        _comando_python_demucs() + [\\\"-o\\\", output_dir, ruta_audio],\\r\\n        env=_entorno_subproceso(),\\r\\n        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\\r\\n        text=True, encoding='utf-8', errors='replace', **opciones,\\r\\n    )\\r\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672795.6000903},"guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000}},{"type":"reasoning","id":"rs_077583884d8d8ef9016ae94662668c8191b4eaefeae87dd506","summary":[],"encrypted_content":"gAAAAABq6UZjY-tC4-k9yPafPqd9P4ljADJNjOYNyb_JN6Dxyp-Ka_k1tBQBC2QrUNid4zHGK1f2R45W2EoQJgA5H-wNtrT8CZeBNJiyVzRcBQausfxLlMOYKZCkoeHB0rijkGMtVA77kmFPzCOzJM5klGJkYG7MyQyUF5vAalWKcaND6f5lBt5yZKuKuNy8wBff1OMVUyYcCkesQbVFkzHOIl3yGkwtgptgndyv21DhY4vrNkfJ9h4BKyBFVZgIXkqVLvqsYxCV3ko14fmPKbWeoIqFQ2jb8XI6cnqRbgu1wb1McmE18gxPWT8cVQ7akm9YmRkdynNOiM8vXzBJzrb