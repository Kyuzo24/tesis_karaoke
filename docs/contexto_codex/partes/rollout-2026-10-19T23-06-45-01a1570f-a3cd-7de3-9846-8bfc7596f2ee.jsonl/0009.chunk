fQdWfZA4M33xygjSs-hhkt-8a7IltA7LzjSvr3h0bQyISP4_KSF1MQqBwBJNd16XmEQO4mlnpVUegxuAMJlxKXEVE8vJQtaFIpWlG8ImZKy4N1wGSZ7xD4pOT8hC0ARwOVpfzcWz3SKekXfi9OhlTka0hZCJTHFrLnFLtRYjsipUR8B2V4529Y5I9wK7ckREIsUIZ_9sIag4DTpMPG1Y73xIj6exJNG9dKUA==","internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922"}},{"type":"custom_tool_call","id":"ctc_077583884d8d8ef9016ae946e593ec81919e4f962a62da6010","status":"completed","call_id":"call_a4689f5de576448a8ad23f56c17b3c42","name":"exec","input":"text(await tools.apply_patch(\"*** Begin Patch\\n*** Update File: audio/catalogo.py\\n@@\\n-def agregar_cancion(ruta_audio, titulo, artista=\\\"\\\", forzar=False, progreso_callback=None):\\n+def agregar_cancion(ruta_audio, titulo, artista=\\\"\\\", forzar=False, progreso_callback=None, fuente=None):\\n@@\\n-    guardar_metadata(metadata)\\n-    return preparar_cancion(cancion_id, forzar=forzar, progreso_callback=progreso_callback)\\n+    if fuente:\\n+        metadata['fuente'] = dict(fuente)\\n+    guardar_metadata(metadata)\\n+    return preparar_cancion(cancion_id, forzar=forzar, progreso_callback=progreso_callback)\\n*** Update File: desktop_live.py\\n@@\\n import re\\n+import tempfile\\n@@\\n     regenerar_pitch_referencia,\\n+    preparar_cancion,\\n@@\\n-    def add_song_from_file(self, audio_path, title, artist=\\\"\\\"):\\n+    def search_youtube(self, query):\\n+        from audio.youtube import buscar_videos\\n+        try:\\n+            return {'ok': True, 'results': buscar_videos(query)}\\n+        except Exception as exc:\\n+            return {'ok': False, 'error': str(exc)}\\n+\\n+    def add_song_from_youtube(self, video_id, title, artist=''):\\n+        from audio.youtube import descargar_audio, validar_id\\n+        try:\\n+            video_id = validar_id(video_id)\\n+            title = str(title or '').strip()\\n+            artist = str(artist or '').strip()\\n+            if not title:\\n+                raise ValueError('Ingresa un título para la canción.')\\n+        except ValueError as exc:\\n+            return {'ok': False, 'error': str(exc)}\\n+        with self._lock:\\n+            if self._tarea_en_curso():\\n+                return {'ok': False, 'error': 'Hay una tarea de audio en curso.'}\\n+            self._estado = {**self._estado_inicial(), 'status': 'adding',\\n+                            'preparation_message': 'Conectando con YouTube…'}\\n+        try:\\n+            existing = next((s for s in cargar_canciones()\\n+                             if (s.get('fuente') or {}).get('provider') == 'youtube'\\n+                             and (s.get('fuente') or {}).get('video_id') == video_id), None)\\n+            if existing:\\n+                # A failed preparation retains the original and can be retried.\\n+                cancion = existing if existing.get('preparada') else preparar_cancion(\\n+                    existing['id'], progreso_callback=self._progreso_preparacion)\\n+            else:\\n+                with tempfile.TemporaryDirectory(prefix='karaoke-youtube-') as folder:\\n+                    downloaded = descargar_audio(video_id, folder, self._progreso_preparacion)\\n+                    cancion = agregar_cancion(downloaded['path'], title, artist,\\n+                        progreso_callback=self._progreso_preparacion, fuente=downloaded['source'])\\n+            song_ui = self._cancion_para_ui(cancion)\\n+            with self._lock:\\n+                self._estado = self._estado_inicial()\\n+            return {'ok': True, 'song': song_ui, 'reused': bool(existing)}\\n+        except Exception as exc:\\n+            logging.exception('Error importando canción de YouTube')\\n+            with self._lock:\\n+                self._estado = {**self._estado_inicial(), 'status': 'error', 'error': str(exc)}\\n+            return {'ok': False, 'error': str(exc)}\\n+\\n+    def add_song_from_file(self, audio_path, title, artist=\\\"\\\"):\\n*** Update File: ui_live/app.js\\n@@\\n-    els.songArtistInput.value = \\\"\\\";\\n+    els.songArtistInput.value = fileInfo?.suggested_artist || \\\"\\\";\\n@@\\n-    const selectedFile = await window.pywebview.api.select_audio_file();\\n+    const selectedFile = window.chooseSongSource\\n+      ? await window.chooseSongSource()\\n+      : await window.pywebview.api.select_audio_file();\\n@@\\n-    const response = await window.pywebview.api.add_song_from_file(selectedFile.path, details.title, details.artist);\\n+    const response = selectedFile.video_id\\n+      ? await window.pywebview.api.add_song_from_youtube(selectedFile.video_id, details.title, details.artist)\\n+      : await window.pywebview.api.add_song_from_file(selectedFile.path, details.title, details.artist);\\n@@\\n-      songs.push(added);\\n+      const existingIndex = songs.findIndex(song => song.id === added.id);\\n+      if (existingIndex >= 0) songs[existingIndex] = added;\\n+      else songs.push(added);\\n@@\\n-    finalStatus = `Lista: ${added?.title || details.title}`;\\n+    finalStatus = `${response.reused ? 'Ya está en tu biblioteca' : 'Lista'}: ${added?.title || details.title}`;\\n*** Update File: ui_live/index.html\\n@@\\n-        <span>Archivo seleccionado</span>\\n+        <span>Audio seleccionado</span>\\n@@\\n   <script src=\\\"app.js\\\"></script>\\n+  <script src=\\\"youtube.js\\\"></script>\\n*** Add File: ui_live/youtube.js\\n+/* Search results are untrusted: render all provider text with textContent. */\\n+(() => {\\n+  const dialog = document.createElement('dialog');\\n+  dialog.className = 'song-modal youtube-dialog';\\n+  dialog.setAttribute('aria-labelledby', 'youtubeTitle');\\n+  dialog.innerHTML = `\\n+    <div class=\\\"modal-head\\\"><div><div class=\\\"section-label\\\">Biblioteca</div>\\n+    <h2 id=\\\"youtubeTitle\\\">Agregar canción</h2></div>\\n+    <button type=\\\"button\\\" class=\\\"button\\\" data-close aria-label=\\\"Cerrar\\\">×</button></div>\\n+    <form><label class=\\\"modal-field\\\" for=\\\"youtubeQuery\\\"><span>Buscar en YouTube</span>\\n+    <input id=\\\"youtubeQuery\\\" type=\\\"search\\\" placeholder=\\\"Nombre de canción y artista\\\" required minlength=\\\"2\\\" maxlength=\\\"200\\\" autocomplete=\\\"off\\\"></label>\\n+    <button class=\\\"button button-primary\\\" type=\\\"submit\\\">Buscar</button></form>\\n+    <p class=\\\"youtube-status\\\" role=\\\"status\\\" aria-live=\\\"polite\\\"></p>\\n+    <div class=\\\"youtube-results\\\"></div>\\n+    <p class=\\\"youtube-hint\\\">La preparación puede tardar varios minutos. Las canciones listas se guardan para tus próximas sesiones. Importa contenido propio o que tengas permiso para utilizar.</p>\\n+    <div class=\\\"modal-actions\\\"><button type=\\\"button\\\" class=\\\"button\\\" data-file>Elegir archivo local</button>\\n+    <button type=\\\"button\\\" class=\\\"button\\\" data-close>Cancelar</button></div>`;\\n+  const style = document.createElement('style');\\n+  style.textContent = `\\n+    .youtube-dialog {width:min(680px,90vw);max-height:85vh;overflow:auto;background:#141c2b;color:#eef2ff;border:1px solid #435069;border-radius:16px;padding:24px;}\\n+    .youtube-dialog::backdrop {background:rgba(0,0,0,.7);}\\n+    .youtube-dialog form {display:flex;align-items:end;gap:12px;}\\n+    .youtube-dialog .modal-field {flex:1;min-width:0;}\\n+    .youtube-results {display:grid;gap:10px;}\\n+    .youtube-result {display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid #435069;border-radius:10px;padding:12px;}\\n+    .youtube-result strong,.youtube-result small {display:block;overflow-wrap:anywhere;}\\n+    .youtube-result small,.youtube-hint {color:#b5c1d6;}\\n+    .youtube-hint {font-size:13px;line-height:1.5;}\\n+    .youtube-status {min-height:24px;}\\n+    @media(max-width:500px){.youtube-result{align-items:start;flex-direction:column;}}\\n+  `;\\n+  document.head.append(style);\\n+  document.body.append(dialog);\\n+  const form = dialog.querySelector('form');\\n+  const query = dialog.querySelector('input');\\n+  const submit = form.querySelector('button');\\n+  const status = dialog.querySelector('.youtube-status');\\n+  const results = dialog.querySelector('.youtube-results');\\n+  let finish = null;\\n+  let generation = 0;\\n+  function close(result) {\\n+    generation++;\\n+    const resolve = finish;\\n+    finish = null;\\n+    dialog.close();\\n+    resolve?.(result);\\n+  }\\n+  dialog.querySelectorAll('[data-close]').forEach(b => b.onclick = () => close({cancelled:true}));\\n+  dialog.addEventListener('cancel', event => {event.preventDefault(); close({cancelled:true});});\\n+  dialog.querySelector('[data-file]').onclick = () => close({local:true});\\n+  form.onsubmit = async event => {\\n+    event.preventDefault();\\n+    const request = ++generation;\\n+    submit.disabled = true;\\n+    results.replaceChildren();\\n+    status.textContent = 'Buscando canciones…';\\n+    try {\\n+      const response = await window.pywebview.api.search_youtube(query.value.trim());\\n+      if (!finish || request !== generation) return;\\n+      if (!response.ok) throw new Error(response.error || 'No se pudo completar la búsqueda.');\\n+      status.textContent = response.results.length\\n+        ? 'Selecciona una canción. Se muestran videos de hasta 20 minutos.'\\n+        : 'No encontramos canciones disponibles. Prueba con otro título o artista.';\\n+      response.results.forEach(item => {\\n+        const row = document.createElement('div'); row.className = 'youtube-result';\\n+        const info = document.createElement('div');\\n+        const title = document.createElement('strong'); title.textContent = item.title;\\n+        const meta = document.createElement('small');\\n+        const seconds = Math.round(item.duration || 0);\\n+        meta.textContent = `${item.channel || 'Canal sin nombre'} · ${seconds ? Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0') : 'Duración no disponible'}`;\\n+        info.append(title, meta);\\n+        const button = document.createElement('button');button.type = 'button';button.className = 'button';button.textContent = 'Seleccionar';\\n+        button.onclick = () => close({ok:true,video_id:item.id,filename:item.title,\\n+          suggested_title:item.title,suggested_artist:''});\\n+        row.append(info,button);results.append(row);\\n+      });\\n+    } catch (error) {\\n+      if (finish && request === generation) status.textContent = error.message || String(error);\\n+    } finally {\\n+      if (request === generation) submit.disabled = false;\\n+    }\\n+  };\\n+  window.chooseSongSource = async () => {\\n+    const selected = await new Promise(resolve => {\\n+      finish = resolve;generation++;submit.disabled = false;\\n+      status.textContent = '';results.replaceChildren();query.value = '';\\n+      dialog.showModal();query.focus();\\n+    });\\n+    return selected.local ? window.pywebview.api.select_audio_file() : selected;\\n+  };\\n+})();\\n*** End Patch\"));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672933.585053}},{"type":"custom_tool_call_output","id":"ctco_01a19f3d-9f45-7c90-92c2-324ddb6a7555","call_id":"call_a4689f5de576448a8ad23f56c17b3c42","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"{}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a19f3a-6f78-7981-bde5-371fd22f0922","create_time":1793672978.2458413},"guardian_metadata":{"client_authored":false,"fallback_token_limit_override":12000}},{"type":"reasoning","id":"rs_077583884d8d8ef9016ae9471999dc81918b586c25a1b9d3c8","summary":[],"encrypted_content":"gAAAAABq6UcZ7lWK-9Bggw6vHuA8c0gsJKxKsk5pihAYuUCuZZqoPNID06Cxn5G3VJq6ZeB-Owq7gfHtWnR_DAuTQR0f8p_WhXJMPtPAa6nqz73gxZZlX-WUdhGafGCQBTc-AKvPGvgzZQ9Nrxg2QVoo_Oy9LddZK2bPqsmqdkmE7VQ2So_s8tHAF2IeLVA4b0PB9VuTbRSR_oze1-WnTML9UupGETCp6eEjB2jwezZ4yofY9ha