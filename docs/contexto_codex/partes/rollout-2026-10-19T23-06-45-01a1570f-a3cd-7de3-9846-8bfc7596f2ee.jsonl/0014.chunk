             if icon_handle != 0:\r\n250:                    self.Icon = Icon.FromHandle(IntPtr.op_Explicit(Int32(icon_handle))).Clone()\r\n251:                    windll.user32.DestroyIcon(icon_handle)\r\n411:                        WinForms.MessageBoxIcon.Asterisk,\r\nusing System;\r\nusing System.Diagnostics;\r\nusing System.IO;\r\nusing System.Windows.Forms;\r\nusing System.Reflection;\r\n\r\n[assembly: AssemblyTitle(\"Karaoke Studio\")]\r\n[assembly: AssemblyVersion(\"1.0.1.0\")]\r\n[assembly: AssemblyFileVersion(\"1.0.1.0\")]\r\n\r\nclass Launcher {\r\n    [STAThread]\r\n    static void Main() {\r\n        string root = AppDomain.CurrentDomain.BaseDirectory;\r\n        try {\r\n            var start = new ProcessStartInfo {\r\n                FileName = Path.Combine(root, \"runtime\", \"audio\", \"pythonw.exe\"),\r\n                Arguments = \"\\\"\" + Path.Combine(root, \"launch.py\") + \"\\\"\",\r\n                WorkingDirectory = root,\r\n                UseShellExecute = false,\r\n\r\nFullName\r\n--------\r\nC:\\Users\\Diego Tapia\\AppData\\Local\\Programs\\Karaoke Studio\\KaraokeStudio.exe\r\ncache\r\ncanciones\r\ngrabaciones\r\nPreferencias\r\ninicio.log\r\n\r\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a1c327-4711-7a42-99d4-4540680e5b0c","create_time":1794275513.8770912}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
