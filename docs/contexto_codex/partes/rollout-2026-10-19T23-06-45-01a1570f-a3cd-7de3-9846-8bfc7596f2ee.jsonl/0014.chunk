r\n        return self._marker.is_file()\r\n\r\n    def set_guide_hidden(self, hidden):\r\n        if hidden:\r\n            self._marker.parent.mkdir(parents=True, exist_ok=True)\r\n            self._marker.touch()\r\n        else:\r\n            self._marker.unlink(missing_ok=True)\r\n        return self.guide_hidden()\r\n\r\n\r\nclass LiveBackend:\r\n    def tutorial_seen(self):\r\n        return self._guide_preferences._marker.with_name('tutorial-visto').is_file()\r\n\r\n    def mark_tutorial_seen(self):\r\n        marker = self._guide_preferences._marker.with_name('tutorial-visto')\r\n        marker.parent.mkdir(parents=True, exist_ok=True)\r\n        marker.touch()\r\n        return True\r\n\r\n    def guide_hidden(self):\r\n        return self._guide_preferences.guide_hidden()\r\n\r\n    def set_guide_hidden(self, hidden):\r\n        return self._guide_preferences.set_guide_hidden(hidden)\r\n\r\n    def library_info(self):\r\n        from audio.biblioteca import informacion\r\n        try:\r\n            return {'ok':True, **informacion()}\r\n        except Exception as exc:\r\n            return {'ok':False,'error':str(exc)}\r\n\r\nName           LastWriteTime\r\n----           -------------\r\nDatos          09-11-2026 12:43:04\r\ntutorial-visto 08-11-2026 22:39:08\r\n[Setup]\r\nAppId={{B16C8B1D-0C41-4F93-9075-10937FD5E963}\r\nAppName=Karaoke Studio\r\nAppVersion=1.0.0\r\nAppPublisher=Proyecto de tesis de Diego Tapia\r\nDefaultDirName={localappdata}\\Programs\\Karaoke Studio\r\nDefaultGroupName=Karaoke Studio\r\nPrivilegesRequired=lowest\r\nArchitecturesAllowed=x64compatible\r\nArchitecturesInstallIn64BitMode=x64compatible\r\nMinVersion=10.0\r\nOutputDir=..\\dist\r\nOutputBaseFilename=KaraokeStudio-1.0.0-Setup\r\nCompression=lzma2/fast\r\nSolidCompression=yes\r\nWizardStyle=modern\r\nUninstallDisplayIcon={app}\\KaraokeStudio.exe\r\nDisableProgramGroupPage=yes\r\nCloseApplications=no\r\nInfoBeforeFile=ANTES-DE-INSTALAR.txt\r\n\r\n[Languages]\r\nName: \"spani